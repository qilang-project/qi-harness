// 常驻工 — 让 agent 主动开口：定时/排期巡检 + 事件桥
//
// harness 本来是被调用的库：你问一句它答一句，调用返回它就不存在了。
// 这个模块补上另一半 —— 一个不用人催、自己醒过来干活、有话才说的常驻工。
//
// ── 难的不是怎么推，是什么时候闭嘴 ─────────────────────────────
//
// 「每天早上推一条」的东西最后都没人看：平静的日子它也得说话，于是产出
// 一堆「今日无异常，一切正常」，读几次之后真出事那天的那条也一起被划过去了。
// 所以这个模块的重心不在循环（循环谁都会写），在 出口 那一层的**去重和节流**：
//
//   出口 = 扇出 + 指纹去重 + 静默期
//
// 同一件事在静默期内只说一次。指纹由你给 —— 它是「什么算同一件事」的定义，
// 这件事只有你知道。剩下的（记账、过期清理、并发保护）归模块。
//
// ── 三层，各管各的 ──────────────────────────────────────────────
//
//   常驻工   什么时候醒            —— 间隔 或 cron 排期（见 Harness.排期）
//   出口     说不说 / 说给谁       —— 去重、静默期、扇出到 N 个接收者
//   接收者   怎么送出去            —— 你写：qi-web 广播 / Redis / 日志 / webhook
//
// 事件桥是第四件：把 harness 自己的生命周期事件（Harness.事件）转发进出口，
// 于是「agent 干活的过程」也能实时推出去，不用等它跑完。
//
// ── 用法 ────────────────────────────────────────────────────────
//
//   导入 Harness.常驻工::{创建出口, 挂接收者, 创建推送, 送,
//                        按排期, 起工后台, 架事件桥};
//
//   变量 出: 整数 = 创建出口(3600);              // 同一指纹一小时内只说一次
//   挂接收者(出, 闭包(消息JSON: 字符串): 整数 {
//       Web::广播(锁, 连接表, "看板", 消息JSON);  // 送到浏览器
//       返回 1;
//   });
//
//   起工后台(按排期("巡检", "*/15 9-17 * * MON-FRI"), 出,
//       闭包(轮次: 整数, 触发时刻: 整数): 整数 {
//           如果 (有异动() == 0) { 返回 1; }      // 没事就闭嘴
//           送(出, 创建推送(指纹(), "标的异动", 正文()));
//           返回 1;                               // 返 0 = 这个工收工
//       });
//
// ── 写 一轮 / 接收者 闭包时的一个坑 ─────────────────────────────
//
// **闭包捕获局部变量是按值的**，在闭包里改它，外面看不见：
//
//     函数 错的() {
//         变量 计: 整数 = 0;
//         挂接收者(出, 闭包(消息: 字符串): 整数 { 计 = 计 + 1; 返回 1; });
//         …            // 计 永远是 0
//     }
//
// 捕获**全局**变量才是按引用的，改得动。要在闭包里累计状态，
// 把它放全局，或者存进句柄化的容器（列表/JSON 对象）里 —— 那些传的是句柄。
// 这条不报错、不崩，只是计数永远为零，排查起来很费时间。
//
// opt-in：不在 Harness.qi 核心自动导入。

包 Harness;

导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 标准库.时间;
导入 标准库.同步 作为 同步;
导入 标准库.JSON 作为 J;
导入 Harness.排期::{排期, 解析排期, 排期匹配, 下次触发, 排期说明};
导入 Harness.事件::{订阅生命周期事件};

// ── 推送 ────────────────────────────────────────────────────────

公开 类型 推送 {
    指纹: 字符串,       // 「什么算同一件事」——去重就看它
    标题: 字符串,
    正文: 字符串,
    级别: 字符串,       // 信息 / 注意 / 警报
    来源: 字符串,
    时间戳毫秒: 整数,
}

公开 函数 创建推送(指纹: 字符串, 标题: 字符串, 正文: 字符串) : 推送 {
    返回 新建 推送 {
        指纹: 指纹, 标题: 标题, 正文: 正文,
        级别: "信息", 来源: "", 时间戳毫秒: 时间.现在毫秒(),
    };
}

公开 函数 推送带级别(推: 推送, 级别: 字符串) : 推送 {
    推.级别 = 级别;
    返回 推;
}

公开 函数 推送带来源(推: 推送, 来源: 字符串) : 推送 {
    推.来源 = 来源;
    返回 推;
}

公开 函数 推送转JSON(推: 推送) : 字符串 {
    变量 根: 整数 = J.创建对象();
    J.设置字符串(根, "指纹", 推.指纹);
    J.设置字符串(根, "标题", 推.标题);
    J.设置字符串(根, "正文", 推.正文);
    J.设置字符串(根, "级别", 推.级别);
    J.设置字符串(根, "来源", 推.来源);
    J.设置整数(根, "时间戳毫秒", 推.时间戳毫秒);
    变量 文: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 文;
}

// ── 出口 ────────────────────────────────────────────────────────
//
// 句柄化：出口的状态存在下面这几张平行表里，句柄就是下标。
// 每个出口自带一把锁 —— 工跑在 goroutine 里，两个工共用一个出口是常态。

变量 出口锁表: 整数 = 0;          // 整数列表：同步锁句柄
变量 出口接收表: 整数 = 0;        // 整数列表：指针列表句柄（函数(字符串):整数）
变量 出口指纹表: 整数 = 0;        // 整数列表：字符串列表句柄
变量 出口末次表: 整数 = 0;        // 整数列表：整数列表句柄（毫秒）
变量 出口静默表: 整数 = 0;        // 整数列表：静默期秒
变量 出口送出表: 整数 = 0;        // 整数列表：累计送出条数
变量 出口挡下表: 整数 = 0;        // 整数列表：累计被去重挡下的条数

// 指纹表的上界。超了就清掉已经过了静默期的条目 —— 那些留着也挡不住谁。
常量 指纹上限 = 512;

函数 备好出口表() {
    如果 (出口锁表 == 0) {
        出口锁表 = 列表库::创建整数列表();
        出口接收表 = 列表库::创建整数列表();
        出口指纹表 = 列表库::创建整数列表();
        出口末次表 = 列表库::创建整数列表();
        出口静默表 = 列表库::创建整数列表();
        出口送出表 = 列表库::创建整数列表();
        出口挡下表 = 列表库::创建整数列表();
    }
}

// 静默期秒 <= 0 表示不去重，条条都送。
公开 函数 创建出口(静默期秒: 整数) : 整数 {
    备好出口表();
    列表库::添加整数(出口锁表, 同步.创建锁());
    列表库::添加整数(出口接收表, 列表库::创建指针列表());
    列表库::添加整数(出口指纹表, 列表库::创建字符串列表());
    列表库::添加整数(出口末次表, 列表库::创建整数列表());
    列表库::添加整数(出口静默表, 静默期秒);
    列表库::添加整数(出口送出表, 0);
    列表库::添加整数(出口挡下表, 0);
    返回 列表库::整数列表大小(出口锁表) - 1;
}

函数 出口有效(出口: 整数) : 整数 {
    如果 (出口锁表 == 0) { 返回 0; }
    如果 (出口 < 0) { 返回 0; }
    如果 (出口 >= 列表库::整数列表大小(出口锁表)) { 返回 0; }
    返回 1;
}

公开 函数 挂接收者(出口: 整数, 接收者: 函数(字符串): 整数) : 整数 {
    如果 (出口有效(出口) == 0) { 返回 0; }
    变量 锁: 整数 = 列表库::获取整数(出口锁表, 出口);
    同步.加锁(锁);
    列表库::添加指针(列表库::获取整数(出口接收表, 出口), 接收者);
    变量 数: 整数 = 列表库::指针列表大小(列表库::获取整数(出口接收表, 出口));
    同步.解锁(锁);
    返回 数;
}

公开 函数 接收者数(出口: 整数) : 整数 {
    如果 (出口有效(出口) == 0) { 返回 0; }
    返回 列表库::指针列表大小(列表库::获取整数(出口接收表, 出口));
}

// 找指纹下标，没有返回 -1
函数 找指纹(指纹表: 整数, 指纹: 字符串) : 整数 {
    变量 n: 整数 = 列表库::字符串列表大小(指纹表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (字符串::等于(列表库::获取字符串(指纹表, i), 指纹) == 1) { 返回 i; }
        i = i + 1;
    }
    返回 -1;
}

// 清掉已过静默期的指纹（重建两张平行表）。调用方必须已持锁。
函数 清过期指纹(出口: 整数, 现在毫秒: 整数, 静默毫秒: 整数) {
    变量 老指纹: 整数 = 列表库::获取整数(出口指纹表, 出口);
    变量 老末次: 整数 = 列表库::获取整数(出口末次表, 出口);
    变量 新指纹: 整数 = 列表库::创建字符串列表();
    变量 新末次: 整数 = 列表库::创建整数列表();
    变量 n: 整数 = 列表库::字符串列表大小(老指纹);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 末: 整数 = 列表库::获取整数(老末次, i);
        如果 (现在毫秒 - 末 < 静默毫秒) {
            列表库::添加字符串(新指纹, 列表库::获取字符串(老指纹, i));
            列表库::添加整数(新末次, 末);
        }
        i = i + 1;
    }
    列表库::设置整数(出口指纹表, 出口, 新指纹);
    列表库::设置整数(出口末次表, 出口, 新末次);
    列表库::删除列表(老指纹);
    列表库::删除列表(老末次);
}

// 送一条。1 = 真的送出去了，0 = 被静默期挡下（或出口无效）。
//
// 交付在**锁外**做：接收者可能是一次网络写，握着锁做会把别的工全堵住。
公开 函数 送(出口: 整数, 推: 推送) : 整数 {
    如果 (出口有效(出口) == 0) { 返回 0; }
    变量 锁: 整数 = 列表库::获取整数(出口锁表, 出口);
    变量 静默秒: 整数 = 列表库::获取整数(出口静默表, 出口);
    变量 现: 整数 = 时间.现在毫秒();

    同步.加锁(锁);

    如果 (静默秒 > 0 && 字符串::字节长度(推.指纹) > 0) {
        变量 静默毫秒: 整数 = 静默秒 * 1000;
        变量 指纹表: 整数 = 列表库::获取整数(出口指纹表, 出口);
        变量 末次表: 整数 = 列表库::获取整数(出口末次表, 出口);
        变量 位: 整数 = 找指纹(指纹表, 推.指纹);
        如果 (位 >= 0) {
            变量 末: 整数 = 列表库::获取整数(末次表, 位);
            如果 (现 - 末 < 静默毫秒) {
                列表库::设置整数(出口挡下表, 出口,
                    列表库::获取整数(出口挡下表, 出口) + 1);
                同步.解锁(锁);
                返回 0;
            }
            列表库::设置整数(末次表, 位, 现);
        } 否则 {
            列表库::添加字符串(指纹表, 推.指纹);
            列表库::添加整数(末次表, 现);
            如果 (列表库::字符串列表大小(指纹表) > 指纹上限) {
                清过期指纹(出口, 现, 静默毫秒);
            }
        }
    }

    // 快照接收者，锁外交付
    变量 接收表: 整数 = 列表库::获取整数(出口接收表, 出口);
    变量 个数: 整数 = 列表库::指针列表大小(接收表);
    变量 快照: 整数 = 列表库::创建指针列表();
    变量 k: 整数 = 0;
    当 (k < 个数) {
        变量 复制: 函数(字符串): 整数 = 列表库::获取指针(接收表, k);
        列表库::添加指针(快照, 复制);
        k = k + 1;
    }
    列表库::设置整数(出口送出表, 出口, 列表库::获取整数(出口送出表, 出口) + 1);
    同步.解锁(锁);

    变量 文: 字符串 = 推送转JSON(推);
    变量 i: 整数 = 0;
    当 (i < 个数) {
        变量 收: 函数(字符串): 整数 = 列表库::获取指针(快照, i);
        收(文);
        i = i + 1;
    }
    列表库::删除列表(快照);
    返回 1;
}

公开 函数 出口统计JSON(出口: 整数) : 字符串 {
    如果 (出口有效(出口) == 0) { 返回 "{}"; }
    变量 根: 整数 = J.创建对象();
    J.设置整数(根, "接收者", 接收者数(出口));
    J.设置整数(根, "送出", 列表库::获取整数(出口送出表, 出口));
    J.设置整数(根, "挡下", 列表库::获取整数(出口挡下表, 出口));
    J.设置整数(根, "静默期秒", 列表库::获取整数(出口静默表, 出口));
    J.设置整数(根, "在册指纹", 列表库::字符串列表大小(列表库::获取整数(出口指纹表, 出口)));
    变量 文: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 文;
}

// 清空去重记忆（不动接收者）。测试和「手动强推一次」用得上。
公开 函数 忘掉指纹(出口: 整数) : 整数 {
    如果 (出口有效(出口) == 0) { 返回 0; }
    变量 锁: 整数 = 列表库::获取整数(出口锁表, 出口);
    同步.加锁(锁);
    变量 老指纹: 整数 = 列表库::获取整数(出口指纹表, 出口);
    变量 老末次: 整数 = 列表库::获取整数(出口末次表, 出口);
    变量 数: 整数 = 列表库::字符串列表大小(老指纹);
    列表库::设置整数(出口指纹表, 出口, 列表库::创建字符串列表());
    列表库::设置整数(出口末次表, 出口, 列表库::创建整数列表());
    列表库::删除列表(老指纹);
    列表库::删除列表(老末次);
    同步.解锁(锁);
    返回 数;
}

// ── 工规格 ──────────────────────────────────────────────────────

公开 类型 工规格 {
    名字: 字符串,
    排期文: 字符串,     // 非空 = 走 cron；空 = 走固定间隔
    间隔秒: 整数,
    滴答秒: 整数,       // 醒来查看一次的粒度，也决定 停工 多久生效
    最多轮数: 整数,     // 0 = 不封顶
    首轮立即: 整数,     // 仅间隔模式有意义
    用本地: 整数,       // cron 按本地墙钟（默认）还是 UTC
}

公开 函数 按间隔(名字: 字符串, 间隔秒: 整数) : 工规格 {
    变量 秒: 整数 = 间隔秒;
    如果 (秒 < 1) { 秒 = 1; }
    返回 新建 工规格 {
        名字: 名字, 排期文: "", 间隔秒: 秒, 滴答秒: 默认滴答(秒),
        最多轮数: 0, 首轮立即: 0, 用本地: 1,
    };
}

公开 函数 按排期(名字: 字符串, 排期表达式: 字符串) : 工规格 {
    返回 新建 工规格 {
        名字: 名字, 排期文: 排期表达式, 间隔秒: 0, 滴答秒: 20,
        最多轮数: 0, 首轮立即: 0, 用本地: 1,
    };
}

// 滴答不能超过间隔，否则第一轮就迟到；也不必比 20 秒更密。
函数 默认滴答(间隔秒: 整数) : 整数 {
    如果 (间隔秒 < 20) { 返回 间隔秒; }
    返回 20;
}

公开 函数 工规格最多轮(规: 工规格, 轮数: 整数) : 工规格 {
    规.最多轮数 = 轮数;
    返回 规;
}

公开 函数 工规格首轮立即(规: 工规格, 是否: 整数) : 工规格 {
    规.首轮立即 = 是否;
    返回 规;
}

公开 函数 工规格滴答(规: 工规格, 秒: 整数) : 工规格 {
    变量 s: 整数 = 秒;
    如果 (s < 1) { s = 1; }
    // cron 精度是分钟，滴答超过 30 秒就可能整分钟跳过去
    如果 (字符串::字节长度(规.排期文) > 0 && s > 30) { s = 30; }
    规.滴答秒 = s;
    返回 规;
}

公开 函数 工规格用UTC(规: 工规格, 是否: 整数) : 工规格 {
    如果 (是否 == 1) { 规.用本地 = 0; } 否则 { 规.用本地 = 1; }
    返回 规;
}

// ── 停工开关 ────────────────────────────────────────────────────
//
// 用原子而不是普通全局：工跑在别的 goroutine 上，读写要跨线程可见。

变量 工名表: 整数 = 0;        // 字符串列表
变量 工停表: 整数 = 0;        // 整数列表：原子句柄

函数 备好工表() {
    如果 (工名表 == 0) {
        工名表 = 列表库::创建字符串列表();
        工停表 = 列表库::创建整数列表();
    }
}

函数 取或建停止位(名字: 字符串) : 整数 {
    备好工表();
    变量 n: 整数 = 列表库::字符串列表大小(工名表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (字符串::等于(列表库::获取字符串(工名表, i), 名字) == 1) {
            返回 列表库::获取整数(工停表, i);
        }
        i = i + 1;
    }
    变量 原子: 整数 = 同步.创建原子(0);
    列表库::添加字符串(工名表, 名字);
    列表库::添加整数(工停表, 原子);
    返回 原子;
}

// 让某个工在下一个滴答收工。返回 1 = 找到了这个工。
公开 函数 停工(名字: 字符串) : 整数 {
    备好工表();
    变量 n: 整数 = 列表库::字符串列表大小(工名表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (字符串::等于(列表库::获取字符串(工名表, i), 名字) == 1) {
            同步.写原子(列表库::获取整数(工停表, i), 1);
            返回 1;
        }
        i = i + 1;
    }
    返回 0;
}

公开 函数 停全部工() : 整数 {
    备好工表();
    变量 n: 整数 = 列表库::字符串列表大小(工名表);
    变量 i: 整数 = 0;
    当 (i < n) {
        同步.写原子(列表库::获取整数(工停表, i), 1);
        i = i + 1;
    }
    返回 n;
}

// ── 工循环 ──────────────────────────────────────────────────────
//
// 两种模式共用一个循环：永远按 滴答秒 醒来，醒来只问一句「到点没」。
// 这样 停工 最迟一个滴答就生效 —— 要是直接 睡(间隔秒)，一个跑一小时
// 一轮的工，停它得等一小时。
//
// 一轮 的签名是 函数(轮次, 触发时刻): 整数，返 0 表示这个工自己收工。
公开 函数 起工(规: 工规格, 出口: 整数, 一轮: 函数(整数, 整数): 整数) : 整数 {
    变量 停位: 整数 = 取或建停止位(规.名字);
    同步.写原子(停位, 0);

    变量 排: 排期 = 解析排期(规.排期文);
    变量 用排期: 整数 = 0;
    如果 (字符串::字节长度(规.排期文) > 0) {
        如果 (排.有效 == 0) {
            // 排期写错了就**不要跑** —— 悄悄退化成每分钟一次，
            // 等于半夜给人发一整晚的推送。
            返回 -1;
        }
        用排期 = 1;
    }

    变量 轮次: 整数 = 0;
    变量 上次跑: 整数 = 时间.现在();
    变量 上次分钟键: 整数 = -1;

    如果 (用排期 == 0 && 规.首轮立即 == 1) {
        轮次 = 1;
        如果 (一轮(轮次, 时间.现在()) == 0) { 返回 轮次; }
        上次跑 = 时间.现在();
    }

    当 (真) {
        如果 (同步.读原子(停位) == 1) { 返回 轮次; }
        如果 (规.最多轮数 > 0 && 轮次 >= 规.最多轮数) { 返回 轮次; }

        时间.睡眠秒(规.滴答秒);
        如果 (同步.读原子(停位) == 1) { 返回 轮次; }

        变量 现: 整数 = 时间.现在();
        变量 该跑: 整数 = 0;

        如果 (用排期 == 1) {
            变量 分钟键: 整数 = 现 / 60;
            // 一分钟只放一次：滴答比一分钟密，同一分钟会被撞见好几回
            如果 (分钟键 != 上次分钟键 && 排期匹配(排, 现, 规.用本地) == 1) {
                上次分钟键 = 分钟键;
                该跑 = 1;
            }
        } 否则 {
            如果 (现 - 上次跑 >= 规.间隔秒) { 该跑 = 1; }
        }

        如果 (该跑 == 1) {
            轮次 = 轮次 + 1;
            上次跑 = 现;
            如果 (一轮(轮次, 现) == 0) { 返回 轮次; }
        }
    }
    返回 轮次;
}

// 同 起工，但丢进后台 goroutine，立刻返回。返回 1 = 已启动。
// 排期写错时这里没法回报（goroutine 里的返回值没人接），所以**先在这儿验一遍**。
公开 函数 起工后台(规: 工规格, 出口: 整数, 一轮: 函数(整数, 整数): 整数) : 整数 {
    如果 (字符串::字节长度(规.排期文) > 0) {
        变量 排: 排期 = 解析排期(规.排期文);
        如果 (排.有效 == 0) { 返回 0; }
    }
    启动 起工(规, 出口, 一轮);
    返回 1;
}

// 这个工下一次什么时候跑（只对排期模式有意义；间隔模式返回 -1）。
// 给「看板上显示下次巡检时间」用。
公开 函数 工下次触发(规: 工规格, 从时间戳: 整数) : 整数 {
    如果 (字符串::字节长度(规.排期文) == 0) { 返回 -1; }
    变量 排: 排期 = 解析排期(规.排期文);
    如果 (排.有效 == 0) { 返回 -1; }
    返回 下次触发(排, 从时间戳, 规.用本地);
}

公开 函数 工规格说明(规: 工规格) : 字符串 {
    如果 (字符串::字节长度(规.排期文) > 0) {
        返回 规.名字 + " · 排期 " + 排期说明(解析排期(规.排期文));
    }
    返回 规.名字 + " · 每 " + 整数转字符串(规.间隔秒) + " 秒";
}

// ── 事件桥 ──────────────────────────────────────────────────────
//
// 把 harness 的生命周期事件转成推送，扔进出口。于是 agent **干活的过程**
// 也能实时推出去，而不是等它整个跑完才有动静。
//
// 类型前缀为空 = 全收。指纹用「类型:代理名:运行ID」，所以同一个 agent 的
// 同一类事件在静默期内只报一次 —— 不然一个 tool loop 能刷屏。
//
// 注意：事件总线是**同步**的，接收者会在发布事件那个线程上被调用。
// 接收者里别做慢操作（比如同步 HTTP），要慢就自己往队列里塞。

变量 桥出口表: 整数 = 0;      // 整数列表：每座桥对应的出口句柄
变量 桥前缀表: 整数 = 0;      // 字符串列表
变量 桥已订阅: 整数 = 0;      // 总线上只挂一个订阅者，不是每座桥挂一个

函数 备好桥表() {
    如果 (桥出口表 == 0) {
        桥出口表 = 列表库::创建整数列表();
        桥前缀表 = 列表库::创建字符串列表();
    }
}

// N 座桥只往总线上挂**一个**订阅者，由它遍历桥表分发。
//
// 一开始是「一座桥一个订阅者，闭包里捕获桥号」，能跑，但每架一座桥就漏一个
// 闭包（QI_RC_REPORT 里 活跃闭包 跟架桥次数一比一涨）：**捕获了局部变量的
// 闭包，那份环境不会被回收**。改成只挂一个不捕获任何局部的订阅者之后归零。
// 顺带这样也更对：事件来一次只解一次 JSON，而不是每座桥各解一遍。
公开 函数 架事件桥(出口: 整数, 类型前缀: 字符串) : 整数 {
    如果 (出口有效(出口) == 0) { 返回 0; }
    备好桥表();
    列表库::添加整数(桥出口表, 出口);
    列表库::添加字符串(桥前缀表, 类型前缀);

    如果 (桥已订阅 == 0) {
        桥已订阅 = 1;
        订阅生命周期事件(全部桥转发, 1);
    }
    返回 列表库::整数列表大小(桥出口表);
}

// 拆掉所有桥，并把「已挂订阅者」的记号一起清掉。
//
// 记号必须一起清：桥的订阅者是挂在生命周期总线上的，而 清空生命周期订阅者()
// 会把它一并扫走 —— 那之后 桥已订阅 还留着 1 的话，再 架事件桥 就不会重新挂，
// 桥表有内容却一条事件也收不到，全静默。所以重置的正确姿势是两句一起：
//     清空生命周期订阅者();
//     拆掉全部桥();
公开 函数 拆掉全部桥() : 整数 {
    桥已订阅 = 0;
    如果 (桥出口表 == 0) { 返回 0; }
    变量 数: 整数 = 列表库::整数列表大小(桥出口表);
    变量 老出口: 整数 = 桥出口表;
    变量 老前缀: 整数 = 桥前缀表;
    桥出口表 = 列表库::创建整数列表();
    桥前缀表 = 列表库::创建字符串列表();
    列表库::删除列表(老出口);
    列表库::删除列表(老前缀);
    返回 数;
}

函数 全部桥转发(事件JSON: 字符串) : 整数 {
    如果 (桥出口表 == 0) { 返回 1; }
    变量 座数: 整数 = 列表库::整数列表大小(桥出口表);
    如果 (座数 == 0) { 返回 1; }
    变量 i: 整数 = 0;
    当 (i < 座数) {
        桥转发(i, 事件JSON);
        i = i + 1;
    }
    返回 1;
}

函数 桥转发(桥号: 整数, 事件JSON: 字符串) : 整数 {
    如果 (桥出口表 == 0) { 返回 1; }
    如果 (桥号 < 0 || 桥号 >= 列表库::整数列表大小(桥出口表)) { 返回 1; }
    变量 出口: 整数 = 列表库::获取整数(桥出口表, 桥号);
    变量 前缀: 字符串 = 列表库::获取字符串(桥前缀表, 桥号);

    变量 根: 整数 = J.解码(事件JSON);
    如果 (根 <= 0) { 返回 1; }
    // 键名是**英文**：生命周期事件是上线协议，qi-harness 那边就是按
    // type/agent/run_id 发的（中文只写在 qi 源码里，不进协议）。
    // 照着结构体字段名去取「类型/代理名」会一律拿到空串 —— 而空串不会报错，
    // 只会让前缀过滤永远不匹配、级别永远抬不起来，静悄悄地全错。
    变量 事件类型: 字符串 = J.获取字符串(根, "type");
    变量 代理名: 字符串 = J.获取字符串(根, "agent");
    变量 运行ID: 字符串 = J.获取字符串(根, "run_id");
    J.删除(根);

    如果 (字符串::字节长度(前缀) > 0) {
        如果 (字符串::开始于(事件类型, 前缀) == 0) { 返回 1; }
    }

    变量 推: 推送 = 创建推送(
        事件类型 + ":" + 代理名 + ":" + 运行ID,
        事件类型,
        事件JSON);
    推 = 推送带来源(推, "事件桥");
    // 事件本身没有级别；error/失败 一类抬成警报，好让接收者能分流
    如果 (字符串::包含(事件类型, "error") == 1 || 字符串::包含(事件类型, "失败") == 1) {
        推 = 推送带级别(推, "警报");
    }
    送(出口, 推);
    返回 1;
}

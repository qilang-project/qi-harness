// 长时程 — 分段执行 + 断点续跑的任务编排
//
// ── 为什么不能直接用 循环.qi ──────────────────────────────────────
//
// 循环.qi 是「制造者干活 → 校验者验收 → 再来一轮」，同一个会话里滚。跑十分钟
// 没问题，跑十小时会死在两件事上：
//
//   1. 它的跨轮记忆是**一个只增不减的字符串**（每轮把成果和验收都接在后面）。
//      轮数一多，上下文先被它撑爆。
//   2. 全部状态活在进程内存里。进程一没，从头再来。
//
// 本模块把长任务切成**段**。每一段：
//
//   开一个全新会话  →  从**持久状态**重建上下文  →  干活  →  把该留下的写回去  →  关掉会话
//
// 关键在「重建」而不是「继承」：下一段拿到的不是压缩过的消息历史，而是
// 目标 + 里程碑完成情况 + 上一段留下的**有界**笔记（可选再加图记忆召回的
// 相关事实）。所以上下文长度跟段数无关，跑一百段和跑一段一样长。
//
// 持久状态在 SQLite（跟 会话存储.qi 同一个 标准库.数据库，不引新依赖）。
// 进程崩了、机器重启了，`续长任务` 从库里把任务原样接回来，从下一段继续。
//
// ── 跟别的模块的分工 ──────────────────────────────────────────────
//
//   目标监控.qi  提供 目标/里程碑 的结构与进度计算（本模块直接复用，不重造）
//   循环.qi      段**内**要不要多轮，由调用方自己决定；本模块只管段**间**
//   图记忆.qi    可选的跨段知识源。**不硬依赖** —— 图库句柄由调用方传进来，
//                跟 启用图记忆 对 代理 的做法一致。这样 Harness.qi 仍可以
//                re-export 本模块，而不会把 qi-graph / qi-kv 拖给每个用户。
//
// 用法：
//   变量 库: 整数 = 打开长任务库("任务.db");
//   变量 任务: 长任务 = 开长任务(库, "重构解析器", "把手写 lexer 换成生成的");
//   任务 = 加里程碑(任务, "跑通现有测试");
//   任务 = 加里程碑(任务, "换掉 lexer");
//   任务 = 设分段(任务, 6, 20);            // 每段最多 6 轮，最多 20 段
//   任务 = 一直跑(任务, 模型配置值);
//
// 中断之后：
//   变量 任务: 长任务 = 续长任务(库, "重构解析器");   // 状态、段号、笔记都在
//   任务 = 一直跑(任务, 模型配置值);

包 Harness;

导入 标准库.数据库;
导入 标准库.字符串;
导入 标准库.时间;
导入 标准库.JSON 作为 J;
导入 Harness.模型::{模型配置, 开启会话};
导入 Harness.代理::{代理, 创建代理, 运行, 简单问, 关闭代理};
导入 Harness.文件工具::{文件沙箱, 创建文件沙箱, 允许写, 装备文件工具};
导入 Harness.目标监控::{目标, 创建目标, 添加里程碑, 里程碑数, 已完成数, 标记完成, 进度, 是否达成, 目标报告};
导入 Harness.追踪::{事件};

公开 类型 长任务 {
    库: 整数,
    名字: 字符串,
    目标值: 目标,
    段号: 整数,           // 已经跑完的段数
    每段最多轮: 整数,
    最多段数: 整数,
    文件沙箱根: 字符串,   // 非空 = 每段给新代理装上文件工具（限定在这个目录里）
    沙箱可写: 整数,       // 0 = 只读。要让 agent 真的产出东西就得给 1
    上段笔记: 字符串,
    结局: 字符串,         // "进行中" / "完成" / "升级" / "超限"
}

变量 笔记上限: 整数 = 1200;   // 段间笔记的硬上限，防止它退化成又一个只增不减的串

// ── 存储 ────────────────────────────────────────────────────────

// SQL 字符串字面量：单引号翻倍。所有外部文本只经这里进 SQL。
函数 引(文本: 字符串) : 字符串 {
    返回 "'" + 字符串::替换(文本, "'", "''") + "'";
}

公开 函数 打开长任务库(路径: 字符串) : 整数 {
    变量 库: 整数 = 数据库.连接(路径);
    如果 (库 <= 0) { 返回 0; }
    数据库.执行(库, "CREATE TABLE IF NOT EXISTS 长任务("
        + "名字 TEXT PRIMARY KEY, 目标JSON TEXT, 段号 INTEGER, 每段最多轮 INTEGER,"
        + " 最多段数 INTEGER, 文件沙箱根 TEXT, 沙箱可写 INTEGER, 上段笔记 TEXT, 结局 TEXT, 更新于 INTEGER)");
    数据库.执行(库, "CREATE TABLE IF NOT EXISTS 长任务段("
        + "名字 TEXT, 段号 INTEGER, 笔记 TEXT, 产出 TEXT, 时刻 INTEGER)");
    返回 库;
}

公开 函数 关闭长任务库(库: 整数) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    返回 数据库.关闭(库);
}

函数 目标转JSON(目标值: 目标) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    J.设置字符串(对象, "描述", 目标值.描述);
    J.设置字符串(对象, "验收标准", 目标值.验收标准);
    J.设置字符串(对象, "里程碑们", 目标值.里程碑们);
    J.设置字符串(对象, "完成标记", 目标值.完成标记);
    J.设置字符串(对象, "状态", 目标值.状态);
    变量 文本: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 文本;
}

函数 JSON转目标(文本: 字符串) : 目标 {
    变量 对象: 整数 = J.解码(文本);
    如果 (对象 <= 0) { 返回 创建目标("", ""); }
    变量 出: 目标 = 新建 目标 {
        描述: J.获取字符串(对象, "描述"),
        验收标准: J.获取字符串(对象, "验收标准"),
        里程碑们: J.获取字符串(对象, "里程碑们"),
        完成标记: J.获取字符串(对象, "完成标记"),
        状态: J.获取字符串(对象, "状态"),
    };
    J.删除(对象);
    返回 出;
}

// 把任务当前状态整条写回去（幂等）。每段结束都调一次 —— 崩在任何一段中间，
// 最多丢那一段，已完成的段全在。
公开 函数 保存长任务(任务值: 长任务) : 整数 {
    如果 (任务值.库 <= 0) { 返回 0; }
    // ⚠ 落库失败必须出声。数据库.执行 返回受影响行数但不抛 —— 我给表加列时
    // 漏改了 INSERT 的列名单（列 8 个、值 10 个），语句每次都失败，而现象只
    // 表现为「续长任务 捞不回来」，完全看不出是写的时候就没成。
    变量 影响: 整数 = 数据库.执行(任务值.库, "INSERT OR REPLACE INTO 长任务"
        + "(名字, 目标JSON, 段号, 每段最多轮, 最多段数, 文件沙箱根, 沙箱可写,"
        + " 上段笔记, 结局, 更新于) VALUES("
        + 引(任务值.名字) + ", " + 引(目标转JSON(任务值.目标值)) + ", "
        + 整数转字符串(任务值.段号) + ", " + 整数转字符串(任务值.每段最多轮) + ", "
        + 整数转字符串(任务值.最多段数) + ", " + 引(任务值.文件沙箱根) + ", "
        + 整数转字符串(任务值.沙箱可写) + ", "
        + 引(任务值.上段笔记) + ", "
        + 引(任务值.结局) + ", " + 整数转字符串(时间.现在()) + ")");
    如果 (影响 <= 0) {
        事件("longrun_save_failed", "长时程", 任务值.名字 + " 落库失败，续跑会捞不回来");
        返回 0;
    }
    返回 1;
}

函数 空任务() : 长任务 {
    返回 新建 长任务 {
        库: 0, 名字: "", 目标值: 创建目标("", ""), 段号: 0,
        // 每段 40 轮：**段开大一点**。分段是保险不是优化 —— 换段要重建上下文、
        // 重走一遍现场，段越小这份重走成本占比越高。实测过同一个任务同一个模型
        // 只改段大小：一段能做完的时候总时长最短，切碎了反而更慢。
        // 所以段大小的取法是「模型上下文扛得住的最大值」，不是「越小越安全」。
        每段最多轮: 40, 最多段数: 24, 文件沙箱根: "", 沙箱可写: 0,
        上段笔记: "", 结局: "进行中",
    };
}

公开 函数 长任务可用(任务值: 长任务) : 整数 {
    如果 (任务值.库 <= 0) { 返回 0; }
    如果 (字符串::字节长度(任务值.名字) == 0) { 返回 0; }
    返回 1;
}

// 载入已存在的任务；没有则返回不可用的空任务（长任务可用 判 0）。
公开 函数 续长任务(库: 整数, 名字: 字符串) : 长任务 {
    变量 出: 长任务 = 空任务();
    如果 (库 <= 0) { 返回 出; }
    变量 行JSON: 字符串 = 数据库.查询(库,
        "SELECT 目标JSON, 段号, 每段最多轮, 最多段数, 文件沙箱根, 沙箱可写, 上段笔记, 结局 FROM 长任务 WHERE 名字 = "
        + 引(名字) + " LIMIT 1");
    变量 行组: 整数 = J.解码(行JSON);
    如果 (行组 <= 0) { 返回 出; }
    如果 (J.数组长度(行组) == 0) { J.删除(行组); 返回 出; }
    变量 行: 整数 = J.数组获取对象(行组, 0);
    出.库 = 库;
    出.名字 = 名字;
    出.目标值 = JSON转目标(J.获取字符串(行, "目标JSON"));
    出.段号 = J.获取整数(行, "段号");
    出.每段最多轮 = J.获取整数(行, "每段最多轮");
    出.最多段数 = J.获取整数(行, "最多段数");
    出.文件沙箱根 = J.获取字符串(行, "文件沙箱根");
    出.沙箱可写 = J.获取整数(行, "沙箱可写");
    出.上段笔记 = J.获取字符串(行, "上段笔记");
    出.结局 = J.获取字符串(行, "结局");
    J.删除(行组);
    事件("longrun_resume", "长时程", 名字 + " 从第 " + 整数转字符串(出.段号 + 1) + " 段接着跑");
    返回 出;
}

// 开一个长任务：**已存在就原样接回来**（所以反复调是安全的，不会把进度清零）。
公开 函数 开长任务(库: 整数, 名字: 字符串, 目标描述: 字符串) : 长任务 {
    变量 已有: 长任务 = 续长任务(库, 名字);
    如果 (长任务可用(已有) == 1) { 返回 已有; }

    变量 出: 长任务 = 空任务();
    出.库 = 库;
    出.名字 = 名字;
    出.目标值 = 创建目标(目标描述, "");
    保存长任务(出);
    事件("longrun_create", "长时程", 名字);
    返回 出;
}

公开 函数 设分段(任务值: 长任务, 每段最多轮: 整数, 最多段数: 整数) : 长任务 {
    如果 (每段最多轮 > 0) { 任务值.每段最多轮 = 每段最多轮; }
    如果 (最多段数 > 0) { 任务值.最多段数 = 最多段数; }
    保存长任务(任务值);
    返回 任务值;
}

// 给每段的新代理装上文件工具，读写限定在 根目录 里。
//
// 为什么是个字段而不是让调用方自己装：跑一段 **在内部建代理**（段间换会话是
// 这个模块的立身之本），代理生出来就在函数里，外面够不着。而没有工具的长任务
// 只能空对空地聊，根本干不了实事。
//
// 只覆盖文件工具这一种，是因为 harness 的工具注册靠有界槽位（函数指针不能
// 动态生成，见 技能.qi），塞不下一个通用的「装备回调」。要别的工具，眼下的
// 办法是自己按 跑一段 的样子写一层。
// ⚠ **任务库不要放在 根目录 里面**。放进去 agent 一 列目录 就看见 任务.db，
// 会跑去读这个二进制文件 —— 编排器自己的状态不该出现在 agent 的工作区里。
// 实测踩过：第一段就把整段预算花在读 .db 上，然后升级放弃。
//
// 可写 传 0 是只读沙箱（只给 读文件/列目录/文件信息）。要 agent 真产出东西
// 必须传 1，否则它会（正确地）报告「没有写文件的工具」然后升级。
公开 函数 用文件沙箱(任务值: 长任务, 根目录: 字符串, 可写: 整数) : 长任务 {
    任务值.文件沙箱根 = 根目录;
    任务值.沙箱可写 = 可写;
    保存长任务(任务值);
    返回 任务值;
}

公开 函数 加里程碑(任务值: 长任务, 里程碑: 字符串) : 长任务 {
    任务值.目标值 = 添加里程碑(任务值.目标值, 里程碑);
    保存长任务(任务值);
    返回 任务值;
}

公开 函数 完成里程碑(任务值: 长任务, 下标: 整数) : 长任务 {
    任务值.目标值 = 标记完成(任务值.目标值, 下标);
    保存长任务(任务值);
    返回 任务值;
}

// ── 段间重建 ────────────────────────────────────────────────────

// 每段开头喂给新会话的**全部**上下文。
//
// 这里是整个模块的重点：下一段拿到的不是压缩过的消息历史，而是从持久状态
// **重新长出来**的一段文字 —— 目标、里程碑完成情况、上一段留下的有界笔记、
// 外加调用方给的背景知识。所以它的长度只跟里程碑条数有关，跟已经跑了多少段
// 完全无关。跑第 1 段和第 100 段，这段提示一样长。
公开 函数 段提示(任务值: 长任务, 背景知识: 字符串) : 字符串 {
    变量 出: 字符串 = "你在接手一个跨多段执行的长任务。这是第 "
        + 整数转字符串(任务值.段号 + 1) + " 段。\n\n";
    出 = 出 + 目标报告(任务值.目标值) + "\n";
    如果 (字符串::字节长度(背景知识) > 0) {
        出 = 出 + "\n【已知事实】\n" + 背景知识 + "\n";
    }
    如果 (字符串::字节长度(任务值.上段笔记) > 0) {
        出 = 出 + "\n【上一段留下的话】\n" + 任务值.上段笔记 + "\n";
    } 否则 {
        出 = 出 + "\n（这是第一段，没有前情。）\n";
    }
    出 = 出 + "\n请在本段内朝目标推进。做完之后，**最后一条消息只输出严格 JSON**，"
        + "不要有任何多余文字：\n"
        + "{\"完成\":[已完成的里程碑下标，从 0 起，只填**本段新完成**的],"
        + "\"笔记\":\"留给下一段的话：现在到哪了、下一步该干什么、有什么坑。"
        + "控制在 400 字以内，别复述目标\",\"结局\":\"继续\"或\"完成\"或\"升级\"}";
    返回 出;
}

// 标准库没有反向查找，自己往前扫。模型爱在 JSON 前后加解释，所以要取
// **最后**一个右括号，不能取第一个。
函数 最后一个(文本: 字符串, 目标: 字符串) : 整数 {
    变量 命中: 整数 = 0 - 1;
    变量 从: 整数 = 0;
    当 (从 < 字符串::字节长度(文本)) {
        变量 位: 整数 = 字符串::查找从位置(文本, 目标, 从);
        如果 (位 < 0) { 返回 命中; }
        命中 = 位;
        从 = 位 + 1;
    }
    返回 命中;
}

// 从段末的 JSON 里取结构化结果。模型不听话（没给 JSON / 给了别的）时一律
// 当作「继续」，把原文截断当笔记 —— 不能因为一段没按格式说话就让整个任务停摆。
函数 解析段结果(任务值: 长任务, 原文: 字符串) : 长任务 {
    变量 起: 整数 = 字符串::查找(原文, "{");
    变量 止: 整数 = 最后一个(原文, "}");
    如果 (起 < 0 || 止 <= 起) {
        任务值.上段笔记 = 截断笔记(原文);
        返回 任务值;
    }
    变量 片: 字符串 = 字符串::子串(原文, 起, 止 - 起 + 1);
    变量 对象: 整数 = J.解码(片);
    如果 (对象 <= 0) {
        任务值.上段笔记 = 截断笔记(原文);
        返回 任务值;
    }

    变量 完成组: 整数 = J.获取数组(对象, "完成");
    如果 (完成组 > 0) {
        变量 i: 整数 = 0;
        当 (i < J.数组长度(完成组)) {
            任务值.目标值 = 标记完成(任务值.目标值, J.数组获取整数(完成组, i));
            i = i + 1;
        }
    }

    变量 笔记: 字符串 = J.获取字符串(对象, "笔记");
    如果 (字符串::字节长度(笔记) > 0) { 任务值.上段笔记 = 截断笔记(笔记); }

    变量 结局: 字符串 = J.获取字符串(对象, "结局");
    如果 (结局 == "完成" || 结局 == "升级") { 任务值.结局 = 结局; }
    J.删除(对象);
    返回 任务值;
}

// 笔记必须有界，否则它就退化成又一个只增不减的历史 —— 那正是分段要躲开的东西。
函数 截断笔记(文本: 字符串) : 字符串 {
    如果 (字符串::字节长度(文本) <= 笔记上限) { 返回 文本; }
    返回 字符串::子串(文本, 0, 笔记上限) + "…（超出部分已丢，笔记有硬上限）";
}

// ── 跑 ──────────────────────────────────────────────────────────

// 跑一段：**开新会话 → 从持久状态重建上下文 → 干活 → 写回 → 关会话**。
//
// 每段用全新的会话是关键。沿用同一个会话的话，上下文只会越来越长，
// 压缩也只是延缓；换会话才是真正把它清零，代价是靠 段提示 把该带的带过去。
//
// 背景知识 由调用方给（比如从图记忆召回）。本模块**不依赖 qi-graph** ——
// 那会把 Graph / KV 拖给每个用 Harness 的程序。接法见文件抬头。
公开 函数 跑一段(任务值: 长任务, 配置值: 模型配置, 背景知识: 字符串) : 长任务 {
    如果 (长任务可用(任务值) == 0) { 返回 任务值; }
    如果 (任务值.结局 != "进行中") { 返回 任务值; }

    变量 会话: 整数 = 开启会话(配置值);
    如果 (会话 <= 0) {
        事件("longrun_error", "长时程", 任务值.名字 + " 开不了会话");
        返回 任务值;
    }
    变量 段代理: 代理 = 创建代理(任务值.名字 + "·第" + 整数转字符串(任务值.段号 + 1) + "段", 会话);
    段代理.最大步数 = 任务值.每段最多轮;
    如果 (字符串::字节长度(任务值.文件沙箱根) > 0) {
        变量 沙箱: 文件沙箱 = 创建文件沙箱(任务值.文件沙箱根);
        如果 (任务值.沙箱可写 == 1) { 沙箱 = 允许写(沙箱); }
        段代理 = 装备文件工具(段代理, 沙箱);
    }

    事件("longrun_segment_start", "长时程",
        任务值.名字 + " 第 " + 整数转字符串(任务值.段号 + 1) + " 段");

    变量 产出: 字符串 = 运行(段代理, 段提示(任务值, 背景知识));

    关闭代理(段代理);   // 它自己会把会话一起关掉（代理.qi 的 关闭代理），别再关一次

    任务值.段号 = 任务值.段号 + 1;
    任务值 = 解析段结果(任务值, 产出);

    如果 (是否达成(任务值.目标值) == 1) { 任务值.结局 = "完成"; }
    如果 (任务值.结局 == "进行中" && 任务值.段号 >= 任务值.最多段数) {
        任务值.结局 = "超限";
    }

    // 段落盘：崩在任何一段中间，最多丢那一段，前面的全在
    数据库.执行(任务值.库, "INSERT INTO 长任务段(名字, 段号, 笔记, 产出, 时刻) VALUES("
        + 引(任务值.名字) + ", " + 整数转字符串(任务值.段号) + ", "
        + 引(任务值.上段笔记) + ", " + 引(截断笔记(产出)) + ", "
        + 整数转字符串(时间.现在()) + ")");
    保存长任务(任务值);

    事件("longrun_segment_end", "长时程",
        任务值.名字 + " 第 " + 整数转字符串(任务值.段号) + " 段 · "
        + 整数转字符串(已完成数(任务值.目标值)) + "/" + 整数转字符串(里程碑数(任务值.目标值))
        + " 里程碑 · " + 任务值.结局);
    返回 任务值;
}

// 一段接一段跑到收场（完成 / 升级 / 超限）。中途进程没了，下次 续长任务
// 再调本函数，从下一段接着跑。
公开 函数 一直跑(任务值: 长任务, 配置值: 模型配置, 背景知识: 字符串) : 长任务 {
    当 (任务值.结局 == "进行中" && 任务值.段号 < 任务值.最多段数) {
        变量 之前段号: 整数 = 任务值.段号;
        任务值 = 跑一段(任务值, 配置值, 背景知识);
        // 段号没动 = 这一段根本没跑起来（开不了会话之类），再循环就是死转
        如果 (任务值.段号 == 之前段号) { 返回 任务值; }
    }
    返回 任务值;
}

公开 函数 任务进度(任务值: 长任务) : 字符串 {
    返回 任务值.名字 + "：第 " + 整数转字符串(任务值.段号) + " 段 · "
        + 整数转字符串(已完成数(任务值.目标值)) + "/"
        + 整数转字符串(里程碑数(任务值.目标值)) + " 里程碑 · " + 任务值.结局;
}

// 长时程 — 分段执行 + 断点续跑的任务编排
//
// ── 为什么不能直接用 循环.qi ──────────────────────────────────────
//
// 循环.qi 是「制造者干活 → 校验者验收 → 再来一轮」，同一个会话里滚。跑十分钟
// 没问题，跑十小时会死在两件事上：
//
//   1. 它的跨轮记忆是**一个只增不减的字符串**（每轮把成果和验收都接在后面）。
//      轮数一多，上下文先被它撑爆。
//   2. 全部状态活在进程内存里。进程一没，从头再来。
//
// 本模块把长任务切成**段**。每一段：
//
//   开一个全新会话  →  从**持久状态**重建上下文  →  干活  →  把该留下的写回去  →  关掉会话
//
// 关键在「重建」而不是「继承」：下一段拿到的不是压缩过的消息历史，而是
// 目标 + 里程碑完成情况 + 上一段留下的**有界**笔记（可选再加图记忆召回的
// 相关事实）。所以上下文长度跟段数无关，跑一百段和跑一段一样长。
//
// 持久状态在 SQLite（跟 会话存储.qi 同一个 标准库.数据库，不引新依赖）。
// 进程崩了、机器重启了，`续长任务` 从库里把任务原样接回来，从下一段继续。
//
// ── 跟别的模块的分工 ──────────────────────────────────────────────
//
//   目标监控.qi  提供 目标/里程碑 的结构与进度计算（本模块直接复用，不重造）
//   循环.qi      段**内**要不要多轮，由调用方自己决定；本模块只管段**间**
//   图记忆.qi    可选的跨段知识源。**不硬依赖** —— 图库句柄由调用方传进来，
//                跟 启用图记忆 对 代理 的做法一致。这样 Harness.qi 仍可以
//                re-export 本模块，而不会把 qi-graph / qi-kv 拖给每个用户。
//
// 用法：
//   变量 库: 整数 = 打开长任务库("任务.db");
//   变量 任务: 长任务 = 开长任务(库, "重构解析器", "把手写 lexer 换成生成的");
//   任务 = 加里程碑(任务, "跑通现有测试");
//   任务 = 加里程碑(任务, "换掉 lexer");
//   任务 = 设分段(任务, 6, 20);            // 每段最多 6 轮，最多 20 段
//   任务 = 一直跑(任务, 模型配置值);
//
// 中断之后：
//   变量 任务: 长任务 = 续长任务(库, "重构解析器");   // 状态、段号、笔记都在
//   任务 = 一直跑(任务, 模型配置值);

包 Harness;

导入 标准库.数据库;
导入 标准库.字符串;
导入 标准库.时间;
导入 标准库.JSON 作为 J;
导入 Harness.模型::{模型配置, 开启会话};
导入 Harness.代理::{代理, 创建代理, 运行使用配置, 结构化运行使用配置, 关闭代理};
导入 Harness.运行配置::{运行配置, 默认运行配置, 配置运行预算, 配置最大工具步数};
导入 标准库.列表 作为 列表库;
导入 Harness.文件工具::{文件沙箱, 创建文件沙箱, 允许写, 装备文件工具};
导入 Harness.目标监控::{目标, 创建目标, 添加里程碑, 里程碑数, 已完成数, 标记完成, 进度, 是否达成, 目标报告};
导入 Harness.预算::{超预算, 预算报告, 已用令牌, 补记令牌};
导入 Harness.追踪::{事件};
导入 标准库.同步;
导入 标准库.输入输出 作为 IO;

公开 类型 长任务 {
    库: 整数,
    名字: 字符串,
    目标值: 目标,
    段号: 整数,           // 已经跑完的段数
    每段最多步: 整数,
    最多段数: 整数,
    预算句柄: 整数,       // -1 = 不设上限。长任务最该有的就是这个
    文件沙箱根: 字符串,   // 非空 = 每段给新代理装上文件工具（限定在这个目录里）
    沙箱可写: 整数,       // 0 = 只读。要让 agent 真的产出东西就得给 1
    图库路径: 字符串,     // 非空 = 每段接上这个知识图（见 图记忆.用图记忆）
    图工具开: 整数,       // 1 = 顺带把 记事实/查关系/怎么连的 交给模型
    检查们: 字符串,       // 与 里程碑们 一一对应的 "\n" 平行串，空 = 这条不核实
    已用令牌累计: 整数,   // 落库的花销，续跑时补回预算账（预算表是进程级的）
    上段笔记: 字符串,
    结局: 字符串,         // "进行中" / "完成" / "升级" / "超限"
}

变量 笔记上限: 整数 = 1200;   // 段间笔记的硬上限，防止它退化成又一个只增不减的串

// ── 存储 ────────────────────────────────────────────────────────

// SQL 字符串字面量：单引号翻倍。所有外部文本只经这里进 SQL。
函数 引(文本: 字符串) : 字符串 {
    返回 "'" + 字符串::替换(文本, "'", "''") + "'";
}

公开 函数 打开长任务库(路径: 字符串) : 整数 {
    变量 库: 整数 = 数据库.连接(路径);
    如果 (库 <= 0) { 返回 0; }
    数据库.执行(库, "CREATE TABLE IF NOT EXISTS 长任务("
        + "名字 TEXT PRIMARY KEY, 目标JSON TEXT, 段号 INTEGER, 每段最多步 INTEGER,"
        + " 最多段数 INTEGER, 文件沙箱根 TEXT, 沙箱可写 INTEGER,"
        + " 图库路径 TEXT, 图工具开 INTEGER, 检查们 TEXT,"
        + " 已用令牌累计 INTEGER, 上段笔记 TEXT, 结局 TEXT, 更新于 INTEGER)");
    // 老库补列。已经有这两列时 ALTER 会失败，数据库.执行 不抛，正好当成
    // 「已经有了」。不补的话 保存长任务 的 INSERT 列名对不上，每次静默失败，
    // 现象只表现为「续长任务 捞不回来」—— 加 沙箱可写 那次就是这么栽的。
    数据库.执行(库, "ALTER TABLE 长任务 ADD COLUMN 图库路径 TEXT");
    数据库.执行(库, "ALTER TABLE 长任务 ADD COLUMN 图工具开 INTEGER");
    数据库.执行(库, "ALTER TABLE 长任务 ADD COLUMN 检查们 TEXT");
    数据库.执行(库, "ALTER TABLE 长任务 ADD COLUMN 已用令牌累计 INTEGER");
    数据库.执行(库, "CREATE TABLE IF NOT EXISTS 长任务段("
        + "名字 TEXT, 段号 INTEGER, 笔记 TEXT, 产出 TEXT, 时刻 INTEGER)");
    返回 库;
}

公开 函数 关闭长任务库(库: 整数) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    返回 数据库.关闭(库);
}

函数 目标转JSON(目标值: 目标) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    J.设置字符串(对象, "描述", 目标值.描述);
    J.设置字符串(对象, "验收标准", 目标值.验收标准);
    J.设置字符串(对象, "里程碑们", 目标值.里程碑们);
    J.设置字符串(对象, "完成标记", 目标值.完成标记);
    J.设置字符串(对象, "状态", 目标值.状态);
    变量 文本: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 文本;
}

函数 JSON转目标(文本: 字符串) : 目标 {
    变量 对象: 整数 = J.解码(文本);
    如果 (对象 <= 0) { 返回 创建目标("", ""); }
    变量 出: 目标 = 新建 目标 {
        描述: J.获取字符串(对象, "描述"),
        验收标准: J.获取字符串(对象, "验收标准"),
        里程碑们: J.获取字符串(对象, "里程碑们"),
        完成标记: J.获取字符串(对象, "完成标记"),
        状态: J.获取字符串(对象, "状态"),
    };
    J.删除(对象);
    返回 出;
}

// 把任务当前状态整条写回去（幂等）。每段结束都调一次 —— 崩在任何一段中间，
// 最多丢那一段，已完成的段全在。
公开 函数 保存长任务(任务值: 长任务) : 整数 {
    如果 (任务值.库 <= 0) { 返回 0; }
    // ⚠ 落库失败必须出声。数据库.执行 返回受影响行数但不抛 —— 我给表加列时
    // 漏改了 INSERT 的列名单（列 8 个、值 10 个），语句每次都失败，而现象只
    // 表现为「续长任务 捞不回来」，完全看不出是写的时候就没成。
    变量 影响: 整数 = 数据库.执行(任务值.库, "INSERT OR REPLACE INTO 长任务"
        + "(名字, 目标JSON, 段号, 每段最多步, 最多段数, 文件沙箱根, 沙箱可写,"
        + " 图库路径, 图工具开, 检查们, 已用令牌累计, 上段笔记, 结局, 更新于) VALUES("
        + 引(任务值.名字) + ", " + 引(目标转JSON(任务值.目标值)) + ", "
        + 整数转字符串(任务值.段号) + ", " + 整数转字符串(任务值.每段最多步) + ", "
        + 整数转字符串(任务值.最多段数) + ", " + 引(任务值.文件沙箱根) + ", "
        + 整数转字符串(任务值.沙箱可写) + ", "
        + 引(任务值.图库路径) + ", " + 整数转字符串(任务值.图工具开) + ", "
        + 引(任务值.检查们) + ", " + 整数转字符串(任务值.已用令牌累计) + ", "
        + 引(任务值.上段笔记) + ", "
        + 引(任务值.结局) + ", " + 整数转字符串(时间.现在()) + ")");
    如果 (影响 <= 0) {
        事件("longrun_save_failed", "长时程", 任务值.名字 + " 落库失败，续跑会捞不回来");
        返回 0;
    }
    返回 1;
}

函数 空任务() : 长任务 {
    返回 新建 长任务 {
        库: 0, 名字: "", 目标值: 创建目标("", ""), 段号: 0,
        // 每段 40 **步**。这里的「步」= 一次 运行() 里的工具调用上限
        // （代理.最大步数），**不是对话轮数** —— 一段就是一次 运行()，模型在
        // 里面最多动 40 次工具，然后必须交出段末 JSON。
        //
        // **段要开大。** 分段是保险不是优化 —— 换段要重建上下文、重走一遍现场，
        // 段越小这份成本占比越高。而且步数用完时这一段是被**腰斩**的：活可能
        // 干了但汇报不出来（见 跑一段 里的截断检测）。实测把它压到 5，agent
        // 列目录 + 写 4 个文件就用光，六个里程碑一个都没记上。
        // 取值该按「模型上下文扛得住多少工具往返」，不是「越小越安全」。
        每段最多步: 40, 最多段数: 24, 预算句柄: 0 - 1, 文件沙箱根: "", 沙箱可写: 0,
        图库路径: "", 图工具开: 0, 检查们: "", 已用令牌累计: 0,
        上段笔记: "", 结局: "进行中",
    };
}

公开 函数 长任务可用(任务值: 长任务) : 整数 {
    如果 (任务值.库 <= 0) { 返回 0; }
    如果 (字符串::字节长度(任务值.名字) == 0) { 返回 0; }
    返回 1;
}

// 载入已存在的任务；没有则返回不可用的空任务（长任务可用 判 0）。
公开 函数 续长任务(库: 整数, 名字: 字符串) : 长任务 {
    变量 出: 长任务 = 空任务();
    如果 (库 <= 0) { 返回 出; }
    变量 行JSON: 字符串 = 数据库.查询(库,
        "SELECT 目标JSON, 段号, 每段最多步, 最多段数, 文件沙箱根, 沙箱可写,"
        + " 图库路径, 图工具开, 检查们, 已用令牌累计, 上段笔记, 结局 FROM 长任务 WHERE 名字 = "
        + 引(名字) + " LIMIT 1");
    变量 行组: 整数 = J.解码(行JSON);
    如果 (行组 <= 0) { 返回 出; }
    如果 (J.数组长度(行组) == 0) { J.删除(行组); 返回 出; }
    变量 行: 整数 = J.数组获取对象(行组, 0);
    出.库 = 库;
    出.名字 = 名字;
    出.目标值 = JSON转目标(J.获取字符串(行, "目标JSON"));
    出.段号 = J.获取整数(行, "段号");
    出.每段最多步 = J.获取整数(行, "每段最多步");
    出.最多段数 = J.获取整数(行, "最多段数");
    出.文件沙箱根 = J.获取字符串(行, "文件沙箱根");
    出.沙箱可写 = J.获取整数(行, "沙箱可写");
    出.图库路径 = J.获取字符串(行, "图库路径");
    出.图工具开 = J.获取整数(行, "图工具开");
    出.检查们 = J.获取字符串(行, "检查们");
    出.已用令牌累计 = J.获取整数(行, "已用令牌累计");
    出.上段笔记 = J.获取字符串(行, "上段笔记");
    出.结局 = J.获取字符串(行, "结局");
    J.删除(行组);
    事件("longrun_resume", "长时程", 名字 + " 从第 " + 整数转字符串(出.段号 + 1) + " 段接着跑");
    返回 出;
}

// 开一个长任务：**已存在就原样接回来**（所以反复调是安全的，不会把进度清零）。
公开 函数 开长任务(库: 整数, 名字: 字符串, 目标描述: 字符串) : 长任务 {
    变量 已有: 长任务 = 续长任务(库, 名字);
    如果 (长任务可用(已有) == 1) { 返回 已有; }

    变量 出: 长任务 = 空任务();
    出.库 = 库;
    出.名字 = 名字;
    出.目标值 = 创建目标(目标描述, "");
    保存长任务(出);
    事件("longrun_create", "长时程", 名字);
    返回 出;
}

// 每段最多步 = 一次 运行() 里的工具调用上限，不是对话轮数。
公开 函数 设分段(任务值: 长任务, 每段最多步: 整数, 最多段数: 整数) : 长任务 {
    如果 (每段最多步 > 0) { 任务值.每段最多步 = 每段最多步; }
    如果 (最多段数 > 0) { 任务值.最多段数 = 最多段数; }
    保存长任务(任务值);
    返回 任务值;
}

// 给每段的新代理装上文件工具，读写限定在 根目录 里。
//
// 为什么是个字段而不是让调用方自己装：跑一段 **在内部建代理**（段间换会话是
// 这个模块的立身之本），代理生出来就在函数里，外面够不着。而没有工具的长任务
// 只能空对空地聊，根本干不了实事。
//
// 内建的只有文件工具和图工具（后者走 图记忆.用图记忆 接线）两种，是因为
// harness 的工具注册靠有界槽位（函数指针不能动态生成，见 技能.qi），塞不下
// 一个通用的「装备回调」。要别的工具，眼下的办法是自己按 跑一段 的样子写一层。
// 给整个长任务挂一个预算（用 预算::创建预算(令牌上限, 成本上限分) 拿句柄）。
//
// **长任务最需要的就是这个**：最多段数 只挡得住段数，挡不住一段里烧掉多少 ——
// 一个卡在死循环上的 agent 可以在预算内的段数里花掉任意多钱。挂上之后每段
// 开跑前先看一眼超没超，超了立刻收场，结局记「超预算」。
//
// 预算表是进程级的（预算.qi 用列表存），所以续跑后要自己重新 挂预算 ——
// 但**花掉的钱接得回来**：每段结束都把累计已用落库，这里再补记进新账本。
// 不补的话「整个长任务最多烧 N 令牌」每重启一次就重新算一遍，等于没上限。
// 只在新账本还是空的时候补，重复调 挂预算 不会重复扣。
//
// 接不回来的只剩手工记的成本（记入成本 那一路）—— 那本来就是调用方自己
// 在记，要跨进程也该由调用方自己补。
公开 函数 挂预算(任务值: 长任务, 预算句柄: 整数) : 长任务 {
    任务值.预算句柄 = 预算句柄;
    如果 (预算句柄 >= 0 && 任务值.已用令牌累计 > 0 && 已用令牌(预算句柄) == 0) {
        补记令牌(预算句柄, 任务值.已用令牌累计);
        事件("longrun_budget_restored", "长时程",
            任务值.名字 + " 补回上次花掉的 " + 整数转字符串(任务值.已用令牌累计) + " 令牌");
    }
    返回 任务值;
}

// ⚠ **任务库不要放在 根目录 里面**。放进去 agent 一 列目录 就看见 任务.db，
// 会跑去读这个二进制文件 —— 编排器自己的状态不该出现在 agent 的工作区里。
// 实测踩过：第一段就把整段预算花在读 .db 上，然后升级放弃。
//
// 可写 传 0 是只读沙箱（只给 读文件/列目录/文件信息）。要 agent 真产出东西
// 必须传 1，否则它会（正确地）报告「没有写文件的工具」然后升级。
公开 函数 用文件沙箱(任务值: 长任务, 根目录: 字符串, 可写: 整数) : 长任务 {
    任务值.文件沙箱根 = 根目录;
    任务值.沙箱可写 = 可写;
    保存长任务(任务值);
    返回 任务值;
}

// ── 图记忆接线（可选依赖） ──────────────────────────────────────
//
// 长时程本身**不导入** 图记忆.qi。理由跟 代理.qi 里那段一模一样：图记忆依赖
// qi-graph + qi-kv，而 长时程 是 Harness.qi re-export 的模块，引一下就等于
// 逼所有用 Harness 的程序都装上那两个包（实测报「注册中心依赖 KV 尚未安装」）。
// 所以依赖方向反过来：图记忆.用图记忆 把两个函数注册进来，长时程 只按句柄
// 和路径这类不透明的标量跟它打交道。没接线时下面两个调用是安静的空操作。
变量 图钩子表: 整数 = 0;      // 指针列表：0 = 装备器，1 = 背景器
变量 图钩子锁: 整数 = 同步.创建锁();

// 由 图记忆.用图记忆 调用，正常代码不用直接碰。首次注册生效，重复调用安全。
//   装备(段代理, 库路径, 任务名, 给工具) : 代理  —— 接上图库；给工具=1 再装三个图工具
//   背景(库路径, 任务名, 里程碑们) : 字符串      —— 种下任务/里程碑节点并召回一块背景
//   查(库路径, 关键词) : 字符串                  —— 纯查，不写；里程碑核实用
公开 函数 设置图接线(装备: 函数(代理, 字符串, 字符串, 整数): 代理,
                     背景: 函数(字符串, 字符串, 字符串): 字符串,
                     查: 函数(字符串, 字符串): 字符串) : 整数 {
    同步.加锁(图钩子锁);
    如果 (图钩子表 == 0) { 图钩子表 = 列表库::创建指针列表(); }
    如果 (列表库::指针列表大小(图钩子表) == 0) {
        列表库::添加指针(图钩子表, 装备);
        列表库::添加指针(图钩子表, 背景);
        列表库::添加指针(图钩子表, 查);
    }
    同步.解锁(图钩子锁);
    返回 1;
}

函数 图已接线() : 整数 {
    同步.加锁(图钩子锁);
    变量 n: 整数 = 0;
    如果 (图钩子表 != 0) { n = 列表库::指针列表大小(图钩子表); }
    同步.解锁(图钩子锁);
    如果 (n >= 3) { 返回 1; }
    返回 0;
}

函数 装图记忆(段代理: 代理, 库路径: 字符串, 任务名: 字符串, 给工具: 整数) : 代理 {
    如果 (图已接线() == 0) { 返回 段代理; }
    变量 装备: 函数(代理, 字符串, 字符串, 整数): 代理 = 列表库::获取指针(图钩子表, 0);
    返回 装备(段代理, 库路径, 任务名, 给工具);
}

函数 取图背景(库路径: 字符串, 任务名: 字符串, 里程碑们: 字符串) : 字符串 {
    如果 (图已接线() == 0) { 返回 ""; }
    变量 背景: 函数(字符串, 字符串, 字符串): 字符串 = 列表库::获取指针(图钩子表, 1);
    返回 背景(库路径, 任务名, 里程碑们);
}

函数 查图(库路径: 字符串, 关键词: 字符串) : 字符串 {
    如果 (图已接线() == 0) { 返回 ""; }
    变量 查: 函数(字符串, 字符串): 字符串 = 列表库::获取指针(图钩子表, 2);
    返回 查(库路径, 关键词);
}

// 记下这个长任务要用哪个知识图。**不要直接调**：走 图记忆.用图记忆，那个会
// 先把接线注册好。直接调这个只会把路径存进库，每段照样查不到东西。
公开 函数 设置图库(任务值: 长任务, 库路径: 字符串, 给工具: 整数) : 长任务 {
    任务值.图库路径 = 库路径;
    任务值.图工具开 = 给工具;
    保存长任务(任务值);
    返回 任务值;
}

// 加一个里程碑。**同名的只加一次** —— 长任务的建法就是「开长任务 已存在就
// 接回来，然后照着写一遍里程碑」，不去重的话每跑一次程序里程碑就翻一倍，
// 进度分母越变越大、已完成的下标全错位。实测踩过：同一个脚本跑两遍，
// 2 个里程碑变成 4 个，进度从 2/2 掉回 2/4。
公开 函数 加里程碑(任务值: 长任务, 里程碑: 字符串) : 长任务 {
    返回 加里程碑带检查(任务值, 里程碑, "");
}

// ── 可核实的里程碑 ──────────────────────────────────────────────
//
// **里程碑默认是模型自己说完成就算完成的**，这是长时程最大的软肋。真模型
// 实测抓到过：一段被工具步数上限腰斩，文件一个字都没写，收尾那一问照样回
// 「完成: [0, 1]，结局: 完成」，任务就这么"成功"结束了。
//
// 检查式给一条里程碑挂一个**确定性**的验收条件，模型说完成、检查不过就不认，
// 并且把这件事写进笔记和事件里让下一段知道。支持三种（空串 = 不核实）：
//
//   文件存在:<沙箱内相对路径>
//   文件含:<沙箱内相对路径>|<子串>
//   图有:<关键词>|<子串>          —— 按关键词召回一块，看里面有没有这个子串
//
// 前两种要先 用文件沙箱，第三种要先 用图记忆，否则一律判不过。
公开 函数 加里程碑带检查(任务值: 长任务, 里程碑: 字符串, 检查式: 字符串) : 长任务 {
    如果 (已有里程碑(任务值.目标值, 里程碑) == 1) { 返回 任务值; }
    任务值.目标值 = 添加里程碑(任务值.目标值, 里程碑);
    如果 (字符串::字节长度(任务值.检查们) == 0 && 里程碑数(任务值.目标值) == 1) {
        任务值.检查们 = 检查式;
    } 否则 {
        任务值.检查们 = 任务值.检查们 + "\n" + 检查式;
    }
    保存长任务(任务值);
    返回 任务值;
}

函数 取检查(任务值: 长任务, 下标: 整数) : 字符串 {
    如果 (字符串::字节长度(任务值.检查们) == 0) { 返回 ""; }
    变量 表: 整数 = 字符串::分割(任务值.检查们, "\n");
    变量 出: 字符串 = "";
    如果 (下标 >= 0 && 下标 < 列表库::字符串列表大小(表)) {
        出 = 列表库::获取字符串(表, 下标);
    }
    列表库::删除列表(表);
    返回 出;
}

// 检查式两段式：冒号前是种类，冒号后是参数（第二个参数用 | 分隔）。
函数 过检查(任务值: 长任务, 检查式: 字符串) : 整数 {
    如果 (字符串::字节长度(检查式) == 0) { 返回 1; }   // 没挂检查 = 照旧信模型
    变量 冒: 整数 = 字符串::查找(检查式, ":");
    如果 (冒 < 0) { 返回 1; }
    变量 种: 字符串 = 字符串::子串(检查式, 0, 冒);
    变量 参: 字符串 = 字符串::子串(检查式, 冒 + 1,
        字符串::字节长度(检查式) - 冒 - 1);

    如果 (种 == "文件存在") {
        如果 (字符串::字节长度(任务值.文件沙箱根) == 0) { 返回 0; }
        返回 IO.文件存在(任务值.文件沙箱根 + "/" + 参);
    }
    如果 (种 == "文件含") {
        如果 (字符串::字节长度(任务值.文件沙箱根) == 0) { 返回 0; }
        变量 竖: 整数 = 字符串::查找(参, "|");
        如果 (竖 < 0) { 返回 0; }
        变量 路: 字符串 = 字符串::子串(参, 0, 竖);
        变量 需: 字符串 = 字符串::子串(参, 竖 + 1, 字符串::字节长度(参) - 竖 - 1);
        变量 全: 字符串 = 任务值.文件沙箱根 + "/" + 路;
        如果 (IO.文件存在(全) == 0) { 返回 0; }
        如果 (字符串::查找(IO.读取文件(全), 需) >= 0) { 返回 1; }
        返回 0;
    }
    如果 (种 == "图有") {
        如果 (字符串::字节长度(任务值.图库路径) == 0) { 返回 0; }
        变量 竖2: 整数 = 字符串::查找(参, "|");
        如果 (竖2 < 0) { 返回 0; }
        变量 词: 字符串 = 字符串::子串(参, 0, 竖2);
        变量 需2: 字符串 = 字符串::子串(参, 竖2 + 1, 字符串::字节长度(参) - 竖2 - 1);
        如果 (字符串::查找(查图(任务值.图库路径, 词), 需2) >= 0) { 返回 1; }
        返回 0;
    }
    返回 1;   // 不认识的种类不拦，免得写错一个字就永远完不成
}

函数 已有里程碑(目标值: 目标, 里程碑: 字符串) : 整数 {
    如果 (字符串::字节长度(目标值.里程碑们) == 0) { 返回 0; }
    变量 表: 整数 = 字符串::分割(目标值.里程碑们, "\n");
    变量 n: 整数 = 列表库::字符串列表大小(表);
    变量 i: 整数 = 0;
    变量 有: 整数 = 0;
    当 (i < n) {
        如果 (列表库::获取字符串(表, i) == 里程碑) { 有 = 1; }
        i = i + 1;
    }
    列表库::删除列表(表);
    返回 有;
}

公开 函数 完成里程碑(任务值: 长任务, 下标: 整数) : 长任务 {
    任务值.目标值 = 标记完成(任务值.目标值, 下标);
    保存长任务(任务值);
    返回 任务值;
}

// ── 段间重建 ────────────────────────────────────────────────────

// 每段开头喂给新会话的**全部**上下文。
//
// 这里是整个模块的重点：下一段拿到的不是压缩过的消息历史，而是从持久状态
// **重新长出来**的一段文字 —— 目标、里程碑完成情况、上一段留下的有界笔记、
// 外加调用方给的背景知识。所以它的长度只跟里程碑条数有关，跟已经跑了多少段
// 完全无关。跑第 1 段和第 100 段，这段提示一样长。
公开 函数 段提示(任务值: 长任务, 背景知识: 字符串) : 字符串 {
    变量 出: 字符串 = "你在接手一个跨多段执行的长任务。这是第 "
        + 整数转字符串(任务值.段号 + 1) + " 段。\n\n";
    出 = 出 + 目标报告(任务值.目标值) + "\n";
    如果 (字符串::字节长度(背景知识) > 0) {
        出 = 出 + "\n【已知事实】\n" + 背景知识 + "\n";
    }
    如果 (字符串::字节长度(任务值.上段笔记) > 0) {
        出 = 出 + "\n【上一段留下的话】\n" + 任务值.上段笔记 + "\n";
    } 否则 {
        出 = 出 + "\n（这是第一段，没有前情。）\n";
    }
    出 = 出 + "\n请在本段内朝目标推进：用你有的工具把能做的做掉。"
        + "本段结束后会**单独**问你一次进度，所以现在专心干活，不用汇报格式。";
    返回 出;
}

// 标准库没有反向查找，自己往前扫。模型爱在 JSON 前后加解释，所以要取
// **最后**一个右括号，不能取第一个。
函数 最后一个(文本: 字符串, 目标: 字符串) : 整数 {
    变量 命中: 整数 = 0 - 1;
    变量 从: 整数 = 0;
    当 (从 < 字符串::字节长度(文本)) {
        变量 位: 整数 = 字符串::查找从位置(文本, 目标, 从);
        如果 (位 < 0) { 返回 命中; }
        命中 = 位;
        从 = 位 + 1;
    }
    返回 命中;
}

// 段末**单独**问一次进度，用 结构化运行 —— provider 端开 json_object 模式、
// 带必需字段校验和重试，比「求模型在最后一条消息里自觉吐 JSON」稳得多。
//
// 为什么必须分成两步：干活那一问要用工具，而模型用着工具时很容易在步数用完
// 前都没走到「输出最终文本」那一步 —— 真跑时就撞到了，四个文件全写对了、
// 段末 JSON 一个字没有，账上零进展。收尾单独问，它面对的是一个纯文本任务。
函数 问进度(段代理: 代理, 任务值: 长任务, 收尾配置: 运行配置) : 字符串 {
    变量 字段: 整数 = 列表库::创建字符串列表();
    列表库::添加字符串(字段, "完成");
    列表库::添加字符串(字段, "笔记");
    列表库::添加字符串(字段, "结局");
    变量 问: 字符串 = "本段到此为止。对照下面的里程碑清单汇报进度。\n\n"
        + 目标报告(任务值.目标值)
        + "\n字段含义："
        + "完成 = 数组，**本段新完成**的里程碑下标（从 0 起），没有就给 []；"
        + "笔记 = 留给下一段的话（现在到哪了、下一步干什么、有什么坑，400 字以内，别复述目标）；"
        + "结局 = \"继续\" 或 \"完成\" 或 \"升级\"。";
    变量 回: 字符串 = 结构化运行使用配置(段代理, 问, 字段, 收尾配置);
    列表库::删除列表(字段);
    返回 回;
}

// 从段末的 JSON 里取结构化结果。模型不听话（没给 JSON / 给了别的）时一律
// 当作「继续」，把原文截断当笔记 —— 不能因为一段没按格式说话就让整个任务停摆。
函数 解析段结果(任务值: 长任务, 原文: 字符串) : 长任务 {
    变量 起: 整数 = 字符串::查找(原文, "{");
    变量 止: 整数 = 最后一个(原文, "}");
    如果 (起 < 0 || 止 <= 起) {
        任务值.上段笔记 = 截断笔记(原文);
        返回 任务值;
    }
    变量 片: 字符串 = 字符串::子串(原文, 起, 止 - 起 + 1);
    变量 对象: 整数 = J.解码(片);
    如果 (对象 <= 0) {
        任务值.上段笔记 = 截断笔记(原文);
        返回 任务值;
    }

    // 模型报的「完成」要过一遍检查式才作数。驳回的写进笔记 —— 下一段必须
    // 知道它以为干完的事其实没干成，否则它会接着往下走，留一个空洞。
    变量 驳回: 字符串 = "";
    变量 完成组: 整数 = J.获取数组(对象, "完成");
    如果 (完成组 > 0) {
        变量 i: 整数 = 0;
        当 (i < J.数组长度(完成组)) {
            变量 号: 整数 = J.数组获取整数(完成组, i);
            变量 检: 字符串 = 取检查(任务值, 号);
            如果 (过检查(任务值, 检) == 1) {
                任务值.目标值 = 标记完成(任务值.目标值, 号);
            } 否则 {
                驳回 = 驳回 + "里程碑 #" + 整数转字符串(号) + " 没通过验收（"
                    + 检 + "），不算完成。";
                事件("longrun_milestone_unverified", "长时程",
                    任务值.名字 + " 里程碑 #" + 整数转字符串(号)
                    + " 模型报了完成但检查不过：" + 检);
            }
            i = i + 1;
        }
    }

    变量 笔记: 字符串 = J.获取字符串(对象, "笔记");
    如果 (字符串::字节长度(笔记) > 0) { 任务值.上段笔记 = 截断笔记(笔记); }
    如果 (字符串::字节长度(驳回) > 0) {
        任务值.上段笔记 = 截断笔记(驳回 + "\n" + 任务值.上段笔记);
    }

    变量 结局: 字符串 = J.获取字符串(对象, "结局");
    如果 (结局 == "完成" || 结局 == "升级") { 任务值.结局 = 结局; }
    // 报「完成」但里程碑没全达成 = 它在自说自话。别让它就这么收场。
    如果 (结局 == "完成" && 是否达成(任务值.目标值) == 0) {
        任务值.结局 = "进行中";
        事件("longrun_premature_done", "长时程",
            任务值.名字 + " 报了完成，但里程碑只有 "
            + 整数转字符串(已完成数(任务值.目标值)) + "/"
            + 整数转字符串(里程碑数(任务值.目标值)) + " —— 不收场，接着跑");
    }
    J.删除(对象);
    返回 任务值;
}

// 笔记必须有界，否则它就退化成又一个只增不减的历史 —— 那正是分段要躲开的东西。
函数 截断笔记(文本: 字符串) : 字符串 {
    如果 (字符串::字节长度(文本) <= 笔记上限) { 返回 文本; }
    返回 字符串::子串(文本, 0, 笔记上限) + "…（超出部分已丢，笔记有硬上限）";
}

// ── 跑 ──────────────────────────────────────────────────────────

// 跑一段：**开新会话 → 从持久状态重建上下文 → 干活 → 写回 → 关会话**。
//
// 每段用全新的会话是关键。沿用同一个会话的话，上下文只会越来越长，
// 压缩也只是延缓；换会话才是真正把它清零，代价是靠 段提示 把该带的带过去。
//
// 背景知识 由调用方给（比如从图记忆召回）。本模块**不依赖 qi-graph** ——
// 那会把 Graph / KV 拖给每个用 Harness 的程序。接法见文件抬头。
公开 函数 跑一段(任务值: 长任务, 配置值: 模型配置, 背景知识: 字符串) : 长任务 {
    如果 (长任务可用(任务值) == 0) { 返回 任务值; }
    如果 (任务值.结局 != "进行中") { 返回 任务值; }

    // 预算在**开跑前**查。查完再开会话，免得白开一个又立刻关掉。
    如果 (任务值.预算句柄 >= 0 && 超预算(任务值.预算句柄) == 1) {
        任务值.结局 = "超预算";
        任务值.上段笔记 = "预算用完了：" + 预算报告(任务值.预算句柄);
        保存长任务(任务值);
        事件("longrun_over_budget", "长时程",
            任务值.名字 + " 在第 " + 整数转字符串(任务值.段号 + 1) + " 段前停下 · "
            + 预算报告(任务值.预算句柄));
        返回 任务值;
    }

    变量 会话: 整数 = 开启会话(配置值);
    如果 (会话 <= 0) {
        事件("longrun_error", "长时程", 任务值.名字 + " 开不了会话");
        返回 任务值;
    }
    变量 段代理: 代理 = 创建代理(任务值.名字 + "·第" + 整数转字符串(任务值.段号 + 1) + "段", 会话);
    段代理.最大步数 = 任务值.每段最多步;   // 真正生效的是下面塞进 段配置 的那一份
    如果 (字符串::字节长度(任务值.文件沙箱根) > 0) {
        变量 沙箱: 文件沙箱 = 创建文件沙箱(任务值.文件沙箱根);
        如果 (任务值.沙箱可写 == 1) { 沙箱 = 允许写(沙箱); }
        段代理 = 装备文件工具(段代理, 沙箱);
    }

    // 知识图：本段既是**读**（把相关事实拼进段提示）也是**写**（给工具 = 1 时
    // 模型能自己 记事实）。这是分段执行里唯一跨段活下来的结构化知识 ——
    // 上段笔记 是一段有界的自然语言，图是可以累积、可以按关系查的。
    变量 全部背景: 字符串 = 背景知识;
    如果 (字符串::字节长度(任务值.图库路径) > 0) {
        段代理 = 装图记忆(段代理, 任务值.图库路径, 任务值.名字, 任务值.图工具开);
        变量 图背景: 字符串 = 取图背景(任务值.图库路径, 任务值.名字, 任务值.目标值.里程碑们);
        如果 (字符串::字节长度(图背景) > 0) {
            如果 (字符串::字节长度(全部背景) > 0) { 全部背景 = 全部背景 + "\n"; }
            全部背景 = 全部背景 + 图背景;
        }
    }

    事件("longrun_segment_start", "长时程",
        任务值.名字 + " 第 " + 整数转字符串(任务值.段号 + 1) + " 段");

    // 走 运行使用配置 把预算句柄递下去 —— 不递的话 harness 不记账，超预算
    // 那个判断永远不会为真，等于挂了个摆设。
    变量 段配置: 运行配置 = 默认运行配置();
    如果 (任务值.预算句柄 >= 0) { 段配置 = 配置运行预算(段配置, 任务值.预算句柄); }
    // ⚠ 步数上限必须**放进配置里**。运行使用配置 → 应用运行配置 会拿配置里的
    // 最大工具步数 直接覆盖 代理.最大步数，所以上面那句 段代理.最大步数 = …
    // 到这一步就被默认值 10 盖掉了 —— 设分段(任务, 20, 4) 形同虚设。
    // 真模型实测抓到：事件写着「第 1 段撞上工具循环上限 20」，而同一段里
    // 代理自己报的是「tool loop 超过 10 步上限」，两个数对不上就是这个原因。
    段配置 = 配置最大工具步数(段配置, 任务值.每段最多步);
    变量 产出: 字符串 = 运行使用配置(段代理, 段提示(任务值, 全部背景), 段配置);
    变量 腰斩: 整数 = 0;
    如果 (字符串::查找(产出, "tool 循环达到上限") >= 0) { 腰斩 = 1; }

    // 干活那一问结束后，**单独**再问一次进度。哪怕上面被腰斩，这一问也照发 ——
    // 活可能已经干完了，只是没机会说；不问就白丢。
    // 收尾那一问走 结构化运行使用配置，那里的 最大步数 是**重试次数**不是工具
    // 步数 —— 拿 每段最多步（几十）当重试次数，模型犟起来能白烧几十次。给 3。
    变量 收尾配置: 运行配置 = 配置最大工具步数(段配置, 3);
    变量 汇报: 字符串 = 问进度(段代理, 任务值, 收尾配置);

    关闭代理(段代理);   // 它自己会把会话一起关掉（代理.qi 的 关闭代理），别再关一次

    任务值.段号 = 任务值.段号 + 1;

    // 撞上工具循环上限 = 这一段被**腰斩**，模型没机会输出段末 JSON。
    // 活可能已经干了（文件都写了），但账上一个里程碑都没推进 —— 再跑下去
    // 只是把预算重复烧在同一段上。所以要专门认出来、说清楚，而不是把
    // 「[harness] tool 循环达到上限」当成一条普通笔记存下去。
    //
    // 实测踩过：每段最多步 设成 4，agent 列目录 + 写三个文件正好 4 次调用，
    // 三个文件都写对了，段号 +1、里程碑 0/3、笔记只剩那句上限提示。
    任务值 = 解析段结果(任务值, 汇报);
    如果 (腰斩 == 1) {
        // 腰斩不再等于丢结果（收尾那一问照发），但仍要说一声：这一段没干完，
        // 而且步数上限多半设小了。
        任务值.上段笔记 = "上一段撞上工具循环上限（每段最多步 = "
            + 整数转字符串(任务值.每段最多步) + "）被打断。" + 任务值.上段笔记;
        事件("longrun_segment_truncated", "长时程",
            任务值.名字 + " 第 " + 整数转字符串(任务值.段号) + " 段撞上工具循环上限 "
            + 整数转字符串(任务值.每段最多步) + " —— 考虑把 每段最多步 调大");
    }

    如果 (是否达成(任务值.目标值) == 1) { 任务值.结局 = "完成"; }
    如果 (任务值.结局 == "进行中" && 任务值.段号 >= 任务值.最多段数) {
        任务值.结局 = "超限";
    }

    // 花销落库 —— 下个进程 挂预算 时补得回来
    如果 (任务值.预算句柄 >= 0) {
        任务值.已用令牌累计 = 已用令牌(任务值.预算句柄);
    }

    // 段落盘：崩在任何一段中间，最多丢那一段，前面的全在
    数据库.执行(任务值.库, "INSERT INTO 长任务段(名字, 段号, 笔记, 产出, 时刻) VALUES("
        + 引(任务值.名字) + ", " + 整数转字符串(任务值.段号) + ", "
        + 引(任务值.上段笔记) + ", " + 引(截断笔记(产出)) + ", "
        + 整数转字符串(时间.现在()) + ")");
    保存长任务(任务值);

    事件("longrun_segment_end", "长时程",
        任务值.名字 + " 第 " + 整数转字符串(任务值.段号) + " 段 · "
        + 整数转字符串(已完成数(任务值.目标值)) + "/" + 整数转字符串(里程碑数(任务值.目标值))
        + " 里程碑 · " + 任务值.结局);
    返回 任务值;
}

// 一段接一段跑到收场（完成 / 升级 / 超限）。中途进程没了，下次 续长任务
// 再调本函数，从下一段接着跑。
公开 函数 一直跑(任务值: 长任务, 配置值: 模型配置, 背景知识: 字符串) : 长任务 {
    当 (任务值.结局 == "进行中" && 任务值.段号 < 任务值.最多段数) {
        变量 之前段号: 整数 = 任务值.段号;
        任务值 = 跑一段(任务值, 配置值, 背景知识);
        // 段号没动 = 这一段根本没跑起来（开不了会话之类），再循环就是死转
        如果 (任务值.段号 == 之前段号) { 返回 任务值; }
    }
    返回 任务值;
}

公开 函数 任务进度(任务值: 长任务) : 字符串 {
    返回 任务值.名字 + "：第 " + 整数转字符串(任务值.段号) + " 段 · "
        + 整数转字符串(已完成数(任务值.目标值)) + "/"
        + 整数转字符串(里程碑数(任务值.目标值)) + " 里程碑 · " + 任务值.结局;
}

// MCP服务 Streamable HTTP 传输：同进程起 server（goroutine），用 MCP客户端.连接MCP_http
// 做往返，再用裸 TCP 核对协议细节（会话头 / 202 / 400 / 404 / 405 / DELETE）。离线。
// 跑：tests/run-qi-test.sh tests/mcp_transport/MCP服务HTTP_测.qi
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.时间;
导入 标准库.网络 作为 网络;
导入 标准库.JSON 作为 J;
导入 Harness.工具::{工具};
导入 Harness.MCP服务::{MCP服务, 创建MCP服务, 服务注册工具, 运行MCP服务_HTTP};
导入 Harness.MCP客户端::{连接MCP_http, MCP列出工具, MCP调用工具, 发送请求, 关闭MCP};

变量 失败数: 整数 = 0;

函数 断言包含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 未包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 加法(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 "参数解析失败"; }
    变量 a: 整数 = J.获取整数(对象, "a");
    变量 b: 整数 = J.获取整数(对象, "b");
    J.删除(对象);
    返回 整数转字符串(a + b);
}

函数 回声(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 "参数解析失败"; }
    变量 文本值: 字符串 = J.获取字符串(对象, "text");
    J.删除(对象);
    返回 "echo: " + 文本值;
}

// goroutine 入口（启动 不支持内联闭包）
函数 服务协程(服务: MCP服务, 端口: 整数) {
    运行MCP服务_HTTP(服务, "127.0.0.1", 端口);
}

// 裸 TCP 发一个 HTTP 请求，读回完整响应（头 + 体）
函数 裸请求(端口: 整数, 方法: 字符串, 会话ID: 字符串, 体: 字符串) : 字符串 {
    变量 连接: 整数 = 网络.TCP连接("127.0.0.1", 端口, 3000);
    如果 (连接 <= 0) { 返回 "[连接失败]"; }
    变量 请求: 字符串 = 方法 + " /mcp HTTP/1.1\r\nHost: 127.0.0.1\r\nAccept: application/json\r\nContent-Type: application/json\r\n";
    如果 (字符串::字节长度(会话ID) > 0) { 请求 = 请求 + "Mcp-Session-Id: " + 会话ID + "\r\n"; }
    请求 = 请求 + "Content-Length: " + 整数转字符串(字符串::字节长度(体)) + "\r\nConnection: close\r\n\r\n" + 体;
    网络.TCP写入(连接, 请求);
    网络.TCP刷新(连接);
    变量 响应: 字符串 = "";
    变量 块: 字符串 = 网络.TCP读取(连接, 65536);
    当 (字符串::字节长度(块) > 0) {
        响应 = 响应 + 块;
        块 = 网络.TCP读取(连接, 65536);
    }
    网络.TCP关闭(连接);
    返回 响应;
}

函数 取响应头(响应: 字符串, 名小写: 字符串) : 字符串 {
    变量 小写: 字符串 = 字符串::转小写(响应);
    变量 位置: 整数 = 字符串::查找(小写, "\n" + 名小写 + ":");
    如果 (位置 < 0) { 返回 ""; }
    变量 余: 字符串 = 字符串::子串从位置(响应, 位置 + 2 + 字符串::字节长度(名小写));
    变量 行尾: 整数 = 字符串::查找(余, "\r\n");
    如果 (行尾 < 0) { 返回 字符串::去空白(余); }
    返回 字符串::去空白(字符串::子串(余, 0, 行尾));
}

函数 入口() {
    变量 端口: 整数 = 41963;
    当 (网络.端口可用(端口) == 0) { 端口 = 端口 + 1; }

    变量 服务: MCP服务 = 创建MCP服务("qi-harness HTTP 测试服务", "1.2.3");
    服务 = 服务注册工具(服务, 新建 工具 {
        名字: "add",
        描述: "两个整数相加",
        参数schema: "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}},\"required\":[\"a\",\"b\"]}",
        处理: 加法,
    });
    服务 = 服务注册工具(服务, 新建 工具 {
        名字: "echo",
        描述: "原样回显",
        参数schema: "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}",
        处理: 回声,
    });
    启动 服务协程(服务, 端口);
    时间.睡眠毫秒(300);
    变量 基址: 字符串 = "http://127.0.0.1:" + 整数转字符串(端口) + "/mcp";

    // ── 1. 用本仓 MCP客户端 往返 ──
    变量 描述符: 字符串 = 连接MCP_http(基址);
    如果 (字符串::字节长度(描述符) == 0) {
        IO.打印行("FAIL 连接MCP_http 失败: " + 基址);
        返回;
    }
    IO.打印行("PASS 客户端/initialize + notifications/initialized 成功");
    变量 工具们: 字符串 = MCP列出工具(描述符);
    断言包含("客户端/tools/list 含 add", 工具们, "\"name\":\"add\"");
    断言包含("客户端/tools/list 含 inputSchema", 工具们, "\"inputSchema\":{");
    断言包含("客户端/tools/list 含 echo", 工具们, "\"name\":\"echo\"");
    变量 结果1: 字符串 = MCP调用工具(描述符, "add", "{\"a\":2,\"b\":40}");
    断言包含("客户端/tools/call add = 42", 结果1, "\"text\":\"42\"");
    变量 结果2: 字符串 = MCP调用工具(描述符, "echo", "{\"text\":\"你好 MCP\"}");
    断言包含("客户端/tools/call echo 中文", 结果2, "echo: 你好 MCP");
    变量 心跳: 字符串 = 发送请求(描述符, "ping", "{}");
    断言包含("客户端/ping", 心跳, "\"result\":{}");
    变量 未知方法: 字符串 = 发送请求(描述符, "nope/x", "{}");
    断言包含("客户端/未知方法 -32601", 未知方法, "-32601");
    变量 未知工具: 字符串 = 发送请求(描述符, "tools/call", "{\"name\":\"nope\",\"arguments\":{}}");
    断言包含("客户端/未知工具 -32602", 未知工具, "-32602");
    变量 大参数: 字符串 = MCP调用工具(描述符, "echo", "{\"text\":\"" + 字符串::替换("一二三四五六七八九十", "十", "十一二三四五六七八九十一二三四五六七八九十") + "\"}");
    断言包含("客户端/多字节参数完整", 大参数, "一二三四五六七八九十一二三四五六七八九十一二三四五六七八九十");
    关闭MCP(描述符);   // 发 DELETE
    IO.打印行("PASS 客户端/关闭（DELETE）");

    // ── 2. 裸 TCP 核对协议细节 ──
    变量 初始: 字符串 = 裸请求(端口, "POST", "", "{\"jsonrpc\":\"2.0\",\"id\":\"init-1\",\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-03-26\",\"capabilities\":{},\"clientInfo\":{\"name\":\"raw\",\"version\":\"0\"}}}");
    断言包含("协议/initialize 200", 初始, "HTTP/1.1 200 OK");
    断言包含("协议/initialize Content-Type json", 初始, "Content-Type: application/json");
    断言包含("协议/initialize 回 protocolVersion", 初始, "\"protocolVersion\":\"2025-03-26\"");
    断言包含("协议/initialize 回 serverInfo", 初始, "\"name\":\"qi-harness HTTP 测试服务\"");
    断言包含("协议/字符串 id 原样回", 初始, "\"id\":\"init-1\"");
    变量 会话ID: 字符串 = 取响应头(初始, "mcp-session-id");
    如果 (字符串::字节长度(会话ID) > 0) { IO.打印行("PASS 协议/initialize 签发 Mcp-Session-Id"); }
    否则 { 失败数 = 失败数 + 1; IO.打印行("FAIL 协议/没有 Mcp-Session-Id: " + 初始); }

    变量 通知: 字符串 = 裸请求(端口, "POST", 会话ID, "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/initialized\"}");
    断言包含("协议/通知 202", 通知, "HTTP/1.1 202 Accepted");
    变量 列表响应: 字符串 = 裸请求(端口, "POST", 会话ID, "{\"jsonrpc\":\"2.0\",\"id\":7,\"method\":\"tools/list\"}");
    断言包含("协议/带会话 tools/list 200", 列表响应, "HTTP/1.1 200 OK");
    断言包含("协议/整数 id 原样回", 列表响应, "\"id\":7");
    变量 缺头: 字符串 = 裸请求(端口, "POST", "", "{\"jsonrpc\":\"2.0\",\"id\":8,\"method\":\"tools/list\"}");
    断言包含("协议/缺 Mcp-Session-Id 400", 缺头, "HTTP/1.1 400 Bad Request");
    变量 假会话: 字符串 = 裸请求(端口, "POST", "no-such-session", "{\"jsonrpc\":\"2.0\",\"id\":9,\"method\":\"tools/list\"}");
    断言包含("协议/未知会话 404", 假会话, "HTTP/1.1 404 Not Found");
    变量 坏JSON: 字符串 = 裸请求(端口, "POST", 会话ID, "{not json");
    断言包含("协议/坏 JSON 400 + -32700", 坏JSON, "-32700");
    变量 批量: 字符串 = 裸请求(端口, "POST", 会话ID, "[{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"ping\"}]");
    断言包含("协议/批量请求 400", 批量, "HTTP/1.1 400 Bad Request");
    变量 取: 字符串 = 裸请求(端口, "GET", 会话ID, "");
    断言包含("协议/GET 405", 取, "HTTP/1.1 405 Method Not Allowed");
    断言包含("协议/GET 带 Allow 头", 取, "Allow: POST, DELETE, OPTIONS");
    变量 预检: 字符串 = 裸请求(端口, "OPTIONS", "", "");
    断言包含("协议/OPTIONS 204", 预检, "HTTP/1.1 204 No Content");
    变量 删: 字符串 = 裸请求(端口, "DELETE", 会话ID, "");
    断言包含("协议/DELETE 200", 删, "HTTP/1.1 200 OK");
    变量 删后: 字符串 = 裸请求(端口, "POST", 会话ID, "{\"jsonrpc\":\"2.0\",\"id\":10,\"method\":\"ping\"}");
    断言包含("协议/DELETE 后会话 404", 删后, "HTTP/1.1 404 Not Found");
    变量 再删: 字符串 = 裸请求(端口, "DELETE", 会话ID, "");
    断言包含("协议/重复 DELETE 404", 再删, "HTTP/1.1 404 Not Found");

    // ── 3. 第二个客户端仍能正常连（server 没被前面的 DELETE 弄坏）──
    变量 描述符2: 字符串 = 连接MCP_http(基址);
    如果 (字符串::字节长度(描述符2) > 0) {
        断言包含("客户端/第二个会话 add", MCP调用工具(描述符2, "add", "{\"a\":1,\"b\":1}"), "\"text\":\"2\"");
        关闭MCP(描述符2);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL 客户端/第二个会话连接失败");
    }

    如果 (失败数 == 0) { IO.打印行("全部通过"); }
    否则 { IO.打印行("失败 " + 整数转字符串(失败数) + " 项"); }
}

// 观测台端到端 —— 起看板 + 真跑一次 agent，然后挂着等 Python 来抓页面。
//
// 断言在 跑观测台测.py：看板对不对得看**浏览器拿到的 HTML**，
// 「渲染函数返回了字符串」什么都不能证明。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 标准库.操作系统 作为 系统;
导入 标准库.字符串;
导入 Harness::{大模型, 配置超时, 开启会话, 创建代理, 添加工具, 运行, 关闭代理, 工具};
导入 Harness.代理::{代理};
导入 Harness.观测台::{开观测台, 设置观测台标题};

函数 fixture_echo(参数JSON: 字符串) : 字符串 {
    返回 "fixture-result";
}

函数 入口() {
    变量 端口: 整数 = 字符串转整数(系统.获取环境变量("QI_OBS_PORT"));
    设置观测台标题("观测台自测");
    开观测台(端口);
    // 等服务真的听上。不等的话 Python 那边第一发 curl 会撞上「连接被拒」，
    // 而那看着像「看板起不来」，其实只是快了 50 毫秒。
    时间.睡眠毫秒(500);

    变量 配置 = 大模型(系统.获取环境变量("QI_TEST_URL") + "/v1/tool",
        "fixture-key", "fixture-model");
    配置 = 配置超时(配置, 5);
    变量 代理值: 代理 = 创建代理("看板自测代理", 开启会话(配置));
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "fixture_echo",
        描述: "确定性夹具工具",
        参数schema: "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}}}",
        处理: fixture_echo,
    });
    变量 回复: 字符串 = 运行(代理值, "call the fixture tool");
    IO.打印行("agent 回复: " + 回复);
    IO.打印行("READY");

    // 挂着让 Python 抓页面。它抓完会 kill 掉本进程。
    时间.睡眠毫秒(30000);
    关闭代理(代理值);
}

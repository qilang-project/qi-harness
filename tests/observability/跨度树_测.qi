// 跨度树单测 —— 直接喂生命周期事件，不起模型，离线且确定性。
//
// 喂的序列就是 tests/events/agent_lifecycle_test.qi 实测到的那串，
// 所以这里验的是「真实事件流能不能还原成正确的树」，不是我自己编的形状。

包 主程序;

导入 标准库.JSON 作为 J;
导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.时间;
导入 Harness.事件::{发出生命周期事件, 清空生命周期订阅者};
导入 Harness.跨度::{安装跨度采集器, 跨度树JSON, 最近运行JSON, 运行数, 清空,
    设置保留运行数, 设置单运行跨度上限, 丢弃跨度计数};

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言(条件: 整数, 名字: 字符串) {
    如果 (条件 == 1) {
        IO.打印行("PASS " + 名字);
        通过数 = 通过数 + 1;
    } 否则 {
        IO.打印行("FAIL " + 名字);
        失败数 = 失败数 + 1;
    }
}

函数 断言相等(实际: 字符串, 期望: 字符串, 名字: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) {
        IO.打印行("PASS " + 名字);
        通过数 = 通过数 + 1;
    } 否则 {
        IO.打印行("FAIL " + 名字 + "\n  期望: " + 期望 + "\n  实际: " + 实际);
        失败数 = 失败数 + 1;
    }
}

函数 发(运行ID: 字符串, 轮次: 字符串, 步骤: 字符串, 类型值: 字符串, 载荷: 字符串) {
    发出生命周期事件(运行ID, 轮次, 步骤, 类型值, "测代理", 载荷);
}

// 从跨度树 JSON 里取第 i 个 span 的某个字段（整数）
函数 取跨度整数(树: 字符串, i: 整数, 字段: 字符串) : 整数 {
    变量 根: 整数 = J.解码(树);
    变量 数组值: 整数 = J.获取数组(根, "spans");
    变量 项: 整数 = J.数组获取对象(数组值, i);
    变量 值: 整数 = J.获取整数(项, 字段);
    J.删除(根);
    返回 值;
}

函数 取跨度串(树: 字符串, i: 整数, 字段: 字符串) : 字符串 {
    变量 根: 整数 = J.解码(树);
    变量 数组值: 整数 = J.获取数组(根, "spans");
    变量 项: 整数 = J.数组获取对象(数组值, i);
    变量 值: 字符串 = J.获取字符串(项, 字段);
    J.删除(根);
    返回 值;
}

函数 跨度数(树: 字符串) : 整数 {
    变量 根: 整数 = J.解码(树);
    变量 数组值: 整数 = J.获取数组(根, "spans");
    变量 n: 整数 = J.数组长度(数组值);
    J.删除(根);
    返回 n;
}

函数 树整数(树: 字符串, 字段: 字符串) : 整数 {
    变量 根: 整数 = J.解码(树);
    变量 值: 整数 = J.获取整数(根, 字段);
    J.删除(根);
    返回 值;
}

// ——— 1. 正常一次带工具的运行 ———
函数 测正常树() {
    清空();
    变量 R: 字符串 = "run-normal";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "", "turn_start", "{}");
    发(R, "turn-1", "step-0", "llm_start", "{}");
    发(R, "turn-1", "step-0", "llm_end", "{\"tokens\":120,\"cost\":7}");
    发(R, "turn-1", "step-0-tool-0", "tool_start", "{\"name\":\"查天气\"}");
    发(R, "turn-1", "step-0-tool-0", "tool_end", "{}");
    发(R, "turn-1", "step-1", "llm_start", "{}");
    发(R, "turn-1", "step-1", "llm_end", "{\"tokens\":80,\"cost\":5}");
    发(R, "turn-1", "", "turn_end", "{}");
    发(R, "turn-1", "", "agent_end", "{}");

    变量 树: 字符串 = 跨度树JSON(R);
    // agent + turn + llm + tool + llm = 5（两次 llm 是同一层的两步，不是嵌套）
    断言(跨度数(树) == 5, "跨度数为5");

    // 层级：agent(根) > turn > llm/tool
    断言相等(取跨度串(树, 0, "t"), "agent", "第0个是agent");
    断言(取跨度整数(树, 0, "p") == -1, "agent是根");
    断言(取跨度整数(树, 0, "d") == 0, "agent深度0");

    断言相等(取跨度串(树, 1, "t"), "turn", "第1个是turn");
    断言(取跨度整数(树, 1, "p") == 0, "turn的父是agent");
    断言(取跨度整数(树, 1, "d") == 1, "turn深度1");

    断言相等(取跨度串(树, 2, "t"), "llm", "第2个是llm");
    断言(取跨度整数(树, 2, "p") == 1, "llm的父是turn");
    断言(取跨度整数(树, 2, "d") == 2, "llm深度2");
    断言(取跨度整数(树, 2, "tok") == 120, "llm令牌120");

    断言相等(取跨度串(树, 3, "t"), "tool", "第3个是tool");
    断言(取跨度整数(树, 3, "p") == 1, "tool的父是turn而不是llm");
    断言相等(取跨度串(树, 3, "n"), "查天气", "tool名字取自载荷name");

    // 合计只算 llm/tool 叶子，不能把父 span 重复计进去
    断言(树整数(树, "tokens") == 200, "令牌合计200");
    断言(树整数(树, "cost") == 12, "成本合计12");
    断言(树整数(树, "live") == 0, "已结束");

    // 每个 span 都收了尾
    变量 i: 整数 = 0;
    变量 全收尾: 整数 = 1;
    当 (i < 5) {
        如果 (取跨度整数(树, i, "ms") < 0) { 全收尾 = 0; }
        如果 (取跨度整数(树, i, "st") != 1) { 全收尾 = 0; }
        i = i + 1;
    }
    断言(全收尾, "所有跨度都已收尾且成功");
}

// ——— 2. 出错路径 ———
// error 事件夹在 llm_start/llm_end 中间，应该把当前最内层 span 标红。
函数 测出错() {
    清空();
    变量 R: 字符串 = "run-error";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "", "turn_start", "{}");
    发(R, "turn-1", "step-0", "llm_start", "{}");
    发(R, "turn-1", "step-0", "error", "{\"source\":\"retry\",\"reason\":\"exhausted\"}");
    发(R, "turn-1", "step-0", "llm_end", "{}");
    发(R, "turn-1", "", "turn_end", "{}");
    发(R, "turn-1", "", "agent_end", "{}");

    变量 树: 字符串 = 跨度树JSON(R);
    断言(跨度数(树) == 3, "出错树3个跨度");
    断言(取跨度整数(树, 2, "st") == 2, "llm被标红");
    断言相等(取跨度串(树, 2, "err"), "exhausted", "错误原因取自载荷reason");
    断言(取跨度整数(树, 0, "st") == 1, "agent本身仍算成功收尾");
}

// ——— 3. _end 丢失时能自愈 ———
// 如果哪个模块只发了 start 没发 end（新加代码最容易犯），
// 「按类型匹配弹栈」应该跳过它，而不是让之后所有 span 挂错父亲。
函数 测end丢失() {
    清空();
    变量 R: 字符串 = "run-unbalanced";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "", "turn_start", "{}");
    发(R, "turn-1", "step-0", "llm_start", "{}");
    // llm_end 故意不发
    发(R, "turn-1", "", "turn_end", "{}");
    发(R, "turn-1", "", "agent_end", "{}");

    变量 树: 字符串 = 跨度树JSON(R);
    断言(跨度数(树) == 3, "丢end仍是3个跨度");
    断言(取跨度整数(树, 1, "ms") >= 0, "turn照常收尾");
    断言(取跨度整数(树, 0, "ms") >= 0, "agent照常收尾");
    断言(取跨度整数(树, 2, "ms") == -1, "没收到end的llm标为未结束");
    断言(取跨度整数(树, 2, "st") == 0, "未结束的状态是进行中");
}

// ——— 4. 运行中（还没 agent_end）———
函数 测运行中() {
    清空();
    变量 R: 字符串 = "run-live";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "", "turn_start", "{}");
    变量 树: 字符串 = 跨度树JSON(R);
    断言(树整数(树, "live") == 1, "未结束标live");
    断言(树整数(树, "ms") >= 0, "运行中也能给出已耗时");
}

// ——— 5. 淘汰 ———
函数 测淘汰() {
    清空();
    设置保留运行数(3);
    变量 i: 整数 = 0;
    当 (i < 8) {
        变量 R: 字符串 = "run-" + 整数转字符串(i);
        发(R, "turn-1", "", "agent_start", "{}");
        发(R, "turn-1", "", "agent_end", "{}");
        i = i + 1;
    }
    断言(运行数() == 3, "只保留3次运行");
    // 最老的已经查不到，最新的还在
    断言(跨度数(跨度树JSON("run-0")) == 0, "最老的已淘汰");
    断言(跨度数(跨度树JSON("run-7")) == 1, "最新的还在");
    设置保留运行数(20);
}

// ——— 6. 单运行跨度上限 ———
函数 测上限() {
    清空();
    设置单运行跨度上限(4);
    变量 R: 字符串 = "run-cap";
    发(R, "turn-1", "", "agent_start", "{}");
    变量 i: 整数 = 0;
    当 (i < 20) {
        发(R, "turn-1", "step-" + 整数转字符串(i), "llm_start", "{}");
        发(R, "turn-1", "step-" + 整数转字符串(i), "llm_end", "{}");
        i = i + 1;
    }
    断言(跨度数(跨度树JSON(R)) == 4, "撞顶后不再增长");
    断言(丢弃跨度计数() > 0, "丢弃有计数不是悄悄丢");
    设置单运行跨度上限(2048);
}

// ——— 7. 多次运行互不串台 ———
函数 测多运行() {
    清空();
    发("A", "turn-1", "", "agent_start", "{}");
    发("B", "turn-1", "", "agent_start", "{}");
    发("A", "turn-1", "", "turn_start", "{}");
    发("B", "turn-1", "step-0", "llm_start", "{}");
    发("A", "turn-1", "", "turn_end", "{}");
    发("B", "turn-1", "step-0", "llm_end", "{}");
    发("A", "turn-1", "", "agent_end", "{}");
    发("B", "turn-1", "", "agent_end", "{}");

    变量 甲: 字符串 = 跨度树JSON("A");
    变量 乙: 字符串 = 跨度树JSON("B");
    断言(跨度数(甲) == 2, "A两个跨度");
    断言(跨度数(乙) == 2, "B两个跨度");
    断言相等(取跨度串(甲, 1, "t"), "turn", "A的第二个是turn");
    断言相等(取跨度串(乙, 1, "t"), "llm", "B的第二个是llm");
    断言(取跨度整数(乙, 1, "p") == 0, "B的llm挂在自己的agent下");
}

// ——— 8. 名字里的引号/换行不能打烂 JSON ———
函数 测转义() {
    清空();
    变量 R: 字符串 = "run-escape";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "step-0-tool-0", "tool_start", "{\"name\":\"说\\\"你好\\\"\\n换行\"}");
    发(R, "turn-1", "step-0-tool-0", "tool_end", "{}");
    发(R, "turn-1", "", "agent_end", "{}");
    变量 树: 字符串 = 跨度树JSON(R);
    // 能解析出来就说明转义没打烂
    断言(跨度数(树) == 2, "带引号换行的名字仍能解析");
    断言相等(取跨度串(树, 1, "n"), "说\"你好\"\n换行", "名字原样还原");
}

// ——— 9. 摘要列表 ———
函数 测摘要() {
    清空();
    发("S1", "turn-1", "", "agent_start", "{}");
    发("S1", "turn-1", "", "agent_end", "{}");
    发("S2", "turn-1", "", "agent_start", "{}");
    变量 列表值: 字符串 = 最近运行JSON(10);
    变量 根: 整数 = J.解码(列表值);
    断言(J.数组长度(根) == 2, "摘要两条");
    // 最新的排前面
    变量 首: 整数 = J.数组获取对象(根, 0);
    断言相等(J.获取字符串(首, "run"), "S2", "最新的排最前");
    断言(J.获取整数(首, "live") == 1, "S2还在跑");
    J.删除(根);
}

// ——— 10. 偏移与耗时是瀑布图的全部输入 ———
// 瀑布条的左边界 = o / 总耗时，宽度 = ms / 总耗时。这两个值错了，
// 图会画得很自信但完全不对 —— 而所有用瞬时夹具的测试都发现不了，
// 因为那时候每条都是最小宽度。这里用真实睡眠造出可分辨的时长差。
函数 测偏移与耗时() {
    清空();
    变量 R: 字符串 = "run-geometry";
    发(R, "turn-1", "", "agent_start", "{}");
    发(R, "turn-1", "step-0", "llm_start", "{}");
    时间.睡眠毫秒(300);
    发(R, "turn-1", "step-0", "llm_end", "{}");
    发(R, "turn-1", "step-1", "llm_start", "{}");
    时间.睡眠毫秒(100);
    发(R, "turn-1", "step-1", "llm_end", "{}");
    发(R, "turn-1", "", "agent_end", "{}");

    变量 树: 字符串 = 跨度树JSON(R);
    变量 总: 整数 = 树整数(树, "ms");
    断言(总 >= 400, "总耗时覆盖了两段睡眠");

    // 根 span 从 0 开始
    断言(取跨度整数(树, 0, "o") == 0, "根跨度偏移为0");

    变量 长段: 整数 = 取跨度整数(树, 1, "ms");
    变量 短段: 整数 = 取跨度整数(树, 2, "ms");
    断言(长段 >= 250, "长段耗时接近300ms");
    断言(短段 >= 80 && 短段 < 250, "短段耗时接近100ms");
    断言(长段 > 短段 * 2, "长段明显长于短段（宽度才分得开）");

    // 第二段必须排在第一段之后，否则瀑布上两条会叠在一起
    断言(取跨度整数(树, 2, "o") >= 长段, "第二段偏移排在第一段之后");
    断言(取跨度整数(树, 2, "o") + 短段 <= 总, "最后一段不超出总耗时");
}

函数 入口() {
    清空生命周期订阅者();
    安装跨度采集器();

    测正常树();
    测出错();
    测end丢失();
    测运行中();
    测淘汰();
    测上限();
    测多运行();
    测转义();
    测摘要();
    测偏移与耗时();

    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过数) + "，失败 " + 整数转字符串(失败数));
    清空生命周期订阅者();
}

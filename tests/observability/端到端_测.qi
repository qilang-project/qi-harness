// 端到端 —— 真跑一次带工具的 agent（打本地假 OpenAI），验跨度树。
//
// 前面的单测是我自己喂事件，等于「我按我以为的样子发，再验它是那个样子」。
// 这里让 代理.qi 自己发，验的才是**真实主循环**产出的东西 ——
// llm_end 的 token 载荷和 tool_start 的工具名当初就是空的，
// 而任何只喂合成事件的测试都发现不了。

包 主程序;

导入 标准库.JSON 作为 J;
导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 标准库.字符串;
导入 Harness::{大模型, 配置超时, 开启会话, 创建代理, 添加工具, 运行, 关闭代理, 工具};
导入 Harness.代理::{代理};
导入 Harness.事件::{清空生命周期订阅者};
导入 Harness.跨度::{安装跨度采集器, 跨度树JSON, 最近运行JSON, 清空};

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言(条件: 整数, 名字: 字符串) {
    如果 (条件 == 1) {
        IO.打印行("PASS " + 名字);
        通过数 = 通过数 + 1;
    } 否则 {
        IO.打印行("FAIL " + 名字);
        失败数 = 失败数 + 1;
    }
}

函数 fixture_echo(参数JSON: 字符串) : 字符串 {
    返回 "fixture-result";
}

函数 入口() {
    清空生命周期订阅者();
    安装跨度采集器();
    清空();

    变量 配置 = 大模型(系统.获取环境变量("QI_TEST_URL") + "/v1/tool",
        "fixture-key", "fixture-model");
    配置 = 配置超时(配置, 5);
    变量 代理值: 代理 = 创建代理("端到端观测", 开启会话(配置));
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "fixture_echo",
        描述: "确定性夹具工具",
        参数schema: "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}}}",
        处理: fixture_echo,
    });

    变量 回复: 字符串 = 运行(代理值, "call the fixture tool");
    断言(字符串::等于(回复, "tool-finished"), "agent 跑通");

    // "" = 最近一次运行；这条同时验了「不用自己记 run_id 也能拿到树」
    变量 树: 字符串 = 跨度树JSON("");
    IO.打印行("树: " + 树);

    变量 根: 整数 = J.解码(树);
    断言(根 > 0, "树是合法 JSON");
    断言(字符串::等于(J.获取字符串(根, "agent"), "端到端观测"), "代理名对");
    断言(J.获取整数(根, "live") == 0, "运行已结束");

    变量 跨度们: 整数 = J.获取数组(根, "spans");
    变量 数量: 整数 = J.数组长度(跨度们);
    断言(数量 == 5, "5 个跨度：agent+turn+llm+tool+llm");

    // 逐个跨度检查
    变量 有工具名: 整数 = 0;
    变量 有真令牌: 整数 = 0;
    变量 全收尾: 整数 = 1;
    变量 根跨度数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 数量) {
        变量 项: 整数 = J.数组获取对象(跨度们, i);
        变量 种: 字符串 = J.获取字符串(项, "t");
        如果 (J.获取整数(项, "ms") < 0) { 全收尾 = 0; }
        如果 (J.获取整数(项, "p") < 0) { 根跨度数 = 根跨度数 + 1; }
        // tool_start 以前不带工具名，链路图上只能看到 step-0-tool-0
        如果 (字符串::等于(种, "tool") == 1) {
            如果 (字符串::等于(J.获取字符串(项, "n"), "fixture_echo") == 1) {
                有工具名 = 1;
            }
        }
        // llm_end 以前恒发 "{}"，于是 token 永远是 0
        如果 (字符串::等于(种, "llm") == 1) {
            如果 (J.获取整数(项, "tok") > 0) { 有真令牌 = 1; }
        }
        i = i + 1;
    }
    断言(全收尾, "所有跨度都收了尾");
    断言(根跨度数 == 1, "只有一个根跨度");
    断言(有工具名, "工具跨度显示的是工具名而不是步骤编号");
    断言(有真令牌, "llm 跨度带 provider 返回的真实 token");
    断言(J.获取整数(根, "tokens") > 0, "整棵树的 token 合计非零");
    J.删除(根);

    // 摘要里能看到这次运行
    变量 摘要: 字符串 = 最近运行JSON(5);
    变量 摘要根: 整数 = J.解码(摘要);
    断言(J.数组长度(摘要根) == 1, "摘要里一条运行");
    变量 首: 整数 = J.数组获取对象(摘要根, 0);
    断言(J.获取整数(首, "spans") == 5, "摘要里的跨度数对得上");
    断言(J.获取整数(首, "ms") >= 0, "摘要里有耗时");
    J.删除(摘要根);

    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过数) + "，失败 " + 整数转字符串(失败数));
    清空生命周期订阅者();
    关闭代理(代理值);
}

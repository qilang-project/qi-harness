// 并发采集测 —— 两路 goroutine 同时往采集器灌事件，两棵树都得完好。
//
// 为什么要有这条：单 agent 跑的时候事件全在主线程上按序到达，
// 采集器不加锁也一切正常 —— 于是「多代理并发」这条路的错乱会一直藏着。
// 而它的表现不是崩溃，是 span 悄悄挂到别人家的父节点下、深度算错，
// 图画出来还挺合理。
//
// 灌的量要够大：竞态是概率事件，一路十条的话不加锁也可能碰巧全对。

包 主程序;

导入 标准库.JSON 作为 J;
导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.时间;
导入 Harness.事件::{发出生命周期事件, 清空生命周期订阅者};
导入 Harness.跨度::{安装跨度采集器, 跨度树JSON, 清空, 设置保留运行数};

常量 每路轮数 = 40;

变量 通过数: 整数 = 0;
变量 失败数: 整数 = 0;

函数 断言(条件: 整数, 名字: 字符串) {
    如果 (条件 == 1) {
        IO.打印行("PASS " + 名字);
        通过数 = 通过数 + 1;
    } 否则 {
        IO.打印行("FAIL " + 名字);
        失败数 = 失败数 + 1;
    }
}

// 一路：模拟一次完整的 agent 运行，agent > turn > (llm, tool) × N
函数 灌一路(运行ID: 字符串, 代理名: 字符串, 完成信道: 通道<整数>) {
    发出生命周期事件(运行ID, "turn-1", "", "agent_start", 代理名, "{}");
    发出生命周期事件(运行ID, "turn-1", "", "turn_start", 代理名, "{}");
    变量 i: 整数 = 0;
    当 (i < 每路轮数) {
        变量 步: 字符串 = "step-" + 整数转字符串(i);
        发出生命周期事件(运行ID, "turn-1", 步, "llm_start", 代理名, "{}");
        发出生命周期事件(运行ID, "turn-1", 步, "llm_end", 代理名, "{\"tokens\":10}");
        发出生命周期事件(运行ID, "turn-1", 步 + "-tool-0", "tool_start", 代理名,
            "{\"name\":\"工具" + 整数转字符串(i) + "\"}");
        发出生命周期事件(运行ID, "turn-1", 步 + "-tool-0", "tool_end", 代理名, "{}");
        // 让出点。没有它三路 goroutine 会各自跑到底、根本不交错 ——
        // 那样这条测试连去掉锁都是绿的，等于没测。真实 agent 在两条事件之间
        // 有 HTTP 往返，交错是常态，这里用睡眠把那个形状造出来。
        时间.睡眠毫秒(1);
        i = i + 1;
    }
    发出生命周期事件(运行ID, "turn-1", "", "turn_end", 代理名, "{}");
    发出生命周期事件(运行ID, "turn-1", "", "agent_end", 代理名, "{}");
    完成信道 <- 1;
}

// 验一棵树的形状：根唯一、turn 挂根下、llm/tool 全挂 turn 下、深度一致、都收了尾
函数 验树(运行ID: 字符串, 名字: 字符串) {
    变量 树: 字符串 = 跨度树JSON(运行ID);
    变量 根: 整数 = J.解码(树);
    如果 (根 <= 0) { 断言(0, 名字 + "-可解析"); 返回; }

    变量 跨度们: 整数 = J.获取数组(根, "spans");
    变量 数量: 整数 = J.数组长度(跨度们);
    // agent + turn + 每轮两个
    断言(数量 == 2 + 每路轮数 * 2, 名字 + "-跨度数");

    变量 根数: 整数 = 0;
    变量 层级对: 整数 = 1;
    变量 全收尾: 整数 = 1;
    变量 令牌合计: 整数 = J.获取整数(根, "tokens");
    变量 i: 整数 = 0;
    当 (i < 数量) {
        变量 项: 整数 = J.数组获取对象(跨度们, i);
        变量 种: 字符串 = J.获取字符串(项, "t");
        变量 父: 整数 = J.获取整数(项, "p");
        变量 深: 整数 = J.获取整数(项, "d");
        如果 (J.获取整数(项, "ms") < 0) { 全收尾 = 0; }
        如果 (父 < 0) { 根数 = 根数 + 1; }
        如果 (字符串::等于(种, "agent") == 1) {
            如果 (深 != 0 || 父 != -1) { 层级对 = 0; }
        }
        如果 (字符串::等于(种, "turn") == 1) {
            如果 (深 != 1 || 父 != 0) { 层级对 = 0; }
        }
        // llm / tool 一律是 turn（下标 1）的孩子，深度 2 ——
        // 串台的话这里会看到别的父下标或者深度 3
        如果 (字符串::等于(种, "llm") == 1 || 字符串::等于(种, "tool") == 1) {
            如果 (深 != 2 || 父 != 1) { 层级对 = 0; }
        }
        i = i + 1;
    }
    断言(根数 == 1, 名字 + "-唯一根");
    断言(层级对, 名字 + "-层级没串台");
    断言(全收尾, 名字 + "-全收尾");
    断言(令牌合计 == 每路轮数 * 10, 名字 + "-令牌合计");
    断言(字符串::等于(J.获取字符串(根, "agent"), 名字) == 1, 名字 + "-代理名没串");
    J.删除(根);
}

函数 入口() {
    清空生命周期订阅者();
    安装跨度采集器();
    清空();
    设置保留运行数(20);

    变量 完成: 通道<整数> = 通道<整数>(8);
    // 五路而不是两路：竞态是概率事件，并发面越大越稳定地暴露。
    // 实测两路 × 25 轮时，去掉锁三次里只红一次 —— 那种偶发的回归测试
    // 最后总会被当成「抖一下」忽略掉，等于没有。
    启动 灌一路("run-A", "甲代理", 完成);
    启动 灌一路("run-B", "乙代理", 完成);
    启动 灌一路("run-C", "丙代理", 完成);
    启动 灌一路("run-D", "丁代理", 完成);
    启动 灌一路("run-E", "戊代理", 完成);

    变量 收: 整数 = 0;
    当 (收 < 5) {
        变量 一个: 整数 = <- 完成;
        收 = 收 + 1;
    }

    验树("run-A", "甲代理");
    验树("run-B", "乙代理");
    验树("run-C", "丙代理");
    验树("run-D", "丁代理");
    验树("run-E", "戊代理");

    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过数) + "，失败 " + 整数转字符串(失败数));
    清空生命周期订阅者();
}

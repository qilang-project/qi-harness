// OTLP 导出测 —— 把一棵跨度树推给真 collector，由 Python 那边验形状。
//
// 这里只负责「造树 + 发」，断言全在 跑OTLP测.py：
// 判 OTLP 对不对得看**收到的字节**，qi 自己说「我发了」是不作数的
// （parentSpanId 缺失的 bug 就是这么活下来的）。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 标准库.操作系统 作为 系统;
导入 Harness.事件::{发出生命周期事件, 清空生命周期订阅者};
导入 Harness.跨度::{安装跨度采集器, 跨度树JSON, 清空};
导入 Harness.追踪::{设置OTLP, 设置OTLP同步, 设置服务名, 导出树到OTLP};

函数 发(运行ID: 字符串, 步骤: 字符串, 类型值: 字符串, 载荷: 字符串) {
    发出生命周期事件(运行ID, "turn-1", 步骤, 类型值, "测代理", 载荷);
}

函数 入口() {
    清空生命周期订阅者();
    安装跨度采集器();
    清空();

    设置OTLP(系统.获取环境变量("QI_OTLP_URL"));
    设置服务名("观测台自测");
    // 同步发：异步的话进程可能在 POST 落地前就退出了，测试会偶发红。
    设置OTLP同步(1);

    // 用真 UUID 当 run_id —— OTLP 的 traceId 要 32 位 hex，UUID 去横杠正好。
    变量 R: 字符串 = "6f1a2b3c-4d5e-6f70-8192-a3b4c5d6e7f8";
    发(R, "", "agent_start", "{}");
    发(R, "", "turn_start", "{}");
    发(R, "step-0", "llm_start", "{}");
    发(R, "step-0", "llm_end", "{\"tokens\":120,\"cost\":7}");
    发(R, "step-0-tool-0", "tool_start", "{\"name\":\"查天气\"}");
    发(R, "step-0-tool-0", "tool_end", "{}");
    发(R, "step-1", "llm_start", "{}");
    发(R, "step-1", "error", "{\"source\":\"retry\",\"reason\":\"exhausted\"}");
    发(R, "step-1", "llm_end", "{}");
    发(R, "", "turn_end", "{}");
    发(R, "", "agent_end", "{}");

    变量 结果值: 整数 = 导出树到OTLP(跨度树JSON(R));
    IO.打印行("导出返回 " + 整数转字符串(结果值));

    // 第二次运行走**异步**那条路 —— 生产默认就是它（collector 的 RTT 不该
    // 串进 agent）。同步路径全绿不代表异步路径不炸：启动 出来的 goroutine
    // 里出事是静默的，只表现为「collector 什么都没收到」。
    设置OTLP同步(0);
    // span id 不能跟第一次撞车，否则 Jaeger 上两次运行的 span 会互相认亲
    // （树里的下标是 run 内局部的）。
    变量 R2: 字符串 = "11112222-3333-4444-5555-666677778888";
    发(R2, "", "agent_start", "{}");
    发(R2, "step-0", "llm_start", "{}");
    发(R2, "step-0", "llm_end", "{\"tokens\":5,\"cost\":1}");
    发(R2, "", "agent_end", "{}");
    导出树到OTLP(跨度树JSON(R2));
    // 等后台那一发落地。不等的话进程可能先退出，测试变成偶发红 ——
    // 而偶发红最后总会被当成「抖一下」忽略掉。
    时间.睡眠毫秒(800);

    清空生命周期订阅者();
}

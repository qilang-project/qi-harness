// MCP 资源 / 提示进代理：装备MCP资源 / 装备MCP提示 / 装备MCP全部
// 对着 tests/mcp_equip/fake_mcp_server.py（stdio）跑，离线，不打模型。
// 跑：tests/run-qi-test.sh tests/mcp_equip/MCP装备_测.qi
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.大模型 作为 底层模型;
导入 Harness.MCP客户端::{连接MCP_stdio, 关闭MCP};
导入 Harness.MCP装备::{装备MCP资源, 装备MCP提示, 装备MCP全部};
导入 Harness.工具::{派发, 查找索引};
导入 Harness.代理::{代理, 创建代理, 关闭代理};

变量 失败数: 整数 = 0;

函数 断言包含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 未包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 断言不含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 0) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 不该包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 断言真(名字: 字符串, 条件: 整数) {
    如果 (条件 == 1) { IO.打印行("PASS " + 名字); }
    否则 { 失败数 = 失败数 + 1; IO.打印行("FAIL " + 名字); }
}

函数 入口() {
    变量 描述符: 字符串 = 连接MCP_stdio("python3", "[\"tests/mcp_equip/fake_mcp_server.py\"]");
    如果 (字符串::字节长度(描述符) == 0) {
        IO.打印行("FAIL 连接假 MCP server 失败");
        返回;
    }
    变量 会话: 整数 = 底层模型.创建会话("http://127.0.0.1:43510/v1", "test", "test");
    变量 代理值: 代理 = 创建代理("MCP装备测", 会话);
    代理值 = 装备MCP全部(代理值, 描述符);

    // 工具照旧（装备MCP）
    变量 回显: 字符串 = 派发(代理值.工具表, "echo", "{\"text\":\"你好\"}");
    断言包含("全部/工具仍走 MCP", 回显, "echo: 你好");

    // 资源
    变量 列: 字符串 = 派发(代理值.工具表, "mcp_list_resources", "{}");
    断言包含("资源/列出含 uri", 列, "memo://hello");
    断言包含("资源/列出含第二个", 列, "memo://data");
    变量 读: 字符串 = 派发(代理值.工具表, "mcp_read_resource", "{\"uri\":\"memo://hello\"}");
    断言包含("资源/读取文本", 读, "你好，资源");
    变量 缺参: 字符串 = 派发(代理值.工具表, "mcp_read_resource", "{}");
    断言包含("资源/缺 uri 被 schema 拦下", 缺参, "invalid_arguments");
    变量 不存在: 字符串 = 派发(代理值.工具表, "mcp_read_resource", "{\"uri\":\"memo://nope\"}");
    断言包含("资源/server 错误透传", 不存在, "mcp_error");
    断言包含("资源/server 错误消息", 不存在, "resource not found");

    // 提示
    断言真("提示/greet 注册成 prompt_greet", 查找索引(代理值.工具表, "prompt_greet") >= 0);
    断言真("提示/中文名 ASCII 安全化", 查找索引(代理值.工具表, "prompt______") >= 0);
    变量 问好: 字符串 = 派发(代理值.工具表, "prompt_greet", "{\"name\":\"张三\",\"style\":\"热情\"}");
    断言包含("提示/参数填进模板", 问好, "user: 请用热情风格向张三问好");
    断言包含("提示/数组 content 拼接", 问好, "assistant: 好的，\n张三你好！");
    断言包含("提示/description 带上", 问好, "问候模板");
    断言不含("提示/内部键没外泄", 问好, "unexpected arguments");
    变量 少参: 字符串 = 派发(代理值.工具表, "prompt_greet", "{\"style\":\"x\"}");
    断言包含("提示/required 参数缺失被 schema 拦下", 少参, "invalid_arguments");
    变量 中文: 字符串 = 派发(代理值.工具表, "prompt______", "{}");
    断言包含("提示/中文名 prompt 可调", 中文, "user: 请总结这份文档");

    // 第二台 server：工具名带后缀，各走各的连接
    变量 描述符2: 字符串 = 连接MCP_stdio("python3", "[\"tests/mcp_equip/fake_mcp_server.py\"]");
    断言真("多服务/第二连接成功", 字符串::字节长度(描述符2) > 0);
    代理值 = 装备MCP资源(代理值, 描述符2);
    代理值 = 装备MCP提示(代理值, 描述符2);
    断言真("多服务/资源工具带 _2 后缀", 查找索引(代理值.工具表, "mcp_list_resources_2") >= 0);
    断言真("多服务/读资源工具带 _2 后缀", 查找索引(代理值.工具表, "mcp_read_resource_2") >= 0);
    断言真("多服务/提示工具带 _2 后缀", 查找索引(代理值.工具表, "prompt_greet_2") >= 0);
    变量 列2: 字符串 = 派发(代理值.工具表, "mcp_list_resources_2", "{}");
    断言包含("多服务/第二连接可用", 列2, "memo://hello");
    变量 问好2: 字符串 = 派发(代理值.工具表, "prompt_greet_2", "{\"name\":\"李四\"}");
    断言包含("多服务/第二连接的 prompt 走对了原名", 问好2, "向李四问好");

    关闭MCP(描述符2);
    关闭MCP(描述符);
    关闭代理(代理值);
    如果 (失败数 == 0) { IO.打印行("全部通过"); }
    否则 { IO.打印行("失败 " + 整数转字符串(失败数) + " 项"); }
}

// 给模型的三个图工具：记事实 / 查关系 / 怎么连的。
//
// 直接用 工具.派发 调，不经过模型 —— 这样测的是工具本身（含槽位注入这条
// 最容易错的路），不受模型发挥影响。真模型的端到端另跑过：一个进程让它
// 记，另一个全新进程让它查，答对了两跳的链。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 Harness.模型::{大模型, 开启会话};
导入 Harness.代理::{代理, 创建代理, 关闭代理};
导入 Harness.工具::{派发, 查找索引};
导入 Harness.图记忆::{启用图记忆, 装备图记忆工具, 打开图记忆, 关闭图记忆, 图回忆};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    IO.删除文件("/tmp/图工具测.kv");
    变量 甲: 代理 = 创建代理("图工具验", 开启会话(大模型("http://127.0.0.1:1/v1", "k", "m")));
    甲 = 启用图记忆(甲, "/tmp/图工具测.kv");
    甲 = 装备图记忆工具(甲);

    断言(查找索引(甲.工具表, "记事实") >= 0, "记事实 装上了");
    断言(查找索引(甲.工具表, "查关系") >= 0, "查关系 装上了");
    断言(查找索引(甲.工具表, "怎么连的") >= 0, "怎么连的 装上了");

    // ① 写：模型侧看到的就是这个调用形状
    变量 回一: 字符串 = 派发(甲.工具表, "记事实",
        "{\"主体\":\"登录接口\",\"关系\":\"需要请求头\",\"客体\":\"X-Token\"}");
    断言(字符串::查找(回一, "\"ok\":true") >= 0, "记事实 写成功（" + 回一 + "）");
    派发(甲.工具表, "记事实",
        "{\"主体\":\"X-Token\",\"关系\":\"签发方\",\"客体\":\"认证服务\"}");

    // ② 读：默认跳数要能跨两跳把「认证服务」带出来
    变量 查: 字符串 = 派发(甲.工具表, "查关系", "{\"关键词\":\"登录接口\"}");
    断言(字符串::查找(查, "X-Token") >= 0, "查关系 带出一跳");
    断言(字符串::查找(查, "认证服务") >= 0, "查关系 默认就跨到两跳（1 跳的话这里必挂）");

    // ③ 路径
    变量 路: 字符串 = 派发(甲.工具表, "怎么连的",
        "{\"甲\":\"登录接口\",\"乙\":\"认证服务\"}");
    断言(字符串::查找(路, "X-Token") >= 0, "怎么连的 给出中间节点（" + 路 + "）");

    // ④ 参数不全要拒，不能悄悄写半条进去
    变量 坏: 字符串 = 派发(甲.工具表, "记事实", "{\"主体\":\"甲\",\"关系\":\"\"}");
    断言(字符串::查找(坏, "\"ok\":false") >= 0, "缺字段被拒");

    关闭代理(甲);

    // ⑤ 真正的价值在这儿：**换一个进程也能读到**。这里退一步 —— 重新打开同一个
    //    .kv（新句柄、新槽位），确认写进去的东西是落盘的而不是内存里的。
    变量 库二: 整数 = 打开图记忆("/tmp/图工具测.kv");
    变量 重开: 字符串 = 图回忆(库二, "登录接口", 6);
    断言(字符串::查找(重开, "认证服务") >= 0, "重开图库仍读得到（落盘了，不是内存）");
    关闭图记忆(库二);

    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

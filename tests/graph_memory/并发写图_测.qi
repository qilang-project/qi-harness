// 图的写路径在并发下不能长出重复边。
//
// 代理的工具派发是并发的（本地工具全进 goroutine，见 工具.qi 的 并发派发），
// 模型一次吐三个 记事实 就是三个线程同时进 关联。而 关联 里「找已有边 →
// 没有 → 加边」是 check-then-act，不串起来就会双双落空。
// 真模型实测抓到过：一次长任务下来 -【涉及】梳理模块图 → 入库 有两条。
// 重复边不只是难看 —— 召回有 条数上限，重复的会把真正有用的边挤出去。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 关联, 图记忆条数};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

// 同一条三元组灌 轮数 遍。多路同时灌，最后图里只该有一条边。
函数 灌一路(库: 整数, 轮数: 整数, 完成: 通道<整数>) {
    变量 i: 整数 = 0;
    当 (i < 轮数) {
        关联(库, "梳理模块图", "涉及", "入库");
        i = i + 1;
    }
    完成 <- 1;
}

函数 入口() {
    IO.删除文件("/tmp/并发写图测.kv");
    变量 库: 整数 = 打开图记忆("/tmp/并发写图测.kv");
    断言(库 > 0, "开得了图库");

    // 五路而不是两路：竞态是概率事件，并发面越大越稳定地暴露。
    变量 完成: 通道<整数> = 通道<整数>(8);
    启动 灌一路(库, 20, 完成);
    启动 灌一路(库, 20, 完成);
    启动 灌一路(库, 20, 完成);
    启动 灌一路(库, 20, 完成);
    启动 灌一路(库, 20, 完成);

    变量 收: 整数 = 0;
    当 (收 < 5) {
        变量 一个: 整数 = <- 完成;
        收 = 收 + 1;
    }

    变量 条数: 整数 = 图记忆条数(库);
    断言(条数 == 1, "五路 × 20 遍同一条边，图里仍只有 1 条（实得 " + 条数 + "）");

    关闭图记忆(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

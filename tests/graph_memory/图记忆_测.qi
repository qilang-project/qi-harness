// 图记忆：关系型召回（qi-graph 属性图）。离线，不打模型。
// 跑：tests/graph_memory/run.sh   （或 tests/run-qi-test.sh tests/graph_memory/图记忆_测.qi）
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 图记忆可用, 记实体, 关联,
    关联带属性, 图回忆, 怎么连的, 按关系回忆, 图记忆条数, 图记忆统计};

变量 失败数: 整数 = 0;
变量 库路径: 字符串 = "/tmp/qi_harness_graph_memory_test.kv";

函数 断言相等(名字: 字符串, 实际: 字符串, 期望: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 实际=[" + 实际 + "] 期望=[" + 期望 + "]");
    }
}

函数 断言数相等(名字: 字符串, 实际: 整数, 期望: 整数) {
    断言相等(名字, 整数转字符串(实际), 整数转字符串(期望));
}

函数 断言包含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 未包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 断言不含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 0) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 不该包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

// 文本块的行数（"" 记 0 行）
函数 行数(块: 字符串) : 整数 {
    如果 (字符串::字节长度(块) == 0) { 返回 0; }
    变量 行表: 整数 = 字符串::分割(块, "\n");
    变量 n: 整数 = 列表库::字符串列表大小(行表);
    列表库::删除列表(行表);
    返回 n;
}

// 每一行都得以 "-【" 开头 —— 这是能跟 记忆.回忆 的块直接拼接的硬条件
函数 断言格式对齐(名字: 字符串, 块: 字符串) {
    变量 行表: 整数 = 字符串::分割(块, "\n");
    变量 n: 整数 = 列表库::字符串列表大小(行表);
    变量 坏行: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 行: 字符串 = 列表库::获取字符串(行表, i);
        如果 (字符串::开始于(行, "-【") == 0) { 坏行 = 行; }
        i = i + 1;
    }
    列表库::删除列表(行表);
    如果 (n > 0 && 字符串::字节长度(坏行) == 0) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 坏行=[" + 坏行 + "] 行数=" + 整数转字符串(n));
    }
}

函数 建图(库: 整数) {
    // 研究员 --用过--> mcp:fetch --能取--> 网页
    // 研究员 --用过--> 计算器
    // 分析师 --用过--> 计算器
    // 报告器 --依赖--> 分析师
    记实体(库, "mcp:fetch", "工具");
    记实体(库, "研究员", "人");
    关联(库, "研究员", "用过", "mcp:fetch");
    关联(库, "mcp:fetch", "能取", "网页");
    关联(库, "研究员", "用过", "计算器");
    关联(库, "分析师", "用过", "计算器");
    关联带属性(库, "报告器", "依赖", "分析师", "{\"次数\":3}");
}

函数 入口() {
    IO.删除文件(库路径);

    变量 库: 整数 = 打开图记忆(库路径);
    如果 (库 <= 0) {
        IO.打印行("FAIL 打开图记忆: 句柄=" + 整数转字符串(库));
        IO.打印行("图记忆 测试失败 1 项");
        返回;
    }
    IO.打印行("PASS 打开图记忆");
    断言数相等("图记忆可用", 图记忆可用(库), 1);

    // ── 写：自动建两端 + 幂等 ────────────────────────────────
    断言数相等("空库条数", 图记忆条数(库), 0);
    断言数相等("关联/首次", 关联(库, "研究员", "用过", "mcp:fetch"), 1);
    断言数相等("关联/自动建两端实体后 1 条边", 图记忆条数(库), 1);
    断言包含("关联/自动建了两个实体", 图记忆统计(库), "\"entities\":2");
    断言数相等("关联/重复调用仍返回 1", 关联(库, "研究员", "用过", "mcp:fetch"), 1);
    断言数相等("关联/幂等：没长出第二条边", 图记忆条数(库), 1);
    断言数相等("关联/不同关系是另一条边", 关联(库, "研究员", "配置", "mcp:fetch"), 1);
    断言数相等("关联/两条边", 图记忆条数(库), 2);

    // ── 名字带冒号：安全名往返 ────────────────────────────────
    变量 冒号块: 字符串 = 图回忆(库, "mcp:fetch", 5);
    断言包含("冒号名/能被当关键词查到", 冒号块, "mcp:fetch");
    断言不含("冒号名/展示的是原名不是十六进制", 冒号块, "qi_g_");
    断言格式对齐("冒号名/格式对齐", 冒号块);

    关闭图记忆(库);
    IO.删除文件(库路径);

    // ── 完整图：跳数 / 合并去重 / 上限 / 路径 / 按关系 ────────
    库 = 打开图记忆(库路径);
    建图(库);
    断言数相等("建图/边数", 图记忆条数(库), 5);

    变量 一跳: 字符串 = 图回忆(库, "研究员", 9);
    断言数相等("一跳/研究员两条出边", 行数(一跳), 2);
    断言包含("一跳/用过 mcp:fetch", 一跳, "-【用过】研究员 → mcp:fetch");
    断言包含("一跳/用过 计算器", 一跳, "-【用过】研究员 → 计算器");
    断言不含("一跳/不含两跳外的边", 一跳, "能取");
    断言格式对齐("一跳/格式对齐", 一跳);

    变量 两跳: 字符串 = 图回忆(库, "研究员", 2, 9);
    断言包含("两跳/走到 mcp:fetch 的下一跳", 两跳, "-【能取】mcp:fetch → 网页");
    断言包含("两跳/走到 计算器 的入边", 两跳, "-【用过】分析师 → 计算器");
    断言数相等("两跳/共四条边", 行数(两跳), 4);
    断言格式对齐("两跳/格式对齐", 两跳);

    变量 三跳: 字符串 = 图回忆(库, "研究员", 3, 20);
    断言包含("三跳/走到 报告器 → 分析师", 三跳, "-【依赖】报告器 → 分析师");
    断言数相等("三跳/全部五条边", 行数(三跳), 5);

    // 多关键词：两个种子的邻域重叠 —— 研究员→mcp:fetch 那条既是前者的出边
    // 又是后者的入边，没去重的话会出现两次。合并后应该是 3 条：
    //   研究员→mcp:fetch、研究员→计算器、mcp:fetch→网页
    变量 合并: 字符串 = 图回忆(库, "研究员,mcp:fetch", 9);
    断言数相等("多关键词/合并去重后三条", 行数(合并), 3);
    断言包含("多关键词/含第二个种子的边", 合并, "-【能取】mcp:fetch → 网页");
    断言格式对齐("多关键词/格式对齐", 合并);
    变量 中文逗号: 字符串 = 图回忆(库, "研究员，mcp:fetch", 9);
    断言相等("多关键词/中文逗号同样认", 中文逗号, 合并);

    断言相等("没命中/未知关键词返回空串", 图回忆(库, "不存在的东西", 5), "");
    断言相等("没命中/空关键词返回空串", 图回忆(库, "", 5), "");
    断言数相等("上限/1 条", 行数(图回忆(库, "研究员", 3, 1)), 1);
    断言数相等("上限/2 条", 行数(图回忆(库, "研究员", 3, 2)), 2);

    // ── 怎么连的 ──────────────────────────────────────────────
    断言相等("怎么连的/有路径", 怎么连的(库, "研究员", "网页"),
        "-【路径】研究员 → mcp:fetch → 网页");
    断言相等("怎么连的/自己到自己", 怎么连的(库, "研究员", "研究员"), "-【路径】研究员");
    断言相等("怎么连的/无路径", 怎么连的(库, "网页", "研究员"), "");
    断言相等("怎么连的/端点不在图里", 怎么连的(库, "研究员", "查无此人"), "");
    断言格式对齐("怎么连的/格式对齐", 怎么连的(库, "研究员", "网页"));

    // ── 按关系回忆 ────────────────────────────────────────────
    变量 用过块: 字符串 = 按关系回忆(库, "用过", 9);
    断言数相等("按关系/用过 三条", 行数(用过块), 3);
    断言包含("按关系/含分析师那条", 用过块, "-【用过】分析师 → 计算器");
    断言格式对齐("按关系/格式对齐", 用过块);
    断言数相等("按关系/上限生效", 行数(按关系回忆(库, "用过", 2)), 2);
    断言相等("按关系/没有这个关系", 按关系回忆(库, "从没有过的关系", 5), "");

    // ── 统计 ──────────────────────────────────────────────────
    断言包含("统计/available", 图记忆统计(库), "\"available\":1");
    断言包含("统计/relations", 图记忆统计(库), "\"relations\":5");
    断言包含("统计/entities", 图记忆统计(库), "\"entities\":6");

    // ── 坏句柄不崩 ────────────────────────────────────────────
    断言数相等("坏句柄/可用", 图记忆可用(0), 0);
    断言数相等("坏句柄/条数", 图记忆条数(0), 0);
    断言相等("坏句柄/图回忆", 图回忆(0, "研究员", 5), "");
    断言相等("坏句柄/怎么连的", 怎么连的(0, "研究员", "网页"), "");
    断言数相等("坏句柄/关联", 关联(0, "甲", "连", "乙"), 0);
    断言数相等("空名字/记实体", 记实体(库, "", "工具"), 0);
    断言数相等("空关系/关联", 关联(库, "甲", "", "乙"), 0);

    // ── 重开：数据还在 ────────────────────────────────────────
    关闭图记忆(库);
    变量 再开: 整数 = 打开图记忆(库路径);
    断言数相等("重开/边数还在", 图记忆条数(再开), 5);
    断言包含("重开/召回照旧", 图回忆(再开, "研究员", 9), "-【用过】研究员 → mcp:fetch");
    断言包含("重开/冒号名还在", 图回忆(再开, "mcp:fetch", 9), "mcp:fetch");
    断言数相等("重开/幂等仍成立", 关联(再开, "研究员", "用过", "mcp:fetch"), 1);
    断言数相等("重开/没长出重复边", 图记忆条数(再开), 5);
    关闭图记忆(再开);
    IO.删除文件(库路径);

    如果 (失败数 == 0) {
        IO.打印行("图记忆 全部通过");
    } 否则 {
        IO.打印行("图记忆 测试失败 " + 整数转字符串(失败数) + " 项");
    }
}

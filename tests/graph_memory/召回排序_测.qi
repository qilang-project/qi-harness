// 召回排序_测 —— 候选比坑位多的时候，挑的是最相关的那几条，不是先碰到的那几条
//
// 昨天接图记忆时撞到的真问题：注入提示词的条数是死的（默认 12），而两跳邻域
// 动辄几十条边，BFS 一撞上限就停 —— 留下的是**先走到**的，不是最相关的。
//
// 这里造一张形状明确的图：一个任务节点连着「一条真正相关的深链」和「一堆噪声」。
// 噪声先被 BFS 碰到（加边顺序在前），所以不排序时它们会把坑位占满。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 关联, 图回忆, 图回忆按相关度};

变量 库路径: 字符串 = "/tmp/qi_harness_召回排序_测.kv";

// 任务节点 T：
//   先加 10 条噪声边 T--涉及-->噪声i（每条都是死胡同）
//   再加一条真链   T--涉及-->核心, 核心--用法-->要点1, 要点1--细节-->要点2
// 噪声在前，所以不排序时 BFS 会先把它们收满。
函数 建图() : 整数 {
    如果 (IO.文件存在(库路径) == 1) {
        IO.删除文件(库路径);
    }
    变量 库: 整数 = 打开图记忆(库路径);
    变量 i: 整数 = 1;
    当 (i <= 10) {
        关联(库, "T", "涉及", "噪声" + i);
        i = i + 1;
    }
    关联(库, "T", "涉及", "核心");
    关联(库, "核心", "用法", "要点1");
    关联(库, "要点1", "细节", "要点2");
    // 让 核心 这一支在游走里更「重」：核心 与 要点1 互指，随机游走会在这一带打转
    关联(库, "要点1", "回到", "核心");
    返回 库;
}

函数 测_排序前后不一样() : 整数 {
    变量 库: 整数 = 建图();

    // 不排序：坑位 4 条，BFS 先碰到的是噪声，真链基本进不来
    变量 原: 字符串 = 图回忆(库, "T", 2, 4);
    断言包含(原, "噪声", "不排序时噪声占了坑位");

    // 按相关度：以 T 为种子跑个性化 PageRank，核心那一支分数更高
    变量 排: 字符串 = 图回忆按相关度(库, "T", 2, 4);
    断言包含(排, "核心", "排序后真链进来了");

    // 两者应当不同 —— 相同说明排序没起作用
    断言为真(原 != 排, "排序确实改变了挑选结果");

    关闭图记忆(库);
    返回 1;
}

函数 测_放得下时不排序() : 整数 {
    变量 库: 整数 = 建图();
    // 坑位给足（邻域一共 14 条边），全都放得下，就该跟 图回忆 一字不差 ——
    // 没竞争时不该白跑一遍 PageRank，也不该无端改变顺序
    变量 原: 字符串 = 图回忆(库, "T", 2, 100);
    变量 排: 字符串 = 图回忆按相关度(库, "T", 2, 100);
    断言为真(原 == 排, "放得下时两者逐字节相同");
    关闭图记忆(库);
    返回 1;
}

函数 测_边界() : 整数 {
    变量 库: 整数 = 建图();
    断言相等整数(字符串::字节长度(图回忆按相关度(库, "查无此点", 2, 4)), 0,
        "关键词不在图里给空串");
    断言相等整数(字符串::字节长度(图回忆按相关度(0, "T", 2, 4)), 0, "库句柄无效给空串");
    // 多关键词、中英文逗号都认（跟 图回忆 一致）
    断言包含(图回忆按相关度(库, "T，核心", 1, 6), "核心", "全角逗号分隔的多关键词");
    关闭图记忆(库);
    返回 1;
}

函数 入口() {
    运行用例("候选超坑位时按相关度挑", 测_排序前后不一样);
    运行用例("放得下时不排序", 测_放得下时不排序);
    运行用例("边界", 测_边界);
    摘要并退出();
}

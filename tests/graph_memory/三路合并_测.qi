// 带记忆运行 的两路召回合并（词法 + 关系）。
// 断言的是**注入进提示的那段文本**，靠 run.sh 在 stdout 的 llm_call 事件里核对 ——
// 会话历史在 LLM 调用失败时不落，只有事件流里留着真正发出去的提示。
// 故意指向一个没人听的端口：这测的是注入，不是模型。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.大模型 作为 底层模型;
导入 Harness.代理::{代理, 创建代理, 关闭代理, 启用记忆, 带记忆运行,
    代理记忆库, 代理图记忆库};
导入 Harness.记忆::{记住, 关闭记忆};
导入 Harness.图记忆::{启用图记忆, 记关联, 关联, 图记忆条数, 关闭图记忆};

变量 失败数: 整数 = 0;
变量 记忆路径: 字符串 = "/tmp/qi_harness_graph_memory_merge_test.db";
变量 图路径: 字符串 = "/tmp/qi_harness_graph_memory_merge_test.kv";

函数 断言数相等(名字: 字符串, 实际: 整数, 期望: 整数) {
    如果 (实际 == 期望) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 实际=" + 整数转字符串(实际)
            + " 期望=" + 整数转字符串(期望));
    }
}

函数 断言为正(名字: 字符串, 实际: 整数) {
    如果 (实际 > 0) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 期望 > 0，实际=" + 整数转字符串(实际));
    }
}

函数 新代理(名字: 字符串) : 代理 {
    // 关掉的端口 —— 走到 LLM 就必然失败，我们只看失败之前拼出来的提示
    变量 会话: 整数 = 底层模型.创建会话("http://127.0.0.1:43519/v1", "test", "test");
    返回 创建代理(名字, 会话);
}

函数 入口() {
    IO.删除文件(记忆路径);
    IO.删除文件(图路径);

    // ── 没启用图记忆时：记关联 安静地返回 0，带记忆运行 只走词法那一路 ──
    变量 只词法: 代理 = 新代理("只词法");
    只词法 = 启用记忆(只词法, 记忆路径);
    断言数相等("未启用图记忆/句柄为 0", 代理图记忆库(只词法), 0);
    断言数相等("未启用图记忆/记关联返回 0", 记关联(只词法, "甲", "连", "乙"), 0);
    记住(代理记忆库(只词法), "偏好", "用户喜欢简短回答", "回答,风格,研究员", 4);
    带记忆运行(只词法, "只有词法这一路", "研究员");   // run.sh 核对只注入了词法块
    关闭代理(只词法);

    // ── 两路都开 ────────────────────────────────────────────
    变量 双路: 代理 = 新代理("双路");
    双路 = 启用记忆(双路, 记忆路径);
    双路 = 启用图记忆(双路, 图路径);
    断言为正("启用图记忆/拿到句柄", 代理图记忆库(双路));
    断言数相等("记关联/成功", 记关联(双路, "研究员", "用过", "mcp:fetch"), 1);
    断言数相等("记关联/幂等", 记关联(双路, "研究员", "用过", "mcp:fetch"), 1);
    断言数相等("记关联/落到库里就一条", 图记忆条数(代理图记忆库(双路)), 1);
    关联(代理图记忆库(双路), "mcp:fetch", "能取", "网页");
    断言数相等("关联/直接对句柄写也算数", 图记忆条数(代理图记忆库(双路)), 2);
    带记忆运行(双路, "两路都要", "研究员");            // run.sh 核对两路块都注入了

    // ── 都没命中时一个字都不注入 ────────────────────────────
    带记忆运行(双路, "谁都不该命中", "彻底没有的关键词");

    关闭记忆(代理记忆库(双路));
    关闭图记忆(代理图记忆库(双路));
    关闭代理(双路);

    IO.删除文件(记忆路径);
    IO.删除文件(图路径);

    如果 (失败数 == 0) {
        IO.打印行("三路合并 全部通过");
    } 否则 {
        IO.打印行("三路合并 测试失败 " + 整数转字符串(失败数) + " 项");
    }
}

// 长时程：分段 + 断点续跑。对着假 OpenAI 服务器真跑，不是纸上验配置。
//
// 起法：python3 tests/service_persistence/fake_openai.py --port-file <文件>
// 端点走 FAKE_LLM_ENDPOINT（环境变量名不能用中文，shell 传不了）。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.目标监控::{里程碑数, 已完成数};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 续长任务, 长任务可用,
    设分段, 加里程碑, 跑一段, 一直跑, 任务进度, 段提示, 保存长任务
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 库路径: 字符串 = "/tmp/长时程测.db";
    IO.删除文件(库路径);
    变量 库: 整数 = 打开长任务库(库路径);
    断言(库 > 0, "开得了任务库");

    变量 任务: 长任务 = 开长任务(库, "搬砖", "把一堆砖从东头搬到西头");
    任务 = 加里程碑(任务, "清点砖数");
    任务 = 加里程碑(任务, "搬前一半");
    任务 = 加里程碑(任务, "搬后一半");
    任务 = 设分段(任务, 3, 5);
    断言(里程碑数(任务.目标值) == 3, "三个里程碑记下了");

    // ── 段提示：长度只跟里程碑有关，跟段号无关 ──
    变量 一段时: 整数 = 字符串::字节长度(段提示(任务, ""));
    任务.段号 = 99;
    变量 九九段时: 整数 = 字符串::字节长度(段提示(任务, ""));
    任务.段号 = 0;
    变量 差: 整数 = 九九段时 - 一段时;
    如果 (差 < 0) { 差 = 0 - 差; }
    断言(差 < 20, "第 1 段和第 100 段的提示几乎一样长（差 " + 差 + " 字节）—— 这才叫重建不是继承");

    变量 带背景: 整数 = 字符串::字节长度(段提示(任务, "砖是红色的"));
    断言(带背景 > 一段时, "背景知识确实拼进去了（+" + (带背景 - 一段时) + " 字节）");

    // ── 真跑 ──
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) {
        IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过真跑部分");
        IO.打印行("");
        IO.打印行("通过 " + 过 + "，失败 " + 挂);
        返回;
    }
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    任务 = 跑一段(任务, 配置, "");
    断言(任务.段号 == 1, "跑完一段，段号 1（实得 " + 任务.段号 + "）");
    断言(字符串::字节长度(任务.上段笔记) > 0, "留下了给下一段的笔记");

    // ── 断点续跑：把内存里的任务丢掉，从库里重新捞 ──
    变量 捞回: 长任务 = 续长任务(库, "搬砖");
    断言(长任务可用(捞回) == 1, "从库里捞得回来");
    断言(捞回.段号 == 1, "捞回来的段号对（实得 " + 捞回.段号 + "）");
    断言(捞回.上段笔记 == 任务.上段笔记, "笔记原样在（这就是跨进程接得上的东西）");
    断言(里程碑数(捞回.目标值) == 3, "里程碑也在");

    // ── 接着跑到收场 ──
    捞回 = 一直跑(捞回, 配置, "");
    IO.打印行("  " + 任务进度(捞回));
    断言(捞回.结局 != "进行中", "跑到收场了（" + 捞回.结局 + "）");
    断言(捞回.段号 <= 5, "没突破最多段数（" + 捞回.段号 + " ≤ 5）");

    // ── 收场之后再调，必须是空操作，不能又跑起来 ──
    变量 段号快照: 整数 = 捞回.段号;
    捞回 = 一直跑(捞回, 配置, "");
    断言(捞回.段号 == 段号快照, "收场后再调是空操作（段号仍 " + 捞回.段号 + "）");

    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

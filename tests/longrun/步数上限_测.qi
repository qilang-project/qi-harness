// 设分段 里的「每段最多步」到底生不生效。
//
// 曾经不生效：跑一段 里 段代理.最大步数 = 每段最多步 设完之后，紧接着
// 运行使用配置(…, 段配置) 又走 应用运行配置，把 代理.最大步数 拿配置里的
// 默认值 10 盖了回去。真模型实测才露馅 —— 同一段里事件写着「撞上上限 20」，
// 而代理自己报的是「tool loop 超过 10 步上限」，两个数对不上。
//
// 这里用一个「永远回一个 写文件 工具调用」的假模型，跑完数沙箱里有几个文件，
// 那就是真正放行的步数。设 3 就该正好 3 个。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 设分段,
    加里程碑, 用文件沙箱, 跑一段
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

// 从 步1.txt 往上数，数到断为止。不用 列出目录 —— 那要先保证目录干净，
// 而标准库没有递归删目录。挨个清、挨个数，反而更稳。
函数 清并数(目录: 字符串, 上探: 整数) : 整数 {
    变量 数: 整数 = 0;
    变量 i: 整数 = 1;
    当 (i <= 上探) {
        变量 路: 字符串 = 目录 + "/步" + i + ".txt";
        如果 (IO.文件存在(路) == 1) { 数 = 数 + 1; IO.删除文件(路); }
        i = i + 1;
    }
    返回 数;
}

函数 入口() {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) { IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过"); 返回; }
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    变量 沙箱根: 字符串 = "/tmp/步数上限测沙箱";
    IO.创建目录(沙箱根);
    清并数(沙箱根, 40);              // 上一轮的残留先清掉
    IO.删除文件("/tmp/步数上限测.db");

    变量 库: 整数 = 打开长任务库("/tmp/步数上限测.db");
    变量 任务: 长任务 = 开长任务(库, "数步", "验每段最多步真的是上限");
    任务 = 加里程碑(任务, "随便");
    任务 = 设分段(任务, 3, 2);
    任务 = 用文件沙箱(任务, 沙箱根, 1);

    任务 = 跑一段(任务, 配置, "");

    变量 数: 整数 = 清并数(沙箱根, 40);
    断言(数 == 3, "每段最多步 = 3 就正好放行 3 步（实得 " + 数
        + "；默认 10 那个 bug 会给 10）");

    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

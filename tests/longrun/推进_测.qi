// 长时程的 happy path：里程碑真的被推进、结局真的变成「完成」。
//
// 用 tests/longrun/听话的假模型.py —— 它每次回一条合法段末 JSON。
// service_persistence 那个假模型只回 turn-N，走不到解析路径，测出来只有「超限」。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.目标监控::{里程碑数, 已完成数, 是否达成};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 续长任务,
    设分段, 加里程碑, 跑一段, 一直跑, 任务进度
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) { IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过"); 返回; }
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    变量 库路径: 字符串 = "/tmp/长时程推进测.db";
    IO.删除文件(库路径);
    变量 库: 整数 = 打开长任务库(库路径);
    变量 任务: 长任务 = 开长任务(库, "推进", "验里程碑真的会被推进");
    任务 = 加里程碑(任务, "甲");
    任务 = 加里程碑(任务, "乙");
    任务 = 加里程碑(任务, "丙");
    任务 = 设分段(任务, 3, 8);

    任务 = 跑一段(任务, 配置, "");
    断言(已完成数(任务.目标值) == 1, "第一段推进了一个里程碑（实得 "
        + 已完成数(任务.目标值) + "）");
    断言(字符串::查找(任务.上段笔记, "第 1 段") >= 0,
        "笔记是模型给的那句，不是原文兜底（[" + 任务.上段笔记 + "]）");

    任务 = 一直跑(任务, 配置, "");
    IO.打印行("  " + 任务进度(任务));
    断言(已完成数(任务.目标值) == 3, "三个里程碑全推完（实得 "
        + 已完成数(任务.目标值) + "）");
    断言(是否达成(任务.目标值) == 1, "目标判定为达成");
    断言(任务.结局 == "完成", "结局是完成，不是超限（实得 " + 任务.结局 + "）");
    断言(任务.段号 == 3, "只用了 3 段，没白跑（实得 " + 任务.段号 + "）");

    // 落盘的也是完成态
    变量 捞: 长任务 = 续长任务(库, "推进");
    断言(捞.结局 == "完成", "完成态落了盘");
    断言(已完成数(捞.目标值) == 3, "里程碑完成情况也落了盘");

    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

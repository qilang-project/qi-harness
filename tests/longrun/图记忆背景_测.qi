// 图记忆当长时程的跨段知识源。
//
// 长时程本身**不依赖 qi-graph** —— 召回在调用处做，把结果作为 背景知识 传进去。
// 这个测试钉住那条接法，并且确认多跳召回真的把二度事实带出来了（1 跳只给
// 直接邻居，「作者住哪」这种要 2 跳，实测过 1 跳时模型只能回答「未知」）。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 记实体, 关联, 图回忆};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 设分段, 加里程碑, 段提示
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    IO.删除文件("/tmp/图记忆背景测.kv");
    变量 图库: 整数 = 打开图记忆("/tmp/图记忆背景测.kv");
    断言(图库 > 0, "开得了图库");

    记实体(图库, "语料.txt", "文件");
    记实体(图库, "小奇", "人");
    记实体(图库, "成都", "城市");
    关联(图库, "语料.txt", "作者是", "小奇");
    关联(图库, "小奇", "住在", "成都");

    变量 一跳: 字符串 = 图回忆(图库, "语料.txt", 1, 6);
    变量 两跳: 字符串 = 图回忆(图库, "语料.txt", 2, 6);
    断言(字符串::查找(一跳, "小奇") >= 0, "1 跳带出直接邻居");
    断言(字符串::查找(一跳, "成都") < 0, "1 跳带不出二度事实（这就是要多跳的原因）");
    断言(字符串::查找(两跳, "成都") >= 0, "2 跳带出二度事实");

    IO.删除文件("/tmp/图记忆背景测.db");
    变量 库: 整数 = 打开长任务库("/tmp/图记忆背景测.db");
    变量 任务: 长任务 = 开长任务(库, "接法验", "验召回结果能进段提示");
    任务 = 加里程碑(任务, "写出处");
    任务 = 设分段(任务, 8, 3);

    变量 没背景: 字符串 = 段提示(任务, "");
    变量 有背景: 字符串 = 段提示(任务, 两跳);
    断言(字符串::查找(没背景, "成都") < 0, "不给背景时提示里没有这些事实");
    断言(字符串::查找(有背景, "成都") >= 0, "给了背景就拼进段提示（这就是全部接法）");
    断言(字符串::查找(有背景, "已知事实") >= 0, "带标题，模型能分清这是给定事实");

    关闭长任务库(库);
    关闭图记忆(图库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

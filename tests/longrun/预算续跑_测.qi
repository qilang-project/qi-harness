// 预算跨进程接得回来。
//
// 预算表是进程级的（预算.qi 用列表存），所以「整个长任务最多烧 N 令牌」
// 这句话原来每重启一次就重新算一遍 —— 一个卡住的长任务只要反复续跑，
// 能花掉任意多钱，上限形同虚设。现在每段把累计已用落库，挂预算 时补回去。
//
// 这里用同一个进程模拟两次续跑：创建预算 每次都给一个**全新的空账本**，
// 跟新进程里的情形一样。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.预算::{创建预算, 已用令牌, 超预算};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 续长任务,
    设分段, 加里程碑, 挂预算, 跑一段
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) { IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过"); 返回; }
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    IO.删除文件("/tmp/预算续跑测.db");
    变量 库: 整数 = 打开长任务库("/tmp/预算续跑测.db");

    // ── 第一"进程"：跑一段，花掉一点 ──
    变量 甲预算: 整数 = 创建预算(1000000, 0);
    变量 任务: 长任务 = 开长任务(库, "烧钱", "验预算跨进程接得回来");
    任务 = 加里程碑(任务, "随便");
    任务 = 设分段(任务, 2, 9);
    任务 = 挂预算(任务, 甲预算);
    任务 = 跑一段(任务, 配置, "");

    变量 一段花: 整数 = 已用令牌(甲预算);
    断言(一段花 > 0, "第一段确实花了令牌（实得 " + 一段花 + "）");
    断言(任务.已用令牌累计 == 一段花, "花销记在任务上（实得 " + 任务.已用令牌累计 + "）");

    变量 捞: 长任务 = 续长任务(库, "烧钱");
    断言(捞.已用令牌累计 == 一段花, "花销落了盘（实得 " + 捞.已用令牌累计 + "）");

    // ── 第二"进程"：全新空账本，挂上去就该带着旧账 ──
    变量 乙预算: 整数 = 创建预算(1000000, 0);
    断言(已用令牌(乙预算) == 0, "新账本是空的");
    捞 = 挂预算(捞, 乙预算);
    断言(已用令牌(乙预算) == 一段花,
        "挂上去就补回了上次花的（实得 " + 已用令牌(乙预算) + "，应为 " + 一段花 + "）");

    // 重复挂不该重复扣
    捞 = 挂预算(捞, 乙预算);
    断言(已用令牌(乙预算) == 一段花,
        "重复 挂预算 不重复扣（实得 " + 已用令牌(乙预算) + "）");

    // ── 上限真的因此生效：给一个只够第一段的小预算，续跑立刻收场 ──
    变量 丙预算: 整数 = 创建预算(一段花, 0);
    变量 捞2: 长任务 = 续长任务(库, "烧钱");
    捞2 = 挂预算(捞2, 丙预算);
    断言(超预算(丙预算) == 1, "补回旧账之后就已经超了 —— 上限是对整个长任务说的");
    变量 段号前: 整数 = 捞2.段号;
    捞2 = 跑一段(捞2, 配置, "");
    断言(捞2.段号 == 段号前, "超预算就不再开新段（段号仍 " + 捞2.段号 + "）");
    断言(捞2.结局 == "超预算", "结局记成超预算（实得 " + 捞2.结局 + "）");

    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

// 里程碑验收：模型说完成，检查不过就不认。
//
// 这是长时程最大的软肋。真模型（cpa gemini-3.8）现场表演过：第 2 段被工具
// 步数上限腰斩，工作区里一个文件都没有，收尾那一问照样回「完成: [0, 1]，
// 结局: 完成」，任务就这么"成功"结束了。挂上检查式之后同样的回答会被驳回。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.目标监控::{已完成数};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 设分段,
    加里程碑, 加里程碑带检查, 用文件沙箱, 跑一段
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) { IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过"); 返回; }
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    变量 根: 字符串 = "/tmp/验收测沙箱";
    IO.创建目录(根);
    IO.删除文件(根 + "/成果.md");
    IO.删除文件("/tmp/验收测.db");

    变量 库: 整数 = 打开长任务库("/tmp/验收测.db");
    变量 任务: 长任务 = 开长任务(库, "验收", "验模型的自述要过一遍确定性检查");
    任务 = 加里程碑带检查(任务, "写出 成果.md", "文件存在:成果.md");
    任务 = 设分段(任务, 2, 6);
    任务 = 用文件沙箱(任务, 根, 1);

    // ── 文件不存在时：模型说完成也不认 ──
    任务 = 跑一段(任务, 配置, "");
    断言(已完成数(任务.目标值) == 0,
        "文件没写出来，模型说完成也不算（实得 " + 已完成数(任务.目标值) + "）");
    断言(字符串::查找(任务.上段笔记, "没通过验收") >= 0,
        "驳回写进了笔记，下一段能看见（[" + 任务.上段笔记 + "]）");
    断言(任务.结局 == "进行中",
        "也不许就这么收场（实得 " + 任务.结局 + "）");

    // ── 文件真的在了：同样的回答就认 ──
    IO.写入文件(根 + "/成果.md", "有了");
    任务 = 跑一段(任务, 配置, "");
    断言(已完成数(任务.目标值) == 1,
        "文件在了就认（实得 " + 已完成数(任务.目标值) + "）");
    断言(任务.结局 == "完成", "里程碑全达成才准收场（实得 " + 任务.结局 + "）");

    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

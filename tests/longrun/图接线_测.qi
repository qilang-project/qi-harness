// 知识图当长任务的跨段知识源 —— 读写闭环，一整圈都在这里钉住。
//
// 跟 图记忆背景_测.qi 的区别：那条测的是**手工接法**（自己 图回忆，结果当
// 背景知识传进 段提示）。这条测的是长时程内建的那条线：用图记忆 之后，
//   1. 每段自动把跟这个任务相关的事实拼进提示（读）
//   2. 模型用 记事实 写进去的东西挂在任务节点下（写）
//   3. 于是第 2 段的提示里出现第 1 段写的事实（闭环）
// 第 3 条是重点。前两条各自绿而闭环断掉是完全可能的 —— 模型记的事实要是没
// 挂锚点，它跟任务子图就是两个连通分量，按任务名召回一条都捞不着。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 图回忆, 怎么连的, 用图记忆};
导入 Harness.长时程::{
    长任务, 打开长任务库, 关闭长任务库, 开长任务, 续长任务,
    设分段, 加里程碑, 一直跑
};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    如果 (字符串::字节长度(端点) == 0) { IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过"); 返回; }
    变量 提示存档: 字符串 = 系统.获取环境变量("PROMPT_DUMP");
    变量 配置: 模型配置 = 大模型(端点, "k", "fixture-model");

    变量 库路径: 字符串 = "/tmp/图接线测.db";
    变量 图路径: 字符串 = "/tmp/图接线测.kv";
    IO.删除文件(库路径);
    IO.删除文件(图路径);

    变量 库: 整数 = 打开长任务库(库路径);
    变量 任务: 长任务 = 开长任务(库, "接线验", "验图记忆真的接进了分段循环");
    任务 = 加里程碑(任务, "查清登录方式");
    任务 = 加里程碑(任务, "写出来");
    任务 = 设分段(任务, 4, 4);
    任务 = 用图记忆(任务, 图路径, 1);

    断言(任务.图库路径 == 图路径, "图库路径记在任务上");
    断言(任务.图工具开 == 1, "图工具开关记在任务上");
    变量 捞: 长任务 = 续长任务(库, "接线验");
    断言(捞.图库路径 == 图路径, "图库路径落了盘（续跑时不用重接）");
    断言(捞.图工具开 == 1, "图工具开关也落了盘");

    任务 = 一直跑(任务, 配置, "");
    断言(任务.结局 == "完成", "两段跑完（实得 " + 任务.结局 + "）");

    // ── 写：模型的 记事实 真的落进了图 ──
    变量 图: 整数 = 打开图记忆(图路径);
    变量 事实: 字符串 = 图回忆(图, "登录接口", 1, 9);
    断言(字符串::查找(事实, "X-Token") >= 0,
        "模型 记事实 写的那条在图里（实得 [" + 事实 + "]）");

    // ── 锚：事实挂在任务节点下，不是孤岛 ──
    变量 路径: 字符串 = 怎么连的(图, "接线验", "X-Token");
    断言(字符串::字节长度(路径) > 0,
        "任务名到事实之间有路径 —— 没有的话下一段召回捞不着它");

    变量 按任务召回: 字符串 = 图回忆(图, "接线验", 9);
    断言(字符串::查找(按任务召回, "登录接口") >= 0,
        "按任务名（默认 2 跳）就能召回模型写的事实");
    断言(字符串::查找(按任务召回, "查清登录方式") >= 0,
        "里程碑也被种进图，任务子图有锚点");

    // ── 读：第 2 段的提示里真的出现了第 1 段写进去的事实 ──
    如果 (字符串::字节长度(提示存档) > 0) {
        变量 全文: 字符串 = IO.读取文件(提示存档);
        变量 边界: 整数 = 字符串::查找(全文, "===段边界===");
        断言(边界 >= 0, "存档里至少有两段提示");
        如果 (边界 >= 0) {
            变量 第一段: 字符串 = 字符串::子串(全文, 0, 边界);
            变量 第二段: 字符串 = 字符串::子串(全文, 边界, 字符串::字节长度(全文) - 边界);
            断言(字符串::查找(第一段, "X-Token") < 0,
                "第 1 段的提示里还没有这条事实（那时还没写）");
            断言(字符串::查找(第二段, "X-Token") >= 0,
                "第 2 段的提示里有了 —— 闭环成立");
            断言(字符串::查找(第二段, "已知事实") >= 0,
                "而且是挂在「已知事实」标题下进去的");
        }
    } 否则 {
        IO.打印行("  （没给 PROMPT_DUMP，跳过注入断言）");
    }

    关闭图记忆(图);
    关闭长任务库(库);
    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

// 问答管线_测 —— 14.5 意图 → 14.6 模式 → 14.7 生成查询 → **真的查出答案**
//
// 前面那些测试各自只验一段。这一条把整条链串起来跑完，落点是最后一步：
// 模型照着模式文本里教的语法写出来的那条查询，**拿去查真图能查出正确答案**。
// 中间任何一环讲错了（模式描述不准、教的语法库不认、字段顺序反了），
// 最后这一步都会露馅。
//
// 数据是 monorepo 真实的包依赖图（对着各仓 qi.toml：Harness→Web/Graph、Graph→KV）。
// 问题是「谁依赖 KV？」，正确答案只有 Graph 一个 —— 这个答案不是模型给的，
// 是查询在真图上跑出来的。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.JSON 作为 J;
导入 标准库.操作系统 作为 系统;
导入 Harness.模型::{模型配置, 大模型};
导入 Harness.意图::{意图分类器, 展示型分类器, 问题种类分类器, 识别意图, 多级识别};
导入 Harness.文本转查询::{查询提示, 图语句提示, 用模式, 用意图, 组装提示,
                        生成查询, 取查询, 取推理};
导入 Graph::{打开图, 关闭图, 加节点, 加边, 图模式文本, 查, 查数};

变量 库路径: 字符串 = "/tmp/qi_harness_问答管线_测.kv";

函数 建依赖图() : 整数 {
    如果 (IO.文件存在(库路径) == 1) {
        IO.删除文件(库路径);
    }
    变量 图: 整数 = 打开图(库路径);
    加节点(图, "Harness", "[\"包\"]", "{\"版本\":\"0.4.0\",\"下载数\":120}");
    加节点(图, "Web", "[\"包\"]", "{\"版本\":\"0.2.0\",\"下载数\":340}");
    加节点(图, "Graph", "[\"包\"]", "{\"版本\":\"0.1.1\",\"下载数\":15}");
    加节点(图, "KV", "[\"包\"]", "{\"版本\":\"0.1.1\",\"下载数\":22}");
    加节点(图, "CLI", "[\"包\"]", "{\"版本\":\"2026.424.1\",\"下载数\":500}");
    加边(图, "", "依赖", "Harness", "Web", "{}");
    加边(图, "", "依赖", "Harness", "Graph", "{}");
    加边(图, "", "依赖", "Graph", "KV", "{}");
    加边(图, "", "开发依赖", "Harness", "CLI", "{}");
    返回 图;
}

函数 配置() : 模型配置 {
    返回 大模型(系统.获取环境变量("FAKE_LLM_ENDPOINT"), "k", "fixture-model");
}

函数 测_意图先行() : 整数 {
    变量 回: 字符串 = 识别意图(展示型分类器(), "谁依赖 KV？", 配置());
    变量 对象: 整数 = J.解码(回);
    断言为真(对象 > 0, "分类结果是合法 JSON");
    断言相等(J.获取字符串(对象, "类别"), "表格", "分成了表格");
    断言为真(字符串::字节长度(J.获取字符串(对象, "理由")) > 0, "带了理由（用来诊断误判）");
    J.删除(对象);

    // 两级分类：系统相关 要给出子类别
    变量 二: 字符串 = 识别意图(问题种类分类器(), "能把数据导出成 CSV 吗？", 配置());
    变量 对象2: 整数 = J.解码(二);
    断言相等(J.获取字符串(对象2, "类别"), "系统相关", "认出是系统问题");
    断言相等(J.获取字符串(对象2, "子类别"), "文档相关", "给出了子类别");
    J.删除(对象2);
    返回 1;
}

// 整条链
函数 测_端到端() : 整数 {
    变量 图: 整数 = 建依赖图();
    变量 问题: 字符串 = "谁依赖 KV？";

    // ① 意图
    变量 意图JSON: 字符串 = 识别意图(展示型分类器(), 问题, 配置());
    变量 意图对象: 整数 = J.解码(意图JSON);
    变量 意图名: 字符串 = J.获取字符串(意图对象, "类别");
    J.删除(意图对象);
    断言相等(意图名, "表格", "第一步：意图是表格");

    // ② 模式（qi-graph 出，qi-harness 只当字符串收）
    变量 模式: 字符串 = 图模式文本(图);
    断言包含(模式, "(:包 {", "模式里有 包 这个类");
    断言包含(模式, "-[:依赖", "模式里有 依赖 这种边");
    断言包含(模式, "匹配 ", "模式里教了怎么查");

    // ③ 组装八段提示 + 生成查询
    变量 p: 查询提示 = 图语句提示();
    p = 用模式(p, 模式);
    p = 用意图(p, 意图名, "结果要能列成表，用 返回 只留必要的变量。");
    变量 结果: 字符串 = 生成查询(p, 问题, 配置());
    变量 查询语句: 字符串 = 取查询(结果);
    断言为真(字符串::字节长度(取推理(结果)) > 0, "模型先写了推理再给查询");
    断言包含(查询语句, "匹配 ", "生成的是图语句，不是 Cypher");
    断言不含(查询语句, "MATCH ", "确实不是 Cypher");

    // ④ 拿生成的查询去查**真图** —— 整条链的落点
    变量 答: 字符串 = 查(图, 查询语句);
    断言相等整数(查数(图, 查询语句), 1, "查出来正好一个包依赖 KV");
    断言包含(答, "Graph", "那个包是 Graph（对着 qi.toml 能核）");
    断言不含(答, "Harness", "Harness 依赖的是 Web 和 Graph，不是 KV");

    关闭图(图);
    返回 1;
}

// 生成的提示词里，模式那一段必须真的进去了 —— 不然模型是在凭空猜类名
函数 测_模式确实进了提示() : 整数 {
    变量 图: 整数 = 建依赖图();
    变量 p: 查询提示 = 图语句提示();
    p = 用模式(p, 图模式文本(图));
    变量 提示: 字符串 = 组装提示(p, "谁依赖 KV？");

    断言包含(提示, "### 节点类", "模式的小标题在");
    断言包含(提示, "版本: STRING", "具体属性和类型都在");
    断言包含(提示, "下载数: INTEGER", "整数属性类型也在");
    断言包含(提示, "### 再说一遍：要回答的问题", "长模式之后又提了一遍问题");
    断言包含(提示, "### 输出格式", "输出格式在最后");
    关闭图(图);
    返回 1;
}

函数 入口() {
    如果 (字符串::字节长度(系统.获取环境变量("FAKE_LLM_ENDPOINT")) == 0) {
        IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过");
        返回;
    }
    运行用例("意图先行", 测_意图先行);
    运行用例("端到端：意图→模式→查询→真答案", 测_端到端);
    运行用例("模式确实进了提示词", 测_模式确实进了提示);
    摘要并退出();
}

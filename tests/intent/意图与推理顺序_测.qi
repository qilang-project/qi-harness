// 意图与推理顺序_测 —— 提示词怎么拼、字段怎么排（纯组装，不需要模型）
//
// 对应书里 14.5（意图识别）与 14.7（推理顺序 + 八段结构）。
// 这一套断言的是**提示词里该有的东西一样不缺**：书里列的六条分类提示词要求、
// 八段查询提示词结构、以及最要紧的那件事 —— 字段顺序。

包 主程序;

导入 测试::{运行用例, 摘要并退出, 断言相等, 断言相等整数, 断言为真, 断言包含, 断言不含};
导入 标准库.列表 作为 表列;
导入 标准库.字符串;
导入 Harness.意图::{意图分类器, 创建分类器, 加类别, 加子类别, 加示例, 加子类示例,
                   加边界示例, 设兜底, 分类提示, 分类字段, 分类字段带子类别,
                   在类别名单里, 展示型分类器, 问题种类分类器};
导入 Harness.文本转查询::{查询提示, 创建查询提示, 用模式, 用意图, 加查询示例, 加图注记,
                        设用户选择, 记上次失败, 组装提示, 查询字段,
                        推理在前, 答案在前, 按顺序排字段, 是推理在前, 图语句提示};

// ── 14.5：分类提示词的六条要求 ──
函数 测_分类提示六条要求() : 整数 {
    变量 c: 意图分类器 = 展示型分类器();
    变量 提示: 字符串 = 分类提示(c, "上个月各辖区的报案量");

    // 1 任务说明在最前面
    断言为真(字符串开头是(提示, "下面是一个用户问题"), "任务说明打头");
    // 2 每个类别都有定义
    断言包含(提示, "**关系图**：", "关系图 有定义");
    断言包含(提示, "**表格**：", "表格 有定义");
    断言包含(提示, "**图表**：", "图表 有定义");
    断言包含(提示, "**地图**：", "地图 有定义");
    // 3 有例子
    断言包含(提示, "## 例子", "有例子小节");
    断言包含(提示, "按辖区统计各类犯罪的数量", "例子里有具体问题");
    // 4 有边界例子，并且**标注出来**
    断言包含(提示, "涉及人口贩运的有组织犯罪类型", "带了边界例子");
    断言包含(提示, "卡在两类之间", "边界例子被标注了");
    // 5 有兜底，并说明什么时候用
    断言包含(提示, "（兜底）", "有兜底类别");
    断言包含(提示, "不要硬套", "说明了兜底的用法");
    // 6 输出里要有理由字段（例子里就示范了）
    断言包含(提示, "\"理由\"", "例子的输出带 理由 字段");
    // 待分类的问题在最后
    断言包含(提示, "## 待分类", "有待分类小节");
    断言包含(提示, "上个月各辖区的报案量", "问题进去了");
    返回 1;
}

函数 字符串开头是(s: 字符串, 前缀: 字符串) : 整数 {
    返回 字符串::开始于(s, 前缀);
}

函数 测_两级分类() : 整数 {
    变量 c: 意图分类器 = 问题种类分类器();
    变量 提示: 字符串 = 分类提示(c, "能导出 CSV 吗？");
    断言包含(提示, "**系统相关**：", "主类别在");
    断言包含(提示, "子类别 **文档相关**：", "子类别缩进列出来了");
    断言包含(提示, "子类别 **模式相关**：", "另一个子类别也在");
    断言包含(提示, "必须**再给出子类别", "点明了归到这一类要给子类别");
    // 子类别 是必填字段，可它只对「系统相关」有意义。不告诉模型其余情况填什么，
    // 它会填 null，结构化校验不过 —— 每个「数据相关」的问题白白多打一轮。
    // （真跑 cpa gemini 时事件流里看得清清楚楚：第 1 次校验失败 → 重来一次。）
    断言包含(提示, "子类别 一栏填 `无`", "说清了没有子类别时填什么");
    // 没有子类别的分类器不该出现这句废话
    断言不含(分类提示(展示型分类器(), "谁依赖 KV？"), "子类别 一栏填",
        "不分子类别的分类器不提子类别");
    // 书里点名的那个小模型误判案例，作为边界例子在
    断言包含(提示, "知识图谱多久更新一次", "带了书里那个著名误判例子");

    // 有子类别时字段表要多一个 子类别
    变量 f1: 整数 = 分类字段();
    变量 f2: 整数 = 分类字段带子类别();
    断言相等整数(表列::字符串列表大小(f1), 2, "无子类别时两个字段");
    断言相等整数(表列::字符串列表大小(f2), 3, "有子类别时三个字段");
    表列::删除列表(f1);
    表列::删除列表(f2);
    返回 1;
}

// ── 14.7.1：字段顺序就是思考顺序 ──
函数 测_推理顺序() : 整数 {
    // 生成类任务：推理排在答案前面
    变量 生成: 整数 = 按顺序排字段(推理在前(), "推理", "答案");
    断言相等(表列::获取字符串(生成, 0), "推理", "推理在前时第一个是推理");
    断言相等(表列::获取字符串(生成, 1), "答案", "答案在后");
    断言相等整数(是推理在前(生成, "推理", "答案"), 1, "检查器认得出来");
    表列::删除列表(生成);

    // 分类任务：答案在前，理由在后（书里说这是分类的例外）
    变量 分类: 整数 = 按顺序排字段(答案在前(), "理由", "类别");
    断言相等(表列::获取字符串(分类, 0), "类别", "答案在前时第一个是答案");
    断言相等整数(是推理在前(分类, "理由", "类别"), 0, "检查器认得出这是答案在前");
    表列::删除列表(分类);

    // 真正的分类器就该是「答案在前」—— 这一条钉住 意图.qi 的选择不是笔误
    变量 c字段: 整数 = 分类字段();
    断言相等(表列::获取字符串(c字段, 0), "类别", "分类器把类别排在前");
    断言相等整数(是推理在前(c字段, "理由", "类别"), 0, "分类是答案在前（有意为之）");
    表列::删除列表(c字段);

    // 文本转查询就该是「推理在前」：关系 → 推理 → 查询
    变量 q字段: 整数 = 查询字段();
    断言相等整数(表列::字符串列表大小(q字段), 3, "三个字段");
    断言相等(表列::获取字符串(q字段, 0), "关系", "先列关系，堵住编造关系");
    断言相等(表列::获取字符串(q字段, 1), "推理", "再写推理，给它时间想");
    断言相等(表列::获取字符串(q字段, 2), "查询", "最后才落查询");
    断言相等整数(是推理在前(q字段, "推理", "查询"), 1, "生成任务是推理在前");
    表列::删除列表(q字段);
    返回 1;
}

// ── 14.7.2：八段结构 ──
函数 测_八段结构() : 整数 {
    变量 p: 查询提示 = 创建查询提示("把问题翻译成图查询。");
    p = 用模式(p, "## 图模式\n### 节点类\n(:包 {版本: STRING})\n");
    p = 用意图(p, "表格", "结果要能排序，用 返回 只留必要的变量。");
    p = 加查询示例(p, "谁依赖 KV？", "[\"依赖\"]", "KV 在箭头右边。",
        "匹配 (?p:包)-[:依赖]->(KV) 返回 ?p");
    p = 设用户选择(p, "只看 0.1.x 的包");
    p = 加图注记(p, "边的方向是依赖方 → 被依赖方");
    变量 文: 字符串 = 组装提示(p, "谁依赖 Graph？");

    断言包含(文, "把问题翻译成图查询。", "1 任务说明");
    断言包含(文, "## 图模式", "2 图模式");
    断言包含(文, "### 这次要什么", "3 意图相关的要求");
    断言包含(文, "用户想要的呈现形式：表格", "意图写进去了");
    断言包含(文, "### 例子", "4 例子");
    断言包含(文, "### 用户已经选定的", "5 用户选择");
    断言包含(文, "### 这张图要注意的", "6 图特有注记");
    断言包含(文, "### 再说一遍：要回答的问题", "7 再说一遍问题");
    断言包含(文, "### 输出格式", "8 输出格式");

    // 问题出现两次：开头一次、结尾一次（模式那段太长，得让它贴着答案）
    断言相等整数(出现次数(文, "谁依赖 Graph？"), 2, "问题在头尾各出现一次");

    // 例子必须按输出格式给全三个字段（14.7.3 example consistency）
    断言包含(文, "{\"关系\": [\"依赖\"], \"推理\": ", "例子带 关系 和 推理");
    断言包含(文, "\"查询\": \"匹配 (?p:包)-[:依赖]->(KV) 返回 ?p\"", "例子带 查询");

    // 输出格式那段要把顺序说死
    断言包含(文, "**按这个顺序写**", "点明顺序要求");

    // 可选段没给就不该出现
    变量 素: 查询提示 = 创建查询提示("任务");
    变量 素文: 字符串 = 组装提示(素, "问题");
    断言不含(素文, "### 用户已经选定的", "没给用户选择就不出这一段");
    断言不含(素文, "### 这张图要注意的", "没给注记就不出这一段");
    断言包含(素文, "### 输出格式", "但输出格式永远都在");
    返回 1;
}

函数 测_重试带上次错误() : 整数 {
    变量 p: 查询提示 = 创建查询提示("把问题翻译成图查询。");
    变量 一次: 字符串 = 组装提示(p, "谁依赖 KV？");
    断言不含(一次, "上一次你给的查询跑挂了", "第一次不该有失败信息");

    p = 记上次失败(p, "匹配 (?p:模块)-[:依赖]->(KV)", "没有 模块 这个标签");
    变量 二次: 字符串 = 组装提示(p, "谁依赖 KV？");
    断言包含(二次, "上一次你给的查询跑挂了", "重试时带上上次的查询");
    断言包含(二次, "没有 模块 这个标签", "把数据库的报错也带上");
    返回 1;
}

函数 测_现成的图语句提示() : 整数 {
    变量 p: 查询提示 = 图语句提示();
    变量 文: 字符串 = 组装提示(p, "谁依赖 KV？");
    // 例子用的是 qi-graph 图语句 的语法，不是 Cypher
    断言包含(文, "匹配 (?p:包)-[:依赖]->(KV) 返回 ?p", "例子是图语句语法");
    断言不含(文, "MATCH (", "不该出现 Cypher");
    断言包含(文, "依赖方 → 被依赖方", "带了方向注记");
    断言包含(文, "扫全库", "带了性能注记");
    返回 1;
}

// 数不重叠的出现次数。往后跳**一整个子串长度**，不是跳一个字节 ——
// 跳一个字节会落在多字节字符中间。（runtime 现在会把起点收缩到字符边界不再 abort，
// 但那样数出来是重叠计数，语义也不对。）
函数 出现次数(文: 字符串, 子: 字符串) : 整数 {
    变量 步: 整数 = 字符串::字节长度(子);
    如果 (步 <= 0) { 返回 0; }
    变量 数: 整数 = 0;
    变量 从: 整数 = 0;
    当 (从 < 字符串::字节长度(文)) {
        变量 位: 整数 = 字符串::查找从位置(文, 子, 从);
        如果 (位 < 0) { 跳出; }
        数 = 数 + 1;
        从 = 位 + 步;
    }
    返回 数;
}

函数 测_类别名单校验() : 整数 {
    变量 c: 意图分类器 = 展示型分类器();
    断言相等整数(在类别名单里(c, "表格"), 1, "认得已定义的类别");
    断言相等整数(在类别名单里(c, "关系图"), 1, "兜底类别也算在名单里");
    断言相等整数(在类别名单里(c, "三维全息投影"), 0, "没定义的类别不认");
    返回 1;
}

函数 入口() {
    运行用例("分类提示词的六条要求", 测_分类提示六条要求);
    运行用例("两级分类", 测_两级分类);
    运行用例("推理顺序 = 字段顺序", 测_推理顺序);
    运行用例("八段结构", 测_八段结构);
    运行用例("重试时带上次错误", 测_重试带上次错误);
    运行用例("现成的图语句提示", 测_现成的图语句提示);
    运行用例("类别名单校验", 测_类别名单校验);
    摘要并退出();
}

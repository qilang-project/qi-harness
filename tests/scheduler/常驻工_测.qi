// 常驻工自测：出口去重、扇出、工循环、停工、事件桥
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 标准库.列表 作为 列表库;
导入 标准库.JSON 作为 J;
导入 Harness.常驻工::{推送, 创建推送, 推送带级别, 推送转JSON,
    创建出口, 挂接收者, 接收者数, 送, 出口统计JSON, 忘掉指纹,
    工规格, 按间隔, 按排期, 工规格最多轮, 工规格首轮立即, 工规格滴答,
    起工, 起工后台, 停工, 工下次触发, 工规格说明, 架事件桥, 拆掉全部桥};
导入 Harness.事件::{发出生命周期事件, 清空生命周期订阅者};

变量 通过: 整数 = 0;
变量 失败: 整数 = 0;
变量 收到甲: 整数 = 0;
变量 收到乙: 整数 = 0;
变量 末条: 字符串 = "";

函数 断言(名: 字符串, 实得: 整数, 应为: 整数) {
    如果 (实得 == 应为) {
        通过 = 通过 + 1;
    } 否则 {
        失败 = 失败 + 1;
        IO.打印行("FAIL " + 名 + "：实得 " + 整数转字符串(实得)
            + "，应为 " + 整数转字符串(应为));
    }
}

函数 取统计(出口: 整数, 键: 字符串) : 整数 {
    变量 根: 整数 = J.解码(出口统计JSON(出口));
    变量 v: 整数 = J.获取整数(根, 键);
    J.删除(根);
    返回 v;
}

函数 测出口() {
    IO.打印行("── 出口：扇出与去重 ──");
    变量 出: 整数 = 创建出口(60);        // 静默期 60 秒
    断言("初始没有接收者", 接收者数(出), 0);

    挂接收者(出, 闭包(消息: 字符串): 整数 {
        收到甲 = 收到甲 + 1;
        末条 = 消息;
        返回 1;
    });
    挂接收者(出, 闭包(消息: 字符串): 整数 {
        收到乙 = 收到乙 + 1;
        返回 1;
    });
    断言("挂了两个", 接收者数(出), 2);

    // 第一条：应送出，两个接收者都收到
    断言("首条送出", 送(出, 创建推送("指纹A", "标题A", "正文A")), 1);
    断言("甲收到1", 收到甲, 1);
    断言("乙收到1", 收到乙, 1);

    // 同指纹立刻再来：静默期内应被挡
    断言("同指纹被挡", 送(出, 创建推送("指纹A", "标题A再来", "正文")), 0);
    断言("甲还是1", 收到甲, 1);

    // 换指纹：应送出
    断言("换指纹送出", 送(出, 创建推送("指纹B", "标题B", "正文B")), 1);
    断言("甲变2", 收到甲, 2);

    断言("统计-送出2", 取统计(出, "送出"), 2);
    断言("统计-挡下1", 取统计(出, "挡下"), 1);
    断言("统计-在册指纹2", 取统计(出, "在册指纹"), 2);

    // 忘掉指纹后同一条应该能再送
    断言("忘掉2个指纹", 忘掉指纹(出), 2);
    断言("忘掉后能再送", 送(出, 创建推送("指纹A", "标题A", "正文A")), 1);

    // 静默期 0 = 不去重
    变量 不去重: 整数 = 创建出口(0);
    挂接收者(不去重, 闭包(消息: 字符串): 整数 { 返回 1; });
    断言("不去重-第一条", 送(不去重, 创建推送("同一个", "x", "y")), 1);
    断言("不去重-第二条", 送(不去重, 创建推送("同一个", "x", "y")), 1);

    // 空指纹不参与去重
    变量 空纹: 整数 = 创建出口(60);
    挂接收者(空纹, 闭包(消息: 字符串): 整数 { 返回 1; });
    断言("空指纹-1", 送(空纹, 创建推送("", "x", "y")), 1);
    断言("空指纹-2", 送(空纹, 创建推送("", "x", "y")), 1);

    // 无效出口句柄
    断言("无效出口送不出去", 送(999, 创建推送("z", "z", "z")), 0);
    断言("无效出口接收者数0", 接收者数(999), 0);
}

函数 测推送JSON() {
    IO.打印行("── 推送 JSON ──");
    变量 推: 推送 = 推送带级别(创建推送("f1", "标题", "正文"), "警报");
    变量 根: 整数 = J.解码(推送转JSON(推));
    断言("指纹对", 串等(J.获取字符串(根, "指纹"), "f1"), 1);
    断言("标题对", 串等(J.获取字符串(根, "标题"), "标题"), 1);
    断言("级别对", 串等(J.获取字符串(根, "级别"), "警报"), 1);
    断言("有时间戳", 正数(J.获取整数(根, "时间戳毫秒")), 1);
    J.删除(根);
}

函数 串等(a: 字符串, b: 字符串) : 整数 {
    如果 (a == b) { 返回 1; }
    返回 0;
}

函数 正数(x: 整数) : 整数 {
    如果 (x > 0) { 返回 1; }
    返回 0;
}

变量 工跑了: 整数 = 0;

函数 测工循环() {
    IO.打印行("── 工循环（间隔模式）──");
    变量 出: 整数 = 创建出口(0);

    // 滴答 1 秒、间隔 1 秒、最多 3 轮 —— 阻塞版，跑完就返回
    变量 规: 工规格 = 工规格最多轮(按间隔("测甲", 1), 3);
    变量 轮数: 整数 = 起工(规, 出, 闭包(轮次: 整数, 时刻: 整数): 整数 {
        工跑了 = 工跑了 + 1;
        返回 1;
    });
    断言("跑满3轮", 轮数, 3);
    断言("闭包也被调3次", 工跑了, 3);

    // 首轮立即
    工跑了 = 0;
    变量 规2: 工规格 = 工规格首轮立即(工规格最多轮(按间隔("测乙", 1), 2), 1);
    起工(规2, 出, 闭包(轮次: 整数, 时刻: 整数): 整数 {
        工跑了 = 工跑了 + 1;
        返回 1;
    });
    断言("首轮立即共2轮", 工跑了, 2);

    // 闭包返 0 让工自己收工
    工跑了 = 0;
    变量 规3: 工规格 = 工规格最多轮(按间隔("测丙", 1), 10);
    变量 轮3: 整数 = 起工(规3, 出, 闭包(轮次: 整数, 时刻: 整数): 整数 {
        工跑了 = 工跑了 + 1;
        如果 (轮次 >= 2) { 返回 0; }
        返回 1;
    });
    断言("自己收工在第2轮", 轮3, 2);
}

变量 后台跑了: 整数 = 0;

函数 测停工() {
    IO.打印行("── 后台工与停工 ──");
    变量 出: 整数 = 创建出口(0);
    变量 规: 工规格 = 按间隔("后台工", 1);
    断言("后台工启动", 起工后台(规, 出, 闭包(轮次: 整数, 时刻: 整数): 整数 {
        后台跑了 = 后台跑了 + 1;
        返回 1;
    }), 1);

    时间.睡眠毫秒(2500);
    变量 停前: 整数 = 后台跑了;
    断言("后台确实在跑", 正数(停前), 1);

    断言("停工找到了它", 停工("后台工"), 1);
    时间.睡眠毫秒(2500);
    断言("停工后不再增长", 后台跑了, 停前);

    断言("停不存在的工返回0", 停工("查无此工"), 0);
}

函数 测排期工() {
    IO.打印行("── 排期模式 ──");
    变量 出: 整数 = 创建出口(0);

    // 排期写错必须拒绝启动，不能退化成每分钟一次
    变量 坏规: 工规格 = 按排期("坏排期工", "这不是cron");
    断言("坏排期-后台拒启动", 起工后台(坏规, 出, 闭包(a: 整数, b: 整数): 整数 { 返回 1; }), 0);
    断言("坏排期-阻塞版返回-1", 起工(坏规, 出, 闭包(a: 整数, b: 整数): 整数 { 返回 1; }), -1);

    // 下次触发
    变量 好规: 工规格 = 按排期("九点工", "0 9 * * *");
    变量 下: 整数 = 工下次触发(好规, 时间.现在());
    断言("下次触发在未来", 大于(下, 时间.现在()), 1);
    断言("间隔模式没有下次", 工下次触发(按间隔("x", 60), 时间.现在()), -1);

    IO.打印行("  九点工下次：" + 时间.格式化本地(下, "%Y-%m-%d %H:%M:%S") + "（本地）");
    IO.打印行("  " + 工规格说明(好规));
    IO.打印行("  " + 工规格说明(按间隔("巡检", 300)));

    // 滴答上限：排期模式不许超过 30 秒
    变量 压滴答: 工规格 = 工规格滴答(按排期("y", "* * * * *"), 120);
    断言("排期模式滴答被压到30", 压滴答.滴答秒, 30);
}

函数 大于(a: 整数, b: 整数) : 整数 {
    如果 (a > b) { 返回 1; }
    返回 0;
}

变量 桥收到: 整数 = 0;
变量 桥末级别: 字符串 = "";
变量 刷屏计: 整数 = 0;

函数 测事件桥() {
    IO.打印行("── 事件桥 ──");
    清空生命周期订阅者();
    拆掉全部桥();
    变量 出: 整数 = 创建出口(0);
    挂接收者(出, 闭包(消息: 字符串): 整数 {
        桥收到 = 桥收到 + 1;
        变量 根: 整数 = J.解码(消息);
        桥末级别 = J.获取字符串(根, "级别");
        J.删除(根);
        返回 1;
    });
    断言("架桥成功", 正数(架事件桥(出, "")), 1);

    发出生命周期事件("运行1", "轮1", "步1", "agent_start", "小助手", "{}");
    断言("桥收到1条", 桥收到, 1);
    断言("普通事件是信息级", 串等(桥末级别, "信息"), 1);

    发出生命周期事件("运行1", "轮1", "步2", "tool_error", "小助手", "{}");
    断言("桥收到2条", 桥收到, 2);
    断言("error 抬成警报", 串等(桥末级别, "警报"), 1);

    // 前缀过滤
    清空生命周期订阅者();
    拆掉全部桥();
    桥收到 = 0;
    变量 出2: 整数 = 创建出口(0);
    挂接收者(出2, 闭包(消息: 字符串): 整数 { 桥收到 = 桥收到 + 1; 返回 1; });
    架事件桥(出2, "tool_");
    发出生命周期事件("运行2", "轮1", "步1", "agent_start", "小助手", "{}");
    断言("前缀不匹配-不转发", 桥收到, 0);
    发出生命周期事件("运行2", "轮1", "步2", "tool_call", "小助手", "{}");
    断言("前缀匹配-转发", 桥收到, 1);

    清空生命周期订阅者();
    拆掉全部桥();
}

函数 测桥去重() {
    IO.打印行("── 事件桥 × 去重（防刷屏）──");
    清空生命周期订阅者();
    拆掉全部桥();
    刷屏计 = 0;
    变量 出: 整数 = 创建出口(3600);      // 一小时静默
    挂接收者(出, 闭包(消息: 字符串): 整数 { 刷屏计 = 刷屏计 + 1; 返回 1; });
    架事件桥(出, "");

    // 同一个 agent 同一类事件连发 5 次，指纹一样，只该出去一条
    变量 i: 整数 = 0;
    当 (i < 5) {
        发出生命周期事件("运行3", "轮1", "步" + 整数转字符串(i), "tool_call", "小助手", "{}");
        i = i + 1;
    }
    断言("刷屏5次只出1条", 刷屏计, 1);
    断言("挡下4条", 取统计(出, "挡下"), 4);
    清空生命周期订阅者();
    拆掉全部桥();
}

函数 入口() {
    测出口();
    测推送JSON();
    测工循环();
    测停工();
    测排期工();
    测事件桥();
    测桥去重();
    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过) + "，失败 " + 整数转字符串(失败));
    如果 (失败 > 0) { IO.打印行("FAIL 共 " + 整数转字符串(失败) + " 项断言不过"); }
}

// 排期模块自测：解析、匹配、下次触发、错误路径
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 Harness.排期::{排期, 解析排期, 排期匹配, 下次触发, 排期说明, 本地偏移秒};

变量 通过: 整数 = 0;
变量 失败: 整数 = 0;

函数 断言(名: 字符串, 实得: 整数, 应为: 整数) {
    如果 (实得 == 应为) {
        通过 = 通过 + 1;
    } 否则 {
        失败 = 失败 + 1;
        IO.打印行("FAIL " + 名 + "：实得 " + 整数转字符串(实得)
            + "，应为 " + 整数转字符串(应为));
    }
}

函数 断言串(名: 字符串, 实得: 字符串, 应为: 字符串) {
    如果 (字符串相等(实得, 应为) == 1) {
        通过 = 通过 + 1;
    } 否则 {
        失败 = 失败 + 1;
        IO.打印行("FAIL " + 名 + "：实得「" + 实得 + "」，应为「" + 应为 + "」");
    }
}

函数 字符串相等(a: 字符串, b: 字符串) : 整数 {
    如果 (a == b) { 返回 1; }
    返回 0;
}

// 用 UTC 口径测（用本地=0），这样断言和机器时区无关
函数 于(年: 整数, 月: 整数, 日: 整数, 时: 整数, 分: 整数) : 整数 {
    返回 时间.从年月日时分秒(年, 月, 日, 时, 分, 0);
}

函数 测解析() {
    IO.打印行("── 解析 ──");
    断言("每分钟有效", 解析排期("* * * * *").有效, 1);
    断言("每天九点有效", 解析排期("0 9 * * *").有效, 1);
    断言("步长有效", 解析排期("*/15 * * * *").有效, 1);
    断言("范围有效", 解析排期("0 9-17 * * 1-5").有效, 1);
    断言("逗号有效", 解析排期("0 9,12,18 * * *").有效, 1);
    断言("月名有效", 解析排期("0 0 1 JAN,JUL *").有效, 1);
    断言("周名有效", 解析排期("0 9 * * MON-FRI").有效, 1);
    断言("别名每天", 解析排期("@每天").有效, 1);
    断言("别名daily", 解析排期("@daily").有效, 1);
    断言("多余空格", 解析排期("  0   9  *  *  * ").有效, 1);

    IO.打印行("── 该拒的要拒 ──");
    断言("空串", 解析排期("").有效, 0);
    断言("四段", 解析排期("0 9 * *").有效, 0);
    断言("六段", 解析排期("0 9 * * * *").有效, 0);
    断言("分越界", 解析排期("60 * * * *").有效, 0);
    断言("时越界", 解析排期("* 24 * * *").有效, 0);
    断言("日为零", 解析排期("* * 0 * *").有效, 0);
    断言("月越界", 解析排期("* * * 13 *").有效, 0);
    断言("周越界", 解析排期("* * * * 8").有效, 0);
    断言("范围倒置", 解析排期("* 17-9 * * *").有效, 0);
    断言("步长为零", 解析排期("*/0 * * * *").有效, 0);
    断言("非数字", 解析排期("9x * * * *").有效, 0);
    断言("垃圾月名", 解析排期("0 0 1 FOO *").有效, 0);
}

函数 测匹配() {
    IO.打印行("── 匹配（UTC 口径）──");
    变量 每天九点: 排期 = 解析排期("0 9 * * *");
    断言("09:00 命中", 排期匹配(每天九点, 于(2026, 8, 24, 9, 0), 0), 1);
    断言("09:01 不中", 排期匹配(每天九点, 于(2026, 8, 24, 9, 1), 0), 0);
    断言("08:00 不中", 排期匹配(每天九点, 于(2026, 8, 24, 8, 0), 0), 0);

    变量 一刻钟: 排期 = 解析排期("*/15 * * * *");
    断言("00 分命中", 排期匹配(一刻钟, 于(2026, 8, 24, 3, 0), 0), 1);
    断言("15 分命中", 排期匹配(一刻钟, 于(2026, 8, 24, 3, 15), 0), 1);
    断言("30 分命中", 排期匹配(一刻钟, 于(2026, 8, 24, 3, 30), 0), 1);
    断言("45 分命中", 排期匹配(一刻钟, 于(2026, 8, 24, 3, 45), 0), 1);
    断言("07 分不中", 排期匹配(一刻钟, 于(2026, 8, 24, 3, 7), 0), 0);

    // 2026-08-24 是周一，08-23 是周日，08-22 是周六
    变量 工作日: 排期 = 解析排期("0 9 * * MON-FRI");
    断言("周一命中", 排期匹配(工作日, 于(2026, 8, 24, 9, 0), 0), 1);
    断言("周六不中", 排期匹配(工作日, 于(2026, 8, 22, 9, 0), 0), 0);
    断言("周日不中", 排期匹配(工作日, 于(2026, 8, 23, 9, 0), 0), 0);

    // 周日两种写法
    变量 周日0: 排期 = 解析排期("0 9 * * 0");
    变量 周日7: 排期 = 解析排期("0 9 * * 7");
    断言("周日写0命中", 排期匹配(周日0, 于(2026, 8, 23, 9, 0), 0), 1);
    断言("周日写7命中", 排期匹配(周日7, 于(2026, 8, 23, 9, 0), 0), 1);

    // POSIX 的「或」语义：每月 13 号 或 每周五
    // 2026-08-13 是周四；2026-08-21 是周五
    变量 或语义: 排期 = 解析排期("0 0 13 * 5");
    断言("13号(周四)命中", 排期匹配(或语义, 于(2026, 8, 13, 0, 0), 0), 1);
    断言("周五(21号)命中", 排期匹配(或语义, 于(2026, 8, 21, 0, 0), 0), 1);
    断言("20号周四不中", 排期匹配(或语义, 于(2026, 8, 20, 0, 0), 0), 0);

    // 只限日：周该被忽略
    变量 只限日: 排期 = 解析排期("0 0 13 * *");
    断言("只限日-13号命中", 排期匹配(只限日, 于(2026, 8, 13, 0, 0), 0), 1);
    断言("只限日-21号不中", 排期匹配(只限日, 于(2026, 8, 21, 0, 0), 0), 0);

    变量 月份: 排期 = 解析排期("0 0 1 JAN,JUL *");
    断言("1月1日命中", 排期匹配(月份, 于(2026, 1, 1, 0, 0), 0), 1);
    断言("7月1日命中", 排期匹配(月份, 于(2026, 7, 1, 0, 0), 0), 1);
    断言("3月1日不中", 排期匹配(月份, 于(2026, 3, 1, 0, 0), 0), 0);

    断言("坏排期从不命中", 排期匹配(解析排期("垃圾"), 于(2026, 8, 24, 9, 0), 0), 0);
}

函数 测下次() {
    IO.打印行("── 下次触发 ──");
    变量 每天九点: 排期 = 解析排期("0 9 * * *");
    变量 此刻: 整数 = 于(2026, 8, 24, 8, 30);
    变量 下: 整数 = 下次触发(每天九点, 此刻, 0);
    断言("今天9点", 下, 于(2026, 8, 24, 9, 0));

    变量 过了: 整数 = 于(2026, 8, 24, 9, 30);
    断言("明天9点", 下次触发(每天九点, 过了, 0), 于(2026, 8, 25, 9, 0));

    变量 一刻钟: 排期 = 解析排期("*/15 * * * *");
    断言("下一刻钟", 下次触发(一刻钟, 于(2026, 8, 24, 3, 7), 0), 于(2026, 8, 24, 3, 15));

    // 跨月：8/31 之后的「每月 1 号」
    变量 每月一号: 排期 = 解析排期("0 0 1 * *");
    断言("跨月", 下次触发(每月一号, 于(2026, 8, 31, 12, 0), 0), 于(2026, 9, 1, 0, 0));

    // 永远不会到的：2 月 30 号
    断言("永不触发返回-1", 下次触发(解析排期("0 0 30 2 *"), 于(2026, 8, 24, 0, 0), 0), -1);

    // 整点边界：正好在触发那一分钟问，应给下一次而不是当前这次
    断言("正在触发时给下次", 下次触发(每天九点, 于(2026, 8, 24, 9, 0), 0),
        于(2026, 8, 25, 9, 0));
}

函数 测说明() {
    IO.打印行("── 说明 ──");
    变量 正常: 字符串 = 排期说明(解析排期("0 9 * * *"));
    断言("正常说明就是原文", 字符串相等(正常, "0 9 * * *"), 1);
    // 日和周都限定时要显式提醒「或」
    变量 或说明: 字符串 = 排期说明(解析排期("0 0 13 * 5"));
    断言("或语义有提醒", 位含(或说明, "或"), 1);
    变量 坏说明: 字符串 = 排期说明(解析排期("0 9 * *"));
    断言("坏排期有说明", 位含(坏说明, "无效排期"), 1);
}

函数 位含(整串: 字符串, 找: 字符串) : 整数 {
    如果 (字符串::包含(整串, 找) == 1) { 返回 1; }
    返回 0;
}

函数 测本地() {
    IO.打印行("── 本地时区 ──");
    变量 现: 整数 = 时间.现在();
    变量 偏: 整数 = 本地偏移秒(现);
    IO.打印行("  本机偏移 " + 整数转字符串(偏 / 3600) + " 小时（仅供参考，不断言）");
    // 不管在哪个时区，「本地口径的下一次」减「UTC 口径的下一次」应正好是偏移的整数倍差
    变量 每天九点: 排期 = 解析排期("0 9 * * *");
    变量 本地下次: 整数 = 下次触发(每天九点, 现, 1);
    断言("本地下次是未来", 大于(本地下次, 现), 1);
    断言("本地下次能命中", 排期匹配(每天九点, 本地下次, 1), 1);
}

函数 大于(a: 整数, b: 整数) : 整数 {
    如果 (a > b) { 返回 1; }
    返回 0;
}

函数 入口() {
    测解析();
    测匹配();
    测下次();
    测说明();
    测本地();
    IO.打印行("");
    IO.打印行("通过 " + 整数转字符串(通过) + "，失败 " + 整数转字符串(失败));
    如果 (失败 > 0) { IO.打印行("FAIL 共 " + 整数转字符串(失败) + " 项断言不过"); }
}

// 自动压缩的三件事：默认开着 / 摘要策略接进自动路径 / 缺摘要会话时退回滑窗
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.大模型 作为 底层模型;
导入 Harness.运行配置::{运行配置, 默认运行配置, 配置滑窗压缩, 配置摘要压缩, 取消上下文压缩};
导入 Harness.上下文::{需要压缩, 历史令牌估算, 滑窗裁剪};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 入口() {
    变量 默认值: 运行配置 = 默认运行配置();
    断言(默认值.上下文压缩阈值 > 0, "默认就开着压缩（以前是 0 = 关，长对话一路涨到 provider 报错）");
    断言(默认值.上下文压缩策略 == 1, "默认策略是滑窗（不调模型、不花钱、不用额外会话）");
    断言(默认值.滑窗保留条数 >= 8, "默认保留条数不算苛刻（实得 " + 默认值.滑窗保留条数 + "）");

    变量 摘要配置: 运行配置 = 配置摘要压缩(默认运行配置(), 1000, 6, 12345);
    断言(摘要配置.上下文压缩策略 == 2, "配置摘要压缩 把策略设成 2");
    断言(摘要配置.摘要会话 == 12345, "摘要会话句柄存下来了");

    变量 关掉: 运行配置 = 取消上下文压缩(默认运行配置());
    断言(关掉.上下文压缩阈值 == 0, "取消上下文压缩 仍然能整个关掉");

    // 阈值真的按估算 token 生效
    变量 会话: 整数 = 底层模型.创建会话("http://127.0.0.1:1/v1", "k", "m");
    如果 (会话 > 0) {
        变量 历史: 整数 = J.创建数组();
        变量 一条: 整数 = J.创建对象();
        J.设置字符串(一条, "role", "user");
        变量 长文: 字符串 = "";
        变量 n: 整数 = 0;
        当 (n < 200) { 长文 = 长文 + "很长的一段话。"; n = n + 1; }
        J.设置字符串(一条, "content", 长文);
        J.数组添加对象(历史, 一条);
        底层模型.设置历史JSON(会话, J.转字符串(历史));
        J.删除(历史);
        变量 估: 整数 = 历史令牌估算(会话);
        断言(需要压缩(会话, 估 - 1) == 1, "超过阈值判要压（估算 " + 估 + "）");
        断言(需要压缩(会话, 估 + 1) == 0, "没超阈值判不压");
    }

    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

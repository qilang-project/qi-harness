// 自动压缩**在真实 agent 跑动中**到底触发没有 —— 前一个测试只验了配置结构，
// 那不算数。这里对着假 OpenAI 服务器真跑几轮，看历史有没有被裁。
//
// 起法：python3 tests/service_persistence/fake_openai.py --port <端口>
// 端点走 FAKE_LLM_ENDPOINT —— **环境变量名不能用中文**，shell 传不了。
// 端口从命令行参数拿。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 标准库.操作系统 作为 系统;
导入 标准库.字符串;
导入 标准库.大模型 作为 底层模型;
导入 Harness.模型::{模型配置, 大模型, 开启会话};
导入 Harness.代理::{代理, 创建代理, 运行使用配置, 关闭代理};
导入 Harness.运行配置::{运行配置, 默认运行配置, 配置滑窗压缩, 配置摘要压缩, 取消上下文压缩};
导入 Harness.上下文::{历史令牌估算};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;
函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 历史条数(会话: 整数) : 整数 {
    变量 组: 整数 = J.解码(底层模型.历史JSON(会话));
    如果 (组 <= 0) { 返回 0; }
    变量 n: 整数 = J.数组长度(组);
    J.删除(组);
    返回 n;
}

函数 跑几轮(配置值: 运行配置, 轮数: 整数, 标题: 字符串) : 整数 {
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    变量 会话: 整数 = 开启会话(大模型(端点, "k", "fixture-model"));
    如果 (会话 <= 0) { 返回 0 - 1; }
    变量 甲: 代理 = 创建代理("压缩验", 会话);
    变量 i: 整数 = 0;
    当 (i < 轮数) {
        运行使用配置(甲, "第 " + i + " 问，随便说点什么让历史涨起来", 配置值);
        i = i + 1;
    }
    变量 条: 整数 = 历史条数(会话);
    IO.打印行("  " + 标题 + "：跑 " + 轮数 + " 轮后历史 " + 条 + " 条，估算 "
        + 历史令牌估算(会话) + " token");
    关闭代理(甲);
    返回 条;
}

函数 入口() {
    // 没给端点就跳过 —— 这套要假模型服务器，不是每次 find 扫到都能跑
    如果 (字符串::字节长度(系统.获取环境变量("FAKE_LLM_ENDPOINT")) == 0) {
        IO.打印行("没给 FAKE_LLM_ENDPOINT，跳过");
        IO.打印行("");
        IO.打印行("通过 0，失败 0");
        返回;
    }

    // ① 关掉压缩：历史应当一路涨（每轮至少 user+assistant 两条）
    变量 关: 运行配置 = 取消上下文压缩(默认运行配置());
    变量 不压条数: 整数 = 跑几轮(关, 8, "关掉压缩");
    如果 (不压条数 < 0) { IO.打印行("连不上假模型，跳过"); 返回; }
    断言(不压条数 >= 16, "关掉压缩时历史确实一路涨（" + 不压条数 + " 条）");

    // ② 阈值压到很低 + 只保留 4 条：自动路径必须真的裁
    变量 开: 运行配置 = 配置滑窗压缩(默认运行配置(), 50, 4);
    变量 压后条数: 整数 = 跑几轮(开, 8, "阈值 50 保留 4");
    断言(压后条数 < 不压条数, "自动压缩真的在 agent 跑动中触发了（"
        + 压后条数 + " < " + 不压条数 + "）");
    断言(压后条数 <= 8, "裁到了保留条数附近（" + 压后条数 + " 条）");

    // ③ 带工具调用的轮次 + 压缩：裁完的历史必须仍然合法（不能留孤儿 tool）
    //
    // **保留条数 4 是挑出来的**，不是随手写的：拿修复前的 上下文.qi 逐个试过
    // 1..7，只有 2 和 4 会让边界落在 assistant(tool_calls) 与 tool result 之间。
    // 别改成别的数 —— 改了这条就退化成「跑得通」而不是「回归」。
    变量 端点: 字符串 = 系统.获取环境变量("FAKE_LLM_ENDPOINT");
    变量 会话三: 整数 = 开启会话(大模型(端点, "k", "fixture-model"));
    变量 丙: 代理 = 创建代理("带工具", 会话三);
    变量 工具配置: 运行配置 = 配置滑窗压缩(默认运行配置(), 30, 4);
    变量 t: 整数 = 0;
    当 (t < 6) {
        运行使用配置(丙, "use tool", 工具配置);
        t = t + 1;
    }
    变量 组三: 整数 = J.解码(底层模型.历史JSON(会话三));
    变量 孤儿: 整数 = 0;
    变量 前一条带调用: 整数 = 0;
    变量 k: 整数 = 0;
    当 (k < J.数组长度(组三)) {
        变量 消息: 整数 = J.数组获取对象(组三, k);
        变量 角色: 字符串 = J.获取字符串(消息, "role");
        如果 (角色 == "tool" && 前一条带调用 == 0) { 孤儿 = 孤儿 + 1; }
        如果 (角色 == "assistant" && J.是否包含键(消息, "tool_calls") == 1) { 前一条带调用 = 1; }
        否则 { 如果 (角色 != "tool") { 前一条带调用 = 0; } }
        k = k + 1;
    }
    IO.打印行("  带工具跑 6 轮 + 压缩：历史 " + J.数组长度(组三) + " 条，孤儿 " + 孤儿 + " 个");
    J.删除(组三);
    关闭代理(丙);
    断言(孤儿 == 0, "带工具调用时裁完仍然合法（孤儿 tool 会让下次请求 400）");

    // ④ 策略 2 但没给摘要会话：必须退回滑窗照样裁，不能当没配置
    变量 缺会话: 运行配置 = 配置摘要压缩(默认运行配置(), 50, 4, 0);
    变量 退回后: 整数 = 跑几轮(缺会话, 8, "策略2 但没给摘要会话");
    断言(退回后 < 不压条数, "缺摘要会话时退回滑窗，仍然裁了（"
        + 退回后 + " < " + 不压条数 + "）");

    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

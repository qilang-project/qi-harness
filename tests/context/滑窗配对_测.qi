// 滑窗裁剪会不会把 assistant(tool_calls) 和它的 tool result 切散？
//
// OpenAI 规定：role="tool" 的消息必须紧跟在带 tool_calls 的 assistant 之后。
// 切散了，下一次请求直接 400（harness-rs 上就栽过同一个坑）。
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.JSON 作为 J;
导入 标准库.大模型 作为 底层模型;
导入 Harness.上下文::{滑窗裁剪};

变量 过: 整数 = 0;
变量 挂: 整数 = 0;

函数 断言(条件: 整数, 名: 字符串) {
    如果 (条件 == 1) { 过 = 过 + 1; IO.打印行("PASS " + 名); }
    否则 { 挂 = 挂 + 1; IO.打印行("FAIL " + 名); }
}

函数 加消息(消息组: 整数, 角色: 字符串, 内容: 字符串, 带工具调用: 整数, 工具ID: 字符串) {
    变量 消息: 整数 = J.创建对象();
    J.设置字符串(消息, "role", 角色);
    J.设置字符串(消息, "content", 内容);
    如果 (带工具调用 == 1) {
        变量 调用组: 整数 = J.创建数组();
        变量 一个: 整数 = J.创建对象();
        J.设置字符串(一个, "id", 工具ID);
        J.设置字符串(一个, "type", "function");
        J.数组添加对象(调用组, 一个);
        J.设置数组(消息, "tool_calls", 调用组);
    }
    如果 (角色 == "tool") {
        J.设置字符串(消息, "tool_call_id", 工具ID);
    }
    J.数组添加对象(消息组, 消息);
}

函数 入口() {
    变量 配置: 整数 = 底层模型.创建会话("http://127.0.0.1:1/v1", "k", "m");
    如果 (配置 <= 0) { IO.打印行("建不了会话，跳过"); 返回; }

    // system, user, assistant(tool_calls), tool, assistant, user, assistant
    变量 历史: 整数 = J.创建数组();
    加消息(历史, "system", "你是助手", 0, "");
    加消息(历史, "user", "查一下天气", 0, "");
    加消息(历史, "assistant", "", 1, "call_1");
    加消息(历史, "tool", "晴", 0, "call_1");
    加消息(历史, "assistant", "今天晴", 0, "");
    加消息(历史, "user", "谢谢", 0, "");
    加消息(历史, "assistant", "不客气", 0, "");
    底层模型.设置历史JSON(配置, J.转字符串(历史));
    J.删除(历史);

    // 非 system 共 6 条，保留最近 4 条 → 边界正好落在 assistant(tool_calls) 和 tool 之间
    滑窗裁剪(配置, 4);

    变量 后JSON: 字符串 = 底层模型.历史JSON(配置);
    变量 后: 整数 = J.解码(后JSON);
    IO.打印行("裁剪后：" + 后JSON);

    // 检查：任何 role=tool 的前面必须有带 tool_calls 的 assistant
    变量 孤儿: 整数 = 0;
    变量 上一条带调用: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < J.数组长度(后)) {
        变量 消息: 整数 = J.数组获取对象(后, i);
        变量 角色: 字符串 = J.获取字符串(消息, "role");
        如果 (角色 == "tool" && 上一条带调用 == 0) { 孤儿 = 孤儿 + 1; }
        如果 (角色 == "assistant" && J.是否包含键(消息, "tool_calls") == 1) {
            上一条带调用 = 1;
        } 否则 {
            如果 (角色 != "tool") { 上一条带调用 = 0; }
        }
        i = i + 1;
    }
    J.删除(后);

    断言(孤儿 == 0, "裁剪后没有孤儿 tool 消息（有的话下次请求必 400）");
    断言(J.数组长度(后) <= 5, "没有为了补配对反而留多（往后挪，不往前扩）");

    // ② 连续多条 tool result（一个 assistant 调了三个工具）
    变量 二: 整数 = 底层模型.创建会话("http://127.0.0.1:1/v1", "k", "m");
    变量 历史二: 整数 = J.创建数组();
    加消息(历史二, "system", "s", 0, "");
    加消息(历史二, "user", "u1", 0, "");
    加消息(历史二, "assistant", "", 1, "c1");
    加消息(历史二, "tool", "r1", 0, "c1");
    加消息(历史二, "tool", "r2", 0, "c2");
    加消息(历史二, "tool", "r3", 0, "c3");
    加消息(历史二, "assistant", "汇总", 0, "");
    底层模型.设置历史JSON(二, J.转字符串(历史二));
    J.删除(历史二);
    滑窗裁剪(二, 4);
    变量 后二: 整数 = J.解码(底层模型.历史JSON(二));
    变量 头角色: 字符串 = "";
    变量 k: 整数 = 0;
    当 (k < J.数组长度(后二)) {
        变量 m2: 整数 = J.数组获取对象(后二, k);
        如果 (J.获取字符串(m2, "role") != "system" && 字符串::字节长度(头角色) == 0) {
            头角色 = J.获取字符串(m2, "role");
        }
        k = k + 1;
    }
    断言(头角色 != "tool", "连续三条 tool 也不会留下孤儿（第一条非 system 是 " + 头角色 + "）");
    J.删除(后二);

    // ③ 边界没切到配对时，行为一个字不变
    变量 三: 整数 = 底层模型.创建会话("http://127.0.0.1:1/v1", "k", "m");
    变量 历史三: 整数 = J.创建数组();
    加消息(历史三, "system", "s", 0, "");
    加消息(历史三, "user", "a", 0, "");
    加消息(历史三, "assistant", "b", 0, "");
    加消息(历史三, "user", "c", 0, "");
    加消息(历史三, "assistant", "d", 0, "");
    底层模型.设置历史JSON(三, J.转字符串(历史三));
    J.删除(历史三);
    变量 剩: 整数 = 滑窗裁剪(三, 2);
    断言(剩 == 3, "没有工具调用时照旧：system + 最近 2 条 = 3（实得 " + 剩 + "）");

    IO.打印行("");
    IO.打印行("通过 " + 过 + "，失败 " + 挂);
}

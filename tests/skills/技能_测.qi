// 技能：frontmatter 解析修正 + 技能库渐进式披露（load_skill / read_skill_file）
// 跑：tests/run-qi-test.sh tests/skills/技能_测.qi   （离线，不打模型）
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.大模型 作为 底层模型;
导入 Harness.技能::{技能, 解析技能, 技能允许的工具, 装备技能库, 技能库清单,
    技能库已加载, 应用技能工具白名单};
导入 Harness.工具::{派发};
导入 Harness.代理::{代理, 创建代理, 工具是否放行, 关闭代理};

变量 失败数: 整数 = 0;

函数 断言相等(名字: 字符串, 实际: 字符串, 期望: 字符串) {
    如果 (字符串::等于(实际, 期望) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 实际=[" + 实际 + "] 期望=[" + 期望 + "]");
    }
}

函数 断言包含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 1) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 未包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 断言不含(名字: 字符串, 文本: 字符串, 片段: 字符串) {
    如果 (字符串::包含(文本, 片段) == 0) {
        IO.打印行("PASS " + 名字);
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL " + 名字 + ": 不该包含 [" + 片段 + "]，文本=[" + 文本 + "]");
    }
}

函数 会话系统提示(会话: 整数) : 字符串 {
    // 只做包含判断，直接在会话视图 JSON 上找即可
    返回 底层模型.会话视图(会话);
}

函数 测解析() {
    // 1. description 里含 "name:" 字样 —— 老实现按全文子串找 name: 会撞上
    变量 甲: 技能 = 解析技能("---\ndescription: 用法：先写 name: 再写别的\nname: 真名\n---\n正文A");
    断言相等("解析/name 不被 description 里的 name: 干扰", 甲.名称, "真名");
    断言相等("解析/description 取整行", 甲.描述, "用法：先写 name: 再写别的");
    断言相等("解析/正文", 甲.正文, "正文A");

    // 2. 带引号的值
    变量 乙: 技能 = 解析技能("---\nname: \"引号名\"\ndescription: '单引号描述'\n---\n\n正文B\n");
    断言相等("解析/双引号值去引号", 乙.名称, "引号名");
    断言相等("解析/单引号值去引号", 乙.描述, "单引号描述");

    // 3. 折叠多行 description（>）
    变量 丙: 技能 = 解析技能("---\nname: 多行\ndescription: >\n  第一行，\n  第二行。\nallowed-tools: a, b c\n---\n正文C");
    断言相等("解析/> 折叠多行", 丙.描述, "第一行， 第二行。");
    断言相等("解析/allowed-tools 逗号空格混合", 技能允许的工具(丙), "a,b,c");

    // 4. 保留换行的多行 description（|）
    变量 丁: 技能 = 解析技能("---\nname: 竖线\ndescription: |\n  行一\n  行二\n---\n正文D");
    断言相等("解析/| 保留换行", 丁.描述, "行一\n行二");

    // 5. 没有 frontmatter：名称为空，全文当正文
    变量 戊: 技能 = 解析技能("# 标题\n\nname: 假的\n正文E");
    断言相等("解析/无 frontmatter 名称为空", 戊.名称, "");
    断言相等("解析/无 frontmatter 全文为正文", 戊.正文, "# 标题\n\nname: 假的\n正文E");

    // 6. 只有开头 --- 没闭合：不算 frontmatter
    变量 己: 技能 = 解析技能("---\nname: 未闭合\n正文F");
    断言相等("解析/未闭合不算 frontmatter", 己.名称, "");

    // 7. 正文里出现 --- 与 name: 不影响（只认首个块）
    变量 庚: 技能 = 解析技能("---\nname: 首块\n---\n正文\n---\nname: 第二块\n---\n");
    断言相等("解析/只认首个块", 庚.名称, "首块");
    断言包含("解析/正文保留后续 ---", 庚.正文, "name: 第二块");

    // 8. CRLF 换行
    变量 辛: 技能 = 解析技能("---\r\nname: 回车\r\ndescription: 描述\r\n---\r\n正文G\r\n");
    断言相等("解析/CRLF 名称", 辛.名称, "回车");
    断言相等("解析/CRLF 正文", 辛.正文, "正文G");

    // 9. 键前缀不误匹配：`username:` 不是 `name:`
    变量 壬: 技能 = 解析技能("---\nusername: 张三\nname: 正确\n---\n");
    断言相等("解析/username 不算 name", 壬.名称, "正确");
}

函数 测技能库() {
    变量 会话: 整数 = 底层模型.创建会话("http://127.0.0.1:43510/v1", "test", "test");
    底层模型.设置配置(会话, "system", "基础提示甲");
    变量 代理值: 代理 = 创建代理("技能测", 会话);

    代理值 = 装备技能库(代理值, "examples/技能/技能库");
    变量 清单: 字符串 = 技能库清单(代理值);
    断言包含("技能库/清单含海盗腔", 清单, "- 海盗腔：");
    断言包含("技能库/清单含报表（折叠描述）", 清单, "- 报表：把一组数字整理成简明的中文周报： 先给结论");
    断言不含("技能库/清单不含正文", 清单, "老子");
    断言不含("技能库/无 frontmatter 的目录被跳过", 清单, "无名");

    变量 视图: 字符串 = 会话系统提示(会话);
    断言包含("技能库/系统提示保留原提示", 视图, "基础提示甲");
    断言包含("技能库/系统提示注入清单", 视图, "可用技能库");
    断言不含("技能库/系统提示不含正文", 视图, "老子");

    // load_skill：首次给正文 + 资源清单，第二次幂等
    变量 首次: 字符串 = 派发(代理值.工具表, "load_skill", "{\"name\":\"海盗腔\"}");
    断言包含("load_skill/首次返回正文", 首次, "自称「老子」");
    断言包含("load_skill/列出 references", 首次, "- references/口头禅.md");
    断言包含("load_skill/列出 scripts", 首次, "- scripts/说.sh");
    断言不含("load_skill/不列 SKILL.md 自身", 首次, "- SKILL.md");
    断言相等("load_skill/已加载标记", 整数转字符串(技能库已加载(代理值, "海盗腔")), "1");
    变量 再次: 字符串 = 派发(代理值.工具表, "load_skill", "{\"name\":\"海盗腔\"}");
    断言包含("load_skill/第二次只回短句", 再次, "已加载过");
    断言不含("load_skill/第二次不再灌正文", 再次, "老子");
    变量 未知: 字符串 = 派发(代理值.工具表, "load_skill", "{\"name\":\"不存在\"}");
    断言包含("load_skill/未知技能报错", 未知, "unknown_skill");
    断言包含("load_skill/未知技能列出可用", 未知, "海盗腔");

    // allowed-tools 进了 load_skill 的返回
    变量 报表: 字符串 = 派发(代理值.工具表, "load_skill", "{\"name\":\"报表\"}");
    断言包含("load_skill/建议工具", 报表, "建议只使用这些工具：read_skill_file, load_skill, 查天气");
    断言包含("load_skill/列出 assets", 报表, "- assets/模板.csv");

    // read_skill_file：正常 / .. / 绝对路径 / ~ / 不存在 / 目录
    变量 读: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"references/口头禅.md\"}");
    断言包含("read_skill_file/读到内容", 读, "朗姆酒管够");
    变量 穿越: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"../报表/SKILL.md\"}");
    断言包含("read_skill_file/拒绝 ..", 穿越, "path_rejected");
    变量 绝对: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"/etc/hosts\"}");
    断言包含("read_skill_file/拒绝绝对路径", 绝对, "path_rejected");
    变量 家: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"~/x\"}");
    断言包含("read_skill_file/拒绝 ~", 家, "path_rejected");
    变量 缺: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"references/没有.md\"}");
    断言包含("read_skill_file/不存在", 缺, "not_found");
    变量 目录: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"references\"}");
    断言包含("read_skill_file/目录不算文件", 目录, "not_found");
    变量 别的技能: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"没有\",\"path\":\"x\"}");
    断言包含("read_skill_file/未知技能", 别的技能, "unknown_skill");

    // 超大文件截断（临时生成，测完删）
    变量 大文件: 字符串 = "examples/技能/技能库/海盗腔/references/大文件.txt";
    变量 块: 字符串 = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef";
    变量 内容: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 5000) { 内容 = 内容 + 块; i = i + 1; }   // 320000 字节 > 262144
    IO.写入文件(大文件, 内容);
    变量 大: 字符串 = 派发(代理值.工具表, "read_skill_file", "{\"name\":\"海盗腔\",\"path\":\"references/大文件.txt\"}");
    IO.删除文件(大文件);
    断言包含("read_skill_file/超限截断注明", 大, "[已截断：文件共 320000 字节");
    如果 (字符串::字节长度(大) < 262144 + 120 && 字符串::字节长度(大) > 262144 - 100) {
        IO.打印行("PASS read_skill_file/截断长度在 256KB 附近");
    } 否则 {
        失败数 = 失败数 + 1;
        IO.打印行("FAIL read_skill_file/截断长度: " + 整数转字符串(字符串::字节长度(大)));
    }

    // 第二个根目录叠加：重名覆盖 + 清单不重复 + 可再加载一次拿到新正文
    代理值 = 装备技能库(代理值, "examples/技能/技能库2");
    变量 清单2: 字符串 = 技能库清单(代理值);
    断言包含("技能库/叠加后描述被覆盖", 清单2, "- 海盗腔：覆盖版海盗腔");
    断言不含("技能库/叠加后旧描述消失", 清单2, "加勒比海盗");
    断言包含("技能库/叠加后报表仍在", 清单2, "- 报表：");
    变量 覆盖后: 字符串 = 派发(代理值.工具表, "load_skill", "{\"name\":\"海盗腔\"}");
    断言包含("load_skill/覆盖后可重新加载新正文", 覆盖后, "自称「船长」");

    // allowed-tools 收窄白名单（宿主显式调用）
    断言相等("白名单/收窄前全放行", 整数转字符串(工具是否放行(代理值, "随便")), "1");
    代理值 = 应用技能工具白名单(代理值, "报表");
    断言相等("白名单/allowed-tools 放行", 整数转字符串(工具是否放行(代理值, "查天气")), "1");
    断言相等("白名单/技能库工具放行", 整数转字符串(工具是否放行(代理值, "load_skill")), "1");
    断言相等("白名单/其他拒绝", 整数转字符串(工具是否放行(代理值, "随便")), "0");
    代理值 = 应用技能工具白名单(代理值, "海盗腔");   // 没写 allowed-tools：不改
    断言相等("白名单/无 allowed-tools 不改", 整数转字符串(工具是否放行(代理值, "随便")), "0");

    // 第二个代理有自己的槽位：已加载状态互不影响
    变量 会话2: 整数 = 底层模型.创建会话("http://127.0.0.1:43510/v1", "test", "test");
    变量 代理2: 代理 = 创建代理("技能测2", 会话2);
    代理2 = 装备技能库(代理2, "examples/技能/技能库");
    变量 二首次: 字符串 = 派发(代理2.工具表, "load_skill", "{\"name\":\"海盗腔\"}");
    断言包含("多代理/第二个代理首次仍给正文", 二首次, "自称「老子」");
    断言相等("多代理/第一个代理的加载状态不受影响", 整数转字符串(技能库已加载(代理值, "报表")), "1");

    关闭代理(代理2);
    关闭代理(代理值);
}

函数 入口() {
    测解析();
    测技能库();
    如果 (失败数 == 0) { IO.打印行("全部通过"); }
    否则 { IO.打印行("失败 " + 整数转字符串(失败数) + " 项"); }
}

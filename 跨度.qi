// 跨度 — 从生命周期事件流还原调用树
//
// 追踪.qi 里本来就有 开始跨度/结束跨度 这套手写 API，但代理主循环一个都没调 ——
// 1980 行的 代理.qi 只发扁平事件，于是「这次跑了 40 秒，时间花哪了」根本答不上来。
//
// 与其把 span id 一路穿进主循环（要改几十处、还容易漏掉早退分支），不如认一个事实：
// **生命周期事件流本身已经是配对且正确嵌套的**。实测一次带工具的运行：
//
//     agent_start, turn_start, llm_start, llm_end, tool_start, tool_end,
//     llm_start, llm_end, turn_end, agent_end
//
// 连出错的路径也平衡（error 事件夹在 llm_start/llm_end 中间）。既然是配对的括号串，
// 一个栈就能还原成树 —— 采集器完全在旁路，主循环一行都不用改。
//
// ── 为什么每个 run 一个独立跨度仓 ──────────────────────────────────
//
// 父指针存的是 **run 内局部下标**，不是全局下标。这样淘汰老 run 时只要丢掉整个仓，
// 不用把剩下所有 span 的父指针重新映射一遍 —— 重映射是这类环形缓冲最容易写错的地方，
// 错了的表现是「瀑布图上某个 span 挂到了别人家的父节点下」，看着还挺合理。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//     导入 Harness.跨度::{安装跨度采集器, 最近运行JSON, 跨度树JSON};
//     安装跨度采集器();
//     运行(代理值, "...");
//     IO.打印行(跨度树JSON(""));      // "" = 最近一次运行

包 Harness;

导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 哈希表;
导入 标准库.时间;
导入 标准库.同步 作为 同步;
导入 标准库.JSON 作为 J;
导入 Harness.事件::{订阅生命周期事件};
// 复用 追踪 的转义：JSON 字符串转义只该有一份实现。
// （它当初是个空的 TODO，detail 里带引号或换行就把整行 JSON 打烂 —— 后来才补上。）
导入 Harness.追踪::{转义引号};

// 裹成 JSON 字符串字面量
函数 引(文本: 字符串) : 字符串 {
    返回 "\"" + 转义引号(文本) + "\"";
}

// 布尔转 0/1。qi 里比较表达式不能直接当整数参与算术，得显式分支。
函数 是否(条件: 整数) : 字符串 {
    如果 (条件 == 1) { 返回 "1"; }
    返回 "0";
}

// 结束毫秒为 -1 = 这次运行还在跑
函数 运行未结束(止毫秒: 整数) : 整数 {
    如果 (止毫秒 < 0) { 返回 1; }
    返回 0;
}

// 保留最近多少次运行。超了淘汰最老的整仓。
// 默认 20：看板上翻得动、内存又压得住（一次运行几十个 span，20 次就是千级）。
变量 保留运行数: 整数 = 20;

// 单次运行最多记多少个 span。跑飞的 agent（工具循环打到上限）会疯狂产 span，
// 不设顶就是一条内存泄漏。撞顶后丢弃并计数 —— 悄悄丢比丢了还说不出来更坏。
变量 单运行跨度上限: 整数 = 2048;
变量 丢弃跨度数: 整数 = 0;

// ——— 运行级（每项一个 run）———
// 采集锁。
//
// 单个 agent 跑的时候用不上：并发工具的 goroutine 里**不发**生命周期事件
// （代理受控工具工人 只调 执行单个受控调用，那条路一条事件都不出），
// 所以事件全在主线程上按序到达。
//
// 但 多代理 / 自己 启动 两个 运行() 的时候就是真并发了，而这些表是进程全局的。
// 不加锁的表现不是崩溃，是**树悄悄错乱**：span 挂到别人家的父节点下、
// 淘汰时把还在用的仓释放掉 —— 看着都挺合理，最难查。
// 事件频率很低（一次 LLM 调用几条），这把锁的代价可以忽略。
变量 采集锁: 整数 = 同步.创建锁();
变量 表已建: 整数 = 0;
变量 运行ID表: 整数 = 0;        // 字符串列表
变量 运行代理表: 整数 = 0;      // 字符串列表
变量 运行起表: 整数 = 0;        // 整数列表：起始毫秒
变量 运行止表: 整数 = 0;        // 整数列表：结束毫秒，-1 = 还在跑
变量 运行栈组: 整数 = 0;        // 整数列表：每项是该 run 的开栈句柄（存 span 局部下标）

// ——— 跨度级（每项一个 run 的仓句柄）———
变量 父组: 整数 = 0;            // 每仓：整数列表，父的局部下标，-1 = 根
变量 起组: 整数 = 0;            // 每仓：整数列表，起始毫秒
变量 止组: 整数 = 0;            // 每仓：整数列表，结束毫秒，-1 = 未结束
变量 令牌组: 整数 = 0;          // 每仓：整数列表
变量 成本组: 整数 = 0;          // 每仓：整数列表（分）
变量 状态组: 整数 = 0;          // 每仓：整数列表 0=进行中 1=成功 2=出错
变量 深度组: 整数 = 0;          // 每仓：整数列表
变量 类型组: 整数 = 0;          // 每仓：字符串列表 agent/turn/llm/tool/retry
变量 名字组: 整数 = 0;          // 每仓：字符串列表
变量 步骤组: 整数 = 0;          // 每仓：字符串列表

// 出错原因。字符串列表没有 设置字符串（整数列表有 设置整数、指针列表有 设置指针，
// 只有字符串列表没有 —— 标准库的一处不对称），所以可变的字符串走哈希表：
// 键 "<run下标>:<span下标>"。
变量 错误表: 整数 = 0;

函数 确保表() {
    如果 (表已建 == 1) { 返回; }
    运行ID表 = 列表库::创建字符串列表();
    运行代理表 = 列表库::创建字符串列表();
    运行起表 = 列表库::创建整数列表();
    运行止表 = 列表库::创建整数列表();
    运行栈组 = 列表库::创建整数列表();
    父组 = 列表库::创建整数列表();
    起组 = 列表库::创建整数列表();
    止组 = 列表库::创建整数列表();
    令牌组 = 列表库::创建整数列表();
    成本组 = 列表库::创建整数列表();
    状态组 = 列表库::创建整数列表();
    深度组 = 列表库::创建整数列表();
    // 这三个是**组**列表：每项存的是某个 run 仓里那张字符串列表的句柄（整数），
    // 所以本体是整数列表。建成字符串列表的话 添加整数 会静默不生效，
    // 表现是所有 span 的类型/名字都读成空串。
    类型组 = 列表库::创建整数列表();
    名字组 = 列表库::创建整数列表();
    步骤组 = 列表库::创建整数列表();
    错误表 = 哈希表::创建字符串表();
    表已建 = 1;
}

公开 函数 设置保留运行数(数量: 整数) : 整数 {
    如果 (数量 < 1) { 返回 0; }
    保留运行数 = 数量;
    返回 1;
}

公开 函数 设置单运行跨度上限(数量: 整数) : 整数 {
    如果 (数量 < 1) { 返回 0; }
    单运行跨度上限 = 数量;
    返回 1;
}

公开 函数 丢弃跨度计数() : 整数 { 返回 丢弃跨度数; }

公开 函数 运行数() : 整数 {
    确保表();
    返回 列表库::字符串列表大小(运行ID表);
}

公开 函数 取运行ID按下标(下标: 整数) : 字符串 {
    确保表();
    如果 (下标 < 0 || 下标 >= 运行数()) { 返回 ""; }
    返回 列表库::获取字符串(运行ID表, 下标);
}

// run_id → 下标，找不到返回 -1
函数 找运行(运行ID: 字符串) : 整数 {
    确保表();
    变量 n: 整数 = 列表库::字符串列表大小(运行ID表);
    变量 i: 整数 = n - 1;      // 倒着找：事件总是打在最近的 run 上
    当 (i >= 0) {
        如果 (字符串::等于(列表库::获取字符串(运行ID表, i), 运行ID) == 1) { 返回 i; }
        i = i - 1;
    }
    返回 -1;
}

// 淘汰最老的若干个 run。列表库没有「删掉第 0 项」，所以重建这几张**运行级**小表
// （最多几十项，重建很便宜），并把被淘汰那些仓的内层列表释放掉。
// 仓内的父指针是局部下标，整仓丢弃不影响任何人 —— 这正是当初分仓的理由。
函数 淘汰() {
    变量 总数: 整数 = 列表库::字符串列表大小(运行ID表);
    如果 (总数 <= 保留运行数) { 返回; }
    变量 丢弃数: 整数 = 总数 - 保留运行数;

    变量 i: 整数 = 0;
    当 (i < 丢弃数) {
        列表库::删除列表(列表库::获取整数(运行栈组, i));
        列表库::删除列表(列表库::获取整数(父组, i));
        列表库::删除列表(列表库::获取整数(起组, i));
        列表库::删除列表(列表库::获取整数(止组, i));
        列表库::删除列表(列表库::获取整数(令牌组, i));
        列表库::删除列表(列表库::获取整数(成本组, i));
        列表库::删除列表(列表库::获取整数(状态组, i));
        列表库::删除列表(列表库::获取整数(深度组, i));
        列表库::删除列表(列表库::获取整数(类型组, i));
        列表库::删除列表(列表库::获取整数(名字组, i));
        列表库::删除列表(列表库::获取整数(步骤组, i));
        i = i + 1;
    }

    变量 新运行ID: 整数 = 列表库::创建字符串列表();
    变量 新运行代理: 整数 = 列表库::创建字符串列表();
    变量 新运行起: 整数 = 列表库::创建整数列表();
    变量 新运行止: 整数 = 列表库::创建整数列表();
    变量 新栈组: 整数 = 列表库::创建整数列表();
    变量 新父组: 整数 = 列表库::创建整数列表();
    变量 新起组: 整数 = 列表库::创建整数列表();
    变量 新止组: 整数 = 列表库::创建整数列表();
    变量 新令牌组: 整数 = 列表库::创建整数列表();
    变量 新成本组: 整数 = 列表库::创建整数列表();
    变量 新状态组: 整数 = 列表库::创建整数列表();
    变量 新深度组: 整数 = 列表库::创建整数列表();
    变量 新类型组: 整数 = 列表库::创建整数列表();
    变量 新名字组: 整数 = 列表库::创建整数列表();
    变量 新步骤组: 整数 = 列表库::创建整数列表();

    i = 丢弃数;
    当 (i < 总数) {
        列表库::添加字符串(新运行ID, 列表库::获取字符串(运行ID表, i));
        列表库::添加字符串(新运行代理, 列表库::获取字符串(运行代理表, i));
        列表库::添加整数(新运行起, 列表库::获取整数(运行起表, i));
        列表库::添加整数(新运行止, 列表库::获取整数(运行止表, i));
        列表库::添加整数(新栈组, 列表库::获取整数(运行栈组, i));
        列表库::添加整数(新父组, 列表库::获取整数(父组, i));
        列表库::添加整数(新起组, 列表库::获取整数(起组, i));
        列表库::添加整数(新止组, 列表库::获取整数(止组, i));
        列表库::添加整数(新令牌组, 列表库::获取整数(令牌组, i));
        列表库::添加整数(新成本组, 列表库::获取整数(成本组, i));
        列表库::添加整数(新状态组, 列表库::获取整数(状态组, i));
        列表库::添加整数(新深度组, 列表库::获取整数(深度组, i));
        列表库::添加整数(新类型组, 列表库::获取整数(类型组, i));
        列表库::添加整数(新名字组, 列表库::获取整数(名字组, i));
        列表库::添加整数(新步骤组, 列表库::获取整数(步骤组, i));
        i = i + 1;
    }

    列表库::删除列表(运行ID表);   运行ID表 = 新运行ID;
    列表库::删除列表(运行代理表); 运行代理表 = 新运行代理;
    列表库::删除列表(运行起表);   运行起表 = 新运行起;
    列表库::删除列表(运行止表);   运行止表 = 新运行止;
    列表库::删除列表(运行栈组);   运行栈组 = 新栈组;
    列表库::删除列表(父组);       父组 = 新父组;
    列表库::删除列表(起组);       起组 = 新起组;
    列表库::删除列表(止组);       止组 = 新止组;
    列表库::删除列表(令牌组);     令牌组 = 新令牌组;
    列表库::删除列表(成本组);     成本组 = 新成本组;
    列表库::删除列表(状态组);     状态组 = 新状态组;
    列表库::删除列表(深度组);     深度组 = 新深度组;
    列表库::删除列表(类型组);     类型组 = 新类型组;
    列表库::删除列表(名字组);     名字组 = 新名字组;
    列表库::删除列表(步骤组);     步骤组 = 新步骤组;
}

// 开一个新 run 仓，返回下标
函数 新运行(运行ID: 字符串, 代理名: 字符串, 时刻: 整数) : 整数 {
    确保表();
    列表库::添加字符串(运行ID表, 运行ID);
    列表库::添加字符串(运行代理表, 代理名);
    列表库::添加整数(运行起表, 时刻);
    列表库::添加整数(运行止表, -1);
    列表库::添加整数(运行栈组, 列表库::创建整数列表());
    列表库::添加整数(父组, 列表库::创建整数列表());
    列表库::添加整数(起组, 列表库::创建整数列表());
    列表库::添加整数(止组, 列表库::创建整数列表());
    列表库::添加整数(令牌组, 列表库::创建整数列表());
    列表库::添加整数(成本组, 列表库::创建整数列表());
    列表库::添加整数(状态组, 列表库::创建整数列表());
    列表库::添加整数(深度组, 列表库::创建整数列表());
    列表库::添加整数(类型组, 列表库::创建字符串列表());
    列表库::添加整数(名字组, 列表库::创建字符串列表());
    列表库::添加整数(步骤组, 列表库::创建字符串列表());
    淘汰();
    返回 列表库::字符串列表大小(运行ID表) - 1;
}

// ——— 栈操作（栈里存 span 的局部下标）———
函数 栈顶(运行下标: 整数) : 整数 {
    变量 栈: 整数 = 列表库::获取整数(运行栈组, 运行下标);
    变量 n: 整数 = 列表库::整数列表大小(栈);
    如果 (n == 0) { 返回 -1; }
    返回 列表库::获取整数(栈, n - 1);
}

函数 入栈(运行下标: 整数, 跨度下标: 整数) {
    列表库::添加整数(列表库::获取整数(运行栈组, 运行下标), 跨度下标);
}

// 列表库没有 pop：用一个「栈深」游标模拟不现实（还要另存），所以出栈 = 重建。
// 栈最深也就 agent>turn>llm/tool 三四层，重建代价可以忽略。
函数 出栈(运行下标: 整数) : 整数 {
    变量 栈: 整数 = 列表库::获取整数(运行栈组, 运行下标);
    变量 n: 整数 = 列表库::整数列表大小(栈);
    如果 (n == 0) { 返回 -1; }
    变量 顶: 整数 = 列表库::获取整数(栈, n - 1);
    变量 新栈: 整数 = 列表库::创建整数列表();
    变量 i: 整数 = 0;
    当 (i < n - 1) {
        列表库::添加整数(新栈, 列表库::获取整数(栈, i));
        i = i + 1;
    }
    列表库::设置整数(运行栈组, 运行下标, 新栈);
    列表库::删除列表(栈);
    返回 顶;
}

// 在栈里从顶往下找第一个类型匹配的 span，并把它连同其上的所有 span 一起弹出。
// 为什么不是「直接弹栈顶」：一旦某个 _end 事件丢了（比如新加的模块只发了 start），
// 栈会永远歪掉，之后所有 span 都挂错父亲。按类型匹配能自愈 —— 中间那些没等到
// _end 的 span 就地按「未结束」收尾。
函数 弹到类型(运行下标: 整数, 跨度类型: 字符串) : 整数 {
    变量 栈: 整数 = 列表库::获取整数(运行栈组, 运行下标);
    变量 类型表: 整数 = 列表库::获取整数(类型组, 运行下标);
    变量 n: 整数 = 列表库::整数列表大小(栈);
    变量 i: 整数 = n - 1;
    当 (i >= 0) {
        变量 候选: 整数 = 列表库::获取整数(栈, i);
        如果 (字符串::等于(列表库::获取字符串(类型表, 候选), 跨度类型) == 1) {
            变量 深: 整数 = n - i;
            变量 弹出: 整数 = -1;
            变量 k: 整数 = 0;
            当 (k < 深) {
                弹出 = 出栈(运行下标);
                k = k + 1;
            }
            返回 候选;
        }
        i = i - 1;
    }
    返回 -1;
}

// ——— 采集器 ———

// 事件类型里的 _start / _end 后缀剥掉，得到 span 类型（agent/turn/llm/tool/retry）
函数 基础类型(事件类型: 字符串, 是开始: 整数) : 字符串 {
    变量 长: 整数 = 字符串::字节长度(事件类型);
    如果 (是开始 == 1) { 返回 字符串::子串(事件类型, 0, 长 - 6); }
    返回 字符串::子串(事件类型, 0, 长 - 4);
}

// 载荷里挑一个人看得懂的名字。工具事件带 name，别的退回步骤 ID。
函数 取名字(载荷: 整数, 步骤ID: 字符串, 跨度类型: 字符串) : 字符串 {
    如果 (载荷 > 0) {
        如果 (J.是否包含键(载荷, "name") == 1) { 返回 J.获取字符串(载荷, "name"); }
        如果 (J.是否包含键(载荷, "tool") == 1) { 返回 J.获取字符串(载荷, "tool"); }
    }
    如果 (字符串::字节长度(步骤ID) > 0) { 返回 步骤ID; }
    返回 跨度类型;
}

函数 错误键(运行下标: 整数, 跨度下标: 整数) : 字符串 {
    返回 整数转字符串(运行下标) + ":" + 整数转字符串(跨度下标);
}

// 订阅回调。生命周期总线是同步交付，所以这里跑在 agent 线程上 ——
// 只做纯内存记账，一次几十纳秒；任何 IO（写文件、发 OTLP）都不能放这儿，
// 否则每次 LLM 调用前后各挨一次阻塞。
// 对外的采集回调。内部有十来处提前 return，所以不在每条路径上手动解锁 ——
// 漏一个就是死锁，而死锁的表现是「agent 跑到一半不动了」，比数据错还难查。
// 统一在这层加锁/解锁，内部那份纯粹是逻辑。
公开 函数 处理生命周期跨度事件(事件JSON: 字符串) : 整数 {
    同步.加锁(采集锁);
    变量 结果值: 整数 = 采集一条(事件JSON);
    同步.解锁(采集锁);
    // 回调在锁**外**触发：订阅方（比如观测指标）可能反过来读跨度树，
    // 在锁内调就是自己等自己。
    如果 (待回调运行 >= 0) {
        变量 r: 整数 = 待回调运行;
        变量 sp: 整数 = 待回调跨度;
        待回调运行 = -1;
        待回调跨度 = -1;
        触发完成回调(r, sp);
    }
    返回 结果值;
}

// 待触发的完成回调（在锁内记下，出锁后再调）
变量 待回调运行: 整数 = -1;
变量 待回调跨度: 整数 = -1;

函数 采集一条(事件JSON: 字符串) : 整数 {
    变量 根: 整数 = J.解码(事件JSON);
    如果 (根 <= 0) { 返回 0; }
    确保表();

    变量 类型值: 字符串 = J.获取字符串(根, "type");
    变量 运行ID: 字符串 = J.获取字符串(根, "run_id");
    变量 代理名: 字符串 = J.获取字符串(根, "agent");
    变量 步骤ID: 字符串 = J.获取字符串(根, "step_id");
    变量 时刻: 整数 = J.获取整数(根, "ts_ms");
    变量 载荷: 整数 = J.获取对象(根, "payload");

    // 没有 run_id 的事件挂不上任何一棵树（模块级事件会这样），直接忽略。
    如果 (字符串::字节长度(运行ID) == 0) { J.删除(根); 返回 1; }

    变量 是开始: 整数 = 字符串::结束于(类型值, "_start");
    变量 是结束: 整数 = 字符串::结束于(类型值, "_end");

    // 非配对事件：error 之类。挂到当前最内层还开着的 span 上，标红。
    如果 (是开始 == 0 && 是结束 == 0) {
        如果 (字符串::等于(类型值, "error") == 1) {
            变量 运行下标2: 整数 = 找运行(运行ID);
            如果 (运行下标2 >= 0) {
                变量 顶: 整数 = 栈顶(运行下标2);
                如果 (顶 >= 0) {
                    列表库::设置整数(列表库::获取整数(状态组, 运行下标2), 顶, 2);
                    变量 因: 字符串 = "error";
                    如果 (载荷 > 0 && J.是否包含键(载荷, "reason") == 1) {
                        因 = J.获取字符串(载荷, "reason");
                    }
                    哈希表::设置字符串(错误表, 错误键(运行下标2, 顶), 因);
                }
            }
        }
        J.删除(根);
        返回 1;
    }

    变量 跨度类型: 字符串 = 基础类型(类型值, 是开始);
    变量 运行下标: 整数 = 找运行(运行ID);

    如果 (是开始 == 1) {
        // agent_start 是一次运行的开端 —— 也是唯一会新建仓的地方。
        如果 (运行下标 < 0) {
            运行下标 = 新运行(运行ID, 代理名, 时刻);
        }
        变量 类型表: 整数 = 列表库::获取整数(类型组, 运行下标);
        如果 (列表库::字符串列表大小(类型表) >= 单运行跨度上限) {
            丢弃跨度数 = 丢弃跨度数 + 1;
            J.删除(根);
            返回 1;
        }
        变量 父: 整数 = 栈顶(运行下标);
        变量 深: 整数 = 0;
        如果 (父 >= 0) {
            深 = 列表库::获取整数(列表库::获取整数(深度组, 运行下标), 父) + 1;
        }
        列表库::添加整数(列表库::获取整数(父组, 运行下标), 父);
        列表库::添加整数(列表库::获取整数(起组, 运行下标), 时刻);
        列表库::添加整数(列表库::获取整数(止组, 运行下标), -1);
        列表库::添加整数(列表库::获取整数(令牌组, 运行下标), 0);
        列表库::添加整数(列表库::获取整数(成本组, 运行下标), 0);
        列表库::添加整数(列表库::获取整数(状态组, 运行下标), 0);
        列表库::添加整数(列表库::获取整数(深度组, 运行下标), 深);
        列表库::添加字符串(类型表, 跨度类型);
        列表库::添加字符串(列表库::获取整数(名字组, 运行下标),
            取名字(载荷, 步骤ID, 跨度类型));
        列表库::添加字符串(列表库::获取整数(步骤组, 运行下标), 步骤ID);
        入栈(运行下标, 列表库::字符串列表大小(类型表) - 1);
        J.删除(根);
        返回 1;
    }

    // _end：配对收尾
    如果 (运行下标 < 0) { J.删除(根); 返回 1; }
    变量 跨度下标: 整数 = 弹到类型(运行下标, 跨度类型);
    如果 (跨度下标 < 0) { J.删除(根); 返回 1; }

    列表库::设置整数(列表库::获取整数(止组, 运行下标), 跨度下标, 时刻);
    变量 状态表: 整数 = 列表库::获取整数(状态组, 运行下标);
    如果 (列表库::获取整数(状态表, 跨度下标) == 0) {
        列表库::设置整数(状态表, 跨度下标, 1);
    }
    如果 (载荷 > 0) {
        变量 令牌: 整数 = 0;
        如果 (J.是否包含键(载荷, "tokens") == 1) { 令牌 = J.获取整数(载荷, "tokens"); }
        如果 (令牌 > 0) {
            列表库::设置整数(列表库::获取整数(令牌组, 运行下标), 跨度下标, 令牌);
        }
        如果 (J.是否包含键(载荷, "cost") == 1) {
            列表库::设置整数(列表库::获取整数(成本组, 运行下标), 跨度下标,
                J.获取整数(载荷, "cost"));
        }
    }
    // agent_end 收整个 run
    如果 (字符串::等于(跨度类型, "agent") == 1) {
        列表库::设置整数(运行止表, 运行下标, 时刻);
    }
    J.删除(根);
    // 记下来、出锁后再触发：回调看到的必须是已经填好耗时/令牌/状态的完整 span
    待回调运行 = 运行下标;
    待回调跨度 = 跨度下标;
    返回 1;
}

公开 函数 安装跨度采集器() : 整数 {
    确保表();
    返回 订阅生命周期事件(处理生命周期跨度事件, 1);
}

// ——— 跨度完成钩子 ———
//
// 每个 span 收尾时回调一次，参数是这条 span 的 JSON。
// 存在的理由是**依赖方向**：指标要喂 Prometheus 注册表，那在 qi-web 里；
// 而 跨度.qi 是 agent 侧的东西，绝不能因为「想看指标」就把整个 web 框架
// 拖进每一个装了采集器的程序。所以这边只出数据，接线的人自己去 import Web。
//
// 回调不能捕获状态（qi 的函数值传进 FFI 是闭包对象地址，不是代码指针），
// 所以只能是顶层具名函数；要带状态的自己用全局变量。
变量 完成回调表: 整数 = 0;

公开 函数 设置跨度完成回调(回调: 函数(字符串): 整数) : 整数 {
    如果 (完成回调表 == 0) { 完成回调表 = 列表库::创建指针列表(); }
    列表库::添加指针(完成回调表, 回调);
    返回 列表库::指针列表大小(完成回调表);
}

函数 触发完成回调(运行下标: 整数, 跨度下标: 整数) {
    如果 (完成回调表 == 0) { 返回; }
    变量 n: 整数 = 列表库::指针列表大小(完成回调表);
    如果 (n == 0) { 返回; }
    变量 运行起: 整数 = 列表库::获取整数(运行起表, 运行下标);
    // span 本体里不存 agent/run（一棵树几十上百条，每条都带一份纯属浪费带宽），
    // 但指标要拿它们当标签，所以只在回调这一路上补进去。
    变量 本体: 字符串 = 跨度JSON(运行下标, 跨度下标, 运行起);
    变量 一条: 字符串 = "{\"agent\":" + 引(列表库::获取字符串(运行代理表, 运行下标))
        + ",\"run\":" + 引(列表库::获取字符串(运行ID表, 运行下标))
        + "," + 字符串::子串(本体, 1, 字符串::字节长度(本体));
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 回调: 函数(字符串): 整数 = 列表库::获取指针(完成回调表, i);
        回调(一条);
        i = i + 1;
    }
}

// ——— 导出 ———
//
// JSON 的键一律英文：这是给看板前端和外部工具消费的**线上协议**，
// 不是 qi 内部标识符。字段缩写是因为一次运行几十上百个 span，
// WebSocket 每帧都要推一遍。
//
//   i    局部下标（父指针指的就是它）
//   p    父下标，-1 = 根
//   t    类型 agent/turn/llm/tool/retry
//   n    名字
//   d    深度
//   o    相对本次运行起点的偏移毫秒（瀑布图直接拿它定位）
//   ms   耗时毫秒，-1 = 还没结束
//   tok  令牌
//   cost 成本（分）
//   st   0 进行中 / 1 成功 / 2 出错
//   err  出错原因（仅 st=2）

函数 跨度JSON(运行下标: 整数, i: 整数, 运行起: 整数) : 字符串 {
    变量 止: 整数 = 列表库::获取整数(列表库::获取整数(止组, 运行下标), i);
    变量 起: 整数 = 列表库::获取整数(列表库::获取整数(起组, 运行下标), i);
    变量 耗时: 整数 = -1;
    如果 (止 >= 0) { 耗时 = 止 - 起; }
    变量 状态: 整数 = 列表库::获取整数(列表库::获取整数(状态组, 运行下标), i);
    变量 行: 字符串 = "{\"i\":" + 整数转字符串(i)
        + ",\"p\":" + 整数转字符串(列表库::获取整数(列表库::获取整数(父组, 运行下标), i))
        + ",\"t\":\"" + 列表库::获取字符串(列表库::获取整数(类型组, 运行下标), i) + "\""
        + ",\"n\":" + 引(列表库::获取字符串(列表库::获取整数(名字组, 运行下标), i))
        + ",\"d\":" + 整数转字符串(列表库::获取整数(列表库::获取整数(深度组, 运行下标), i))
        + ",\"o\":" + 整数转字符串(起 - 运行起)
        + ",\"ms\":" + 整数转字符串(耗时)
        + ",\"tok\":" + 整数转字符串(列表库::获取整数(列表库::获取整数(令牌组, 运行下标), i))
        + ",\"cost\":" + 整数转字符串(列表库::获取整数(列表库::获取整数(成本组, 运行下标), i))
        + ",\"st\":" + 整数转字符串(状态);
    如果 (状态 == 2) {
        行 = 行 + ",\"err\":" + 引(哈希表::获取字符串(错误表, 错误键(运行下标, i)));
    }
    返回 行 + "}";
}

// 一次运行的完整跨度树。运行ID 传 "" = 最近一次。
公开 函数 跨度树JSON(运行ID: 字符串) : 字符串 {
    同步.加锁(采集锁);
    变量 出: 字符串 = 跨度树JSON内部(运行ID);
    同步.解锁(采集锁);
    返回 出;
}

函数 跨度树JSON内部(运行ID: 字符串) : 字符串 {
    确保表();
    变量 运行下标: 整数 = 运行数() - 1;
    如果 (字符串::字节长度(运行ID) > 0) { 运行下标 = 找运行(运行ID); }
    如果 (运行下标 < 0) { 返回 "{\"run\":\"\",\"spans\":[]}"; }

    变量 运行起: 整数 = 列表库::获取整数(运行起表, 运行下标);
    变量 运行止: 整数 = 列表库::获取整数(运行止表, 运行下标);
    变量 总耗时: 整数 = -1;
    如果 (运行止 >= 0) { 总耗时 = 运行止 - 运行起; }
    否则 { 总耗时 = 时间.当前毫秒() - 运行起; }

    变量 类型表: 整数 = 列表库::获取整数(类型组, 运行下标);
    变量 数量: 整数 = 列表库::字符串列表大小(类型表);
    变量 令牌合计: 整数 = 0;
    变量 成本合计: 整数 = 0;
    变量 体: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 数量) {
        如果 (i > 0) { 体 = 体 + ","; }
        体 = 体 + 跨度JSON(运行下标, i, 运行起);
        // 只累加叶子层的 llm/tool，避免父 span 重复计入
        变量 t: 字符串 = 列表库::获取字符串(类型表, i);
        如果 (字符串::等于(t, "llm") == 1 || 字符串::等于(t, "tool") == 1) {
            令牌合计 = 令牌合计 + 列表库::获取整数(列表库::获取整数(令牌组, 运行下标), i);
            成本合计 = 成本合计 + 列表库::获取整数(列表库::获取整数(成本组, 运行下标), i);
        }
        i = i + 1;
    }

    返回 "{\"run\":" + 引(列表库::获取字符串(运行ID表, 运行下标))
        + ",\"agent\":" + 引(列表库::获取字符串(运行代理表, 运行下标))
        + ",\"start\":" + 整数转字符串(运行起)
        + ",\"ms\":" + 整数转字符串(总耗时)
        + ",\"live\":" + 是否(运行未结束(运行止))
        + ",\"tokens\":" + 整数转字符串(令牌合计)
        + ",\"cost\":" + 整数转字符串(成本合计)
        + ",\"spans\":[" + 体 + "]}";
}

// 最近若干次运行的摘要（看板左栏的列表）。最新的排在前面。
公开 函数 最近运行JSON(最多: 整数) : 字符串 {
    同步.加锁(采集锁);
    变量 出: 字符串 = 最近运行JSON内部(最多);
    同步.解锁(采集锁);
    返回 出;
}

函数 最近运行JSON内部(最多: 整数) : 字符串 {
    确保表();
    变量 总数: 整数 = 运行数();
    变量 取数: 整数 = 最多;
    如果 (取数 <= 0 || 取数 > 总数) { 取数 = 总数; }
    变量 体: 字符串 = "";
    变量 现在: 整数 = 时间.当前毫秒();
    变量 k: 整数 = 0;
    当 (k < 取数) {
        变量 i: 整数 = 总数 - 1 - k;
        变量 起: 整数 = 列表库::获取整数(运行起表, i);
        变量 止: 整数 = 列表库::获取整数(运行止表, i);
        变量 耗时: 整数 = 现在 - 起;
        如果 (止 >= 0) { 耗时 = 止 - 起; }
        如果 (k > 0) { 体 = 体 + ","; }
        体 = 体 + "{\"run\":" + 引(列表库::获取字符串(运行ID表, i))
            + ",\"agent\":" + 引(列表库::获取字符串(运行代理表, i))
            + ",\"start\":" + 整数转字符串(起)
            + ",\"ms\":" + 整数转字符串(耗时)
            + ",\"spans\":" + 整数转字符串(列表库::字符串列表大小(列表库::获取整数(类型组, i)))
            + ",\"live\":" + 是否(运行未结束(止)) + "}";
        k = k + 1;
    }
    返回 "[" + 体 + "]";
}

公开 函数 清空() : 整数 {
    如果 (表已建 == 0) { 返回 0; }
    变量 保留: 整数 = 保留运行数;
    保留运行数 = 0;
    淘汰();
    保留运行数 = 保留;
    丢弃跨度数 = 0;
    返回 1;
}

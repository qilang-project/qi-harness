// 图记忆 — agent 的**关系型**记忆（属性图，建在 qi-graph / qi-kv 上）
//
// harness 到这里为止有两路召回，都答不了关系型问题：
//   记忆.qi       SQLite 单表 + LIKE 逐词匹配 —— **词法**召回
//   向量记忆.qi   余弦相似度 —— **语义**召回
// 「谁用过这个工具」「这个模块依赖什么」「A 和 B 之间是怎么连上的」这类问题，
// 靠词法和语义都只能碰运气：答案不在某一条记忆的字面里，而在**条目之间的边**上。
// 本模块把那些边显式存下来，于是可以顺着边走。
//
//   记实体(库, "mcp:fetch", "工具")
//   关联(库, "研究员", "用过", "mcp:fetch")
//   图回忆(库, "研究员", 5)        →  -【用过】研究员 → mcp:fetch（默认 2 跳）
//   怎么连的(库, "研究员", "网页")  →  -【路径】研究员 → mcp:fetch → 网页
//
// **输出格式与 记忆.回忆 对齐**（每行 `-【标签】正文`），所以三路召回的块可以
// 直接拼在一起丢进提示词，不需要各写各的渲染。没命中一律返回 ""，跟 回忆 一致。
//
// ── 名字里的冒号 ────────────────────────────────────────────────────
// qi-graph 的键靠 ':' 分段，所以节点 id 和边类型都不能含冒号（合法段 会拒）。
// 而 agent 世界里的名字偏偏常带冒号：mcp:fetch、用户:1、http://…。
// 于是内部走 安全名()：能直接当段用的原样，不能的整串转十六进制（可逆、不撞车），
// **原名存进节点/边的属性**。查找时过 安全名，展示时读回原名 —— 调用方全程只见原名。
//
// ── 依赖 ────────────────────────────────────────────────────────────
// 本文件（也只有本文件）依赖 qi-graph（包名 Graph）+ qi-kv（包名 KV）。
// 不导入本模块符号的程序不受影响 —— 所以 Harness.qi 故意不 re-export 它，
// 跟 观测台（依赖 qi-web）同样的道理：不能让每个用 Harness 的程序都得解析到
// 一个它根本不用的包。要用就显式：
//   导入 Harness.图记忆::{打开图记忆, 记实体, 关联, 图回忆, 怎么连的, 关闭图记忆};
//
// 注意别跟 图.qi 混：那个是**控制流**图（LangGraph-lite，节点是函数、边是跳转），
// 这个是**数据**图（节点是实体、边是关系）。两者除了名字没有关系。

包 Harness;

导入 标准库.字符串;
导入 标准库.字节切片;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 哈希表;
导入 Graph::{打开图, 关闭图, 图可用, 加节点, 有节点, 取属性,
    加边, 出边, 入边, 取边, 最短路径, 按类型列边,
    节点数, 边数, 合法段};
导入 Harness.代理::{代理, 设置关系召回器, 设置代理图记忆库, 代理图记忆库, 添加工具};
导入 Harness.工具::{工具, 设置工具钩子};
导入 Harness.追踪::{错误事件};

// ── 名字 ↔ 键段 ──────────────────────────────────────────────────

// 原名 → 可当 qi-graph 键段用的安全名。
// 能直接用的（非空、不含 ':'）原样返回；否则整串转十六进制加前缀 —— 可逆、
// 不同原名不会撞到同一个安全名。参考 标准库.大模型 的 工具安全名。
函数 安全名(原名: 字符串) : 字符串 {
    如果 (合法段(原名) == 1) { 返回 原名; }
    变量 切片: 整数 = 字节切片::从字符串(原名);
    变量 十六: 字符串 = 字节切片::转十六进制(切片);
    字节切片::释放切片(切片);
    返回 "qi_g_" + 十六;
}

// 节点的展示名：属性里的 "名字"；读不到就退回安全名（至少不空）。
函数 节点显示名(库: 整数, 安全id: 字符串) : 字符串 {
    变量 属性文本: 字符串 = 取属性(库, 安全id);
    如果 (字符串::字节长度(属性文本) == 0) { 返回 安全id; }
    变量 属性: 整数 = J.解码(属性文本);
    如果 (属性 <= 0) { 返回 安全id; }
    变量 名: 字符串 = J.获取字符串(属性, "名字");
    J.删除(属性);
    如果 (字符串::字节长度(名) == 0) { 返回 安全id; }
    返回 名;
}

// 一条边渲染成一行：-【关系】主体 → 客体（关系/两端都用原名）。取不到边返回 ""。
函数 边成行(库: 整数, 边id: 字符串) : 字符串 {
    变量 边文本: 字符串 = 取边(库, 边id);
    如果 (字符串::字节长度(边文本) == 0) { 返回 ""; }
    变量 边对象: 整数 = J.解码(边文本);
    如果 (边对象 <= 0) { 返回 ""; }
    变量 起: 字符串 = J.获取字符串(边对象, "from");
    变量 止: 字符串 = J.获取字符串(边对象, "to");
    变量 关系: 字符串 = "";
    变量 属性: 整数 = J.获取对象(边对象, "props");   // 深拷贝，用完删
    如果 (属性 > 0) {
        关系 = J.获取字符串(属性, "关系");
        J.删除(属性);
    }
    如果 (字符串::字节长度(关系) == 0) { 关系 = J.获取字符串(边对象, "type"); }
    J.删除(边对象);
    返回 "-【" + 关系 + "】" + 节点显示名(库, 起) + " → " + 节点显示名(库, 止);
}

// ── 开关 ────────────────────────────────────────────────────────

// 打开（不存在则新建）图记忆库。返回库句柄（>0）；打不开返回 0。
// qi-graph 的 打开图 失败时给 -1，这里归一成 0，跟 打开记忆 一个约定。
// 省略跳数时走几跳。2 = 「顺着边走一步」，是这个模块区别于查找表的最小深度。
变量 默认跳数: 整数 = 2;

// 调默认跳数（进程级）。图特别密时可以调回 1 控扇出，或调到 3 找更远的关系。
公开 函数 设置图记忆默认跳数(跳数: 整数) : 整数 {
    如果 (跳数 <= 0) { 返回 默认跳数; }
    默认跳数 = 跳数;
    返回 默认跳数;
}

公开 函数 图记忆默认跳数() : 整数 { 返回 默认跳数; }

公开 函数 打开图记忆(库路径: 字符串) : 整数 {
    变量 库: 整数 = 打开图(库路径);
    如果 (库 <= 0) { 返回 0; }
    返回 库;
}

// 关闭图记忆库（顺带落盘）。成功返回 1。
公开 函数 关闭图记忆(库: 整数) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    关闭图(库);
    返回 1;
}

// 库还能用吗（句柄有效且底层 kv 没坏）。
公开 函数 图记忆可用(库: 整数) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    返回 图可用(库);
}

// ── 写 ──────────────────────────────────────────────────────────

// 登记一个实体。幂等：已经有了就什么都不做、照样返回 1。
// 种类当标签存（"工具" / "人" / "模块" …），空种类按 "实体" 处理。
// 名字为空返回 0。
公开 函数 记实体(库: 整数, 名字: 字符串, 种类: 字符串) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    如果 (字符串::字节长度(名字) == 0) { 返回 0; }
    变量 id: 字符串 = 安全名(名字);
    如果 (有节点(库, id) == 1) { 返回 1; }

    变量 实际种类: 字符串 = 种类;
    如果 (字符串::字节长度(实际种类) == 0) { 实际种类 = "实体"; }

    变量 标签组: 整数 = J.创建数组();
    J.数组添加字符串(标签组, 安全名(实际种类));
    变量 标签JSON: 字符串 = J.转字符串(标签组);
    J.删除(标签组);

    变量 属性: 整数 = J.创建对象();
    J.设置字符串(属性, "名字", 名字);
    J.设置字符串(属性, "种类", 实际种类);
    变量 属性JSON: 字符串 = J.转字符串(属性);
    J.删除(属性);

    返回 加节点(库, id, 标签JSON, 属性JSON);
}

// 已经有这条边了吗？有则返回边 id，没有返回 ""。
// 「同一对端点 + 同一关系」算同一条 —— 关联 的幂等就靠它。
函数 找已有边(库: 整数, 起安全名: 字符串, 边类型: 字符串, 止安全名: 字符串) : 字符串 {
    变量 边表: 整数 = 出边(库, 起安全名);
    如果 (边表 <= 0) { 返回 ""; }
    变量 边数量: 整数 = 列表库::字符串列表大小(边表);
    变量 命中: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 边数量) {
        变量 边id: 字符串 = 列表库::获取字符串(边表, i);
        变量 边对象: 整数 = J.解码(取边(库, 边id));
        如果 (边对象 > 0) {
            如果 (字符串::等于(J.获取字符串(边对象, "type"), 边类型) == 1
                && 字符串::等于(J.获取字符串(边对象, "to"), 止安全名) == 1) {
                命中 = 边id;
            }
            J.删除(边对象);
        }
        如果 (字符串::字节长度(命中) > 0) { 跳出; }
        i = i + 1;
    }
    列表库::删除列表(边表);
    返回 命中;
}

// 关联带属性 的实现体。属性JSON 解不出（或不是对象）时按空对象处理。
函数 连起来(库: 整数, 主体: 字符串, 关系: 字符串, 客体: 字符串, 属性JSON: 字符串) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    如果 (字符串::字节长度(主体) == 0 || 字符串::字节长度(关系) == 0) { 返回 0; }
    如果 (字符串::字节长度(客体) == 0) { 返回 0; }

    // 两端不存在就顺手建（种类 "实体"）—— 调用方不必先 记实体 再 关联
    记实体(库, 主体, "实体");
    记实体(库, 客体, "实体");

    变量 起: 字符串 = 安全名(主体);
    变量 止: 字符串 = 安全名(客体);
    变量 边类型: 字符串 = 安全名(关系);
    如果 (字符串::字节长度(找已有边(库, 起, 边类型, 止)) > 0) { 返回 1; }

    变量 属性: 整数 = 0;
    变量 净: 字符串 = 字符串::去空白(属性JSON);
    如果 (字符串::开始于(净, "{") == 1) { 属性 = J.解码(净); }
    如果 (属性 <= 0) { 属性 = J.创建对象(); }
    J.设置字符串(属性, "关系", 关系);       // 原名留底，展示时读它
    变量 属性文本: 字符串 = J.转字符串(属性);
    J.删除(属性);

    返回 加边(库, "", 边类型, 起, 止, 属性文本);
}

// 记一条关系。两端实体不存在会自动建（种类 "实体"）。
// 幂等：同一对端点 + 同一关系重复调用不会长出第二条边，返回 1。
公开 函数 关联(库: 整数, 主体: 字符串, 关系: 字符串, 客体: 字符串) : 整数 {
    返回 连起来(库, 主体, 关系, 客体, "");
}

// 同 关联，但给这条边挂上额外属性（如 {"次数":3,"时间":"2026-09-06"}）。
// 边已存在时不覆盖属性，直接返回 1（保持幂等）。
公开 函数 关联带属性(库: 整数, 主体: 字符串, 关系: 字符串, 客体: 字符串, 属性JSON: 字符串) : 整数 {
    返回 连起来(库, 主体, 关系, 客体, 属性JSON);
}

// ── 读 ──────────────────────────────────────────────────────────

// 从 起点 出发按无向邻域走 跳数 跳，把沿途的边渲染成行追加进 行表。
// 已收边 / 已访点 是跨关键词共享的去重表 —— 多个关键词的邻域重叠时不会出重复行。
// 行表满（>= 条数上限）就停。
函数 邻域成行(库: 整数, 起点: 字符串, 跳数: 整数, 条数上限: 整数,
        已收边: 整数, 已访点: 整数, 行表: 整数) : 整数 {
    变量 前沿: 整数 = 列表库::创建字符串列表();
    如果 (哈希表::获取整数(已访点, 起点) == 0) {
        哈希表::设置整数(已访点, 起点, 1);
    }
    列表库::添加字符串(前沿, 起点);

    变量 深: 整数 = 0;
    当 (深 < 跳数) {
        如果 (列表库::字符串列表大小(前沿) == 0) { 跳出; }
        如果 (列表库::字符串列表大小(行表) >= 条数上限) { 跳出; }
        变量 下一层: 整数 = 列表库::创建字符串列表();
        变量 点数: 整数 = 列表库::字符串列表大小(前沿);
        变量 p: 整数 = 0;
        当 (p < 点数) {
            变量 当前点: 字符串 = 列表库::获取字符串(前沿, p);
            // 两个方向都走：「X 依赖什么」看出边，「谁用过 X」看入边
            变量 方向: 整数 = 0;
            当 (方向 < 2) {
                // 两个句柄别在同一个变量上覆盖 —— 那会漏掉先拿的那张表
                变量 边表: 整数 = 0;
                如果 (方向 == 0) { 边表 = 出边(库, 当前点); }
                否则 { 边表 = 入边(库, 当前点); }
                如果 (边表 > 0) {
                    变量 边数量: 整数 = 列表库::字符串列表大小(边表);
                    变量 i: 整数 = 0;
                    当 (i < 边数量) {
                        如果 (列表库::字符串列表大小(行表) >= 条数上限) { 跳出; }
                        变量 边id: 字符串 = 列表库::获取字符串(边表, i);
                        如果 (哈希表::获取整数(已收边, 边id) == 0) {
                            哈希表::设置整数(已收边, 边id, 1);
                            变量 行: 字符串 = 边成行(库, 边id);
                            如果 (字符串::字节长度(行) > 0) {
                                列表库::添加字符串(行表, 行);
                            }
                        }
                        // 对端进下一层（不管这条边收没收过 —— 路可能是别人走出来的）
                        变量 边对象: 整数 = J.解码(取边(库, 边id));
                        如果 (边对象 > 0) {
                            变量 对端: 字符串 = J.获取字符串(边对象, "to");
                            如果 (方向 == 1) { 对端 = J.获取字符串(边对象, "from"); }
                            如果 (字符串::字节长度(对端) > 0
                                && 哈希表::获取整数(已访点, 对端) == 0) {
                                哈希表::设置整数(已访点, 对端, 1);
                                列表库::添加字符串(下一层, 对端);
                            }
                            J.删除(边对象);
                        }
                        i = i + 1;
                    }
                    列表库::删除列表(边表);
                }
                方向 = 方向 + 1;
            }
            p = p + 1;
        }
        列表库::删除列表(前沿);
        前沿 = 下一层;
        深 = 深 + 1;
    }
    列表库::删除列表(前沿);
    返回 列表库::字符串列表大小(行表);
}

// 行表拼成文本块（每行一条，无尾换行）。空表返回 ""。
函数 行表成块(行表: 整数) : 字符串 {
    变量 n: 整数 = 列表库::字符串列表大小(行表);
    变量 块: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (i > 0) { 块 = 块 + "\n"; }
        块 = 块 + 列表库::获取字符串(行表, i);
        i = i + 1;
    }
    返回 块;
}

// 按关键词做关系召回，走 跳数 跳邻域。
//
// 查询关键词逗号分隔（中英文逗号都认，跟 记忆.回忆 同款）。每个关键词过 安全名
// 后能在图里找到节点的，就把它 跳数 跳邻域内的边渲染出来；多个关键词的结果合并
// 去重，最多 条数上限 行。没命中返回 ""。
//
// 返回的文本块格式与 记忆.回忆 一致（每行 `-【…】…`），可以直接拼在一起。
公开 函数 图回忆(库: 整数, 查询关键词: 字符串, 跳数: 整数, 条数上限: 整数) : 字符串 {
    如果 (库 <= 0) { 返回 ""; }
    变量 实际跳数: 整数 = 跳数;
    如果 (实际跳数 <= 0) { 实际跳数 = 1; }
    变量 实际上限: 整数 = 条数上限;
    如果 (实际上限 <= 0) { 实际上限 = 5; }

    变量 规整: 字符串 = 字符串::替换(查询关键词, "，", ",");
    变量 词表: 整数 = 字符串::分割(规整, ",");
    变量 词数: 整数 = 列表库::字符串列表大小(词表);

    变量 行表: 整数 = 列表库::创建字符串列表();
    变量 已收边: 整数 = 哈希表::创建整数表();
    变量 已访点: 整数 = 哈希表::创建整数表();

    变量 i: 整数 = 0;
    当 (i < 词数) {
        变量 词: 字符串 = 字符串::去空白(列表库::获取字符串(词表, i));
        如果 (字符串::字节长度(词) > 0) {
            变量 起点: 字符串 = 安全名(词);
            如果 (有节点(库, 起点) == 1) {
                邻域成行(库, 起点, 实际跳数, 实际上限, 已收边, 已访点, 行表);
            }
        }
        如果 (列表库::字符串列表大小(行表) >= 实际上限) { 跳出; }
        i = i + 1;
    }
    列表库::删除列表(词表);

    变量 块: 字符串 = 行表成块(行表);
    列表库::删除列表(行表);
    返回 块;
}

// 省略跳数的便利版。用 默认跳数（**2 跳**，不是 1）。
//
// 为什么默认 2：一跳召回只给直接邻居 —— 那是一张查找表能做的事，本模块存在
// 的理由（「A 和 B 之间是怎么连上的」「作者住哪」）全在二度以上。这个便利版
// 又是签名最短、最容易被顺手用的那个，默认给 1 等于把卖点默默关掉。
// 实测：图里 `语料.txt --作者是--> 小奇 --住在--> 成都`，1 跳时模型回答
// 「住址未知」，2 跳才两条都用上。
//
// 扇出由 条数上限 兜住，不会因为跳多了就爆。要更深自己用四参版。
公开 函数 图回忆(库: 整数, 查询关键词: 字符串, 条数上限: 整数) : 字符串 {
    返回 图回忆(库, 查询关键词, 默认跳数, 条数上限);
}

// 甲 和 乙 是怎么连上的 —— 最短路径渲染成一行：
//   -【路径】甲 → 中间 → 乙
// 两端有一个不在图里、或者压根不连通，返回 ""（跟其他召回一致，好直接拼）。
公开 函数 怎么连的(库: 整数, 甲: 字符串, 乙: 字符串) : 字符串 {
    如果 (库 <= 0) { 返回 ""; }
    变量 起: 字符串 = 安全名(甲);
    变量 止: 字符串 = 安全名(乙);
    如果 (有节点(库, 起) == 0 || 有节点(库, 止) == 0) { 返回 ""; }

    变量 路: 整数 = 最短路径(库, 起, 止);
    如果 (路 <= 0) { 返回 ""; }
    变量 步数: 整数 = 列表库::字符串列表大小(路);
    如果 (步数 == 0) {
        列表库::删除列表(路);
        返回 "";
    }
    变量 行: 字符串 = "-【路径】";
    变量 i: 整数 = 0;
    当 (i < 步数) {
        如果 (i > 0) { 行 = 行 + " → "; }
        行 = 行 + 节点显示名(库, 列表库::获取字符串(路, i));
        i = i + 1;
    }
    列表库::删除列表(路);
    返回 行;
}

// 按关系名召回：把这个关系的边挨个渲染出来（最多 条数上限 行）。
// 「所有『依赖』关系都有哪些」这类问题用它。没有返回 ""。
公开 函数 按关系回忆(库: 整数, 关系: 字符串, 条数上限: 整数) : 字符串 {
    如果 (库 <= 0) { 返回 ""; }
    如果 (字符串::字节长度(关系) == 0) { 返回 ""; }
    变量 实际上限: 整数 = 条数上限;
    如果 (实际上限 <= 0) { 实际上限 = 5; }

    变量 边表: 整数 = 按类型列边(库, 安全名(关系));
    如果 (边表 <= 0) { 返回 ""; }
    变量 边数量: 整数 = 列表库::字符串列表大小(边表);
    变量 行表: 整数 = 列表库::创建字符串列表();
    变量 i: 整数 = 0;
    当 (i < 边数量) {
        如果 (列表库::字符串列表大小(行表) >= 实际上限) { 跳出; }
        变量 行: 字符串 = 边成行(库, 列表库::获取字符串(边表, i));
        如果 (字符串::字节长度(行) > 0) { 列表库::添加字符串(行表, 行); }
        i = i + 1;
    }
    列表库::删除列表(边表);
    变量 块: 字符串 = 行表成块(行表);
    列表库::删除列表(行表);
    返回 块;
}

// 库里记了多少条关系（= 边数）。
公开 函数 图记忆条数(库: 整数) : 整数 {
    如果 (库 <= 0) { 返回 0; }
    返回 边数(库);
}

// 统计快照 JSON：{"available":1,"entities":3,"relations":2}
公开 函数 图记忆统计(库: 整数) : 字符串 {
    变量 根: 整数 = J.创建对象();
    J.设置整数(根, "available", 图记忆可用(库));
    变量 点: 整数 = 0;
    变量 边: 整数 = 0;
    如果 (库 > 0) {
        点 = 节点数(库);
        边 = 边数(库);
    }
    J.设置整数(根, "entities", 点);
    J.设置整数(根, "relations", 边);
    变量 文本: 字符串 = J.转字符串(根);
    J.删除(根);
    返回 文本;
}

// ── 代理集成 ────────────────────────────────────────────────────
//
// 依赖方向是 图记忆 → 代理，不是反过来：代理.qi 一旦引本模块的符号，qi-graph +
// qi-kv 就成了所有 Harness 用户的硬依赖（实测连 创建代理 都编不过）。所以
// 代理.qi 那边只留一个不透明句柄槽 + 一个召回钩子，接线在这里做。

// 代理自动召回时用的跳数。签名固定成 函数(整数, 字符串, 整数) : 字符串 ——
// 图回忆 有两个元数重载，直接当函数值传会有歧义，包一层。
//
// 这里原来也是写死 1 跳，于是**所有通过 启用图记忆 接进来的代理拿到的都是
// 一跳召回** —— 图记忆退化成查找表，那些非要有边才能答的问题一个都答不了。
函数 图关系召回(库: 整数, 查询关键词: 字符串, 条数上限: 整数) : 字符串 {
    返回 图回忆(库, 查询关键词, 默认跳数, 条数上限);
}

// 给代理接上图记忆库（qi-graph 属性图，落在一个 qi-kv 文件里）。
// 路径不存在会自动建库。返回更新后的 代理；打开失败时句柄保持 0
// —— 那样 带记忆运行 会自动退化成只走词法那一路，不会崩。
//
// 跟 启用记忆 是两路正交的记忆，可以同时开：
//   代理值 = 启用记忆(代理值, "/x/记忆.db");     // 词法
//   代理值 = 启用图记忆(代理值, "/x/关系.kv");   // 关系
// 之后 带记忆运行 会把两路的召回块合并注入（格式一致，直接拼）。
公开 函数 启用图记忆(代理值: 代理, 库路径: 字符串) : 代理 {
    设置关系召回器(图关系召回);
    变量 库: 整数 = 打开图记忆(库路径);
    如果 (库 <= 0) {
        错误事件(代理值.名字, "图记忆库打开失败: " + 库路径);
    }
    返回 设置代理图记忆库(代理值, 库);
}

// 便捷转发：往代理挂着的图记忆里记一条关系（两端实体不存在会自动建）。
// 没启用图记忆返回 0。等价于 关联(代理图记忆库(代理值), …)。
公开 函数 记关联(代理值: 代理, 主体: 字符串, 关系: 字符串, 客体: 字符串) : 整数 {
    变量 库: 整数 = 代理图记忆库(代理值);
    如果 (库 <= 0) { 返回 0; }
    返回 关联(库, 主体, 关系, 客体);
}

// ── 给模型的图工具 ──────────────────────────────────────────────
//
// 到这里为止，图对模型是**只读**的：召回由 带记忆运行 自动注入，模型自己
// 既不能主动查、也不能把学到的东西记回去。那样图就只是个静态夹具 —— 得有人
// 在循环外面把它填好。
//
// 长任务尤其需要写：第 1 段查到「这个接口要带 X-Token 头」，第 2 段是全新
// 会话，除非它被记进图里，否则等于没学到。
//
// 三个工具：
//   记事实(主体, 关系, 客体)   把学到的关系写进图
//   查关系(关键词, 跳数)       主动查，而不是只吃自动注入的那一份
//   怎么连的(甲, 乙)           两个东西之间的路径
//
// 句柄传递照 文件工具.qi 的槽位办法：tool 处理函数签名固定 函数(字符串):字符串，
// 拿不到代理，所以把库句柄经前置钩子注进参数 JSON。槽位有界（8 个）是因为
// 函数指针不能动态生成 —— 同 技能.qi。

变量 图工具槽表: 整数 = 0;   // 槽位 → 图库句柄

函数 确保槽表() {
    如果 (图工具槽表 == 0) { 图工具槽表 = 列表库::创建整数列表(); }
}

// 给这个图库要一个工具槽位；满了返回 -1。
函数 要图槽位(库: 整数) : 整数 {
    确保槽表();
    变量 n: 整数 = 列表库::整数列表大小(图工具槽表);
    变量 i: 整数 = 0;
    当 (i < n) {
        如果 (列表库::获取整数(图工具槽表, i) == 库) { 返回 i; }   // 同一个库复用槽位
        i = i + 1;
    }
    如果 (n >= 8) { 返回 0 - 1; }
    列表库::添加整数(图工具槽表, 库);
    返回 n;
}

函数 槽位取库(槽: 整数) : 整数 {
    确保槽表();
    如果 (槽 < 0 || 槽 >= 列表库::整数列表大小(图工具槽表)) { 返回 0; }
    返回 列表库::获取整数(图工具槽表, 槽);
}

函数 参数取库(对象: 整数) : 整数 {
    如果 (对象 <= 0) { 返回 0; }
    返回 槽位取库(J.获取整数(对象, "__harness_图槽位"));
}

函数 注图槽位(参数JSON: 字符串, 槽: 整数) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 参数JSON; }
    J.设置整数(对象, "__harness_图槽位", 槽);
    变量 出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 出;
}

函数 图前置0(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 0); }
函数 图前置1(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 1); }
函数 图前置2(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 2); }
函数 图前置3(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 3); }
函数 图前置4(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 4); }
函数 图前置5(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 5); }
函数 图前置6(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 6); }
函数 图前置7(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注图槽位(参数JSON, 7); }
函数 图后置(工具名: 字符串, 输出: 字符串) : 字符串 { 返回 输出; }

函数 绑图槽位(代理值: 代理, 工具名: 字符串, 槽: 整数) : 代理 {
    如果 (槽 == 0) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置0, 图后置); }
    如果 (槽 == 1) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置1, 图后置); }
    如果 (槽 == 2) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置2, 图后置); }
    如果 (槽 == 3) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置3, 图后置); }
    如果 (槽 == 4) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置4, 图后置); }
    如果 (槽 == 5) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置5, 图后置); }
    如果 (槽 == 6) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置6, 图后置); }
    如果 (槽 == 7) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 图前置7, 图后置); }
    返回 代理值;
}

函数 工具_记事实(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    变量 库: 整数 = 参数取库(对象);
    如果 (库 <= 0) { 返回 "{\"ok\":false,\"错误\":\"没挂图记忆\"}"; }
    变量 主: 字符串 = J.获取字符串(对象, "主体");
    变量 系: 字符串 = J.获取字符串(对象, "关系");
    变量 客: 字符串 = J.获取字符串(对象, "客体");
    J.删除(对象);
    如果 (字符串::字节长度(主) == 0 || 字符串::字节长度(系) == 0
        || 字符串::字节长度(客) == 0) {
        返回 "{\"ok\":false,\"错误\":\"主体/关系/客体 都不能为空\"}";
    }
    记实体(库, 主, "");
    记实体(库, 客, "");
    如果 (关联(库, 主, 系, 客) == 0) { 返回 "{\"ok\":false,\"错误\":\"写入失败\"}"; }
    返回 "{\"ok\":true,\"记下\":\"" + 主 + " --" + 系 + "--> " + 客 + "\"}";
}

函数 工具_查关系(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    变量 库: 整数 = 参数取库(对象);
    如果 (库 <= 0) { 返回 "没挂图记忆"; }
    变量 词: 字符串 = J.获取字符串(对象, "关键词");
    变量 跳: 整数 = J.获取整数(对象, "跳数");
    J.删除(对象);
    如果 (跳 <= 0) { 跳 = 默认跳数; }
    变量 回: 字符串 = 图回忆(库, 词, 跳, 12);
    如果 (字符串::字节长度(回) == 0) { 返回 "（图里没有跟它相关的关系）"; }
    返回 回;
}

函数 工具_怎么连的(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    变量 库: 整数 = 参数取库(对象);
    如果 (库 <= 0) { 返回 "没挂图记忆"; }
    变量 甲: 字符串 = J.获取字符串(对象, "甲");
    变量 乙: 字符串 = J.获取字符串(对象, "乙");
    J.删除(对象);
    变量 回: 字符串 = 怎么连的(库, 甲, 乙);
    如果 (字符串::字节长度(回) == 0) { 返回 "（这两个之间没有路径）"; }
    返回 回;
}

// 给代理装上三个图工具。库句柄取自代理已挂的图记忆（先调 启用图记忆）。
// 槽位满（8 个不同的库）时原样返回，不报错也不装 —— 与 装备文件工具 一致。
公开 函数 装备图记忆工具(代理值: 代理) : 代理 {
    变量 库: 整数 = 代理图记忆库(代理值);
    如果 (库 <= 0) { 返回 代理值; }
    变量 槽: 整数 = 要图槽位(库);
    如果 (槽 < 0) { 返回 代理值; }

    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "记事实",
        描述: "把你**新学到的一条关系**记进长期知识图，下一段/下一次会话能查到。"
            + "只记事实，别记猜测。例：主体=登录接口 关系=需要请求头 客体=X-Token。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"主体\":{\"type\":\"string\"},"
            + "\"关系\":{\"type\":\"string\"},\"客体\":{\"type\":\"string\"}},"
            + "\"required\":[\"主体\",\"关系\",\"客体\"]}",
        处理: 工具_记事实,
    });
    代理值 = 绑图槽位(代理值, "记事实", 槽);

    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "查关系",
        描述: "在长期知识图里顺着边查跟某个东西相关的事实。跳数省略=2（1 跳只给"
            + "直接邻居，答不了「A 的作者住哪」这种）。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"关键词\":{\"type\":\"string\"},"
            + "\"跳数\":{\"type\":\"integer\"}},\"required\":[\"关键词\"]}",
        处理: 工具_查关系,
    });
    代理值 = 绑图槽位(代理值, "查关系", 槽);

    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "怎么连的",
        描述: "查两个东西在知识图里是通过哪条路径连起来的。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"甲\":{\"type\":\"string\"},"
            + "\"乙\":{\"type\":\"string\"}},\"required\":[\"甲\",\"乙\"]}",
        处理: 工具_怎么连的,
    });
    代理值 = 绑图槽位(代理值, "怎么连的", 槽);
    返回 代理值;
}

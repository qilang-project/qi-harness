// MCP装备 —— 把 MCP server 的 resources / prompts 也装进代理
//
// 装备MCP（代理.qi）只搬工具。MCP 还有两类原语模型该能用到：
//   resources：server 暴露的只读数据（文件、文档、数据库视图），按 uri 读；
//   prompts：server 预置的提示模板，取回来是 messages，可直接当上下文用。
// 这里把它们都做成代理的本地工具，模型自然会调：
//   装备MCP资源(代理值, 描述符)  → mcp_list_resources / mcp_read_resource
//   装备MCP提示(代理值, 描述符)  → 每个 prompt 一个工具 prompt_<name>
//   装备MCP全部(代理值, 描述符)  = 装备MCP + 装备MCP资源 + 装备MCP提示
//
// 工具处理函数签名固定为 函数(字符串):字符串，捕获不了连接描述符。与 文件工具.qi /
// 技能.qi 同一套办法：每个连接一个槽位，槽位专属的 before hook 把槽位号和工具名写进
// 参数 JSON，处理函数再按槽位查描述符、按「槽位|工具名」查 prompt 原名。
//
// 多台 server：工具名撞了就加后缀 _2 / _3 …（装备MCP 本身对撞名是「后注册覆盖」；
// 这里的工具是我们起的名字，能避就避）。

包 Harness;

导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 哈希表;
导入 标准库.JSON 作为 J;
导入 标准库.输入输出 作为 IO;
导入 Harness.工具::{工具, 设置工具钩子, 查找索引, 工具错误};
导入 Harness.代理::{代理, 添加工具, 装备MCP};
导入 Harness.MCP客户端::{MCP列出资源, MCP读取资源, MCP列出提示, MCP获取提示};
导入 Harness.追踪::{错误事件, 完成事件};

变量 MCP槽位上限值: 整数 = 16;
变量 MCP槽位描述符表: 整数 = 0;   // 字符串列表：槽位 → 连接描述符
变量 MCP提示原名表: 整数 = 0;     // 字符串表："槽位|工具名" → prompt 原名
变量 MCP提示参数表: 整数 = 0;     // 字符串表："槽位|工具名" → 声明的参数名，逗号分隔
变量 MCP装备表已建: 整数 = 0;

函数 确保MCP装备表() {
    如果 (MCP装备表已建 == 1) { 返回; }
    MCP槽位描述符表 = 列表库::创建字符串列表();
    MCP提示原名表 = 哈希表::创建字符串表();
    MCP提示参数表 = 哈希表::创建字符串表();
    MCP装备表已建 = 1;
}

// 同一描述符复用同一槽位（装备MCP全部 会先后调资源、提示两个函数）
函数 取MCP槽位(描述符: 字符串) : 整数 {
    确保MCP装备表();
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(MCP槽位描述符表)) {
        如果 (字符串::等于(列表库::获取字符串(MCP槽位描述符表, i), 描述符) == 1) { 返回 i; }
        i = i + 1;
    }
    如果 (i >= MCP槽位上限值) { 返回 0 - 1; }
    列表库::添加字符串(MCP槽位描述符表, 描述符);
    返回 i;
}

函数 MCP槽位有效(槽位: 整数) : 整数 {
    如果 (MCP装备表已建 == 0 || 槽位 < 0) { 返回 0; }
    如果 (槽位 >= 列表库::字符串列表大小(MCP槽位描述符表)) { 返回 0; }
    返回 1;
}

函数 MCP工具键(槽位: 整数, 工具名: 字符串) : 字符串 {
    返回 整数转字符串(槽位) + "|" + 工具名;
}

// 代理里没这个名字就用它，否则加 _2、_3 … 直到空出来
函数 唯一工具名(代理值: 代理, 基名: 字符串) : 字符串 {
    如果 (查找索引(代理值.工具表, 基名) < 0) { 返回 基名; }
    变量 n: 整数 = 2;
    当 (n < 1000) {
        变量 候选: 字符串 = 基名 + "_" + 整数转字符串(n);
        如果 (查找索引(代理值.工具表, 候选) < 0) { 返回 候选; }
        n = n + 1;
    }
    返回 基名;
}

// prompt 名 → 对模型暴露的 ASCII 安全工具名片段（只留 [A-Za-z0-9_-]，其余换 _，最长 48）
函数 ASCII安全化(名: 字符串) : 字符串 {
    变量 白名单: 字符串 = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-";
    变量 输出: 字符串 = "";
    变量 总数: 整数 = 字符串::字符数量(名);
    变量 i: 整数 = 0;
    当 (i < 总数 && 字符串::字节长度(输出) < 48) {
        变量 字: 字符串 = 字符串::字符取(名, i);
        如果 (字符串::字节长度(字) == 1 && 字符串::包含(白名单, 字) == 1) {
            输出 = 输出 + 字;
        } 否则 {
            输出 = 输出 + "_";
        }
        i = i + 1;
    }
    如果 (字符串::字节长度(输出) == 0) { 返回 "unnamed"; }
    返回 输出;
}

// ——— 槽位 hook ———

函数 注入MCP槽位(参数JSON: 字符串, 槽位: 整数, 工具名: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 参数JSON; }
    J.设置整数(对象, "__harness_MCP槽位", 槽位);
    J.设置字符串(对象, "__harness_MCP工具名", 工具名);
    变量 输出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 输出;
}

函数 MCP前置0(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 0, 工具名); }
函数 MCP前置1(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 1, 工具名); }
函数 MCP前置2(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 2, 工具名); }
函数 MCP前置3(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 3, 工具名); }
函数 MCP前置4(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 4, 工具名); }
函数 MCP前置5(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 5, 工具名); }
函数 MCP前置6(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 6, 工具名); }
函数 MCP前置7(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 7, 工具名); }
函数 MCP前置8(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 8, 工具名); }
函数 MCP前置9(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 9, 工具名); }
函数 MCP前置10(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 10, 工具名); }
函数 MCP前置11(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 11, 工具名); }
函数 MCP前置12(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 12, 工具名); }
函数 MCP前置13(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 13, 工具名); }
函数 MCP前置14(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 14, 工具名); }
函数 MCP前置15(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入MCP槽位(参数JSON, 15, 工具名); }
函数 MCP装备后置(工具名: 字符串, 输出: 字符串) : 字符串 { 返回 输出; }

函数 绑定MCP槽位(代理值: 代理, 工具名: 字符串, 槽位: 整数) : 代理 {
    如果 (槽位 == 0) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置0, MCP装备后置); }
    如果 (槽位 == 1) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置1, MCP装备后置); }
    如果 (槽位 == 2) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置2, MCP装备后置); }
    如果 (槽位 == 3) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置3, MCP装备后置); }
    如果 (槽位 == 4) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置4, MCP装备后置); }
    如果 (槽位 == 5) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置5, MCP装备后置); }
    如果 (槽位 == 6) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置6, MCP装备后置); }
    如果 (槽位 == 7) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置7, MCP装备后置); }
    如果 (槽位 == 8) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置8, MCP装备后置); }
    如果 (槽位 == 9) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置9, MCP装备后置); }
    如果 (槽位 == 10) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置10, MCP装备后置); }
    如果 (槽位 == 11) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置11, MCP装备后置); }
    如果 (槽位 == 12) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置12, MCP装备后置); }
    如果 (槽位 == 13) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置13, MCP装备后置); }
    如果 (槽位 == 14) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置14, MCP装备后置); }
    如果 (槽位 == 15) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, MCP前置15, MCP装备后置); }
    返回 代理值;
}

// ——— 响应整理 ———

// 完整 JSON-RPC 响应行 → result 的 JSON 串；有 error 就原样回 error 对象；空响应给错误 envelope
函数 取结果或错误(响应行: 字符串, 工具名: 字符串) : 字符串 {
    如果 (字符串::字节长度(响应行) == 0) {
        返回 工具错误("mcp_no_response", 工具名, "MCP server 没有响应");
    }
    变量 对象: 整数 = J.解码(响应行);
    如果 (对象 <= 0) { 返回 响应行; }
    变量 输出: 字符串 = 响应行;
    如果 (J.是否包含键(对象, "result") == 1) {
        变量 结果对象: 整数 = J.获取对象(对象, "result");
        输出 = J.转字符串(结果对象);
        J.删除(结果对象);
    } 否则如果 (J.是否包含键(对象, "error") == 1) {
        变量 错误对象: 整数 = J.获取对象(对象, "error");
        输出 = 工具错误("mcp_error", 工具名, J.获取字符串(错误对象, "message"));
        J.删除(错误对象);
    }
    J.删除(对象);
    返回 输出;
}

// prompts/get 的 messages[] → 文本（每条 "role: 内容"，content 可以是对象或数组）
函数 内容转文本(内容: 整数) : 字符串 {
    变量 规范: 字符串 = J.转字符串(内容);
    如果 (字符串::开始于(规范, "[") == 1) {
        变量 拼: 字符串 = "";
        变量 i: 整数 = 0;
        当 (i < J.数组长度(内容)) {
            变量 项: 整数 = J.数组获取对象(内容, i);
            如果 (项 > 0) {
                如果 (i > 0) { 拼 = 拼 + "\n"; }
                拼 = 拼 + 内容转文本(项);
                J.删除(项);
            }
            i = i + 1;
        }
        返回 拼;
    }
    如果 (字符串::开始于(规范, "{") == 1) {
        如果 (J.是否包含键(内容, "text") == 1) { 返回 J.获取字符串(内容, "text"); }
        如果 (J.是否包含键(内容, "resource") == 1) {
            变量 资源: 整数 = J.获取对象(内容, "resource");
            变量 文本: 字符串 = J.获取字符串(资源, "text");
            如果 (字符串::字节长度(文本) == 0) { 文本 = "[资源 " + J.获取字符串(资源, "uri") + "]"; }
            J.删除(资源);
            返回 文本;
        }
        如果 (J.是否包含键(内容, "data") == 1) {
            返回 "[" + J.获取字符串(内容, "mimeType") + " 二进制内容，已省略]";
        }
    }
    返回 规范;
}

函数 提示消息转文本(响应行: 字符串, 工具名: 字符串) : 字符串 {
    变量 结果串: 字符串 = 取结果或错误(响应行, 工具名);
    变量 结果对象: 整数 = J.解码(结果串);
    如果 (结果对象 <= 0 || J.是否包含键(结果对象, "messages") == 0) { 返回 结果串; }
    变量 消息数组: 整数 = J.获取数组(结果对象, "messages");
    变量 输出: 字符串 = "";
    变量 描述: 字符串 = J.获取字符串(结果对象, "description");
    如果 (字符串::字节长度(描述) > 0) { 输出 = 描述 + "\n\n"; }
    变量 i: 整数 = 0;
    当 (i < J.数组长度(消息数组)) {
        变量 消息: 整数 = J.数组获取对象(消息数组, i);
        如果 (消息 > 0) {
            变量 角色: 字符串 = J.获取字符串(消息, "role");
            变量 内容文本: 字符串 = "";
            如果 (J.是否包含键(消息, "content") == 1) {
                变量 内容: 整数 = J.获取对象(消息, "content");
                如果 (内容 <= 0) { 内容 = J.获取数组(消息, "content"); }   // content 也可以是数组
                如果 (内容 > 0) {
                    内容文本 = 内容转文本(内容);
                    J.删除(内容);
                } 否则 {
                    内容文本 = J.取显示值(消息, "content");
                }
            }
            如果 (i > 0) { 输出 = 输出 + "\n\n"; }
            输出 = 输出 + 角色 + ": " + 内容文本;
            J.删除(消息);
        }
        i = i + 1;
    }
    J.删除(结果对象);
    返回 输出;
}

// ——— 工具处理函数 ———

函数 工具_MCP列出资源(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 工具错误("invalid_arguments", "mcp_list_resources", "arguments must be a JSON object"); }
    变量 槽位: 整数 = J.获取整数(对象, "__harness_MCP槽位");
    J.删除(对象);
    如果 (MCP槽位有效(槽位) == 0) { 返回 工具错误("mcp_unbound", "mcp_list_resources", "MCP 连接绑定无效"); }
    返回 取结果或错误(MCP列出资源(列表库::获取字符串(MCP槽位描述符表, 槽位)), "mcp_list_resources");
}

函数 工具_MCP读取资源(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 工具错误("invalid_arguments", "mcp_read_resource", "arguments must be a JSON object"); }
    变量 槽位: 整数 = J.获取整数(对象, "__harness_MCP槽位");
    变量 URI: 字符串 = J.获取字符串(对象, "uri");
    J.删除(对象);
    如果 (MCP槽位有效(槽位) == 0) { 返回 工具错误("mcp_unbound", "mcp_read_resource", "MCP 连接绑定无效"); }
    如果 (字符串::字节长度(URI) == 0) { 返回 工具错误("invalid_arguments", "mcp_read_resource", "uri 不能为空"); }
    返回 取结果或错误(MCP读取资源(列表库::获取字符串(MCP槽位描述符表, 槽位), URI), "mcp_read_resource");
}

函数 工具_MCP提示(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 工具错误("invalid_arguments", "mcp_prompt", "arguments must be a JSON object"); }
    变量 槽位: 整数 = J.获取整数(对象, "__harness_MCP槽位");
    变量 工具名: 字符串 = J.获取字符串(对象, "__harness_MCP工具名");
    如果 (MCP槽位有效(槽位) == 0) {
        J.删除(对象);
        返回 工具错误("mcp_unbound", 工具名, "MCP 连接绑定无效");
    }
    变量 键: 字符串 = MCP工具键(槽位, 工具名);
    变量 原名: 字符串 = 哈希表::获取字符串(MCP提示原名表, 键);
    如果 (字符串::字节长度(原名) == 0) {
        J.删除(对象);
        返回 工具错误("mcp_unbound", 工具名, "找不到这个工具对应的 MCP prompt");
    }
    // 只透传 prompts/list 声明过的参数，注入的内部键不外泄；MCP 规定参数值都是字符串
    变量 参数对象: 整数 = J.创建对象();
    变量 声明: 字符串 = 哈希表::获取字符串(MCP提示参数表, 键);
    如果 (字符串::字节长度(声明) > 0) {
        变量 名单: 整数 = 字符串::分割(声明, ",");
        变量 i: 整数 = 0;
        当 (i < 列表库::字符串列表大小(名单)) {
            变量 参数名: 字符串 = 列表库::获取字符串(名单, i);
            如果 (字符串::字节长度(参数名) > 0 && J.是否包含键(对象, 参数名) == 1) {
                J.设置字符串(参数对象, 参数名, J.取显示值(对象, 参数名));
            }
            i = i + 1;
        }
    }
    变量 参数串: 字符串 = J.转字符串(参数对象);
    J.删除(参数对象);
    J.删除(对象);
    返回 提示消息转文本(
        MCP获取提示(列表库::获取字符串(MCP槽位描述符表, 槽位), 原名, 参数串), 工具名);
}

// ——— 公开 API ———

// 注册两个工具：mcp_list_resources（无参）/ mcp_read_resource（{uri}），派发到
// resources/list / resources/read。多台 server 时后来者的工具名带 _2、_3 后缀。
公开 函数 装备MCP资源(代理值: 代理, 连接描述符: 字符串) : 代理 {
    变量 槽位: 整数 = 取MCP槽位(连接描述符);
    如果 (槽位 < 0) {
        错误事件(代理值.名字, "MCP 装备槽位已满（上限 " + 整数转字符串(MCP槽位上限值) + " 个连接）");
        返回 代理值;
    }
    变量 列名: 字符串 = 唯一工具名(代理值, "mcp_list_resources");
    变量 读名: 字符串 = 唯一工具名(代理值, "mcp_read_resource");
    变量 来源: 字符串 = "";
    如果 (字符串::等于(列名, "mcp_list_resources") == 0) { 来源 = "（连接 " + 整数转字符串(槽位 + 1) + "）"; }
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: 列名,
        描述: "列出 MCP server" + 来源 + " 暴露的资源（uri / name / description / mimeType）。要读某个资源时先用它拿 uri。",
        参数schema: "{\"type\":\"object\",\"properties\":{}}",
        处理: 工具_MCP列出资源,
    });
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: 读名,
        描述: "按 uri 读取 MCP server" + 来源 + " 的一个资源，返回 contents（文本或 base64 blob）。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"uri\":{\"type\":\"string\",\"description\":\"资源 uri，来自 " + 列名 + " 的结果\"}},\"required\":[\"uri\"]}",
        处理: 工具_MCP读取资源,
    });
    代理值 = 绑定MCP槽位(代理值, 列名, 槽位);
    代理值 = 绑定MCP槽位(代理值, 读名, 槽位);
    完成事件(代理值.名字, "装备 MCP 资源工具：" + 列名 + ", " + 读名);
    返回 代理值;
}

// prompts/list 的每个 prompt 注册成一个工具 prompt_<name>（name 做 ASCII 安全化），
// 参数 = prompt 声明的 arguments（都是字符串）。调用时 prompts/get，把 messages 拼成
// 文本回给模型。
公开 函数 装备MCP提示(代理值: 代理, 连接描述符: 字符串) : 代理 {
    变量 槽位: 整数 = 取MCP槽位(连接描述符);
    如果 (槽位 < 0) {
        错误事件(代理值.名字, "MCP 装备槽位已满（上限 " + 整数转字符串(MCP槽位上限值) + " 个连接）");
        返回 代理值;
    }
    变量 响应对象: 整数 = J.解码(MCP列出提示(连接描述符));
    如果 (响应对象 <= 0) {
        错误事件(代理值.名字, "MCP prompts/list 解析失败");
        返回 代理值;
    }
    如果 (J.是否包含键(响应对象, "result") == 0) {
        错误事件(代理值.名字, "MCP prompts/list 无 result（server 可能不支持 prompts）");
        J.删除(响应对象);
        返回 代理值;
    }
    变量 结果对象: 整数 = J.获取对象(响应对象, "result");
    变量 提示数组: 整数 = J.获取数组(结果对象, "prompts");
    变量 数量: 整数 = 0;
    如果 (提示数组 > 0) { 数量 = J.数组长度(提示数组); }
    变量 i: 整数 = 0;
    当 (i < 数量) {
        变量 提示对象: 整数 = J.数组获取对象(提示数组, i);
        变量 原名: 字符串 = J.获取字符串(提示对象, "name");
        变量 描述: 字符串 = J.获取字符串(提示对象, "description");
        如果 (字符串::字节长度(原名) > 0) {
            变量 工具名: 字符串 = 唯一工具名(代理值, "prompt_" + ASCII安全化(原名));
            // 参数 schema：声明的 arguments 全是字符串；required 照搬
            变量 属性: 整数 = J.创建对象();
            变量 必需: 整数 = J.创建数组();
            变量 参数名单: 字符串 = "";
            变量 参数数组: 整数 = J.获取数组(提示对象, "arguments");
            如果 (参数数组 > 0) {
                变量 k: 整数 = 0;
                当 (k < J.数组长度(参数数组)) {
                    变量 参数对象: 整数 = J.数组获取对象(参数数组, k);
                    变量 参数名: 字符串 = J.获取字符串(参数对象, "name");
                    如果 (字符串::字节长度(参数名) > 0) {
                        变量 参数schema: 整数 = J.创建对象();
                        J.设置字符串(参数schema, "type", "string");
                        J.设置字符串(参数schema, "description", J.获取字符串(参数对象, "description"));
                        J.设置对象(属性, 参数名, 参数schema);
                        J.删除(参数schema);
                        如果 (J.获取布尔(参数对象, "required") == 1) { J.数组添加字符串(必需, 参数名); }
                        如果 (字符串::字节长度(参数名单) > 0) { 参数名单 = 参数名单 + ","; }
                        参数名单 = 参数名单 + 参数名;
                    }
                    J.删除(参数对象);
                    k = k + 1;
                }
                J.删除(参数数组);
            }
            变量 schema对象: 整数 = J.创建对象();
            J.设置字符串(schema对象, "type", "object");
            J.设置对象(schema对象, "properties", 属性);
            如果 (J.数组长度(必需) > 0) { J.设置数组(schema对象, "required", 必需); }
            变量 schema串: 字符串 = J.转字符串(schema对象);
            J.删除(schema对象);
            J.删除(属性);
            J.删除(必需);
            如果 (字符串::字节长度(描述) == 0) { 描述 = "MCP 提示模板 " + 原名; }
            代理值 = 添加工具(代理值, 新建 工具 {
                名字: 工具名,
                描述: "MCP 提示模板「" + 原名 + "」：" + 描述 + " 返回填好参数的提示消息文本。",
                参数schema: schema串,
                处理: 工具_MCP提示,
            });
            代理值 = 绑定MCP槽位(代理值, 工具名, 槽位);
            哈希表::设置字符串(MCP提示原名表, MCP工具键(槽位, 工具名), 原名);
            哈希表::设置字符串(MCP提示参数表, MCP工具键(槽位, 工具名), 参数名单);
        }
        J.删除(提示对象);
        i = i + 1;
    }
    如果 (提示数组 > 0) { J.删除(提示数组); }
    J.删除(结果对象);
    J.删除(响应对象);
    完成事件(代理值.名字, "装备 MCP 提示工具 " + 整数转字符串(数量) + " 个");
    返回 代理值;
}

// 工具 + 资源 + 提示一把装
公开 函数 装备MCP全部(代理值: 代理, 连接描述符: 字符串) : 代理 {
    代理值 = 装备MCP(代理值, 连接描述符);
    代理值 = 装备MCP资源(代理值, 连接描述符);
    代理值 = 装备MCP提示(代理值, 连接描述符);
    返回 代理值;
}

// MCP 服务端 — 把 Harness 工具暴露成 MCP 工具，供任意外部 MCP 客户端调用
//
// 与 MCP客户端.qi 对称：客户端「连接别人的 server」，本模块「把自己变成 server」。
// 传输 = stdio + newline-delimited JSON-RPC 2.0（与 MCP客户端 读写的帧格式一致，
// 因此本 server 能被 MCP客户端 直接往返调用）。
//
// 底层复用编译器内置的 `标准库.MCP服务器` Rust 核心（qi_mcp_serve_stdio 主循环，
// 已实现 initialize / notifications/initialized / tools/list / tools/call +
// 完整 JSON-RPC 错误响应），本模块只做一层薄封装：把 Harness 的 `工具` 值
// （名字 / 描述 / 参数schema / 处理）注册进去，工具的 参数schema 原样作为 MCP
// inputSchema，工具的 处理(参数JSON):字符串 作为 tools/call 的回调。
//
// 公开 API：
//   创建MCP服务(名称, 版本)     : MCP服务
//   服务注册工具(服务, 工具值)   : MCP服务   （复用 工具.qi 的 工具 类型）
//   运行MCP服务(服务)                       （阻塞：读 stdin，写 stdout，直到 EOF）
//   运行MCP服务_HTTP(服务, 主机, 端口) : 整数 （阻塞：Streamable HTTP，POST/DELETE /mcp）
//   关闭MCP服务(服务)          : 整数        （释放 Rust 侧服务器句柄）
//
// HTTP 传输不走 Rust 的 qi_mcp_serve_http（它把每个响应都包成 SSE、不校验会话、
// DELETE 回 405），而是在 qi 侧用 标准库.网络 自己收 HTTP、自己派发 JSON-RPC：
// 响应 application/json、initialize 签发 Mcp-Session-Id 之后逐请求校验、DELETE 结束
// 会话、GET 回 405（本 server 没有服务端→客户端通知，按规范可以不开 SSE 流）。
// 工具表因此在 qi 侧也留了一份（服务注册工具 时同时登记）。
//
// 用法（一个 stdio MCP server 程序）：
//   变量 服务: MCP服务 = 创建MCP服务("我的服务", "1.0.0");
//   服务 = 服务注册工具(服务, 新建 工具 { 名字: "add", 描述: "两数相加",
//       参数schema: "{\"type\":\"object\",\"properties\":{...}}", 处理: 加法 });
//   运行MCP服务(服务);   // 阻塞，直到客户端关闭 stdin

包 Harness;

导入 标准库.字符串;
导入 标准库.MCP服务器 作为 核心服务;
导入 标准库.输入输出 作为 IO;
导入 标准库.网络 作为 网络;
导入 标准库.随机 作为 随机;
导入 标准库.JSON 作为 J;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 哈希表;
导入 Harness.工具::{ 工具 };

// ——— qi 侧登记表（HTTP 传输派发用；stdio 走 Rust 主循环不看它）———
变量 服务句柄表: 整数 = 0;        // 整数列表：下标 → 服务句柄
变量 服务名称表: 整数 = 0;        // 字符串列表
变量 服务版本表: 整数 = 0;        // 字符串列表
变量 服务工具名表组: 整数 = 0;    // 整数列表：下标 → 工具名字符串列表
变量 服务工具描述表组: 整数 = 0;  // 整数列表：下标 → 描述字符串列表
变量 服务工具schema表组: 整数 = 0;// 整数列表：下标 → schema 字符串列表
变量 服务工具处理表组: 整数 = 0;  // 整数列表：下标 → 处理函数指针列表
变量 HTTP会话表: 整数 = 0;        // 整数表：会话ID → 1 活跃 / 2 已结束
变量 服务登记表已建: 整数 = 0;

函数 确保服务登记表() {
    如果 (服务登记表已建 == 1) { 返回; }
    服务句柄表 = 列表库::创建整数列表();
    服务名称表 = 列表库::创建字符串列表();
    服务版本表 = 列表库::创建字符串列表();
    服务工具名表组 = 列表库::创建整数列表();
    服务工具描述表组 = 列表库::创建整数列表();
    服务工具schema表组 = 列表库::创建整数列表();
    服务工具处理表组 = 列表库::创建整数列表();
    HTTP会话表 = 哈希表::创建整数表();
    服务登记表已建 = 1;
}

函数 服务下标(句柄: 整数) : 整数 {
    如果 (服务登记表已建 == 0) { 返回 0 - 1; }
    变量 i: 整数 = 0;
    当 (i < 列表库::整数列表大小(服务句柄表)) {
        如果 (列表库::获取整数(服务句柄表, i) == 句柄) { 返回 i; }
        i = i + 1;
    }
    返回 0 - 1;
}

// MCP 服务描述符 —— 仅封装 Rust 服务器池里的 server_id
公开 类型 MCP服务 {
    句柄: 整数,          // qi_mcp_create_server 返回的 server_id（>0 有效）
}

// ——— 创建服务 ———

// 创建一个 MCP 服务（尚未开始监听）。名称/版本会通过 initialize 的 serverInfo
// 回给客户端。成功时 句柄 > 0；失败时 句柄 <= 0。
公开 函数 创建MCP服务(名称: 字符串, 版本: 字符串) : MCP服务 {
    变量 id: 整数 = 核心服务.创建服务器(名称, 版本, "");
    如果 (id <= 0) {
        IO.打印行("[MCP服务] 创建失败");
    } 否则 {
        确保服务登记表();
        列表库::添加整数(服务句柄表, id);
        列表库::添加字符串(服务名称表, 名称);
        列表库::添加字符串(服务版本表, 版本);
        列表库::添加整数(服务工具名表组, 列表库::创建字符串列表());
        列表库::添加整数(服务工具描述表组, 列表库::创建字符串列表());
        列表库::添加整数(服务工具schema表组, 列表库::创建字符串列表());
        列表库::添加整数(服务工具处理表组, 列表库::创建指针列表());
    }
    返回 新建 MCP服务 {
        句柄: id,
    };
}

// ——— 注册工具 ———

// 把一个 Harness 工具暴露成 MCP 工具：
//   - name         = 工具值.名字
//   - description  = 工具值.描述
//   - inputSchema  = 工具值.参数schema（原样作为完整 JSON Schema）
//   - tools/call   → 工具值.处理(arguments JSON) → 结果文本，包成 content[type=text]
// 返回同一个服务描述符（便于链式调用）。
公开 函数 服务注册工具(服务: MCP服务, 工具值: 工具) : MCP服务 {
    变量 id: 整数 = 服务.句柄;
    如果 (id <= 0) {
        返回 服务;
    }
    // 1) 注册工具（名字 + 描述）
    核心服务.注册工具(id, 工具值.名字, 工具值.描述);
    // 2) 原样安装完整 inputSchema（覆盖 Rust 侧按参数重建的 schema）
    核心服务.设置工具schema(id, 工具值.名字, 工具值.参数schema);
    // 3) 安装 Qi 闭包回调：tools/call 时 Rust 主循环直接调 工具值.处理
    核心服务.设置工具回调指针(id, 工具值.名字, 工具值.处理);
    // 4) qi 侧同步登记一份，HTTP 传输在 qi 里派发
    变量 下标: 整数 = 服务下标(id);
    如果 (下标 >= 0) {
        列表库::添加字符串(列表库::获取整数(服务工具名表组, 下标), 工具值.名字);
        列表库::添加字符串(列表库::获取整数(服务工具描述表组, 下标), 工具值.描述);
        列表库::添加字符串(列表库::获取整数(服务工具schema表组, 下标), 工具值.参数schema);
        列表库::添加指针(列表库::获取整数(服务工具处理表组, 下标), 工具值.处理);
    }
    返回 服务;
}

// ——— 运行（阻塞）———

// 启动 stdio JSON-RPC 2.0 主循环：从 stdin 逐行读请求、派发、把响应写到 stdout，
// 一切诊断信息走 stderr。阻塞直到 stdin EOF（客户端关闭连接）。
公开 函数 运行MCP服务(服务: MCP服务) {
    如果 (服务.句柄 <= 0) {
        IO.打印行("[MCP服务] 无效服务，无法运行");
        返回;
    }
    核心服务.运行stdio(服务.句柄);
}

// ——— 关闭 ———

// 释放 Rust 侧服务器句柄（运行结束后可选调用）。成功返回 0。
公开 函数 关闭MCP服务(服务: MCP服务) : 整数 {
    如果 (服务.句柄 <= 0) {
        返回 -1;
    }
    返回 核心服务.销毁服务器(服务.句柄);
}

// ═══════════════════════════════════════════════════════════════════════
// Streamable HTTP 传输（MCP 2025-03-26）
// ═══════════════════════════════════════════════════════════════════════
//
//   POST /mcp    JSON-RPC 请求 → application/json 响应；通知（无 id）→ 202 空体
//                initialize 签发 Mcp-Session-Id；其余请求必须带且会话有效
//                （缺头 400，未知/已结束 404）
//   GET  /mcp    405（不开服务端→客户端 SSE 流）
//   DELETE /mcp  结束会话（200；未知会话 404）
//   OPTIONS      204 + CORS
//
// 每条 TCP 连接一个 goroutine，支持 keep-alive（MCP客户端 就是靠一条长连接连发的）。

变量 MCP_HTTP协议版本: 字符串 = "2025-03-26";
变量 MCP_HTTP最大请求字节: 整数 = 4194304;   // 4MB，超了直接断开

函数 取HTTP头(头文本: 字符串, 名小写: 字符串) : 字符串 {
    变量 行列表: 整数 = 字符串::分割(头文本, "\n");
    变量 i: 整数 = 1;   // 0 是请求行
    当 (i < 列表库::字符串列表大小(行列表)) {
        变量 行: 字符串 = 列表库::获取字符串(行列表, i);
        变量 冒号: 整数 = 字符串::查找(行, ":");
        如果 (冒号 > 0) {
            变量 键: 字符串 = 字符串::转小写(字符串::去空白(字符串::子串(行, 0, 冒号)));
            如果 (字符串::等于(键, 名小写) == 1) {
                返回 字符串::去空白(字符串::子串从位置(行, 冒号 + 1));
            }
        }
        i = i + 1;
    }
    返回 "";
}

函数 请求行片段(头文本: 字符串, 序号: 整数) : 字符串 {
    变量 首行: 字符串 = 头文本;
    变量 换行: 整数 = 字符串::查找(头文本, "\n");
    如果 (换行 >= 0) { 首行 = 字符串::子串(头文本, 0, 换行); }
    首行 = 字符串::去空白(首行);
    变量 片: 整数 = 字符串::分割(首行, " ");
    变量 计: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(片)) {
        变量 项: 字符串 = 列表库::获取字符串(片, i);
        如果 (字符串::字节长度(项) > 0) {
            如果 (计 == 序号) { 返回 项; }
            计 = 计 + 1;
        }
        i = i + 1;
    }
    返回 "";
}

函数 构造HTTP响应(状态: 字符串, 内容类型: 字符串, 会话ID: 字符串, 额外头: 字符串, 体: 字符串) : 字符串 {
    变量 头: 字符串 = "HTTP/1.1 " + 状态 + "\r\n"
        + "Access-Control-Allow-Origin: *\r\n"
        + "Access-Control-Allow-Methods: POST, GET, DELETE, OPTIONS\r\n"
        + "Access-Control-Allow-Headers: Content-Type, Accept, Mcp-Session-Id, MCP-Protocol-Version\r\n"
        + "Access-Control-Expose-Headers: Mcp-Session-Id\r\n";
    如果 (字符串::字节长度(会话ID) > 0) { 头 = 头 + "Mcp-Session-Id: " + 会话ID + "\r\n"; }
    如果 (字符串::字节长度(额外头) > 0) { 头 = 头 + 额外头; }
    如果 (字符串::字节长度(内容类型) > 0) { 头 = 头 + "Content-Type: " + 内容类型 + "\r\n"; }
    头 = 头 + "Content-Length: " + 整数转字符串(字符串::字节长度(体)) + "\r\n\r\n";
    返回 头 + 体;
}

// 请求里的 id 原样回：整数还是整数，字符串还是字符串
函数 回填请求ID(响应: 整数, 请求: 整数) {
    如果 (请求 <= 0 || J.是否包含键(请求, "id") == 0) { 返回; }
    变量 显示: 字符串 = J.取显示值(请求, "id");
    变量 原文: 字符串 = J.转字符串(请求);
    如果 (字符串::包含(原文, "\"id\":\"") == 1 && 字符串::等于(J.获取字符串(请求, "id"), 显示) == 1) {
        J.设置字符串(响应, "id", 显示);
    } 否则 如果 (字符串::字节长度(显示) > 0) {
        J.设置整数(响应, "id", 字符串转整数(显示));
    }
}

函数 JSON_RPC错误体(请求: 整数, 代码: 整数, 消息: 字符串) : 字符串 {
    变量 响应: 整数 = J.创建对象();
    J.设置字符串(响应, "jsonrpc", "2.0");
    变量 错误: 整数 = J.创建对象();
    J.设置整数(错误, "code", 代码);
    J.设置字符串(错误, "message", 消息);
    J.设置对象(响应, "error", 错误);
    J.删除(错误);
    回填请求ID(响应, 请求);
    变量 文本: 字符串 = J.转字符串(响应);
    J.删除(响应);
    如果 (请求 <= 0 || J.是否包含键(请求, "id") == 0) {
        // 没有 id 的错误按规范 id 为 null
        文本 = 字符串::子串(文本, 0, 字符串::字节长度(文本) - 1) + ",\"id\":null}";
    }
    返回 文本;
}

函数 JSON_RPC结果体(请求: 整数, 结果值: 整数) : 字符串 {
    变量 响应: 整数 = J.创建对象();
    J.设置字符串(响应, "jsonrpc", "2.0");
    回填请求ID(响应, 请求);
    J.设置对象(响应, "result", 结果值);
    变量 文本: 字符串 = J.转字符串(响应);
    J.删除(响应);
    返回 文本;
}

函数 HTTP_initialize结果(下标: 整数, 请求: 整数) : 整数 {
    变量 结果值: 整数 = J.创建对象();
    变量 版本: 字符串 = MCP_HTTP协议版本;
    如果 (J.是否包含键(请求, "params") == 1) {
        变量 参数: 整数 = J.获取对象(请求, "params");
        如果 (参数 > 0) {
            变量 客户端版本: 字符串 = J.获取字符串(参数, "protocolVersion");
            // 客户端要的版本我们认识就照它的；不认识回我们支持的
            如果 (字符串::等于(客户端版本, "2025-06-18") == 1 || 字符串::等于(客户端版本, "2025-03-26") == 1
                || 字符串::等于(客户端版本, "2024-11-05") == 1) { 版本 = 客户端版本; }
            J.删除(参数);
        }
    }
    J.设置字符串(结果值, "protocolVersion", 版本);
    变量 能力: 整数 = J.创建对象();
    变量 工具能力: 整数 = J.创建对象();
    J.设置布尔(工具能力, "listChanged", 0);
    J.设置对象(能力, "tools", 工具能力);
    J.删除(工具能力);
    J.设置对象(结果值, "capabilities", 能力);
    J.删除(能力);
    变量 信息: 整数 = J.创建对象();
    J.设置字符串(信息, "name", 列表库::获取字符串(服务名称表, 下标));
    J.设置字符串(信息, "version", 列表库::获取字符串(服务版本表, 下标));
    J.设置对象(结果值, "serverInfo", 信息);
    J.删除(信息);
    返回 结果值;
}

函数 HTTP_tools_list结果(下标: 整数) : 整数 {
    变量 名表: 整数 = 列表库::获取整数(服务工具名表组, 下标);
    变量 描述表: 整数 = 列表库::获取整数(服务工具描述表组, 下标);
    变量 schema表: 整数 = 列表库::获取整数(服务工具schema表组, 下标);
    变量 工具数组: 整数 = J.创建数组();
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(名表)) {
        变量 工具对象: 整数 = J.创建对象();
        J.设置字符串(工具对象, "name", 列表库::获取字符串(名表, i));
        J.设置字符串(工具对象, "description", 列表库::获取字符串(描述表, i));
        变量 schema对象: 整数 = J.解码(列表库::获取字符串(schema表, i));
        如果 (schema对象 <= 0) {
            schema对象 = J.创建对象();
            J.设置字符串(schema对象, "type", "object");
        }
        J.设置对象(工具对象, "inputSchema", schema对象);
        J.删除(schema对象);
        J.数组添加对象(工具数组, 工具对象);
        J.删除(工具对象);
        i = i + 1;
    }
    变量 结果值: 整数 = J.创建对象();
    J.设置数组(结果值, "tools", 工具数组);
    J.删除(工具数组);
    返回 结果值;
}

// tools/call：找到 qi 侧登记的处理函数直接调；返回 result 对象，找不到返回 0
函数 HTTP_tools_call结果(下标: 整数, 请求: 整数, 错误消息: 整数) : 整数 {
    变量 工具名: 字符串 = "";
    变量 参数串: 字符串 = "{}";
    如果 (J.是否包含键(请求, "params") == 1) {
        变量 参数: 整数 = J.获取对象(请求, "params");
        如果 (参数 > 0) {
            工具名 = J.获取字符串(参数, "name");
            如果 (J.是否包含键(参数, "arguments") == 1) {
                变量 实参: 整数 = J.获取对象(参数, "arguments");
                如果 (实参 > 0) {
                    参数串 = J.转字符串(实参);
                    J.删除(实参);
                }
            }
            J.删除(参数);
        }
    }
    如果 (字符串::字节长度(工具名) == 0) {
        J.设置字符串(错误消息, "message", "Missing tool name");
        返回 0;
    }
    变量 名表: 整数 = 列表库::获取整数(服务工具名表组, 下标);
    变量 idx: 整数 = 列表库::字符串列表大小(名表) - 1;
    当 (idx >= 0) {
        如果 (字符串::等于(列表库::获取字符串(名表, idx), 工具名) == 1) {
            变量 处理: 函数(字符串): 字符串 = 列表库::获取指针(列表库::获取整数(服务工具处理表组, 下标), idx);
            变量 文本: 字符串 = 处理(参数串);
            变量 内容: 整数 = J.创建对象();
            J.设置字符串(内容, "type", "text");
            J.设置字符串(内容, "text", 文本);
            变量 内容数组: 整数 = J.创建数组();
            J.数组添加对象(内容数组, 内容);
            J.删除(内容);
            变量 结果值: 整数 = J.创建对象();
            J.设置数组(结果值, "content", 内容数组);
            J.删除(内容数组);
            J.设置布尔(结果值, "isError", 0);
            返回 结果值;
        }
        idx = idx - 1;
    }
    J.设置字符串(错误消息, "message", "Unknown tool: " + 工具名);
    返回 0;
}

// 一条 POST 的 JSON-RPC 派发 → 完整 HTTP 响应文本
函数 处理MCP_HTTP_POST(下标: 整数, 会话ID头: 字符串, 体: 字符串) : 字符串 {
    如果 (字符串::开始于(字符串::去空白(体), "[") == 1) {
        返回 构造HTTP响应("400 Bad Request", "application/json", 会话ID头, "",
            JSON_RPC错误体(0, 0 - 32600, "Batch requests are not supported"));
    }
    变量 请求: 整数 = J.解码(体);
    如果 (请求 <= 0) {
        返回 构造HTTP响应("400 Bad Request", "application/json", 会话ID头, "",
            JSON_RPC错误体(0, 0 - 32700, "Parse error"));
    }
    变量 方法名: 字符串 = J.获取字符串(请求, "method");
    变量 有ID: 整数 = J.是否包含键(请求, "id");
    变量 响应: 字符串 = "";

    如果 (字符串::等于(方法名, "initialize") == 1) {
        变量 新会话: 字符串 = 随机.UUID();
        哈希表::设置整数(HTTP会话表, 新会话, 1);
        变量 结果值: 整数 = HTTP_initialize结果(下标, 请求);
        响应 = 构造HTTP响应("200 OK", "application/json", 新会话, "", JSON_RPC结果体(请求, 结果值));
        J.删除(结果值);
        J.删除(请求);
        返回 响应;
    }

    如果 (字符串::字节长度(会话ID头) == 0) {
        响应 = 构造HTTP响应("400 Bad Request", "application/json", "", "",
            JSON_RPC错误体(请求, 0 - 32600, "Missing Mcp-Session-Id header"));
        J.删除(请求);
        返回 响应;
    }
    如果 (哈希表::获取整数(HTTP会话表, 会话ID头) != 1) {
        响应 = 构造HTTP响应("404 Not Found", "application/json", "", "",
            JSON_RPC错误体(请求, 0 - 32001, "Session not found or terminated"));
        J.删除(请求);
        返回 响应;
    }
    如果 (有ID == 0) {
        // 通知（notifications/initialized、notifications/cancelled …）：收下即可
        J.删除(请求);
        返回 构造HTTP响应("202 Accepted", "", 会话ID头, "", "");
    }

    如果 (字符串::等于(方法名, "ping") == 1) {
        变量 空结果: 整数 = J.创建对象();
        响应 = 构造HTTP响应("200 OK", "application/json", 会话ID头, "", JSON_RPC结果体(请求, 空结果));
        J.删除(空结果);
    } 否则 如果 (字符串::等于(方法名, "tools/list") == 1) {
        变量 列表结果: 整数 = HTTP_tools_list结果(下标);
        响应 = 构造HTTP响应("200 OK", "application/json", 会话ID头, "", JSON_RPC结果体(请求, 列表结果));
        J.删除(列表结果);
    } 否则 如果 (字符串::等于(方法名, "tools/call") == 1) {
        变量 错误消息: 整数 = J.创建对象();
        变量 调用结果: 整数 = HTTP_tools_call结果(下标, 请求, 错误消息);
        如果 (调用结果 > 0) {
            响应 = 构造HTTP响应("200 OK", "application/json", 会话ID头, "", JSON_RPC结果体(请求, 调用结果));
            J.删除(调用结果);
        } 否则 {
            响应 = 构造HTTP响应("200 OK", "application/json", 会话ID头, "",
                JSON_RPC错误体(请求, 0 - 32602, J.获取字符串(错误消息, "message")));
        }
        J.删除(错误消息);
    } 否则 {
        响应 = 构造HTTP响应("200 OK", "application/json", 会话ID头, "",
            JSON_RPC错误体(请求, 0 - 32601, "Method not found: " + 方法名));
    }
    J.删除(请求);
    返回 响应;
}

函数 处理MCP_HTTP请求(下标: 整数, 方法: 字符串, 路径: 字符串, 会话ID头: 字符串, 体: 字符串) : 字符串 {
    如果 (字符串::等于(方法, "OPTIONS") == 1) {
        返回 构造HTTP响应("204 No Content", "", "", "", "");
    }
    // 只认 /mcp（允许带查询串）
    如果 (字符串::等于(路径, "/mcp") == 0 && 字符串::开始于(路径, "/mcp?") == 0) {
        返回 构造HTTP响应("404 Not Found", "application/json", "", "", "{\"error\":\"not found\"}");
    }
    如果 (字符串::等于(方法, "GET") == 1) {
        返回 构造HTTP响应("405 Method Not Allowed", "application/json", "", "Allow: POST, DELETE, OPTIONS\r\n",
            JSON_RPC错误体(0, 0 - 32000, "This server does not open a server-to-client SSE stream; use POST /mcp"));
    }
    如果 (字符串::等于(方法, "DELETE") == 1) {
        如果 (字符串::字节长度(会话ID头) > 0 && 哈希表::获取整数(HTTP会话表, 会话ID头) == 1) {
            哈希表::设置整数(HTTP会话表, 会话ID头, 2);
            返回 构造HTTP响应("200 OK", "", "", "", "");
        }
        返回 构造HTTP响应("404 Not Found", "application/json", "", "",
            JSON_RPC错误体(0, 0 - 32001, "Session not found or terminated"));
    }
    如果 (字符串::等于(方法, "POST") == 0) {
        返回 构造HTTP响应("405 Method Not Allowed", "application/json", "", "Allow: POST, DELETE, OPTIONS\r\n",
            JSON_RPC错误体(0, 0 - 32000, "Method not allowed"));
    }
    返回 处理MCP_HTTP_POST(下标, 会话ID头, 体);
}

// 一条连接：keep-alive 循环收请求、回响应，直到对端关闭 / Connection: close / 出错。
// goroutine 入口（启动 不支持内联闭包，所以要顶层具名函数）。
函数 处理MCP_HTTP连接(下标: 整数, 连接: 整数) {
    变量 缓冲: 字符串 = "";
    当 (真) {
        变量 头尾: 整数 = 字符串::查找(缓冲, "\r\n\r\n");
        当 (头尾 < 0) {
            变量 块: 字符串 = 网络.TCP读取(连接, 65536);
            如果 (字符串::字节长度(块) == 0) { 网络.TCP关闭(连接); 返回; }
            缓冲 = 缓冲 + 块;
            如果 (字符串::字节长度(缓冲) > MCP_HTTP最大请求字节) { 网络.TCP关闭(连接); 返回; }
            头尾 = 字符串::查找(缓冲, "\r\n\r\n");
        }
        变量 头文本: 字符串 = 字符串::子串(缓冲, 0, 头尾);
        变量 方法: 字符串 = 请求行片段(头文本, 0);
        变量 路径: 字符串 = 请求行片段(头文本, 1);
        变量 长度串: 字符串 = 取HTTP头(头文本, "content-length");
        变量 内容长度: 整数 = 0;
        如果 (字符串::字节长度(长度串) > 0) { 内容长度 = 字符串转整数(长度串); }
        如果 (内容长度 < 0 || 内容长度 > MCP_HTTP最大请求字节) { 网络.TCP关闭(连接); 返回; }
        变量 体起: 整数 = 头尾 + 4;
        当 (字符串::字节长度(缓冲) < 体起 + 内容长度) {
            变量 块2: 字符串 = 网络.TCP读取(连接, 65536);
            如果 (字符串::字节长度(块2) == 0) { 网络.TCP关闭(连接); 返回; }
            缓冲 = 缓冲 + 块2;
        }
        变量 体: 字符串 = "";
        如果 (内容长度 > 0) { 体 = 字符串::子串(缓冲, 体起, 内容长度); }
        如果 (字符串::字节长度(缓冲) > 体起 + 内容长度) {
            缓冲 = 字符串::子串从位置(缓冲, 体起 + 内容长度);
        } 否则 {
            缓冲 = "";
        }
        变量 会话ID头: 字符串 = 取HTTP头(头文本, "mcp-session-id");
        变量 响应: 字符串 = 处理MCP_HTTP请求(下标, 方法, 路径, 会话ID头, 体);
        如果 (网络.TCP写入(连接, 响应) < 0) { 网络.TCP关闭(连接); 返回; }
        网络.TCP刷新(连接);
        如果 (字符串::等于(字符串::转小写(取HTTP头(头文本, "connection")), "close") == 1) {
            网络.TCP关闭(连接);
            返回;
        }
    }
}

// 启动 Streamable HTTP 传输（阻塞）。返回 0 正常退出，-1 无效服务，-2 监听失败。
//   变量 服务: MCP服务 = 创建MCP服务("我的服务", "1.0.0");
//   服务 = 服务注册工具(服务, 工具值);
//   运行MCP服务_HTTP(服务, "127.0.0.1", 41963);   // 客户端连 http://127.0.0.1:41963/mcp
// 要后台跑就用 goroutine：顶层写 函数 服务协程(服务: MCP服务, 端口: 整数) { 运行MCP服务_HTTP(...); }
// 然后 启动 服务协程(服务, 端口);
公开 函数 运行MCP服务_HTTP(服务: MCP服务, 主机: 字符串, 端口: 整数) : 整数 {
    变量 下标: 整数 = 服务下标(服务.句柄);
    如果 (服务.句柄 <= 0 || 下标 < 0) {
        IO.打印错误行("[MCP服务] 无效服务，无法运行 HTTP 传输");
        返回 0 - 1;
    }
    变量 监听: 整数 = 网络.TCP监听(主机, 端口, 64);
    如果 (监听 <= 0) {
        IO.打印错误行("[MCP服务] 监听 " + 主机 + ":" + 整数转字符串(端口) + " 失败");
        返回 0 - 2;
    }
    IO.打印错误行("[MCP服务] Streamable HTTP 监听 http://" + 主机 + ":" + 整数转字符串(端口) + "/mcp");
    当 (真) {
        变量 连接: 整数 = 网络.TCP接受连接(监听);
        如果 (连接 <= 0) { 跳出; }
        启动 处理MCP_HTTP连接(下标, 连接);
    }
    网络.TCP服务器关闭(监听);
    返回 0;
}

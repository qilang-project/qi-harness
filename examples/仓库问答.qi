// 仓库问答 —— 拿真模型、真嵌入、真数据把整本书的链路串一遍
//
// 这不是玩具：数据是 qilang monorepo 自己的包与文档（对着各仓 qi.toml 和 README 抄的），
// 模型是 cpa 网关的 gemini，嵌入是 t2m 网关的 embeddinggemma（768 维）。
//
// 跑法（两个网关的地址和密钥从环境变量来，不写死在代码里）：
//   export CPA_BASE_URL=…  CPA_API_KEY=…  CPA_MODEL=gemini-3.8-flash-high
//   export T2M_BASE_URL=…  T2M_API_KEY=…  T2M_EMBED_MODEL=embeddinggemma:latest
//   qi run examples/仓库问答.qi
// 少了任何一个就只打印说明并退出（所以它照样进得了「示例必须能编过」那道门禁）。
//
// 走一遍 Negro《Knowledge Graphs and LLMs in Action》的主干：
//
//   第 5-6 章  用 LLM 从文本里抽事实进图        → 抽事实进图()
//   第 10 章   中心性告诉你「哪个包最要紧」      → 谁最要紧()
//   第 7-8 章  同名歧义靠图上的路径来消          → 消歧()
//   14.5      先分意图，决定走哪条链            → 问一句()
//   14.6      把模式摘给模型看                  → 图模式文本(图)
//   14.7      推理在前 + 八段提示词 → 生成查询   → 问一句() 的数据分支
//   第 13 章   查不到结构化答案就退到语义检索     → 问一句() 的文档分支
//
// **两条链的分工**：能翻译成图查询的问题走图（答案精确、可核对）；
// 「这个库为什么这么设计」这类问题图里没有，走向量检索捞原文。
// 意图识别就是那个岔路口 —— 没有它，第二类问题会被硬翻成一条查不出东西的查询。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.列表 作为 表列;
导入 标准库.哈希表;
导入 标准库.JSON 作为 J;
导入 Harness.模型::{模型配置, 大模型, 开启会话};
导入 Harness.代理::{代理, 创建代理, 运行, 关闭代理};
导入 Harness.意图::{意图分类器, 问题种类分类器, 展示型分类器, 识别意图,
                   加背景, 加边界示例};
导入 Harness.文本转查询::{查询提示, 图语句提示, 用模式, 用意图, 生成查询,
                        取查询, 取推理, 记上次失败};
导入 Harness.向量记忆::{打开向量库, 关闭向量库, 语义记住, 语义回忆, 向量记忆条数};
导入 Graph::{打开图, 关闭图, 加节点, 加边, 有节点, 图模式文本, 查, 查数,
             介数中心性, PageRank, 个性化PageRank, 排行JSON,
             加别名, 候选, 消歧上下文, 合并节点};

变量 图路径: 字符串 = "/tmp/qi仓库问答-图.kv";
变量 向量路径: 字符串 = "/tmp/qi仓库问答-向量.db";

// ── 真数据 ────────────────────────────────────────────────────────

// 包与依赖，逐条对着 monorepo 里各仓的 qi.toml（2026-09-14）
函数 建包图() : 整数 {
    如果 (IO.文件存在(图路径) == 1) {
        IO.删除文件(图路径);
    }
    变量 图: 整数 = 打开图(图路径);
    记一个包(图, "Harness", "0.4.0", "LLM agent 框架，把模型调用包在可观测+可重试+可评估的外壳里");
    记一个包(图, "Web", "0.2.0", "用奇语写的 Web 框架，FastAPI / Express 风格");
    记一个包(图, "Graph", "0.1.1", "建在 qi-kv 上的属性图 + RDFS 本体");
    记一个包(图, "KV", "0.1.1", "嵌入式键值存储，追加日志 + 内存索引 + 压实");
    记一个包(图, "CLI", "2026.424.1", "命令行框架");
    记一个包(图, "Pkg", "0.1.1", "包管理客户端 qipkg");
    记一个包(图, "注册中心", "0.1.0", "pkg.qilang.org 服务端，用 qi-web 写");
    记一个包(图, "测试", "0.1.0", "断言与用例运行器");
    连(图, "依赖", "Harness", "Web");
    连(图, "依赖", "Harness", "Graph");
    连(图, "依赖", "Graph", "KV");
    连(图, "开发依赖", "Harness", "CLI");
    连(图, "开发依赖", "Graph", "CLI");
    连(图, "开发依赖", "Graph", "测试");
    连(图, "开发依赖", "KV", "CLI");
    连(图, "开发依赖", "KV", "Web");
    连(图, "开发依赖", "KV", "测试");
    连(图, "开发依赖", "Pkg", "CLI");
    返回 图;
}

函数 记一个包(图: 整数, 名: 字符串, 版本: 字符串, 一句话: 字符串) {
    加节点(图, 名, "[\"包\"]",
        "{\"版本\":\"" + 版本 + "\",\"简介\":\"" + 一句话 + "\"}");
}

函数 连(图: 整数, 型: 字符串, 起: 字符串, 止: 字符串) {
    加边(图, "", 型, 起, 止, "{}");
}

// 真文档片段：从各仓 README 里摘的原话
函数 文档片段(下标: 整数) : 字符串 {
    如果 (下标 == 0) {
        返回 "qi-kv 是用奇语写的嵌入式键值存储。一个库就是一个文件，"
            + "追加日志 + 内存索引 + 压实。没有 seek / pread，所以是全量读进内存。";
    }
    如果 (下标 == 1) {
        返回 "qi-graph 建在 qi-kv 上，两层共用一个 .kv 文件："
            + "图层是属性图（节点/边/邻接/BFS/最短路径/模式匹配），"
            + "本体层是 RDFS 风味（类/属性/个体/子类闭包/物化推理）。";
    }
    如果 (下标 == 2) {
        返回 "qi-graph 的邻接不靠前缀扫。qi-kv 的前缀列键是 O(全部槽) 线性扫，"
            + "所以每个节点存一条邻接值（JSON 数组），取邻居是 O(1) 拿一条。"
            + "前缀扫只留给「按标签列节点」这种全局枚举。";
    }
    如果 (下标 == 3) {
        返回 "qi-harness 是 LLM agent 框架，基于 Martin Fowler 的 harness engineering 模式，"
            + "把模型调用包在可观测、可重试、可评估的外壳里。"
            + "它跟 qi-cli、qi-web 平级，专门给 agent 开发场景。";
    }
    如果 (下标 == 4) {
        返回 "qi-graph 里名字不能带冒号。键靠冒号分段，含冒号的 id、类名、谓词一律拒绝。"
            + "qi-harness 的图记忆因此走安全名：能当键段的原样用，不能的整串转十六进制。";
    }
    返回 "qi-harness 的长时程模块把长任务切成段，段与段之间不继承消息历史，"
        + "而是从持久状态（目标、里程碑、上段笔记、知识图）重新长出上下文。"
        + "所以跑第 1 段和第 100 段，提示词一样长。";
}

变量 片段数: 整数 = 6;

// ── 第 5-6 章：让模型从文本里抽事实进图 ──────────────────────────

函数 抽事实进图(图: 整数, 配置值: 模型配置) : 整数 {
    IO.打印行("");
    IO.打印行("=== 第 5-6 章：让模型从真文档里抽事实 ===");
    变量 会话: 整数 = 开启会话(配置值);
    变量 代理值: 代理 = 创建代理("抽取", 会话);
    变量 收: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 片段数) {
        变量 提示: 字符串 = "从下面这段技术文档里抽出事实三元组。"
            + "只抽文中**明确写了**的，不要推测、不要常识补充。"
            + "输出一个 JSON 数组，每项 {\"主体\":…,\"关系\":…,\"客体\":…}，"
            + "主体和客体尽量用文中出现的专有名词（如 qi-kv、qi-graph）。"
            + "只输出 JSON 数组本身，不要解释也不要代码块标记。\n\n文档：\n"
            + 文档片段(i);
        变量 回: 字符串 = 运行(代理值, 提示);
        收 = 收 + 落库(图, 回);
        i = i + 1;
    }
    关闭代理(代理值);
    IO.打印行("模型从 " + 片段数 + " 段文档里抽出并落库 " + 收 + " 条事实");
    返回 收;
}

函数 落库(图: 整数, 回: 字符串) : 整数 {
    变量 起: 整数 = 字符串::查找(回, "[");
    如果 (起 < 0) {
        返回 0;
    }
    变量 组: 整数 = J.解码(字符串::子串(回, 起, 字符串::字节长度(回) - 起));
    如果 (组 <= 0) {
        返回 0;
    }
    变量 数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        变量 项: 整数 = J.数组获取对象(组, i);
        变量 主: 字符串 = 净化(J.获取字符串(项, "主体"));
        变量 系: 字符串 = 净化(J.获取字符串(项, "关系"));
        变量 客: 字符串 = 净化(J.获取字符串(项, "客体"));
        如果 (字符串::字节长度(主) > 0 与 字符串::字节长度(系) > 0
            与 字符串::字节长度(客) > 0) {
            如果 (有节点(图, 主) == 0) { 加节点(图, 主, "[\"概念\"]", "{}"); }
            如果 (有节点(图, 客) == 0) { 加节点(图, 客, "[\"概念\"]", "{}"); }
            加边(图, "", 系, 主, 客, "{\"来源\":\"README\"}");
            数 = 数 + 1;
        }
        i = i + 1;
    }
    J.删除(组);
    返回 数;
}

// 键里不能有冒号（图.合法段 拦着），模型抽出来的名字里冒号很常见
函数 净化(s: 字符串) : 字符串 {
    返回 字符串::去空白(字符串::替换(s, ":", "-"));
}

// ── 第 10 章：中心性回答「哪个包最要紧」 ─────────────────────────

函数 谁最要紧(图: 整数) {
    IO.打印行("");
    IO.打印行("=== 第 10 章：谁最要紧（这问题图查询答不了，得靠算法）===");
    变量 介: 整数 = 介数中心性(图);
    IO.打印行("介数中心性前三（卡在最多条最短路上的）：");
    IO.打印行("  " + 排行JSON(图, 介, 3));
    哈希表::释放表(介);
    变量 pr: 整数 = PageRank(图);
    IO.打印行("PageRank 前三（顺着边随机走最容易停在谁身上）：");
    IO.打印行("  " + 排行JSON(图, pr, 3));
    哈希表::释放表(pr);
    变量 个: 整数 = 个性化PageRank(图, "[\"Harness\"]");
    IO.打印行("从 Harness 出发的相关度前四（这就是给 agent 挑召回用的判据）：");
    IO.打印行("  " + 排行JSON(图, 个, 4));
    哈希表::释放表(个);
}

// ── 第 7-8 章：同名歧义 ──────────────────────────────────────────

函数 消歧(图: 整数) {
    IO.打印行("");
    IO.打印行("=== 第 7-8 章：「KV」到底指哪个 ===");
    // 真实歧义：KV 既是这个包的名字，也是「键值」这个泛称
    加节点(图, "键值概念", "[\"概念\"]", "{\"说明\":\"键值存储这一类技术的统称\"}");
    加别名(图, "KV", "kv 包");
    加别名(图, "键值概念", "kv 存储");
    IO.打印行("候选：" + 候选(图, "kv"));
    IO.打印行("");
    IO.打印行(消歧上下文(图, "kv", "[\"Graph\"]"));
    IO.打印行("→ 上下文提到 Graph 时，走得通的那个候选才是答案。");
}

// ── 14.5：给通用分类器补上「这张图里有什么」 ─────────────────────
//
// 第一次实跑（cpa gemini-3.8-flash-high，2026-09-14）时，
// 「谁依赖 KV？」被判成了「系统相关/文档相关」，理由是「组件依赖关系属于系统架构，
// 答案在设计文档里」。在通用语境下这个判断不算错 —— 错的是分类器不知道
// **在这张图里包和依赖恰恰就是数据**。
//
// 书里 14.5.2 分析同类误判时给的处方正是这两条：往任务定义里补领域背景，
// 再把观察到的误判收进边界例子。下面就是照做。
函数 本仓分类器() : 意图分类器 {
    变量 c: 意图分类器 = 问题种类分类器();
    c = 加背景(c, "这个知识图谱存的是 qilang 这个代码仓库的**包与包之间的依赖关系**："
        + "节点是包（有版本、简介等属性），边是 依赖 / 开发依赖。"
        + "所以「谁依赖 X」「X 依赖什么」「哪些包用了 Y」这类问题**是数据相关**，"
        + "查图就能答，不要当成架构文档问题。");
    c = 加背景(c, "而「为什么这么设计」「这个模块的取舍是什么」这类问题图里没有，"
        + "属于文档相关。");
    c = 加边界示例(c, "谁依赖 KV？", "数据相关",
        "听起来像在问架构，但这张图里依赖关系就是数据本身，一条查询就能答"
        + "（这条是实跑时真被判错过的）");
    返回 c;
}

// ── 实体归并：LLM 抽出来的名字跟种子节点对不上 ────────────────────
//
// 抽取那一步是真模型干的，它按文档里的写法给出 qi-kv / qi-graph / qi-harness，
// 而种子节点用的是包名 KV / Graph / Harness —— 同一个东西进了图两次。
// 这不是 bug，是从文本建图必然会遇到的事，书里第 7-8 章整两章讲的就是它。
函数 归并重复实体(图: 整数) {
    IO.打印行("");
    IO.打印行("=== 第 7-8 章：把 LLM 抽出来的重名实体并掉 ===");
    变量 并了: 整数 = 0;
    并了 = 并了 + 并一个(图, "KV", "qi-kv");
    并了 = 并了 + 并一个(图, "Graph", "qi-graph");
    并了 = 并了 + 并一个(图, "Harness", "qi-harness");
    IO.打印行("并掉 " + 并了 + " 个重复实体，边全部改挂到包节点上，旧名字留作别名。");
}

函数 并一个(图: 整数, 保留: 字符串, 并入: 字符串) : 整数 {
    如果 (有节点(图, 并入) == 0) {
        返回 0;
    }
    变量 动: 整数 = 合并节点(图, 保留, 并入);
    如果 (动 < 0) {
        返回 0;
    }
    IO.打印行("  " + 并入 + " → " + 保留 + "（改挂 " + 动 + " 条边）");
    返回 1;
}

// ── 14.5 / 14.6 / 14.7 / 13：问一句 ──────────────────────────────

函数 问一句(图: 整数, 向量库: 整数, 问题: 字符串, 配置值: 模型配置,
             嵌入端点: 字符串, 嵌入密钥: 字符串, 嵌入模型: 字符串) {
    IO.打印行("");
    IO.打印行("────────────────────────────────────────");
    IO.打印行("问：" + 问题);

    // 14.5 先分意图 —— 决定走图还是走文档
    变量 意图JSON: 字符串 = 识别意图(本仓分类器(), 问题, 配置值);
    变量 对象: 整数 = J.解码(意图JSON);
    变量 类别: 字符串 = J.获取字符串(对象, "类别");
    变量 子类: 字符串 = J.获取字符串(对象, "子类别");
    IO.打印行("  意图：" + 类别 + " / " + 子类 + "（" + J.获取字符串(对象, "理由") + "）");
    J.删除(对象);

    如果 (类别 == "数据相关") {
        走图那条(图, 问题, 配置值);
    } 否则 {
        走文档那条(向量库, 问题, 嵌入端点, 嵌入密钥, 嵌入模型);
    }
}

函数 走图那条(图: 整数, 问题: 字符串, 配置值: 模型配置) {
    // 14.5 再分一次：想要什么形状的结果，喂给 14.7 当「意图相关的要求」
    变量 形: 字符串 = 识别意图(展示型分类器(), 问题, 配置值);
    变量 形对象: 整数 = J.解码(形);
    变量 形名: 字符串 = J.获取字符串(形对象, "类别");
    J.删除(形对象);

    // 14.6 模式 + 14.7 八段提示词、推理在前
    变量 p: 查询提示 = 图语句提示();
    p = 用模式(p, 图模式文本(图));
    p = 用意图(p, 形名, "只把回答问题必需的变量放进 返回。");
    变量 结果: 字符串 = 生成查询(p, 问题, 配置值);
    变量 语句: 字符串 = 取查询(结果);
    IO.打印行("  推理：" + 截断(取推理(结果), 110));
    IO.打印行("  查询：" + 语句);

    变量 答: 字符串 = 查(图, 语句);
    // 查挂了就把报错带回去重来一次 —— 14.7.2 说的那个可选补充字段
    如果 (字符串::查找(答, "\"错\"") >= 0) {
        IO.打印行("  ↻ 查询有语法错，带着报错重来一次");
        p = 记上次失败(p, 语句, 答);
        结果 = 生成查询(p, 问题, 配置值);
        语句 = 取查询(结果);
        IO.打印行("  重写：" + 语句);
        答 = 查(图, 语句);
    }
    IO.打印行("  答：" + 截断(答, 400));
}

函数 走文档那条(向量库: 整数, 问题: 字符串, 端点: 字符串, 密钥: 字符串, 模型: 字符串) {
    IO.打印行("  （图里没有这种知识，退到语义检索捞原文 —— 第 13 章那条退路）");
    变量 回: 字符串 = 语义回忆(向量库, 端点, 密钥, 模型, 问题, 2);
    如果 (字符串::字节长度(回) == 0) {
        IO.打印行("  答：文档里也没捞到相关内容。");
    } 否则 {
        IO.打印行("  答（语义召回）：");
        IO.打印行(回);
    }
}

函数 截断(s: 字符串, 上限: 整数) : 字符串 {
    如果 (字符串::字节长度(s) <= 上限) {
        返回 s;
    }
    返回 字符串::子串(s, 0, 上限) + "…";
}

// ── 主流程 ────────────────────────────────────────────────────────

函数 取环境(名: 字符串) : 字符串 {
    返回 字符串::去空白(系统.获取环境变量(名));
}

函数 入口() {
    变量 cpa端点: 字符串 = 取环境("CPA_BASE_URL");
    变量 cpa密钥: 字符串 = 取环境("CPA_API_KEY");
    变量 cpa模型: 字符串 = 取环境("CPA_MODEL");
    变量 t2m端点: 字符串 = 取环境("T2M_BASE_URL");
    变量 t2m密钥: 字符串 = 取环境("T2M_API_KEY");
    变量 t2m模型: 字符串 = 取环境("T2M_EMBED_MODEL");
    如果 (字符串::字节长度(cpa端点) == 0 或 字符串::字节长度(t2m端点) == 0) {
        IO.打印行("这个示例要真模型和真嵌入服务。先设好这六个环境变量：");
        IO.打印行("  CPA_BASE_URL / CPA_API_KEY / CPA_MODEL");
        IO.打印行("  T2M_BASE_URL / T2M_API_KEY / T2M_EMBED_MODEL");
        返回;
    }
    变量 配置值: 模型配置 = 大模型(cpa端点, cpa密钥, cpa模型);

    IO.打印行("=== 建图：monorepo 真实的包与依赖 ===");
    变量 图: 整数 = 建包图();
    IO.打印行("八个包、十条依赖边，全部对着各仓 qi.toml。");

    抽事实进图(图, 配置值);

    IO.打印行("");
    IO.打印行("=== 建语义索引：t2m 的 embeddinggemma（768 维）===");
    如果 (IO.文件存在(向量路径) == 1) {
        IO.删除文件(向量路径);
    }
    变量 向量库: 整数 = 打开向量库(向量路径);
    变量 i: 整数 = 0;
    当 (i < 片段数) {
        语义记住(向量库, t2m端点, t2m密钥, t2m模型, "文档", 文档片段(i), "README", 5);
        i = i + 1;
    }
    IO.打印行("入库 " + 向量记忆条数(向量库) + " 段文档。");

    归并重复实体(图);
    谁最要紧(图);
    消歧(图);

    IO.打印行("");
    IO.打印行("=== 问答：意图先分岔，再走图或走文档 ===");
    // 结构化的：图查询答得了
    问一句(图, 向量库, "谁依赖 KV？", 配置值, t2m端点, t2m密钥, t2m模型);
    问一句(图, 向量库, "Harness 直接依赖哪些包？", 配置值, t2m端点, t2m密钥, t2m模型);
    // 非结构化的：图里没有，得退到语义检索
    问一句(图, 向量库, "qi-graph 的邻接为什么不用前缀扫？", 配置值,
           t2m端点, t2m密钥, t2m模型);
    问一句(图, 向量库, "长任务为什么不继承消息历史？", 配置值,
           t2m端点, t2m密钥, t2m模型);

    关闭向量库(向量库);
    关闭图(图);
    IO.打印行("");
    IO.打印行("完。图在 " + 图路径 + "，向量在 " + 向量路径 + "。");
}

// 图记忆 —— 关系型召回（第三路记忆）
//
// 词法记忆答「关于 X 我记过什么」，语义记忆答「跟这句话意思相近的」，
// 这一路答的是**边**上的问题：谁用过 X / X 依赖什么 / A 和 B 是怎么连上的。
//
// 跑之前要有 qi-graph（包名 Graph）+ qi-kv（包名 KV）——
// 它们只被 Harness.图记忆 这一个模块用到，不碰这个模块的程序不受影响。
//   qi run examples/图记忆_关系召回.qi
包 主程序;

导入 标准库.输入输出 作为 IO;
导入 Harness.图记忆::{打开图记忆, 关闭图记忆, 记实体, 关联, 关联带属性,
    图回忆, 怎么连的, 按关系回忆, 图记忆统计};

变量 库路径: 字符串 = "/tmp/图记忆示例.kv";

函数 入口() {
    IO.删除文件(库路径);
    变量 库: 整数 = 打开图记忆(库路径);
    如果 (库 <= 0) {
        IO.打印行("打不开图记忆库（缺 qi-graph / qi-kv？）");
        返回;
    }

    // 名字带冒号也没问题：内部转成安全键段，展示时还原原名
    记实体(库, "mcp:fetch", "工具");
    记实体(库, "研究员", "角色");

    关联(库, "研究员", "用过", "mcp:fetch");
    关联(库, "mcp:fetch", "能取", "网页");
    关联(库, "研究员", "用过", "计算器");
    关联(库, "分析师", "用过", "计算器");        // 两端不存在会自动建
    关联带属性(库, "报告器", "依赖", "分析师", "{\"频次\":\"每次\"}");
    关联(库, "研究员", "用过", "mcp:fetch");     // 幂等，不会长出第二条边

    IO.打印行("统计: " + 图记忆统计(库));

    IO.打印行("");
    IO.打印行("── 研究员周围一跳 ──");
    IO.打印行(图回忆(库, "研究员", 5));

    IO.打印行("");
    IO.打印行("── 研究员周围两跳 ──");
    IO.打印行(图回忆(库, "研究员", 2, 8));

    IO.打印行("");
    IO.打印行("── 谁用过 计算器（入边也走） ──");
    IO.打印行(图回忆(库, "计算器", 5));

    IO.打印行("");
    IO.打印行("── 所有「用过」关系 ──");
    IO.打印行(按关系回忆(库, "用过", 5));

    IO.打印行("");
    IO.打印行("── 研究员 和 网页 是怎么连上的 ──");
    IO.打印行(怎么连的(库, "研究员", "网页"));

    // 每行都是 -【标签】正文，跟 记忆.回忆 一个格式 —— 可以直接拼成一个块注入提示词
    IO.打印行("");
    IO.打印行("── 拼进提示词的样子 ──");
    IO.打印行("## 相关记忆与过往经验");
    IO.打印行(图回忆(库, "研究员", 2, 5));
    IO.打印行("(参考以上背景作答)");

    关闭图记忆(库);
    IO.删除文件(库路径);
}

// qi-harness · MCP 服务端 Streamable HTTP ↔ 客户端 往返
//
// 同一个进程里：goroutine 起 运行MCP服务_HTTP（POST /mcp，application/json，
// Mcp-Session-Id 会话），主线程用本仓 MCP客户端 的 连接MCP_http 连上去
// initialize → tools/list → tools/call → DELETE。任何标准 MCP 客户端（Claude Desktop、
// MCP Inspector、别的 agent）也能连同一个地址。
//
// 跑：qi run examples/MCP服务HTTP_往返测.qi        （离线，不需要模型密钥）

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.时间;
导入 标准库.网络 作为 网络;
导入 标准库.JSON 作为 J;
导入 Harness.工具::{ 工具 };
导入 Harness.MCP服务::{ MCP服务, 创建MCP服务, 服务注册工具, 运行MCP服务_HTTP };
导入 Harness.MCP客户端::{ 连接MCP_http, MCP列出工具, MCP调用工具, 关闭MCP };

函数 加法(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 "参数解析失败"; }
    变量 和: 整数 = J.获取整数(对象, "a") + J.获取整数(对象, "b");
    J.删除(对象);
    返回 整数转字符串(和);
}

函数 回声(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 "参数解析失败"; }
    变量 文本值: 字符串 = J.获取字符串(对象, "text");
    J.删除(对象);
    返回 "echo: " + 文本值;
}

// goroutine 入口：启动 不支持内联闭包，所以要顶层具名函数
函数 服务协程(服务: MCP服务, 端口: 整数) {
    运行MCP服务_HTTP(服务, "127.0.0.1", 端口);
}

函数 入口() {
    变量 端口: 整数 = 41963;
    当 (网络.端口可用(端口) == 0) { 端口 = 端口 + 1; }

    变量 服务: MCP服务 = 创建MCP服务("qi-harness HTTP 示例服务", "1.0.0");
    服务 = 服务注册工具(服务, 新建 工具 {
        名字: "add",
        描述: "两个整数相加，返回它们的和。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"a\":{\"type\":\"integer\"},\"b\":{\"type\":\"integer\"}},\"required\":[\"a\",\"b\"]}",
        处理: 加法,
    });
    服务 = 服务注册工具(服务, 新建 工具 {
        名字: "echo",
        描述: "原样回显传入的文本。",
        参数schema: "{\"type\":\"object\",\"properties\":{\"text\":{\"type\":\"string\"}},\"required\":[\"text\"]}",
        处理: 回声,
    });
    启动 服务协程(服务, 端口);
    时间.睡眠毫秒(300);

    变量 基址: 字符串 = "http://127.0.0.1:" + 整数转字符串(端口) + "/mcp";
    IO.打印行("=== 连接 " + 基址 + " ===");
    变量 描述符: 字符串 = 连接MCP_http(基址);
    如果 (字符串::字节长度(描述符) == 0) { IO.打印行("连接失败"); 返回; }
    IO.打印行("已连接: " + 描述符);

    IO.打印行("");
    IO.打印行("=== tools/list ===");
    IO.打印行(MCP列出工具(描述符));

    IO.打印行("");
    IO.打印行("=== tools/call add {a:2,b:40} ===");
    IO.打印行(MCP调用工具(描述符, "add", "{\"a\":2,\"b\":40}"));

    IO.打印行("");
    IO.打印行("=== tools/call echo {text:\"你好 MCP\"} ===");
    IO.打印行(MCP调用工具(描述符, "echo", "{\"text\":\"你好 MCP\"}"));

    IO.打印行("");
    IO.打印行("=== 关闭（DELETE /mcp 结束会话）===");
    关闭MCP(描述符);
    IO.打印行("完成");
}

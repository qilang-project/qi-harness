// 常驻工示例 —— 让 agent 主动开口
//
// 跑法（零 API 成本，不联网、不调模型）：
//   QI_RUNTIME_LIB=<runtime.a> qi run examples/常驻工示例.qi
//
// 演示四件事：
//   ① 出口：一份消息扇出给多个接收者
//   ② 去重：同一件事在静默期内只说一次 —— 这是整个模块的重点
//   ③ 常驻工：定时/cron 醒来，有话才说
//   ④ 事件桥：把 agent 干活过程中的生命周期事件实时推出去
//
// 真实部署里，接收者那一格换成 Web::广播(...) 就是推到浏览器，
// 换成 Redis 发布就是跨进程，换成 HTTP POST 就是 webhook。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.时间;
导入 标准库.JSON 作为 J;
导入 Harness.常驻工::{推送, 创建推送, 推送带级别, 创建出口, 挂接收者, 送,
    出口统计JSON, 工规格, 按间隔, 按排期, 工规格最多轮, 工规格首轮立即,
    起工, 工下次触发, 工规格说明, 架事件桥, 拆掉全部桥};
导入 Harness.排期::{解析排期, 排期匹配, 下次触发, 排期说明};
导入 Harness.事件::{发出生命周期事件, 清空生命周期订阅者};

// 闭包捕获局部是**按值**的，累计量必须放全局 —— 这条坑写在 常驻工.qi 头部
变量 屏幕收到: 整数 = 0;
变量 日志收到: 整数 = 0;
变量 假时钟: 整数 = 0;

函数 一() {
    IO.打印行("① 出口：一条消息，两个接收者");
    变量 出: 整数 = 创建出口(60);

    挂接收者(出, 闭包(消息JSON: 字符串): 整数 {
        变量 根: 整数 = J.解码(消息JSON);
        IO.打印行("   [屏幕] " + J.获取字符串(根, "级别") + " · "
            + J.获取字符串(根, "标题"));
        J.删除(根);
        屏幕收到 = 屏幕收到 + 1;
        返回 1;
    });
    挂接收者(出, 闭包(消息JSON: 字符串): 整数 {
        日志收到 = 日志收到 + 1;
        返回 1;
    });

    送(出, 推送带级别(创建推送("黄金异动", "黄金涨了 3.2%", "…正文…"), "注意"));
    IO.打印行("   屏幕收到 " + 整数转字符串(屏幕收到) + " 条，日志收到 "
        + 整数转字符串(日志收到) + " 条");

    IO.打印行("");
    IO.打印行("② 去重：同一件事再说三次");
    变量 出去: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 3) {
        出去 = 出去 + 送(出, 创建推送("黄金异动", "黄金涨了 3.2%", "…正文…"));
        i = i + 1;
    }
    IO.打印行("   又送了 3 次，真正出去 " + 整数转字符串(出去) + " 次（静默期 60 秒）");
    // 换一件事就该说
    送(出, 创建推送("比特币异动", "BTC 跌了 5.1%", "…正文…"));
    IO.打印行("   统计：" + 出口统计JSON(出));
    IO.打印行("   —— 每天照发一条的推送最后没人看；只在有东西可说时说，才有人读。");
}

函数 二() {
    IO.打印行("");
    IO.打印行("③ 常驻工：定时醒来，有话才说");
    变量 出: 整数 = 创建出口(0);
    挂接收者(出, 闭包(消息JSON: 字符串): 整数 {
        变量 根: 整数 = J.解码(消息JSON);
        IO.打印行("   [推送] " + J.获取字符串(根, "标题"));
        J.删除(根);
        返回 1;
    });

    // 每秒一轮，跑 4 轮就收工（真实部署用 按排期 或大得多的间隔）
    变量 规: 工规格 = 工规格首轮立即(工规格最多轮(按间隔("巡检", 1), 4), 1);
    IO.打印行("   " + 工规格说明(规));
    起工(规, 出, 闭包(轮次: 整数, 触发时刻: 整数): 整数 {
        假时钟 = 假时钟 + 1;
        // 装作只有第 2、4 轮才真有异动 —— 没事就闭嘴，不产出「一切正常」
        如果 (假时钟 % 2 != 0) {
            IO.打印行("   （第 " + 整数转字符串(轮次) + " 轮：没事，不说话）");
            返回 1;
        }
        送(出, 创建推送("异动" + 整数转字符串(轮次),
            "第 " + 整数转字符串(轮次) + " 轮发现异动", "…"));
        返回 1;
    });

    IO.打印行("");
    IO.打印行("   排期模式（不真跑，只看排班）：");
    变量 工作日: 工规格 = 按排期("盘中巡检", "*/15 9-17 * * MON-FRI");
    IO.打印行("   " + 工规格说明(工作日));
    变量 下: 整数 = 工下次触发(工作日, 时间.现在());
    如果 (下 > 0) {
        IO.打印行("   下次触发：" + 时间.格式化本地(下, "%Y-%m-%d %H:%M:%S") + "（本地）");
    }
    // 日和周同时限定时是「或」，模块会主动提醒
    IO.打印行("   " + 排期说明(解析排期("0 0 13 * 5")));
}

函数 三() {
    IO.打印行("");
    IO.打印行("④ 事件桥：把 agent 干活的过程实时推出去");
    清空生命周期订阅者();
    拆掉全部桥();

    变量 出: 整数 = 创建出口(0);
    挂接收者(出, 闭包(消息JSON: 字符串): 整数 {
        变量 根: 整数 = J.解码(消息JSON);
        IO.打印行("   [" + J.获取字符串(根, "级别") + "] "
            + J.获取字符串(根, "标题"));
        J.删除(根);
        返回 1;
    });
    架事件桥(出, "");

    // 这些事件平时是 agent 主循环自己发的，这里手动发几条模拟一次运行
    发出生命周期事件("run-1", "turn-1", "step-1", "agent_start", "小助手", "{}");
    发出生命周期事件("run-1", "turn-1", "step-2", "tool_call", "小助手", "{}");
    发出生命周期事件("run-1", "turn-1", "step-3", "tool_error", "小助手", "{}");
    IO.打印行("   —— tool_error 被自动抬成「警报」，接收者那边好分流。");

    清空生命周期订阅者();
    拆掉全部桥();
}

函数 入口() {
    IO.打印行("═══ Harness.常驻工 示例 ═══");
    IO.打印行("");
    一();
    二();
    三();
    IO.打印行("");
    IO.打印行("接下来把接收者换成真的出口就能上线：");
    IO.打印行("  浏览器  → Web::广播(锁, 连接表, \"看板\", 消息JSON)");
    IO.打印行("  跨进程  → 标准库.Redis 发布");
    IO.打印行("  webhook → 标准库.HTTP POST");
}

// 观测台演示 —— 一行起看板，边跑 agent 边在浏览器里看
//
//   export DEEPSEEK_API_KEY=...
//   qi run examples/观测台演示.qi
//   浏览器打开 http://127.0.0.1:47123/
//
// 看板上会实时长出这次运行的瀑布图：哪一步慢、哪一步贵、哪个工具失败了。
// 页面每秒刷一次，只推变化的部分（LiveView morph）。
//
// ── 三条路，同一份数据 ──────────────────────────────────────────
//
//   看板      开观测台(端口)                  本进程、零依赖、看当下
//   Prometheus  QI_METRICS_TOKEN=... + /metrics  多实例汇总、告警
//   Jaeger 等   设置OTLP("http://…:4318")        长期存储、跨服务关联
//
// 想要后两条就把下面注释掉的两行打开。

包 主程序;

导入 标准库.输入输出 作为 IO;
导入 标准库.操作系统 作为 系统;
导入 标准库.时间;
导入 Harness::{大模型, 配置系统提示, 开启会话, 创建代理, 添加工具, 运行, 关闭代理, 工具};
导入 Harness.代理::{代理};
导入 Harness.观测台::{开观测台, 设置观测台标题};
// 要把链路推给 Jaeger / Tempo / Langfuse 时再导这两个：
// 导入 Harness.追踪::{设置OTLP, 设置服务名, 导出树到OTLP};
// 导入 Harness.跨度::{跨度树JSON};

函数 查天气(参数JSON: 字符串) : 字符串 {
    // 演示用，固定返回；真工具在这儿调 HTTP
    时间.睡眠毫秒(400);
    返回 "{\"城市\":\"东京\",\"天气\":\"晴\",\"气温\":22}";
}

函数 查汇率(参数JSON: 字符串) : 字符串 {
    时间.睡眠毫秒(150);
    返回 "{\"对\":\"CNY/JPY\",\"价\":20.6}";
}

函数 入口() {
    // 一行。顺手把跨度采集器和指标也装好了 —— 忘装的话看板永远是空的，
    // 而空看板看着像「agent 没跑」，排查方向整个错掉。
    设置观测台标题("旅行助手 · 观测台");
    开观测台(47123);

    // 设置OTLP("http://127.0.0.1:4318");   // 有 collector 时打开
    // 设置服务名("旅行助手");

    变量 密钥: 字符串 = 系统.获取环境变量("DEEPSEEK_API_KEY");
    变量 配置 = 大模型("https://api.deepseek.com/v1", 密钥, "deepseek-chat");
    配置 = 配置系统提示(配置, "你是旅行助手。需要实时信息时调用工具。");

    变量 代理值: 代理 = 创建代理("旅行助手", 开启会话(配置));
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "查天气",
        描述: "查某个城市当前天气",
        参数schema: "{\"type\":\"object\",\"properties\":{\"城市\":{\"type\":\"string\"}},\"required\":[\"城市\"]}",
        处理: 查天气,
    });
    代理值 = 添加工具(代理值, 新建 工具 {
        名字: "查汇率",
        描述: "查两种货币的汇率",
        参数schema: "{\"type\":\"object\",\"properties\":{\"从\":{\"type\":\"string\"},\"到\":{\"type\":\"string\"}}}",
        处理: 查汇率,
    });

    IO.打印行("开始跑 —— 打开 http://127.0.0.1:47123/ 看着它长出来");
    IO.打印行(运行(代理值, "我明天去东京，天气怎么样？带 5000 人民币够花吗？"));

    // 有 collector 时把整棵树推过去（一次 POST，带 parentSpanId）
    // 导出树到OTLP(跨度树JSON(""));

    // 别急着退：进程一没，看板也就没了（数据在内存里）
    IO.打印行("跑完了。看板还开着，Ctrl-C 退出。");
    时间.睡眠毫秒(600000);
    关闭代理(代理值);
}

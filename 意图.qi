// qi-harness · 意图 —— 先弄清用户到底想要什么，再决定走哪条链
//
// 对应 Negro《Knowledge Graphs and LLMs in Action》第 14 章 14.5 节
// 「Intent detection: Understanding user expectations」。
//
// 那一节的论点：同一个问题「最近有哪些红色 Camaro 被拍到」，答案可以是一张关系图、
// 一张表、一张分布图，也可以是一张地图 —— 到底该给哪个，取决于**用户想要什么**，
// 而不是数据长什么样。所以问答系统的第一步不是查数据，是分类。
// 分完类才知道：该走哪条管线、该让下游生成什么形状的查询、该怎么把结果呈现出去。
//
// 而且不止「要什么图」这一层。真实用户问的东西里有相当一部分**根本不该去查数据**：
// 「能导出 CSV 吗」是文档问题，「这图多久更新一次」是系统问题，「怎么这么慢」是抱怨。
// 拿这些去生成查询，只会得到一条查不出东西的查询和一句莫名其妙的回答。
//
// ── 分类提示词的六条要求（书里 14.5.1 列的，本模块按这六条组装）──
//   1. 任务说明写在最前面，一句话说清要干什么
//   2. 每个类别都要有明确定义，模型才分得开
//   3. 给例子（few-shot）
//   4. **给边界例子** —— 挨着分界线的那些才真正教会模型怎么分
//   5. 留一个兜底类别，并说明什么时候用它，避免硬套
//   6. 输出里要有 理由 字段
//
// ── 为什么分类任务是「答案在前」──
// 14.7.1 讲生成任务要**推理在前**（先想后答，否则模型会为已出口的答案编理由）。
// 分类是那条规则的例外，书里明说了：这里的 理由 不是用来帮模型想的，是给**我们**
// 看的 —— 分错时照着理由就知道该往边界例子里补什么。所以字段顺序是 类别 → 理由，
// 见 分类字段()。这不是疏忽，是两种任务的目的不同。

包 Harness;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 Harness.模型::{模型配置, 开启会话};
导入 Harness.代理::{代理, 创建代理, 结构化运行, 关闭代理, 取JSON对象段};
导入 Harness.追踪::{事件};

公开 类型 意图分类器 {
    名字: 字符串,
    任务说明: 字符串,
    背景: 字符串,       // 领域背景，见 加背景
    类别们: 字符串,     // JSON 数组 [{"名":…,"说明":…,"子类别":[{"名":…,"说明":…}]}]
    示例们: 字符串,     // JSON 数组 [{"问":…,"类别":…,"子类别":…,"理由":…,"边界":0|1}]
    兜底: 字符串,
    兜底说明: 字符串,
}

公开 函数 创建分类器(名字: 字符串, 任务说明: 字符串) : 意图分类器 {
    返回 新建 意图分类器 {
        名字: 名字, 任务说明: 任务说明, 背景: "",
        类别们: "[]", 示例们: "[]", 兜底: "", 兜底说明: "",
    };
}

公开 函数 加类别(分类器: 意图分类器, 名: 字符串, 说明: 字符串) : 意图分类器 {
    变量 组: 整数 = J.解码(分类器.类别们);
    如果 (组 <= 0) { 组 = J.创建数组(); }
    变量 项: 整数 = J.创建对象();
    J.设置字符串(项, "名", 名);
    J.设置字符串(项, "说明", 说明);
    J.设置数组(项, "子类别", J.创建数组());
    J.数组添加对象(组, 项);
    分类器.类别们 = J.转字符串(组);
    J.删除(组);
    返回 分类器;
}

// 子类别 = 书里 14.5.2 的两级分类：系统相关 再分 文档相关 / 模式相关。
// 父类别得先加，找不到父类别时原样返回（不静默造一个出来）。
//
// ⚠ 这里是**重建整个数组**而不是就地改。qi 的 J.数组获取对象 返回的是元素的
// **克隆**（新的 JSON id），往克隆上写字段不会回写进数组 —— 第一版就是那么写的，
// 加子类别 静默无效，提示词里一个子类别都没有，编译和运行都不报错。
公开 函数 加子类别(分类器: 意图分类器, 父类别: 字符串, 名: 字符串, 说明: 字符串) : 意图分类器 {
    变量 组: 整数 = J.解码(分类器.类别们);
    如果 (组 <= 0) { 返回 分类器; }
    变量 新组: 整数 = J.创建数组();
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        变量 项: 整数 = J.数组获取对象(组, i);
        如果 (J.获取字符串(项, "名") == 父类别) {
            变量 子: 整数 = J.获取数组(项, "子类别");
            如果 (子 <= 0) { 子 = J.创建数组(); }
            变量 一: 整数 = J.创建对象();
            J.设置字符串(一, "名", 名);
            J.设置字符串(一, "说明", 说明);
            J.数组添加对象(子, 一);
            J.设置数组(项, "子类别", 子);
        }
        J.数组添加对象(新组, 项);
        i = i + 1;
    }
    分类器.类别们 = J.转字符串(新组);
    J.删除(新组);
    J.删除(组);
    返回 分类器;
}

公开 函数 加示例(分类器: 意图分类器, 问: 字符串, 类别: 字符串, 理由: 字符串) : 意图分类器 {
    返回 记一条示例(分类器, 问, 类别, "", 理由, 0);
}

公开 函数 加子类示例(分类器: 意图分类器, 问: 字符串, 类别: 字符串,
                     子类别: 字符串, 理由: 字符串) : 意图分类器 {
    返回 记一条示例(分类器, 问, 类别, 子类别, 理由, 0);
}

// 边界例子：挨着两个类别分界线的那种。书里说这类例子最值钱 ——
// 「有哪些常见的有组织犯罪类型涉及人口贩运」既像关系图又像聚合表，
// 正是这种没有唯一正确答案的问题在塑造模型的分寸感。
// 拿到边界例子的最好办法是**看线上分错了什么**，把它补进来。
公开 函数 加边界示例(分类器: 意图分类器, 问: 字符串, 类别: 字符串, 理由: 字符串) : 意图分类器 {
    返回 记一条示例(分类器, 问, 类别, "", 理由, 1);
}

函数 记一条示例(分类器: 意图分类器, 问: 字符串, 类别: 字符串,
                子类别: 字符串, 理由: 字符串, 边界: 整数) : 意图分类器 {
    变量 组: 整数 = J.解码(分类器.示例们);
    如果 (组 <= 0) { 组 = J.创建数组(); }
    变量 项: 整数 = J.创建对象();
    J.设置字符串(项, "问", 问);
    J.设置字符串(项, "类别", 类别);
    J.设置字符串(项, "子类别", 子类别);
    J.设置字符串(项, "理由", 理由);
    J.设置整数(项, "边界", 边界);
    J.数组添加对象(组, 项);
    分类器.示例们 = J.转字符串(组);
    J.删除(组);
    返回 分类器;
}

// 给任务说明补一段**领域背景**：这个系统的图里到底存了什么。
//
// 书里 14.5.2 分析那个误判案例（「知识图谱多久更新一次」被小模型判成数据相关）时
// 给的处方就是这一条：「这说明我们应当在任务定义那一节里补上相关背景信息」。
// 真跑一次就知道为什么必要 —— 拿 cpa 的 gemini 跑 qilang 仓库问答时，
// 「谁依赖 KV？」被判成了「系统相关/文档相关」，因为在通用语境里
// 「组件依赖」听起来确实像架构文档的事。而在**这张图**里，包和依赖恰恰就是数据。
// 分类器不知道图里存了什么，就只能按常识猜。
公开 函数 加背景(分类器: 意图分类器, 背景: 字符串) : 意图分类器 {
    如果 (字符串::字节长度(分类器.背景) > 0) {
        分类器.背景 = 分类器.背景 + "\n";
    }
    分类器.背景 = 分类器.背景 + 背景;
    返回 分类器;
}

// 兜底类别：看不出属于哪一类时用它。书里第五条要求 ——
// 不留兜底，模型就会硬把问题塞进某一类，而硬塞出来的类别比「不知道」更有害。
公开 函数 设兜底(分类器: 意图分类器, 名: 字符串, 说明: 字符串) : 意图分类器 {
    分类器.兜底 = 名;
    分类器.兜底说明 = 说明;
    返回 分类器;
}

// ── 提示词 ────────────────────────────────────────────────────────

公开 函数 分类提示(分类器: 意图分类器, 问题: 字符串) : 字符串 {
    // 一、任务说明（含领域背景）
    变量 出: 字符串 = 分类器.任务说明 + "\n";
    如果 (字符串::字节长度(分类器.背景) > 0) {
        出 = 出 + "\n### 这个系统里有什么\n" + 分类器.背景 + "\n";
    }

    // 二、类别定义
    出 = 出 + "\n## 可选类别\n";
    变量 组: 整数 = J.解码(分类器.类别们);
    如果 (组 > 0) {
        变量 i: 整数 = 0;
        当 (i < J.数组长度(组)) {
            变量 项: 整数 = J.数组获取对象(组, i);
            出 = 出 + "- **" + J.获取字符串(项, "名") + "**："
                + J.获取字符串(项, "说明") + "\n";
            变量 子: 整数 = J.获取数组(项, "子类别");
            如果 (子 > 0 与 J.数组长度(子) > 0) {
                变量 k: 整数 = 0;
                当 (k < J.数组长度(子)) {
                    变量 一: 整数 = J.数组获取对象(子, k);
                    出 = 出 + "    - 子类别 **" + J.获取字符串(一, "名") + "**："
                        + J.获取字符串(一, "说明") + "\n";
                    k = k + 1;
                }
                出 = 出 + "  （归到这一类时**必须**再给出子类别。）\n";
            }
            i = i + 1;
        }
        J.删除(组);
    }
    如果 (字符串::字节长度(分类器.兜底) > 0) {
        出 = 出 + "- **" + 分类器.兜底 + "**（兜底）：" + 分类器.兜底说明
            + " 看不出属于以上任何一类时用它，**不要硬套**。\n";
    }

    // 三、例子（边界例子单独标出来）
    变量 例组: 整数 = J.解码(分类器.示例们);
    如果 (例组 > 0 与 J.数组长度(例组) > 0) {
        出 = 出 + "\n## 例子\n";
        变量 e: 整数 = 0;
        当 (e < J.数组长度(例组)) {
            变量 例: 整数 = J.数组获取对象(例组, e);
            出 = 出 + "\n问：" + J.获取字符串(例, "问") + "\n答：";
            变量 答: 整数 = J.创建对象();
            J.设置字符串(答, "类别", J.获取字符串(例, "类别"));
            变量 子名: 字符串 = J.获取字符串(例, "子类别");
            如果 (字符串::字节长度(子名) > 0) {
                J.设置字符串(答, "子类别", 子名);
            }
            J.设置字符串(答, "理由", J.获取字符串(例, "理由"));
            出 = 出 + J.转字符串(答) + "\n";
            J.删除(答);
            如果 (J.获取整数(例, "边界") == 1) {
                出 = 出 + "（这一条卡在两类之间，注意体会分界。）\n";
            }
            e = e + 1;
        }
    }
    如果 (例组 > 0) { J.删除(例组); }

    // 四、待分类的问题
    出 = 出 + "\n## 待分类\n问：" + 问题 + "\n";
    返回 出;
}

// 分类任务的字段顺序：**类别在前、理由在后**。
//
// 跟 文本转查询 那边的「推理在前」正好相反，是有意的（见文件抬头）：
// 分类的 理由 不是给模型用来想的，是给我们用来看它为什么分错的。
// 想让模型在分类时也先想再答，就自己把 理由 排到前面 —— 但那样这个字段就不再是
// 「事后诊断」而变成「事前推理」了，边界例子的调法也得跟着变。
公开 函数 分类字段() : 整数 {
    变量 表: 整数 = 表列::创建字符串列表();
    表列::添加字符串(表, "类别");
    表列::添加字符串(表, "理由");
    返回 表;
}

公开 函数 分类字段带子类别() : 整数 {
    变量 表: 整数 = 表列::创建字符串列表();
    表列::添加字符串(表, "类别");
    表列::添加字符串(表, "子类别");
    表列::添加字符串(表, "理由");
    返回 表;
}

// ── 跑一次 ────────────────────────────────────────────────────────

// 返回模型给的 JSON（含 类别 / 子类别 / 理由）。解析不出来时返回
// {"类别":"<兜底或空>","理由":"模型没给出合法分类"} —— 分类器不该把上层带崩。
公开 函数 识别意图(分类器: 意图分类器, 问题: 字符串, 配置值: 模型配置) : 字符串 {
    变量 会话: 整数 = 开启会话(配置值);
    如果 (会话 <= 0) {
        返回 兜底结果(分类器, "开不了会话");
    }
    变量 代理值: 代理 = 创建代理(分类器.名字, 会话);
    变量 出: 字符串 = 识别意图使用代理(分类器, 问题, 代理值);
    关闭代理(代理值);
    返回 出;
}

// 复用一个已有代理（省一次开会话；批量分类时值得）。
公开 函数 识别意图使用代理(分类器: 意图分类器, 问题: 字符串, 代理值: 代理) : 字符串 {
    变量 有子: 整数 = 是否有子类别(分类器);
    变量 字段: 整数 = 分类字段();
    如果 (有子 == 1) {
        表列::删除列表(字段);
        字段 = 分类字段带子类别();
    }
    变量 回: 字符串 = 结构化运行(代理值, 分类提示(分类器, 问题), 字段);
    表列::删除列表(字段);

    变量 对象: 整数 = J.解码(取JSON对象段(回));
    如果 (对象 <= 0) {
        事件("intent_unparsed", 分类器.名字, 问题);
        返回 兜底结果(分类器, "模型没给出合法 JSON");
    }
    变量 类别: 字符串 = J.获取字符串(对象, "类别");
    J.删除(对象);
    如果 (字符串::字节长度(类别) == 0) {
        事件("intent_unparsed", 分类器.名字, 问题);
        返回 兜底结果(分类器, "模型没给出类别");
    }
    // 类别不在名单里也要说一声 —— 它意味着提示词里的类别定义不够清楚
    如果 (在类别名单里(分类器, 类别) == 0) {
        事件("intent_out_of_range", 分类器.名字, 类别 + " ← " + 问题);
    }
    返回 取JSON对象段(回);
}

// 多级分类（书里 14.5 结尾讨论的 multistage）：先粗分，命中 触发类别 再用细分类器分一次，
// 把细分结果并进 子类别 字段。
//
// 什么时候值得拆：一个大提示词能兼顾所有类别时就别拆（省一次调用）；
// 但类别一多、边界一乱，或者分类口径要经常改，拆开每一级都能单独调，
// 比在一个越来越长的提示词里打补丁强。
公开 函数 多级识别(主分类器: 意图分类器, 触发类别: 字符串, 细分类器: 意图分类器,
                   问题: 字符串, 配置值: 模型配置) : 字符串 {
    变量 粗: 字符串 = 识别意图(主分类器, 问题, 配置值);
    变量 对象: 整数 = J.解码(粗);
    如果 (对象 <= 0) {
        返回 粗;
    }
    如果 (J.获取字符串(对象, "类别") != 触发类别) {
        J.删除(对象);
        返回 粗;
    }
    变量 细: 字符串 = 识别意图(细分类器, 问题, 配置值);
    变量 细对象: 整数 = J.解码(细);
    如果 (细对象 > 0) {
        J.设置字符串(对象, "子类别", J.获取字符串(细对象, "类别"));
        J.设置字符串(对象, "子类别理由", J.获取字符串(细对象, "理由"));
        J.删除(细对象);
    }
    变量 出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 出;
}

函数 是否有子类别(分类器: 意图分类器) : 整数 {
    变量 组: 整数 = J.解码(分类器.类别们);
    如果 (组 <= 0) { 返回 0; }
    变量 有: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        变量 子: 整数 = J.获取数组(J.数组获取对象(组, i), "子类别");
        如果 (子 > 0 与 J.数组长度(子) > 0) { 有 = 1; }
        i = i + 1;
    }
    J.删除(组);
    返回 有;
}

公开 函数 在类别名单里(分类器: 意图分类器, 类别: 字符串) : 整数 {
    如果 (类别 == 分类器.兜底 与 字符串::字节长度(分类器.兜底) > 0) { 返回 1; }
    变量 组: 整数 = J.解码(分类器.类别们);
    如果 (组 <= 0) { 返回 0; }
    变量 有: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < J.数组长度(组)) {
        如果 (J.获取字符串(J.数组获取对象(组, i), "名") == 类别) { 有 = 1; }
        i = i + 1;
    }
    J.删除(组);
    返回 有;
}

函数 兜底结果(分类器: 意图分类器, 理由: 字符串) : 字符串 {
    变量 对象: 整数 = J.创建对象();
    J.设置字符串(对象, "类别", 分类器.兜底);
    J.设置字符串(对象, "理由", 理由);
    变量 出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 出;
}

// ── 书里那两个现成分类器 ──────────────────────────────────────────

// 14.5.1：问题想要什么形状的呈现。前端能画图、能出表、能画分布、能上地图，
// 所以类别就是这四样 —— **类别集合应当照着系统真能呈现什么来定**，
// 而不是照着「问题理论上分几种」来定。
公开 函数 展示型分类器() : 意图分类器 {
    变量 c: 意图分类器 = 创建分类器("展示型意图",
        "下面是一个用户问题。判断它最适合用哪种形式呈现结果。只选一种。");
    c = 加类别(c, "关系图", "问的是实体之间怎么连、谁跟谁有关系");
    c = 加类别(c, "表格", "问的是聚合、排序、统计，答案是一批带字段的记录");
    c = 加类别(c, "图表", "问的是分布、趋势、比例这类要画出来的东西");
    c = 加类别(c, "地图", "问的是位置、地点，或带强地理属性的实体");
    c = 设兜底(c, "关系图", "看不出明确偏好时按关系图给，它信息量最全");
    c = 加示例(c, "按辖区统计各类犯罪的数量", "表格", "要的是聚合结果");
    c = 加示例(c, "跟 Morse 探长经办的案子有牵连的人", "关系图", "问的是实体与关系");
    c = 加示例(c, "近三年交通事故的月度趋势", "图表", "要看的是分布随时间的变化");
    c = 加示例(c, "最近一周哪些摄像头拍到过红色 Camaro", "地图", "摄像头带位置，落在地图上最直观");
    // 边界例子：既像关系又像聚合，书里专门拿它举例说这种最有价值
    c = 加边界示例(c, "涉及人口贩运的有组织犯罪类型主要有哪几种", "关系图",
        "虽然带「有哪几种」的聚合味，但重点是犯罪类型与人口贩运之间的关联");
    返回 c;
}

// 14.5.2：这问题到底该不该去查数据。
// 「能导出 CSV 吗」「这图多久更新一次」拿去生成查询，只会得到一条查不出东西的查询。
公开 函数 问题种类分类器() : 意图分类器 {
    变量 c: 意图分类器 = 创建分类器("问题种类",
        "你要给一个知识图谱问答系统的用户提问分类，判断它该由哪条链路处理。");
    c = 加类别(c, "数据相关", "要从知识图谱里查具体信息的问题");
    c = 加类别(c, "系统相关", "问的是系统本身的功能、特性、结构或设计，答案在文档或模式里，不在数据里");
    c = 加子类别(c, "系统相关", "文档相关", "看用户手册、帮助页就能答的");
    c = 加子类别(c, "系统相关", "模式相关", "要理解图谱的结构（有哪些类、哪些关系）才能答的");
    c = 加类别(c, "反馈与抱怨", "系统答不了的，或者本身就是意见、抱怨、改进请求");
    c = 设兜底(c, "反馈与抱怨", "既不是查数据也不是问系统时归到这里");
    c = 加子类示例(c, "能把数据导成 CSV 吗？", "系统相关", "文档相关",
        "问的是系统有没有导出能力，属于功能说明");
    c = 加子类示例(c, "我要怎么用系统评估某个嫌疑人的风险等级？", "系统相关", "模式相关",
        "要先知道图里跟风险有关的结构才答得上");
    c = 加示例(c, "上个月哪个辖区的入室盗窃最多？", "数据相关", "直接查数据就能答");
    c = 加示例(c, "系统怎么老是不响应？", "反馈与抱怨", "这是对性能的抱怨，不是在要数据");
    // 书里点名的那个误分类：小模型会把它当成「数据相关」
    c = 加边界示例(c, "知识图谱多久更新一次？", "系统相关",
        "问的是更新频率这个系统特性，不是图里的数据本身（小模型常误判成数据相关）");
    返回 c;
}

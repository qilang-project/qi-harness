// qi-harness · 文本转查询 —— 让模型「先想再答」，并按八段结构拼提示词
//
// 对应 Negro《Knowledge Graphs and LLMs in Action》第 14 章 14.7 节
// 「It's time to think: Understanding LLM reasoning」。
//
// ── 14.7.1 顺序决定质量，而顺序就是字段顺序 ──
// 模型一个 token 一个 token 地生成，**已经写出去的会约束还没写的**。让它先给答案、
// 再给理由，它多半会为那个已经出口的答案编一套理由，而不是真的推导一遍；
// 早期一个小错还会顺着 token 链传下去。反过来先写推理，它就得先把问题拆开、
// 定个方案，答案是推完之后落下来的。
//
// 关键在于：**这个顺序不是靠在提示词里客气地请求，而是靠输出 JSON 的字段顺序钉死的。**
// 结构化运行 收的就是一个有序字段表，本模块 查询字段() 给的顺序是
//   关系 → 推理 → 查询
// 先让它列出打算走哪些关系（列出来就不好再编造图里没有的关系了），
// 再给它一块草稿纸写推理，最后才要查询 —— 前两段都在，它写查询时会自觉保持一致。
//
// **分类任务是例外**，见 意图.qi：那里的 理由 是给我们诊断误判用的，排在答案后面。
// 两个模块顺序相反是有意的，不是哪边写漏了。
//
// ── 14.7.2 八段结构 ──
// 提示词按固定八段拼（组装提示）：
//   1 任务说明与问题   2 带说明的图模式   3 意图相关的要求   4 例子
//   5 用户选择（可选）  6 图特有的注记     7 再说一遍问题     8 输出格式
// 第 7 段不是啰嗦：模式那段可能几千 token，问题要是只在开头出现一次，
// 它离模型开始作答的位置就太远了。结尾再放一遍，让它贴着答案。
//
// ── 跟 qi-graph 的关系 ──
// 本模块**不导入** qi-graph：模式是当字符串传进来的（`用模式(提示, 图模式文本(图))`）。
// 理由跟 长时程 那边一样 —— Harness.qi re-export 的模块一旦引 qi-graph，
// 所有用 Harness 的程序都得装上 qi-graph + qi-kv 才编得过。

包 Harness;

导入 标准库.JSON 作为 J;
导入 标准库.字符串;
导入 标准库.列表 作为 表列;
导入 Harness.模型::{模型配置, 开启会话};
导入 Harness.代理::{代理, 创建代理, 结构化运行, 关闭代理, 取JSON对象段};

公开 类型 查询提示 {
    任务说明: 字符串,
    模式文本: 字符串,
    意图: 字符串,
    意图要求: 字符串,
    示例们: 字符串,     // JSON [{"问":…,"关系":[…],"推理":…,"查询":…}]
    图注记: 字符串,
    用户选择: 字符串,
    上次查询: 字符串,
    上次错误: 字符串,
}

公开 函数 创建查询提示(任务说明: 字符串) : 查询提示 {
    返回 新建 查询提示 {
        任务说明: 任务说明, 模式文本: "", 意图: "", 意图要求: "",
        示例们: "[]", 图注记: "", 用户选择: "", 上次查询: "", 上次错误: "",
    };
}

// 图模式那一段。传 qi-graph 的 图模式文本(图) 进来即可 —— 它本来就带 ### 小标题，
// 书里也强调用 markdown 标题分节，模型对结构化的模式描述接得更稳。
公开 函数 用模式(提示: 查询提示, 模式文本: 字符串) : 查询提示 {
    提示.模式文本 = 模式文本;
    返回 提示;
}

// 意图相关的要求（14.7.2 第三段）：同一个问题，意图是「地图」就得把位置属性查出来，
// 是「表格」就得聚合。意图从 意图.识别意图 来。
公开 函数 用意图(提示: 查询提示, 意图: 字符串, 要求: 字符串) : 查询提示 {
    提示.意图 = 意图;
    提示.意图要求 = 要求;
    返回 提示;
}

// 例子（14.7.3「Ensuring example consistency」）：例子**必须按输出格式给全字段**，
// 少一个字段就是在示范一种不合格的输出，模型会照着学。
公开 函数 加查询示例(提示: 查询提示, 问: 字符串, 关系JSON: 字符串,
                    推理: 字符串, 查询: 字符串) : 查询提示 {
    变量 组: 整数 = J.解码(提示.示例们);
    如果 (组 <= 0) { 组 = J.创建数组(); }
    变量 项: 整数 = J.创建对象();
    J.设置字符串(项, "问", 问);
    J.设置字符串(项, "关系", 关系JSON);
    J.设置字符串(项, "推理", 推理);
    J.设置字符串(项, "查询", 查询);
    J.数组添加对象(组, 项);
    提示.示例们 = J.转字符串(组);
    J.删除(组);
    返回 提示;
}

// 这张图特有的注记：字段里的怪缩写、某个关系的实际含义之类。
// 单独一段是为了让人能随图调整，而不用去动提示词主体。
公开 函数 加图注记(提示: 查询提示, 注记: 字符串) : 查询提示 {
    如果 (字符串::字节长度(提示.图注记) > 0) {
        提示.图注记 = 提示.图注记 + "\n";
    }
    提示.图注记 = 提示.图注记 + "- " + 注记;
    返回 提示;
}

公开 函数 设用户选择(提示: 查询提示, 选定: 字符串) : 查询提示 {
    提示.用户选择 = 选定;
    返回 提示;
}

// 上一轮生成的查询跑挂了，把它和数据库的报错一起带上再问一次。
// 书里把这个放在「再说一遍问题」那一段旁边，作为可选补充信息 ——
// 让模型看见自己上次错在哪，比让它盲目重来强得多。
公开 函数 记上次失败(提示: 查询提示, 查询: 字符串, 错误: 字符串) : 查询提示 {
    提示.上次查询 = 查询;
    提示.上次错误 = 错误;
    返回 提示;
}

// ── 推理顺序 ──────────────────────────────────────────────────────

公开 函数 推理在前() : 整数 { 返回 0; }
公开 函数 答案在前() : 整数 { 返回 1; }

// 按顺序拼一个两字段的必需字段表。**顺序就是模型的思考顺序**，见文件抬头。
//   推理在前()：生成类任务用这个 —— 先想后答
//   答案在前()：分类类任务用这个 —— 理由是事后诊断用的（见 意图.qi）
公开 函数 按顺序排字段(顺序: 整数, 推理字段: 字符串, 答案字段: 字符串) : 整数 {
    变量 表: 整数 = 表列::创建字符串列表();
    如果 (顺序 == 1) {
        表列::添加字符串(表, 答案字段);
        表列::添加字符串(表, 推理字段);
    } 否则 {
        表列::添加字符串(表, 推理字段);
        表列::添加字符串(表, 答案字段);
    }
    返回 表;
}

// 检查一个字段表是不是「推理在前」。写测试和做代码审查时用 ——
// 字段顺序是一行不起眼的代码，改反了不会报错，只会让答案悄悄变差。
公开 函数 是推理在前(字段表: 整数, 推理字段: 字符串, 答案字段: 字符串) : 整数 {
    变量 推位: 整数 = 0 - 1;
    变量 答位: 整数 = 0 - 1;
    变量 i: 整数 = 0;
    当 (i < 表列::字符串列表大小(字段表)) {
        变量 名: 字符串 = 表列::获取字符串(字段表, i);
        如果 (名 == 推理字段 与 推位 < 0) { 推位 = i; }
        如果 (名 == 答案字段 与 答位 < 0) { 答位 = i; }
        i = i + 1;
    }
    如果 (推位 < 0 或 答位 < 0) { 返回 0; }
    如果 (推位 < 答位) { 返回 1; }
    返回 0;
}

// 文本转查询的字段顺序（14.7.3）：关系 → 推理 → 查询。
//   关系 排头：先把打算走的关系列出来，后面就不好再编造图里没有的关系
//   推理 居中：草稿纸，拆问题、定方案
//   查询 收尾：前两段都在眼前，写出来的查询自然跟它们一致
公开 函数 查询字段() : 整数 {
    变量 表: 整数 = 表列::创建字符串列表();
    表列::添加字符串(表, "关系");
    表列::添加字符串(表, "推理");
    表列::添加字符串(表, "查询");
    返回 表;
}

// ── 八段结构 ──────────────────────────────────────────────────────

公开 函数 组装提示(提示: 查询提示, 问题: 字符串) : 字符串 {
    // 1 任务说明与问题
    变量 出: 字符串 = 提示.任务说明 + "\n\n问题：" + 问题 + "\n";

    // 2 带说明的图模式
    如果 (字符串::字节长度(提示.模式文本) > 0) {
        出 = 出 + "\n" + 提示.模式文本 + "\n";
    }

    // 3 意图相关的要求
    如果 (字符串::字节长度(提示.意图要求) > 0) {
        出 = 出 + "\n### 这次要什么\n";
        如果 (字符串::字节长度(提示.意图) > 0) {
            出 = 出 + "用户想要的呈现形式：" + 提示.意图 + "\n";
        }
        出 = 出 + 提示.意图要求 + "\n";
    }

    // 4 例子 —— 按输出格式给全，见 加查询示例 的注释
    变量 组: 整数 = J.解码(提示.示例们);
    如果 (组 > 0 与 J.数组长度(组) > 0) {
        出 = 出 + "\n### 例子\n";
        变量 i: 整数 = 0;
        当 (i < J.数组长度(组)) {
            变量 例: 整数 = J.数组获取对象(组, i);
            出 = 出 + "\n问：" + J.获取字符串(例, "问") + "\n答：{\"关系\": "
                + 空则(J.获取字符串(例, "关系"), "[]")
                + ", \"推理\": \"" + 转义(J.获取字符串(例, "推理"))
                + "\", \"查询\": \"" + 转义(J.获取字符串(例, "查询")) + "\"}\n";
            i = i + 1;
        }
    }
    如果 (组 > 0) { J.删除(组); }

    // 5 用户选择（可选）
    如果 (字符串::字节长度(提示.用户选择) > 0) {
        出 = 出 + "\n### 用户已经选定的\n" + 提示.用户选择 + "\n";
    }

    // 6 这张图特有的注记
    如果 (字符串::字节长度(提示.图注记) > 0) {
        出 = 出 + "\n### 这张图要注意的\n" + 提示.图注记 + "\n";
    }

    // 7 再说一遍问题（+ 上次失败）—— 模式那段太长，问题得贴着答案再出现一次
    出 = 出 + "\n### 再说一遍：要回答的问题\n" + 问题 + "\n";
    如果 (字符串::字节长度(提示.上次错误) > 0) {
        出 = 出 + "\n上一次你给的查询跑挂了：\n" + 提示.上次查询
            + "\n数据库的报错：" + 提示.上次错误
            + "\n这次别再犯同一个错。\n";
    }

    // 8 输出格式（字段顺序即思考顺序）
    出 = 出 + "\n### 输出格式\n"
        + "先在 关系 里列出你打算走的边类型（不需要走边就给空数组），"
        + "再用 推理 当草稿纸写出你的思路，最后才给 查询。**按这个顺序写**。\n"
        + "查不出来就在 推理 里说清为什么，查询 给空串 —— 不要编造模式里没有的类或关系。\n";
    返回 出;
}

函数 空则(值: 字符串, 缺省: 字符串) : 字符串 {
    如果 (字符串::字节长度(值) == 0) { 返回 缺省; }
    返回 值;
}

函数 转义(s: 字符串) : 字符串 {
    变量 出: 字符串 = 字符串::替换(s, "\\", "\\\\");
    出 = 字符串::替换(出, "\"", "\\\"");
    出 = 字符串::替换(出, "\n", "\\n");
    返回 出;
}

// ── 跑一次 ────────────────────────────────────────────────────────

// 返回模型给的 JSON（关系 / 推理 / 查询）。
公开 函数 生成查询(提示: 查询提示, 问题: 字符串, 配置值: 模型配置) : 字符串 {
    变量 会话: 整数 = 开启会话(配置值);
    如果 (会话 <= 0) {
        返回 "{\"关系\":[],\"推理\":\"开不了会话\",\"查询\":\"\"}";
    }
    变量 代理值: 代理 = 创建代理("文本转查询", 会话);
    变量 出: 字符串 = 生成查询使用代理(提示, 问题, 代理值);
    关闭代理(代理值);
    返回 出;
}

公开 函数 生成查询使用代理(提示: 查询提示, 问题: 字符串, 代理值: 代理) : 字符串 {
    变量 字段: 整数 = 查询字段();
    变量 回: 字符串 = 结构化运行(代理值, 组装提示(提示, 问题), 字段);
    表列::删除列表(字段);
    返回 取JSON对象段(回);
}

// 只要那条查询本身
公开 函数 取查询(结果JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(结果JSON);
    如果 (对象 <= 0) { 返回 ""; }
    变量 q: 字符串 = J.获取字符串(对象, "查询");
    J.删除(对象);
    返回 q;
}

公开 函数 取推理(结果JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(结果JSON);
    如果 (对象 <= 0) { 返回 ""; }
    变量 r: 字符串 = J.获取字符串(对象, "推理");
    J.删除(对象);
    返回 r;
}

// ── 现成的：给 qi-graph 的 图语句 用 ──────────────────────────────

// 任务说明 + 例子都按 qi-graph 图语句 的语法给好。模式还是要自己传：
//   变量 p: 查询提示 = 图语句提示();
//   p = 用模式(p, 图模式文本(图));        // 从 Graph 包来，本模块不依赖它
//   p = 用意图(p, "表格", "把结果按数量从多到少排，用 返回 只留需要的变量");
//   打印行(取查询(生成查询(p, "谁依赖 KV？", 配置)));
公开 函数 图语句提示() : 查询提示 {
    变量 p: 查询提示 = 创建查询提示(
        "你要把用户的自然语言问题翻译成一条 qi-graph 的图查询语句。"
        + "只用下面模式里真实存在的类、关系和属性。");
    p = 加查询示例(p, "谁依赖 KV？", "[\"依赖\"]",
        "问的是「谁依赖 X」，方向是从依赖方指向被依赖方，所以 KV 在箭头右边，左边留变量。",
        "匹配 (?p:包)-[:依赖]->(KV) 返回 ?p");
    p = 加查询示例(p, "Harness 间接依赖了哪些包？", "[\"依赖\"]",
        "「间接」意味着两跳，把路径串起来写成 (Harness)-[:依赖]->(?a)-[:依赖]->(?b)，要的是 ?b。",
        "匹配 (Harness)-[:依赖]->(?a)-[:依赖]->(?b) 返回 ?b");
    p = 加查询示例(p, "下载量超过一百的包里，谁被别人依赖了？", "[\"依赖\"]",
        "两个条件：被依赖（有入边）+ 下载数 > 100。条件写在 其中 里，属性名照模式里的写。",
        "匹配 (?a:包)-[:依赖]->(?b:包) 其中 ?b.下载数 > 100 返回 ?b");
    p = 加图注记(p, "边的方向是「依赖方 → 被依赖方」，问「谁依赖 X」时 X 在右边");
    p = 加图注记(p, "把带常量的路径写在前面，两端都是变量且类型也不定时会扫全库");
    返回 p;
}

// 模型 — provider 抽象 + 会话配置
//
// 设计原则：任何 OpenAI 兼容 API 都通过 LLM(端点, 密钥, 模型) 一行配置完事。
// 不内置 provider 常量 — 端点 URL 跟模型名是真值，用户自己写最清楚。

包 Harness;

导入 标准库.字符串;
导入 标准库.时间;
// 别名 底层模型 — 避免跟我们公开的 大模型(端点, 密钥, 模型) builder 冲突
导入 标准库.大模型 作为 底层模型;

// ===== 模型配置 =====
公开 类型 模型配置 {
    端点: 字符串,
    模型: 字符串,
    密钥: 字符串,
    系统提示: 字符串,
    温度: 字符串,        // 用字符串而不是 浮点数 — 跟 大模型::设置配置 一致
    最大令牌: 整数,
    超时秒: 整数,
    // 原样并进请求体的 JSON 对象。给各家的非标字段留的口子 —— 见 配置额外参数。
    额外参数: 字符串,
}

// 一站式 builder — 任何 OpenAI 兼容 API 一行配置
//   大模型("https://api.deepseek.com", 密钥, "deepseek-chat")
//   大模型("https://api.openai.com/v1", 密钥, "gpt-4o-mini")
//   大模型("http://127.0.0.1:11434/v1", "ollama", "llama3.1")  // ollama 本地
公开 函数 大模型(端点: 字符串, 密钥: 字符串, 模型: 字符串) : 模型配置 {
    返回 新建 模型配置 {
        端点: 端点,
        模型: 模型,
        密钥: 密钥,
        系统提示: "",
        温度: "0.7",
        // 8192 而不是 2048：**思考型模型的推理 token 花在同一个预算里**。
        // 给 2048 的话，推理稍长一点就把额度吃光，content 回空字符串，
        // agent loop 因为「没有工具调用」直接结束 —— 不报错，看起来就是
        // 「干到一半莫名其妙不干了」。实测 gemini-3.7-flash-high 建模到
        // 第七个实体就这么停了。
        最大令牌: 8192,
        超时秒: 60,
        额外参数: "",
    };
}

// 默认配置 — 给「先建后填」工作流；推荐直接用 大模型(...)
公开 函数 默认配置() : 模型配置 {
    返回 大模型("https://api.openai.com/v1", "", "gpt-4o-mini");
}

公开 函数 配置端点(配置: 模型配置, 端点: 字符串) : 模型配置 {
    配置.端点 = 端点;
    返回 配置;
}

公开 函数 配置模型(配置: 模型配置, 模型: 字符串) : 模型配置 {
    配置.模型 = 模型;
    返回 配置;
}

公开 函数 配置密钥(配置: 模型配置, 密钥: 字符串) : 模型配置 {
    配置.密钥 = 密钥;
    返回 配置;
}

公开 函数 配置系统提示(配置: 模型配置, 提示: 字符串) : 模型配置 {
    配置.系统提示 = 提示;
    返回 配置;
}

公开 函数 配置温度(配置: 模型配置, 温度文本: 字符串) : 模型配置 {
    配置.温度 = 温度文本;
    返回 配置;
}

公开 函数 配置最大令牌(配置: 模型配置, 最大: 整数) : 模型配置 {
    配置.最大令牌 = 最大;
    返回 配置;
}

公开 函数 配置超时(配置: 模型配置, 秒: 整数) : 模型配置 {
    配置.超时秒 = 秒;
    返回 配置;
}

// 生成可直接注入系统提示的真实本地时间上下文。时区说明只用于告诉模型
// 该进程本地时间代表哪个业务时区；实际时间由服务器操作系统时区决定。
公开 函数 当前时间上下文(时区说明: 字符串) : 字符串 {
    变量 现在: 整数 = 时间.现在();
    变量 星期序号: 字符串 = 时间.格式化本地(现在, "%u");
    变量 星期名: 字符串 = "星期日";
    如果 (字符串::等于(星期序号, "1") == 1) { 星期名 = "星期一"; }
    否则如果 (字符串::等于(星期序号, "2") == 1) { 星期名 = "星期二"; }
    否则如果 (字符串::等于(星期序号, "3") == 1) { 星期名 = "星期三"; }
    否则如果 (字符串::等于(星期序号, "4") == 1) { 星期名 = "星期四"; }
    否则如果 (字符串::等于(星期序号, "5") == 1) { 星期名 = "星期五"; }
    否则如果 (字符串::等于(星期序号, "6") == 1) { 星期名 = "星期六"; }
    变量 时区: 字符串 = 时区说明;
    如果 (字符串::字节长度(时区) == 0) { 时区 = "服务器本地时区"; }
    返回 "【真实当前时间】" + 时间.格式化本地(现在, "%Y-%m-%d %H:%M:%S")
        + "，" + 星期名 + "，时区：" + 时区 + "。"
        + "涉及今天、明天、后天、周末、截止日期或相对时间时，必须以此时间为准推算，不得凭训练知识猜测。";
}

// 在原系统提示前注入真实时间，使任意模型配置具备时间感知。
公开 函数 配置时间感知(配置: 模型配置, 时区说明: 字符串) : 模型配置 {
    变量 原提示: 字符串 = 配置.系统提示;
    配置.系统提示 = 当前时间上下文(时区说明);
    如果 (字符串::字节长度(原提示) > 0) {
        配置.系统提示 = 配置.系统提示 + "\n\n" + 原提示;
    }
    返回 配置;
}

// 原样并进请求体的 JSON 对象 —— 各家非标字段的逃生口。
//
//   配置额外参数(配置, `{"enable_search": true}`)              // 百炼
//   配置额外参数(配置, `{"reasoning_effort": "high"}`)          // 部分推理模型
//
// 数组键是**追加**不是覆盖，所以往 tools 里塞东西不会挤掉 agent 的函数工具。
公开 函数 配置额外参数(配置: 模型配置, JSON对象: 字符串) : 模型配置 {
    配置.额外参数 = JSON对象;
    返回 配置;
}

// 打开模型自带的联网搜索。
//
// 这不是我们发一个 HTTP 请求去搜 —— 是模型那侧自己去搜、自己读、把结论
// 写进回答。差别很大：省掉了「抓网页 → 清洗 → 塞进上下文」整条链路。
//
// 实测（cpa 网关 + gemini-3.7-flash）对照组是决定性的：同一个问题「今天
// 金价多少」，开了搜索答 4518 美元并给出当天日期，不开就答 2750 美元、
// 「截至 2024 年 10 月底」—— 后者是训练截止，不是行情。
//
// 注意这是 **Gemini 系的写法**。百炼要 `{"enable_search": true}`，走
// 配置额外参数 自己写。没做成「自动按 provider 分派」是因为那要在这儿
// 维护一张各家搜索字段的对照表，而它每隔几个月就变一次。
// tool_config 那半截不是可选的：**内置搜索和自定义函数工具同时存在时**，
// Gemini 会直接 400 —— "Please enable
// tool_config.include_server_side_tool_invocations to use Built-in tools
// with Function calling."。只搜不带工具时不加也能跑，但那样这个函数就分
// 两种用法了，不如一律带上。
公开 函数 开启联网搜索(配置: 模型配置) : 模型配置 {
    返回 配置额外参数(配置, `{
        "tools": [{"google_search": {}}],
        "tool_config": {"include_server_side_tool_invocations": true}
    }`);
}

// ===== 会话生命周期 =====

// 用配置开会话；返回会话句柄（>0），失败返回 0
公开 函数 开启会话(配置: 模型配置) : 整数 {
    变量 句柄: 整数 = 底层模型.创建会话(配置.端点, 配置.模型, 配置.密钥);
    如果 (句柄 <= 0) {
        返回 0;
    }
    // 设置可选配置
    如果 (字符串::字节长度(配置.系统提示) > 0) {
        底层模型.设置配置(句柄, "system", 配置.系统提示);
    }
    如果 (字符串::字节长度(配置.温度) > 0) {
        底层模型.设置配置(句柄, "temperature", 配置.温度);
    }
    如果 (配置.最大令牌 > 0) {
        底层模型.设置配置(句柄, "max_tokens", 整数转字符串(配置.最大令牌));
    }
    如果 (配置.超时秒 > 0) {
        底层模型.设置配置(句柄, "timeout_secs", 整数转字符串(配置.超时秒));
    }
    如果 (字符串::字节长度(配置.额外参数) > 0) {
        底层模型.设置配置(句柄, "extra_body", 配置.额外参数);
    }
    返回 句柄;
}

公开 函数 关闭会话Harness(句柄: 整数) : 整数 {
    返回 底层模型.关闭会话(句柄);
}

// 一站式：开会话 + 跑一条 prompt + 关会话。适合 one-shot 场景。
公开 函数 一次对话(配置: 模型配置, 提示: 字符串) : 字符串 {
    变量 句柄: 整数 = 开启会话(配置);
    如果 (句柄 <= 0) {
        返回 "[harness] 会话开启失败";
    }
    变量 回复: 字符串 = 底层模型.对话(句柄, 提示);
    关闭会话Harness(句柄);
    返回 回复;
}

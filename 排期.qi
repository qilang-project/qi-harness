// 排期 — cron 表达式解析与匹配（纯计算，不碰时钟以外的任何东西）
//
// 给 常驻工 用的「什么时候该跑」。五段标准 cron：
//
//     分   时   日   月   周
//     0-59 0-23 1-31 1-12 0-6（0=周日，7 也当周日）
//
// 每段支持 `*`、`a`、`a-b`、`*/n`、`a-b/n`，以及逗号连接的任意组合。
// 月和周还认三字母缩写（JAN…DEC / SUN…SAT，大小写不论）。
// 另有别名：@每分钟 @每小时 @每天 @每周 @每月 @每年，
// 以及等价的英文 @minutely @hourly @daily @weekly @monthly @yearly。
//
// ── 两个坑，都是这门语言/这套标准自带的，不是我们发明的 ──────────
//
// 1. **字段取值器全是 UTC**。`时间.时(ts)` 在 UTC+8 的机器上给的是 UTC 的小时，
//    而人写 "0 9 * * *" 想的是「早上九点」，是本地九点。所以匹配前先把
//    时间戳搬到本地墙钟（见 本地偏移秒）。要按 UTC 排班就把 用本地 传 0。
//
// 2. **日和周同时限定时是「或」不是「且」**。这是 POSIX cron 的规定，
//    不是笔误：`0 0 13 * 5` 是「每月 13 号，外加每个周五」，不是「13 号且周五」。
//    只有一边限定（另一边是 `*`）时才退化成单条件。这条最容易被误读，
//    所以 排期说明() 会把它显式打出来。
//
// 用法：
//   导入 Harness.排期::{排期, 解析排期, 排期匹配, 下次触发, 排期说明};
//   变量 每天九点: 排期 = 解析排期("0 9 * * *");
//   如果 (排期匹配(每天九点, 时间.现在(), 1) == 1) { … }

包 Harness;

导入 标准库.字符串;
导入 标准库.列表 作为 列表库;
导入 标准库.时间;

// 掩码按位存：分 60 位、时 24 位、日 1-31、月 1-12、周 0-6，都塞得进 i64。
公开 类型 排期 {
    有效: 整数,
    说明: 字符串,       // 无效时讲清楚哪一段坏了
    原文: 字符串,
    分掩码: 整数,
    时掩码: 整数,
    日掩码: 整数,
    月掩码: 整数,
    周掩码: 整数,
    日是星: 整数,       // 日那段是不是 `*` —— 决定日/周用「或」还是单条件
    周是星: 整数,
}

函数 坏排期(原文: 字符串, 因为: 字符串) : 排期 {
    返回 新建 排期 {
        有效: 0, 说明: 因为, 原文: 原文,
        分掩码: 0, 时掩码: 0, 日掩码: 0, 月掩码: 0, 周掩码: 0,
        日是星: 0, 周是星: 0,
    };
}

// ── 时区 ────────────────────────────────────────────────────────
//
// 把本地墙钟的字符串当成 UTC 再解析回来，差值就是偏移。
// 不硬编码 +8：同一份二进制会跑在东京的机器和法兰克福的机器上。
公开 函数 本地偏移秒(ts: 整数) : 整数 {
    变量 本地串: 字符串 = 时间.格式化本地(ts, "%Y-%m-%d %H:%M:%S");
    变量 当UTC读: 整数 = 时间.解析(本地串, "%Y-%m-%d %H:%M:%S");
    如果 (当UTC读 <= 0) { 返回 0; }
    返回 当UTC读 - ts;
}

// 用本地=1 时把时间戳搬到「本地墙钟读数等于 UTC 读数」的位置，
// 这样下面所有 时间.时/分/日 取出来的就是人看到的那个数。
函数 墙钟(ts: 整数, 用本地: 整数) : 整数 {
    如果 (用本地 == 0) { 返回 ts; }
    返回 ts + 本地偏移秒(ts);
}

// ── 名字表 ──────────────────────────────────────────────────────

函数 月名转数(名: 字符串) : 整数 {
    变量 大: 字符串 = 字符串::转大写(名);
    如果 (字符串::等于(大, "JAN") == 1) { 返回 1; }
    如果 (字符串::等于(大, "FEB") == 1) { 返回 2; }
    如果 (字符串::等于(大, "MAR") == 1) { 返回 3; }
    如果 (字符串::等于(大, "APR") == 1) { 返回 4; }
    如果 (字符串::等于(大, "MAY") == 1) { 返回 5; }
    如果 (字符串::等于(大, "JUN") == 1) { 返回 6; }
    如果 (字符串::等于(大, "JUL") == 1) { 返回 7; }
    如果 (字符串::等于(大, "AUG") == 1) { 返回 8; }
    如果 (字符串::等于(大, "SEP") == 1) { 返回 9; }
    如果 (字符串::等于(大, "OCT") == 1) { 返回 10; }
    如果 (字符串::等于(大, "NOV") == 1) { 返回 11; }
    如果 (字符串::等于(大, "DEC") == 1) { 返回 12; }
    返回 -1;
}

函数 周名转数(名: 字符串) : 整数 {
    变量 大: 字符串 = 字符串::转大写(名);
    如果 (字符串::等于(大, "SUN") == 1) { 返回 0; }
    如果 (字符串::等于(大, "MON") == 1) { 返回 1; }
    如果 (字符串::等于(大, "TUE") == 1) { 返回 2; }
    如果 (字符串::等于(大, "WED") == 1) { 返回 3; }
    如果 (字符串::等于(大, "THU") == 1) { 返回 4; }
    如果 (字符串::等于(大, "FRI") == 1) { 返回 5; }
    如果 (字符串::等于(大, "SAT") == 1) { 返回 6; }
    返回 -1;
}

// 域号：0=分 1=时 2=日 3=月 4=周。只有月/周认名字。
函数 读一个数(文: 字符串, 域号: 整数) : 整数 {
    变量 s: 字符串 = 字符串::去空白(文);
    如果 (字符串::字节长度(s) == 0) { 返回 -1; }
    如果 (域号 == 3) {
        变量 m: 整数 = 月名转数(s);
        如果 (m >= 0) { 返回 m; }
    }
    如果 (域号 == 4) {
        变量 w: 整数 = 周名转数(s);
        如果 (w >= 0) { 返回 w; }
    }
    // 纯数字才收；"9x" 这种要挡掉，否则 字符串转整数 会悄悄给个 9
    变量 n: 整数 = 字符串::字节长度(s);
    变量 i: 整数 = 0;
    当 (i < n) {
        变量 c: 字符串 = 字符串::子串(s, i, 1);
        如果 (字符串::查找("0123456789", c) < 0) { 返回 -1; }
        i = i + 1;
    }
    返回 字符串转整数(s);
}

// ── 解析一段 ────────────────────────────────────────────────────

函数 域下限(域号: 整数) : 整数 {
    如果 (域号 == 2) { 返回 1; }      // 日
    如果 (域号 == 3) { 返回 1; }      // 月
    返回 0;
}

函数 域上限(域号: 整数) : 整数 {
    如果 (域号 == 0) { 返回 59; }
    如果 (域号 == 1) { 返回 23; }
    如果 (域号 == 2) { 返回 31; }
    如果 (域号 == 3) { 返回 12; }
    返回 6;
}

函数 域名(域号: 整数) : 字符串 {
    如果 (域号 == 0) { 返回 "分"; }
    如果 (域号 == 1) { 返回 "时"; }
    如果 (域号 == 2) { 返回 "日"; }
    如果 (域号 == 3) { 返回 "月"; }
    返回 "周";
}

// 一个逗号段：`*` / `a` / `a-b` / `*/n` / `a-b/n` / `a/n`
// 出错返回 -1，成功返回掩码（可能是 0，比如空段，但空段在上层已挡）。
函数 解析一段(段: 字符串, 域号: 整数) : 整数 {
    变量 本段: 字符串 = 字符串::去空白(段);
    如果 (字符串::字节长度(本段) == 0) { 返回 -1; }

    变量 下: 整数 = 域下限(域号);
    变量 上: 整数 = 域上限(域号);

    // 拆步长
    变量 步长: 整数 = 1;
    变量 主体: 字符串 = 本段;
    变量 斜杠: 整数 = 字符串::查找(本段, "/");
    如果 (斜杠 >= 0) {
        主体 = 字符串::子串(本段, 0, 斜杠);
        变量 步文: 字符串 = 字符串::子串从位置(本段, 斜杠 + 1);
        步长 = 读一个数(步文, 0);
        如果 (步长 <= 0) { 返回 -1; }
    }

    变量 起: 整数 = 下;
    变量 止: 整数 = 上;
    如果 (字符串::等于(主体, "*") == 1) {
        // 起止已经是全域
    } 否则 {
        变量 横杠: 整数 = 字符串::查找(主体, "-");
        如果 (横杠 > 0) {
            起 = 读一个数(字符串::子串(主体, 0, 横杠), 域号);
            止 = 读一个数(字符串::子串从位置(主体, 横杠 + 1), 域号);
        } 否则 {
            起 = 读一个数(主体, 域号);
            // `5/15` 这种：起点是 5，一直到域上限
            如果 (斜杠 >= 0) { 止 = 上; } 否则 { 止 = 起; }
        }
    }
    如果 (起 < 0 || 止 < 0) { 返回 -1; }

    // 周日两种写法：7 和 0 都算周日
    如果 (域号 == 4) {
        如果 (起 == 7) { 起 = 0; }
        如果 (止 == 7) { 止 = 0; }
    }
    如果 (起 < 下 || 起 > 上) { 返回 -1; }
    如果 (止 < 下 || 止 > 上) { 返回 -1; }
    如果 (止 < 起) { 返回 -1; }

    变量 掩码: 整数 = 0;
    变量 v: 整数 = 起;
    当 (v <= 止) {
        掩码 = 掩码 | (1 << v);
        v = v + 步长;
    }
    返回 掩码;
}

// 一整个域（可能有逗号）
函数 解析一域(域文: 字符串, 域号: 整数) : 整数 {
    变量 段们: 整数 = 字符串::分割(域文, ",");
    变量 个数: 整数 = 列表库::字符串列表大小(段们);
    如果 (个数 == 0) { 列表库::删除列表(段们); 返回 -1; }
    变量 合: 整数 = 0;
    变量 坏了: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 个数) {
        变量 一: 整数 = 解析一段(列表库::获取字符串(段们, i), 域号);
        如果 (一 < 0) { 坏了 = 1; } 否则 { 合 = 合 | 一; }
        i = i + 1;
    }
    列表库::删除列表(段们);
    如果 (坏了 == 1) { 返回 -1; }
    如果 (合 == 0) { 返回 -1; }
    返回 合;
}

// ── 别名 ────────────────────────────────────────────────────────

函数 展开别名(原文: 字符串) : 字符串 {
    变量 s: 字符串 = 字符串::去空白(原文);
    如果 (字符串::等于(s, "@每分钟") == 1 || 字符串::等于(s, "@minutely") == 1) { 返回 "* * * * *"; }
    如果 (字符串::等于(s, "@每小时") == 1 || 字符串::等于(s, "@hourly") == 1) { 返回 "0 * * * *"; }
    如果 (字符串::等于(s, "@每天") == 1 || 字符串::等于(s, "@daily") == 1) { 返回 "0 0 * * *"; }
    如果 (字符串::等于(s, "@每周") == 1 || 字符串::等于(s, "@weekly") == 1) { 返回 "0 0 * * 0"; }
    如果 (字符串::等于(s, "@每月") == 1 || 字符串::等于(s, "@monthly") == 1) { 返回 "0 0 1 * *"; }
    如果 (字符串::等于(s, "@每年") == 1 || 字符串::等于(s, "@yearly") == 1) { 返回 "0 0 1 1 *"; }
    返回 s;
}

// ── 解析入口 ────────────────────────────────────────────────────

公开 函数 解析排期(表达式: 字符串) : 排期 {
    变量 原文: 字符串 = 字符串::去空白(表达式);
    如果 (字符串::字节长度(原文) == 0) {
        返回 坏排期(表达式, "排期是空的");
    }
    变量 展开: 字符串 = 展开别名(原文);
    // 制表符按空格处理，再挤掉连续空格 —— 从配置文件里抄来的表达式常有多余空白
    变量 平: 字符串 = 字符串::替换(展开, "\t", " ");
    当 (字符串::查找(平, "  ") >= 0) {
        平 = 字符串::替换(平, "  ", " ");
    }

    变量 域们: 整数 = 字符串::分割(平, " ");
    变量 个数: 整数 = 列表库::字符串列表大小(域们);
    如果 (个数 != 5) {
        列表库::删除列表(域们);
        返回 坏排期(原文, "要五段（分 时 日 月 周），这里数出来 "
            + 整数转字符串(个数) + " 段");
    }

    变量 掩码们: 数组<整数> = [0, 0, 0, 0, 0];
    变量 坏在: 整数 = -1;
    变量 i: 整数 = 0;
    当 (i < 5) {
        变量 一: 整数 = 解析一域(列表库::获取字符串(域们, i), i);
        如果 (一 < 0) {
            如果 (坏在 < 0) { 坏在 = i; }
        } 否则 {
            掩码们[i] = 一;
        }
        i = i + 1;
    }
    变量 日文: 字符串 = 字符串::去空白(列表库::获取字符串(域们, 2));
    变量 周文: 字符串 = 字符串::去空白(列表库::获取字符串(域们, 4));
    列表库::删除列表(域们);

    如果 (坏在 >= 0) {
        返回 坏排期(原文, "第 " + 整数转字符串(坏在 + 1) + " 段（"
            + 域名(坏在) + "）看不懂，允许 * a a-b */n a-b/n 和逗号组合");
    }

    变量 日星: 整数 = 0;
    如果 (字符串::等于(日文, "*") == 1) { 日星 = 1; }
    变量 周星: 整数 = 0;
    如果 (字符串::等于(周文, "*") == 1) { 周星 = 1; }

    返回 新建 排期 {
        有效: 1, 说明: "", 原文: 原文,
        分掩码: 掩码们[0], 时掩码: 掩码们[1], 日掩码: 掩码们[2],
        月掩码: 掩码们[3], 周掩码: 掩码们[4],
        日是星: 日星, 周是星: 周星,
    };
}

// ── 匹配 ────────────────────────────────────────────────────────

函数 位命中(掩码: 整数, 位: 整数) : 整数 {
    如果 (位 < 0) { 返回 0; }
    如果 ((掩码 & (1 << 位)) != 0) { 返回 1; }
    返回 0;
}

// 这一分钟该不该跑。精度到分钟 —— cron 本来就没有秒。
公开 函数 排期匹配(排: 排期, 时间戳: 整数, 用本地: 整数) : 整数 {
    如果 (排.有效 == 0) { 返回 0; }
    变量 t: 整数 = 墙钟(时间戳, 用本地);

    如果 (位命中(排.分掩码, 时间.分(t)) == 0) { 返回 0; }
    如果 (位命中(排.时掩码, 时间.时(t)) == 0) { 返回 0; }
    如果 (位命中(排.月掩码, 时间.月(t)) == 0) { 返回 0; }

    变量 日中: 整数 = 位命中(排.日掩码, 时间.日(t));
    // 时间.星期几 是 ISO：1=周一…7=周日；cron 是 0=周日…6=周六
    变量 iso: 整数 = 时间.星期几(t);
    变量 周号: 整数 = iso;
    如果 (iso == 7) { 周号 = 0; }
    变量 周中: 整数 = 位命中(排.周掩码, 周号);

    // POSIX 规矩：两边都限定时取「或」，只有一边限定时取那一边。
    如果 (排.日是星 == 1 && 排.周是星 == 1) { 返回 1; }
    如果 (排.日是星 == 1) { 返回 周中; }
    如果 (排.周是星 == 1) { 返回 日中; }
    如果 (日中 == 1 || 周中 == 1) { 返回 1; }
    返回 0;
}

// ── 下次触发 ────────────────────────────────────────────────────
//
// 逐分钟扫一年是五十万次迭代，太蠢。按天筛（日/月/周），命中的那天再筛小时、
// 再筛分钟 —— 最多 366+24+60 次。找不到（比如 "0 0 30 2 *"，2 月 30 号）返回 -1。
公开 函数 下次触发(排: 排期, 从时间戳: 整数, 用本地: 整数) : 整数 {
    如果 (排.有效 == 0) { 返回 -1; }
    变量 偏移: 整数 = 0;
    如果 (用本地 == 1) { 偏移 = 本地偏移秒(从时间戳); }

    // 起点取下一分钟整（本次这一分钟已经过了）
    变量 起墙: 整数 = 从时间戳 + 偏移;
    变量 分内秒: 整数 = 起墙 % 60;
    变量 光标: 整数 = 起墙 - 分内秒 + 60;

    变量 天数: 整数 = 0;
    当 (天数 <= 366) {
        变量 当天: 整数 = 光标;
        如果 (天数 > 0) {
            // 跳到那一天的 00:00
            当天 = 时间.当天开始(时间.加天(光标, 天数));
        }
        如果 (日子命中(排, 当天) == 1) {
            变量 命中点: 整数 = 当天扫(排, 当天, 光标, 天数);
            如果 (命中点 > 0) { 返回 命中点 - 偏移; }
        }
        天数 = 天数 + 1;
    }
    返回 -1;
}

函数 日子命中(排: 排期, 墙时间: 整数) : 整数 {
    如果 (位命中(排.月掩码, 时间.月(墙时间)) == 0) { 返回 0; }
    变量 日中: 整数 = 位命中(排.日掩码, 时间.日(墙时间));
    变量 iso: 整数 = 时间.星期几(墙时间);
    变量 周号: 整数 = iso;
    如果 (iso == 7) { 周号 = 0; }
    变量 周中: 整数 = 位命中(排.周掩码, 周号);
    如果 (排.日是星 == 1 && 排.周是星 == 1) { 返回 1; }
    如果 (排.日是星 == 1) { 返回 周中; }
    如果 (排.周是星 == 1) { 返回 日中; }
    如果 (日中 == 1 || 周中 == 1) { 返回 1; }
    返回 0;
}

// 在 当天 这一天里找第一个 >= 光标 的命中分钟；天数>0 时光标不设限。
函数 当天扫(排: 排期, 当天: 整数, 光标: 整数, 天数: 整数) : 整数 {
    变量 起时: 整数 = 0;
    变量 起分: 整数 = 0;
    如果 (天数 == 0) {
        起时 = 时间.时(光标);
        起分 = 时间.分(光标);
    }
    变量 h: 整数 = 起时;
    当 (h <= 23) {
        如果 (位命中(排.时掩码, h) == 1) {
            变量 m: 整数 = 0;
            如果 (h == 起时) { m = 起分; }
            当 (m <= 59) {
                如果 (位命中(排.分掩码, m) == 1) {
                    返回 时间.当天开始(当天) + h * 3600 + m * 60;
                }
                m = m + 1;
            }
        }
        h = h + 1;
    }
    返回 -1;
}

// ── 人读说明 ────────────────────────────────────────────────────

公开 函数 排期说明(排: 排期) : 字符串 {
    如果 (排.有效 == 0) { 返回 "无效排期：" + 排.说明; }
    变量 出: 字符串 = 排.原文;
    如果 (排.日是星 == 0 && 排.周是星 == 0) {
        出 = 出 + "（注意：日和周都限定了，按 cron 规矩这是「或」—— "
            + "满足任一条就跑，不是两条都要满足）";
    }
    返回 出;
}

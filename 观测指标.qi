// 观测指标 — 把跨度树喂进 Prometheus
//
// 可观测性的三根柱子里，qi-harness 之前只有 logs（追踪.qi 的 JSONL）和
// 半根 traces（span API 没人调）。**metrics 一根都没有** —— 于是
// 「工具失败率多少」「LLM 的 p95 是几秒」「今天烧了多少 token」
// 这类问题只能自己 grep 日志，也就等于没法做告警。
//
// ── 为什么不自己写注册表 ──────────────────────────────────────────
//
// qi-web 里已经有一份 719 行的 Prometheus 注册表（计数器/量表/直方图、
// 系列上限、两组桶、/metrics 端点）。再写一份只会有两个都对不齐的实现。
// 它那段注释里记着一个正好适用于我们的教训：
//
//     出一课的 text 阶段 11.5 秒、audio 阶段 40.7 秒，所有桶都是 0、
//     全落进 +Inf，那张直方图除了总数什么都没告诉我。
//
// LLM 调用就是这个量级，所以 LLM/运行 这类时延一律用 桶组_慢，
// 只有工具耗时用 桶组_快（多数工具是毫秒级的本地函数）。
//
// ── 依赖方向 ──────────────────────────────────────────────────────
//
// 本模块 import Web，跨度.qi **不** import。装采集器的程序不会因此被拖进
// 整个 web 框架；只有真想要 /metrics 的人才导入这一个模块。
// 两边靠 跨度.设置跨度完成回调 这个钩子对接。
//
// ── 用法 ──────────────────────────────────────────────────────────
//
//     导入 Harness.跨度::{安装跨度采集器};
//     导入 Harness.观测指标::{安装观测指标};
//     安装跨度采集器();
//     安装观测指标();
//     // 然后在你的 qi-web 应用上 挂指标(应用值)，或者用 观测台

包 Harness;

导入 标准库.字符串;
导入 标准库.JSON 作为 J;
// 指标模块没有从 Web.qi 转出（Web.qi 的 公开 导入 清单里没有它），
// 所以要走 Web.指标 这条全名 —— 直接 导入 Web::{计数加} 会报「符号不存在」。
导入 Web.指标::{
    注册指标带桶, 指标说明, 计数加, 量表设, 记录耗时, 加收集器,
    标签, 标签二, 标签三, 类_计数器, 类_量表, 类_直方图, 桶组_快, 桶组_慢
};
导入 Harness.跨度::{设置跨度完成回调, 丢弃跨度计数, 运行数};

// 指标名一律英文小写下划线 —— 这是**线上协议**（Prometheus 抓、Grafana 查、
// 告警规则引用），不是 qi 内部标识符。计数器带 _total，时间用秒带 _seconds。
公开 函数 运行数指标名() : 字符串 { 返回 "harness_agent_runs_total"; }
公开 函数 运行耗时指标名() : 字符串 { 返回 "harness_agent_run_duration_seconds"; }
公开 函数 LLM调用指标名() : 字符串 { 返回 "harness_llm_calls_total"; }
公开 函数 LLM耗时指标名() : 字符串 { 返回 "harness_llm_duration_seconds"; }
公开 函数 令牌指标名() : 字符串 { 返回 "harness_llm_tokens_total"; }
公开 函数 成本指标名() : 字符串 { 返回 "harness_llm_cost_cents_total"; }
公开 函数 工具调用指标名() : 字符串 { 返回 "harness_tool_calls_total"; }
公开 函数 工具耗时指标名() : 字符串 { 返回 "harness_tool_duration_seconds"; }
公开 函数 出错指标名() : 字符串 { 返回 "harness_errors_total"; }
公开 函数 丢弃跨度指标名() : 字符串 { 返回 "harness_spans_dropped_total"; }
公开 函数 留存运行指标名() : 字符串 { 返回 "harness_runs_retained"; }

变量 已安装: 整数 = 0;

// 抓取时才现算的量表。写成收集器而不是每次变动都 量表设：
// 这两个值本来就是「当前状态」，没必要在热路径上维护。
公开 函数 收集内部量表() {
    量表设(丢弃跨度指标名(), "", 丢弃跨度计数());
    量表设(留存运行指标名(), "", 运行数());
}

函数 注册全部() {
    // 先注册再用：**一次都没发生时 /metrics 上也要有 TYPE 行**。
    // 抓取方见到「指标不存在」和「指标是 0」反应完全不同 —— 前者多半是
    // no data，告警规则会静默不触发，等于没配告警。
    注册指标带桶(运行数指标名(), 类_计数器(), 桶组_快());
    指标说明(运行数指标名(), "agent 运行次数，按结果分");

    // LLM 和整次运行都是秒到分钟量级 —— 用快桶的话全落 +Inf，分位数等于没有
    注册指标带桶(运行耗时指标名(), 类_直方图(), 桶组_慢());
    指标说明(运行耗时指标名(), "一次 agent 运行的总耗时");

    注册指标带桶(LLM调用指标名(), 类_计数器(), 桶组_快());
    指标说明(LLM调用指标名(), "LLM 调用次数，按结果分");
    注册指标带桶(LLM耗时指标名(), 类_直方图(), 桶组_慢());
    指标说明(LLM耗时指标名(), "单次 LLM 调用耗时");

    注册指标带桶(令牌指标名(), 类_计数器(), 桶组_快());
    指标说明(令牌指标名(), "provider 返回的真实 token 用量");
    注册指标带桶(成本指标名(), 类_计数器(), 桶组_快());
    指标说明(成本指标名(), "累计成本（分）");

    注册指标带桶(工具调用指标名(), 类_计数器(), 桶组_快());
    指标说明(工具调用指标名(), "工具调用次数，按工具和结果分");
    // 工具多是本地函数，毫秒级 —— 这个才该用快桶
    注册指标带桶(工具耗时指标名(), 类_直方图(), 桶组_快());
    指标说明(工具耗时指标名(), "单次工具调用耗时");

    注册指标带桶(出错指标名(), 类_计数器(), 桶组_快());
    指标说明(出错指标名(), "出错的跨度数，按种类和原因分");

    注册指标带桶(丢弃跨度指标名(), 类_量表(), 桶组_快());
    指标说明(丢弃跨度指标名(), "因撞上单次运行跨度上限而丢弃的跨度数");
    注册指标带桶(留存运行指标名(), 类_量表(), 桶组_快());
    指标说明(留存运行指标名(), "内存里留存的运行数");
}

函数 状态词(st: 整数) : 字符串 {
    如果 (st == 2) { 返回 "error"; }
    如果 (st == 1) { 返回 "ok"; }
    返回 "incomplete";
}

// 跨度完成钩子。**标签基数是这里唯一要小心的东西**：
// run_id / 提示词 / 调用 ID 这类每次都不同的值绝不能当标签 ——
// 一个高基数标签就能把 Prometheus 撑爆，而且是过几天才炸。
// 所以只用 agent（有限个）、tool（注册过的，有限个）、status（三个）。
公开 函数 记一条跨度(跨度JSON文本: 字符串) : 整数 {
    变量 根: 整数 = J.解码(跨度JSON文本);
    如果 (根 <= 0) { 返回 0; }
    变量 种: 字符串 = J.获取字符串(根, "t");
    变量 代理名: 字符串 = J.获取字符串(根, "agent");
    变量 名字: 字符串 = J.获取字符串(根, "n");
    变量 耗时: 整数 = J.获取整数(根, "ms");
    变量 状态: 整数 = J.获取整数(根, "st");
    变量 词: 字符串 = 状态词(状态);

    如果 (字符串::等于(种, "agent") == 1) {
        计数加(运行数指标名(), 标签二("agent", 代理名, "status", 词), 1);
        如果 (耗时 >= 0) {
            记录耗时(运行耗时指标名(), 标签("agent", 代理名), 耗时);
        }
    }

    如果 (字符串::等于(种, "llm") == 1) {
        计数加(LLM调用指标名(), 标签二("agent", 代理名, "status", 词), 1);
        如果 (耗时 >= 0) {
            记录耗时(LLM耗时指标名(), 标签("agent", 代理名), 耗时);
        }
        变量 令牌: 整数 = J.获取整数(根, "tok");
        如果 (令牌 > 0) { 计数加(令牌指标名(), 标签("agent", 代理名), 令牌); }
        变量 成本: 整数 = J.获取整数(根, "cost");
        如果 (成本 > 0) { 计数加(成本指标名(), 标签("agent", 代理名), 成本); }
    }

    如果 (字符串::等于(种, "tool") == 1) {
        计数加(工具调用指标名(),
            标签三("agent", 代理名, "tool", 名字, "status", 词), 1);
        如果 (耗时 >= 0) {
            记录耗时(工具耗时指标名(), 标签("tool", 名字), 耗时);
        }
    }

    如果 (状态 == 2) {
        // 原因来自 error 事件的 reason 字段，是**有限的几个枚举值**
        // （exhausted / timeout / …），不是自由文本，当标签才安全。
        变量 因: 字符串 = J.获取字符串(根, "err");
        如果 (字符串::字节长度(因) == 0) { 因 = "unknown"; }
        计数加(出错指标名(), 标签二("kind", 种, "reason", 因), 1);
    }

    J.删除(根);
    返回 1;
}

// 装上。重复调用只生效一次 —— 装两遍会让每条跨度记两次，
// 而计数器翻倍这种错**看不出来**（曲线形状一模一样，只是数字大一倍）。
公开 函数 安装观测指标() : 整数 {
    如果 (已安装 == 1) { 返回 0; }
    已安装 = 1;
    注册全部();
    加收集器(收集内部量表);
    设置跨度完成回调(记一条跨度);
    返回 1;
}

公开 函数 观测指标已安装() : 整数 { 返回 已安装; }

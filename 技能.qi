// 技能 —— agentskills.io 规范的 Skill 加载
//
// 让 qi-harness agent 装备 SKILL.md 技能：读取 frontmatter（name/description/
// allowed-tools）与正文，按「渐进式披露」交给模型。两条路：
//
//   1. 装备技能 / 装备技能目录（旧）：开会话前把正文整段注入系统提示。简单，但技能
//      一多系统提示就爆，而且模型每轮都得看完全部正文。
//   2. 装备技能库（新）：系统提示里只放 name + description 的清单，再给 agent 两个
//      本地工具 —— load_skill 按名取正文（顺带列出该技能目录里的资源文件），
//      read_skill_file 只读技能目录内的文件。模型用到哪个技能才取哪个。
//
// 规范：https://agentskills.io/specification
//   SKILL.md = YAML frontmatter（--- 包裹，含 name/description，可选 allowed-tools）
//              + Markdown 正文；技能目录可带 scripts/ references/ assets/。

包 Harness;

导入 标准库.输入输出 作为 IO;
导入 标准库.字符串;
导入 标准库.操作系统 作为 系统;
导入 标准库.路径;
导入 标准库.列表 作为 列表库;
导入 标准库.哈希表 作为 哈希表;
导入 标准库.JSON 作为 J;
导入 标准库.大模型 作为 底层模型;
导入 Harness.模型::{模型配置, 配置系统提示};
导入 Harness.工具::{工具, 设置工具钩子, 工具错误};
导入 Harness.代理::{代理, 添加工具, 设置工具白名单};

公开 类型 技能 {
    名称: 字符串,      // frontmatter name
    描述: 字符串,      // frontmatter description（约 100 token，始终可见）
    正文: 字符串,      // Markdown 指令正文（装备时注入）
    允许工具: 字符串,  // frontmatter allowed-tools，规整成逗号分隔；没写则为 ""
}

// ——— frontmatter 解析 ———
//
// 只认首个 `---` … `---` 块，按行、`^键:` 精确匹配。之前是全文子串查找 `name:`，
// description 里一出现 "name:" 字样就撞上，而且根本不限定在 frontmatter 块内。

函数 去行尾回车(行: 字符串) : 字符串 {
    如果 (字符串::结束于(行, "\r") == 1) {
        返回 字符串::子串(行, 0, 字符串::字节长度(行) - 1);
    }
    返回 行;
}

函数 是分隔线(行: 字符串) : 整数 {
    返回 字符串::等于(字符串::去空白(行), "---");
}

函数 是缩进行(行: 字符串) : 整数 {
    如果 (字符串::开始于(行, " ") == 1 || 字符串::开始于(行, "\t") == 1) { 返回 1; }
    返回 0;
}

// 去掉成对的引号（"…" 或 '…'）
函数 去成对引号(值: 字符串) : 字符串 {
    变量 长: 整数 = 字符串::字节长度(值);
    如果 (长 < 2) { 返回 值; }
    变量 首: 字符串 = 字符串::子串(值, 0, 1);
    变量 尾: 字符串 = 字符串::子串(值, 长 - 1, 1);
    如果 (字符串::等于(首, 尾) == 1
        && (字符串::等于(首, "\"") == 1 || 字符串::等于(首, "'") == 1)) {
        返回 字符串::子串(值, 1, 长 - 2);
    }
    返回 值;
}

// `键: >` / `键: |`（含 >- |- 变体）或值为空时，把后续缩进行拼起来：
// `>` 折叠成空格连接，`|` 保留换行。
函数 是块标记(值: 字符串) : 整数 {
    如果 (字符串::等于(值, ">") == 1 || 字符串::等于(值, "|") == 1) { 返回 1; }
    如果 (字符串::等于(值, ">-") == 1 || 字符串::等于(值, "|-") == 1) { 返回 1; }
    如果 (字符串::等于(值, ">+") == 1 || 字符串::等于(值, "|+") == 1) { 返回 1; }
    返回 0;
}

函数 拼接块值(行列表: 整数, 起: 整数, 止: 整数, 标记: 字符串) : 字符串 {
    变量 连接符: 字符串 = " ";
    如果 (字符串::开始于(标记, "|") == 1) { 连接符 = "\n"; }
    变量 结果值: 字符串 = "";
    变量 j: 整数 = 起;
    当 (j < 止) {
        变量 行: 字符串 = 去行尾回车(列表库::获取字符串(行列表, j));
        变量 净: 字符串 = 字符串::去空白(行);
        如果 (字符串::字节长度(净) == 0) {
            // 空行：折叠模式里算段落分隔
            如果 (字符串::字节长度(结果值) > 0 && 字符串::等于(连接符, " ") == 1) {
                结果值 = 结果值 + "\n";
            }
        } 否则如果 (是缩进行(行) == 0) {
            返回 结果值;   // 回到列首 = 块结束
        } 否则 {
            如果 (字符串::字节长度(结果值) > 0 && 字符串::结束于(结果值, "\n") == 0) {
                结果值 = 结果值 + 连接符;
            }
            结果值 = 结果值 + 净;
        }
        j = j + 1;
    }
    返回 结果值;
}

// allowed-tools 规整：空格 / 逗号分隔都收成 "a,b,c"
函数 规整允许工具(原文: 字符串) : 字符串 {
    变量 文本: 字符串 = 字符串::替换(去成对引号(字符串::去空白(原文)), ",", " ");
    文本 = 字符串::替换(文本, "\t", " ");
    文本 = 字符串::替换(文本, "\n", " ");
    变量 片: 整数 = 字符串::分割(文本, " ");
    变量 结果值: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(片)) {
        变量 项: 字符串 = 字符串::去空白(列表库::获取字符串(片, i));
        如果 (字符串::字节长度(项) > 0) {
            如果 (字符串::字节长度(结果值) > 0) { 结果值 = 结果值 + ","; }
            结果值 = 结果值 + 项;
        }
        i = i + 1;
    }
    返回 结果值;
}

// 解析一段 SKILL.md 内容为 技能。没有 frontmatter 时名称/描述为空，全文当正文。
公开 函数 解析技能(原始: 字符串) : 技能 {
    变量 行列表: 整数 = 字符串::分割(原始, "\n");
    变量 行数: 整数 = 列表库::字符串列表大小(行列表);
    变量 名称值: 字符串 = "";
    变量 描述值: 字符串 = "";
    变量 允许值: 字符串 = "";
    变量 正文值: 字符串 = 字符串::去空白(原始);

    // 跳过开头空行，首个非空行必须是 ---
    变量 i: 整数 = 0;
    当 (i < 行数 && 字符串::字节长度(字符串::去空白(列表库::获取字符串(行列表, i))) == 0) {
        i = i + 1;
    }
    如果 (i >= 行数 || 是分隔线(列表库::获取字符串(行列表, i)) == 0) {
        返回 新建 技能 { 名称: "", 描述: "", 正文: 正文值, 允许工具: "" };
    }
    变量 头起: 整数 = i + 1;
    变量 头止: 整数 = 头起;
    当 (头止 < 行数 && 是分隔线(列表库::获取字符串(行列表, 头止)) == 0) {
        头止 = 头止 + 1;
    }
    如果 (头止 >= 行数) {
        // 没有闭合的 ---：不算 frontmatter
        返回 新建 技能 { 名称: "", 描述: "", 正文: 正文值, 允许工具: "" };
    }

    // 正文 = 闭合线之后的所有行
    正文值 = "";
    变量 k: 整数 = 头止 + 1;
    当 (k < 行数) {
        如果 (k > 头止 + 1) { 正文值 = 正文值 + "\n"; }
        正文值 = 正文值 + 去行尾回车(列表库::获取字符串(行列表, k));
        k = k + 1;
    }
    正文值 = 字符串::去空白(正文值);

    // 头部：逐行 ^键: 值
    变量 h: 整数 = 头起;
    当 (h < 头止) {
        变量 行: 字符串 = 去行尾回车(列表库::获取字符串(行列表, h));
        如果 (是缩进行(行) == 0 && 字符串::开始于(行, "#") == 0) {
            变量 冒号: 整数 = 字符串::查找(行, ":");
            如果 (冒号 > 0) {
                变量 键: 字符串 = 字符串::去空白(字符串::子串(行, 0, 冒号));
                变量 值: 字符串 = 字符串::去空白(字符串::子串从位置(行, 冒号 + 1));
                如果 (是块标记(值) == 1 || 字符串::字节长度(值) == 0) {
                    值 = 拼接块值(行列表, h + 1, 头止, 值);
                } 否则 {
                    值 = 去成对引号(值);
                }
                如果 (字符串::等于(键, "name") == 1) { 名称值 = 值; }
                否则如果 (字符串::等于(键, "description") == 1) { 描述值 = 值; }
                否则如果 (字符串::等于(键, "allowed-tools") == 1) { 允许值 = 规整允许工具(值); }
            }
        }
        h = h + 1;
    }

    返回 新建 技能 {
        名称: 名称值,
        描述: 描述值,
        正文: 正文值,
        允许工具: 允许值,
    };
}

// frontmatter allowed-tools（逗号分隔，没写则 ""）
公开 函数 技能允许的工具(技能值: 技能) : 字符串 {
    返回 技能值.允许工具;
}

// 从文件加载 SKILL.md
公开 函数 加载技能文件(路径: 字符串) : 技能 {
    变量 原始: 字符串 = IO::读取文件(路径);
    返回 解析技能(原始);
}

// 技能摘要（渐进式披露的「元数据」层：name — description）
公开 函数 技能摘要(技能值: 技能) : 字符串 {
    返回 "- " + 技能值.名称 + "：" + 技能值.描述;
}

// 装备一个技能到「配置」（必须在 开启会话 之前调用）。
// 把技能正文注入系统提示——开会话时随配置一起生效。
// 用法：配置 = 装备技能(配置, "你是助手。", 技能值); 变量 会话 = 开启会话(配置);
公开 函数 装备技能(配置: 模型配置, 基础系统提示: 字符串, 技能值: 技能) : 模型配置 {
    变量 提示: 字符串 = 基础系统提示
    + "\n\n# 已装备技能：" + 技能值.名称 + "\n"
    + 技能值.描述 + "\n\n"
    + 技能值.正文;
    返回 配置系统提示(配置, 提示);
}

// 多技能：先注入清单摘要 + 各技能正文到配置（开会话前）。
// 多个技能可链式调用 装备技能 逐个叠加（每次基础提示传上一次的结果不便，
// 这里提供按摘要清单注入的轻量形式）。
公开 函数 注入技能清单(配置: 模型配置, 基础系统提示: 字符串, 清单与正文: 字符串) : 模型配置 {
    变量 提示: 字符串 = 基础系统提示
    + "\n\n# 可用技能：\n" + 清单与正文;
    返回 配置系统提示(配置, 提示);
}

// 单条技能正文拼到累积提示
函数 追加技能(累积: 字符串, 技能值: 技能) : 字符串 {
    返回 累积
    + "\n\n# 已装备技能：" + 技能值.名称 + "\n"
    + 技能值.描述 + "\n\n"
    + 技能值.正文;
}

// 批量装备一个技能库目录：扫 <目录>/<名>/SKILL.md，全部加载并注入配置。
// 既适用于 skills 根目录（每个子目录一个技能），也适用于 bundle 目录
// （如 impeccable/，每个子目录一个子技能）。必须在 开启会话 之前调用。
//   配置 = 装备技能目录(配置, "你是助手。", "/Users/x/.agents/skills");
公开 函数 装备技能目录(配置: 模型配置, 基础系统提示: 字符串, 目录路径: 字符串) : 模型配置 {
    // 2.0 起 列出目录 直接给字符串列表句柄，不用再按 \n 走大字符串
    变量 名表: 整数 = 系统.列出目录(目录路径);
    变量 累积: 字符串 = 基础系统提示;
    如果 (名表 < 0) { 返回 配置系统提示(配置, 累积); }

    变量 序: 整数 = 0;
    当 (序 < 列表库::字符串列表大小(名表)) {
        变量 名: 字符串 = 列表库::获取字符串(名表, 序);
        序 = 序 + 1;
        如果 (字符串::字节长度(名) > 0) {
            变量 候选: 字符串 = 目录路径 + "/" + 名 + "/SKILL.md";
            变量 内容: 字符串 = IO::读取文件(候选);
            如果 (字符串::字节长度(内容) > 0) {
                变量 技能值: 技能 = 解析技能(内容);
                如果 (字符串::字节长度(技能值.名称) > 0) {
                    累积 = 追加技能(累积, 技能值);
                }
            }
        }
    }
    列表库::删除列表(名表);

    返回 配置系统提示(配置, 累积);
}

// 列出技能库目录里所有可加载的技能（返回摘要清单，供检视/调试）
公开 函数 技能目录清单(目录路径: 字符串) : 字符串 {
    变量 名表: 整数 = 系统.列出目录(目录路径);
    变量 输出: 字符串 = "";
    如果 (名表 < 0) { 返回 输出; }

    变量 序: 整数 = 0;
    当 (序 < 列表库::字符串列表大小(名表)) {
        变量 名: 字符串 = 列表库::获取字符串(名表, 序);
        序 = 序 + 1;
        如果 (字符串::字节长度(名) > 0) {
            变量 候选: 字符串 = 目录路径 + "/" + 名 + "/SKILL.md";
            变量 内容: 字符串 = IO::读取文件(候选);
            如果 (字符串::字节长度(内容) > 0) {
                变量 技能值: 技能 = 解析技能(内容);
                如果 (字符串::字节长度(技能值.名称) > 0) {
                    输出 = 输出 + 技能摘要(技能值) + "\n";
                }
            }
        }
    }
    列表库::删除列表(名表);

    返回 输出;
}

// ═══════════════════════════════════════════════════════════════════════
// 技能库：渐进式披露（清单进系统提示，正文按需经工具取）
// ═══════════════════════════════════════════════════════════════════════
//
// 工具处理函数签名固定为 函数(字符串):字符串，捕获不了「是哪个 agent 的技能库」。
// 与 文件工具.qi 同一套办法：每个 agent 分一个槽位，槽位专属的 before hook 把槽位号
// 写进参数 JSON，处理函数再按槽位查表。函数指针不能动态生成，所以槽位有界。

变量 技能槽位上限值: 整数 = 8;
变量 槽位代理键表: 整数 = 0;      // 字符串列表：槽位 → 代理键（会话:注册表）
变量 槽位会话表: 整数 = 0;        // 整数列表：槽位 → 会话句柄
变量 槽位名称表组: 整数 = 0;      // 整数列表：槽位 → 该库的技能名字符串列表
变量 槽位基础提示表: 整数 = 0;    // 字符串表：槽位 → 装备前的系统提示
变量 技能存在表: 整数 = 0;        // 整数表："槽位|名称" → 1
变量 技能已加载表: 整数 = 0;      // 整数表："槽位|名称" → 1 已经把正文给过模型
变量 技能描述表: 整数 = 0;        // 字符串表："槽位|名称" → 描述
变量 技能正文表: 整数 = 0;        // 字符串表："槽位|名称" → 正文
变量 技能目录表: 整数 = 0;        // 字符串表："槽位|名称" → 技能目录（含 SKILL.md 的那层）
变量 技能允许工具表: 整数 = 0;    // 字符串表："槽位|名称" → allowed-tools
变量 技能库表已建: 整数 = 0;
变量 技能资源读上限值: 整数 = 262144;   // read_skill_file 单文件 256KB，超了截断

函数 确保技能库表() {
    如果 (技能库表已建 == 1) { 返回; }
    槽位代理键表 = 列表库::创建字符串列表();
    槽位会话表 = 列表库::创建整数列表();
    槽位名称表组 = 列表库::创建整数列表();
    槽位基础提示表 = 哈希表::创建字符串表();
    技能存在表 = 哈希表::创建整数表();
    技能已加载表 = 哈希表::创建整数表();
    技能描述表 = 哈希表::创建字符串表();
    技能正文表 = 哈希表::创建字符串表();
    技能目录表 = 哈希表::创建字符串表();
    技能允许工具表 = 哈希表::创建字符串表();
    技能库表已建 = 1;
}

// 与 代理.qi 的身份键同构：会话句柄 + 注册表名字列表句柄，同会话多代理也不串。
函数 技能代理键(代理值: 代理) : 字符串 {
    返回 整数转字符串(代理值.会话句柄) + ":" + 整数转字符串(代理值.工具表.名字列表);
}

函数 查技能槽位(键: 字符串) : 整数 {
    如果 (技能库表已建 == 0) { 返回 0 - 1; }
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(槽位代理键表)) {
        如果 (字符串::等于(列表库::获取字符串(槽位代理键表, i), 键) == 1) { 返回 i; }
        i = i + 1;
    }
    返回 0 - 1;
}

函数 技能槽位有效(槽位: 整数) : 整数 {
    如果 (技能库表已建 == 0 || 槽位 < 0) { 返回 0; }
    如果 (槽位 >= 列表库::字符串列表大小(槽位代理键表)) { 返回 0; }
    返回 1;
}

函数 技能键(槽位: 整数, 名称: 字符串) : 字符串 {
    返回 整数转字符串(槽位) + "|" + 名称;
}

// 会话当前生效的系统提示（runtime 配置里的 system），没有则 ""
函数 会话系统提示(会话: 整数) : 字符串 {
    变量 视图: 字符串 = 底层模型.会话视图(会话);
    变量 对象: 整数 = J.解码(视图);
    如果 (对象 <= 0) { 返回 ""; }
    变量 提示: 字符串 = "";
    如果 (J.是否包含键(对象, "配置") == 1) {
        变量 配置对象: 整数 = J.获取对象(对象, "配置");
        如果 (配置对象 > 0) {
            如果 (J.是否包含键(配置对象, "system") == 1) {
                提示 = J.获取字符串(配置对象, "system");
            }
            J.删除(配置对象);
        }
    }
    J.删除(对象);
    返回 提示;
}

// ——— 槽位 hook（把槽位号写进参数 JSON）———

函数 注入技能槽位(参数JSON: 字符串, 槽位: 整数) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 参数JSON; }
    J.设置整数(对象, "__harness_技能槽位", 槽位);
    变量 输出: 字符串 = J.转字符串(对象);
    J.删除(对象);
    返回 输出;
}

函数 技能前置0(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 0); }
函数 技能前置1(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 1); }
函数 技能前置2(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 2); }
函数 技能前置3(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 3); }
函数 技能前置4(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 4); }
函数 技能前置5(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 5); }
函数 技能前置6(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 6); }
函数 技能前置7(工具名: 字符串, 参数JSON: 字符串) : 字符串 { 返回 注入技能槽位(参数JSON, 7); }
函数 技能工具后置(工具名: 字符串, 输出: 字符串) : 字符串 { 返回 输出; }

函数 绑定技能槽位(代理值: 代理, 工具名: 字符串, 槽位: 整数) : 代理 {
    如果 (槽位 == 0) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置0, 技能工具后置); }
    如果 (槽位 == 1) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置1, 技能工具后置); }
    如果 (槽位 == 2) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置2, 技能工具后置); }
    如果 (槽位 == 3) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置3, 技能工具后置); }
    如果 (槽位 == 4) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置4, 技能工具后置); }
    如果 (槽位 == 5) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置5, 技能工具后置); }
    如果 (槽位 == 6) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置6, 技能工具后置); }
    如果 (槽位 == 7) { 代理值.工具表 = 设置工具钩子(代理值.工具表, 工具名, 技能前置7, 技能工具后置); }
    返回 代理值;
}

// ——— 目录扫描 / 登记 ———

// 把 <目录>/<名>/SKILL.md 逐个登记到槽位。重名后者覆盖，并打一行警告到 stderr。
函数 登记技能目录(槽位: 整数, 目录路径: 字符串) : 整数 {
    变量 名列表: 整数 = 系统.列出目录(目录路径);
    如果 (名列表 < 0) { 返回 0; }
    变量 槽内名单: 整数 = 列表库::获取整数(槽位名称表组, 槽位);
    变量 登记数: 整数 = 0;
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(名列表)) {
        变量 名: 字符串 = 字符串::去空白(列表库::获取字符串(名列表, i));
        i = i + 1;
        如果 (字符串::字节长度(名) == 0 || 字符串::开始于(名, ".") == 1) { 继续; }
        变量 技能目录: 字符串 = 目录路径 + "/" + 名;
        变量 候选: 字符串 = 技能目录 + "/SKILL.md";
        如果 (IO.文件存在(候选) == 0) { 继续; }
        变量 技能值: 技能 = 解析技能(IO.读取文件(候选));
        如果 (字符串::字节长度(技能值.名称) == 0) {
            IO.打印错误行("[技能] " + 候选 + " 没有 frontmatter name，跳过");
            继续;
        }
        变量 键: 字符串 = 技能键(槽位, 技能值.名称);
        如果 (哈希表::获取整数(技能存在表, 键) == 1) {
            IO.打印错误行("[技能] 技能「" + 技能值.名称 + "」重名，以 " + 技能目录
                + " 覆盖 " + 哈希表::获取字符串(技能目录表, 键));
            // 正文换了，之前给模型的已失效 —— 允许再加载一次
            哈希表::设置整数(技能已加载表, 键, 0);
        } 否则 {
            哈希表::设置整数(技能存在表, 键, 1);
            列表库::添加字符串(槽内名单, 技能值.名称);
        }
        哈希表::设置字符串(技能描述表, 键, 技能值.描述);
        哈希表::设置字符串(技能正文表, 键, 技能值.正文);
        哈希表::设置字符串(技能目录表, 键, 技能目录);
        哈希表::设置字符串(技能允许工具表, 键, 技能值.允许工具);
        登记数 = 登记数 + 1;
    }
    返回 登记数;
}

函数 技能库清单文本(槽位: 整数) : 字符串 {
    变量 槽内名单: 整数 = 列表库::获取整数(槽位名称表组, 槽位);
    变量 文本: 字符串 = "# 可用技能库\n"
        + "下面只列出技能的名称与用途。需要用某个技能完成任务时，先调用工具 load_skill"
        + "（参数 {\"name\": \"<技能名称>\"}）取得完整指令再照做；技能附带的文件用 "
        + "read_skill_file 读取。没用到的技能不要加载。\n";
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(槽内名单)) {
        变量 名: 字符串 = 列表库::获取字符串(槽内名单, i);
        文本 = 文本 + "- " + 名 + "：" + 哈希表::获取字符串(技能描述表, 技能键(槽位, 名)) + "\n";
        i = i + 1;
    }
    返回 文本;
}

// 基础系统提示 + 清单 → 写回会话配置。多次装备只会替换清单段，不会叠两份。
函数 刷新技能清单提示(槽位: 整数) {
    变量 基础: 字符串 = 哈希表::获取字符串(槽位基础提示表, 整数转字符串(槽位));
    变量 提示: 字符串 = 基础;
    如果 (字符串::字节长度(提示) > 0) { 提示 = 提示 + "\n\n"; }
    提示 = 提示 + 技能库清单文本(槽位);
    底层模型.设置配置(列表库::获取整数(槽位会话表, 槽位), "system", 提示);
}

// ——— 资源文件 ———

// 含 .. 穿越段？前后各包一层 "/" 再找 "/../"，一招覆盖开头/中间/结尾/正好四种。
函数 技能路径含穿越(相对路径: 字符串) : 整数 {
    返回 字符串::包含("/" + 相对路径 + "/", "/../");
}

// 递归列出技能目录下的文件（相对路径，跳过 SKILL.md 与隐藏文件），有界。
函数 收集技能资源(目录: 字符串, 前缀: 字符串, 深度: 整数, 累积: 整数) {
    如果 (深度 > 4 || 列表库::字符串列表大小(累积) >= 200) { 返回; }
    变量 名列表: 整数 = 系统.列出目录(目录);
    如果 (名列表 < 0) { 返回; }
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(名列表)) {
        变量 名: 字符串 = 字符串::去空白(列表库::获取字符串(名列表, i));
        i = i + 1;
        如果 (字符串::字节长度(名) == 0 || 字符串::开始于(名, ".") == 1) { 继续; }
        如果 (深度 == 0 && 字符串::等于(名, "SKILL.md") == 1) { 继续; }
        变量 相对: 字符串 = 前缀 + 名;
        变量 全路径: 字符串 = 目录 + "/" + 名;
        如果 (路径.是目录(全路径) == 1) {
            收集技能资源(全路径, 相对 + "/", 深度 + 1, 累积);
        } 否则 {
            列表库::添加字符串(累积, 相对);
        }
    }
}

函数 技能资源清单(技能目录: 字符串) : 字符串 {
    变量 累积: 整数 = 列表库::创建字符串列表();
    收集技能资源(技能目录, "", 0, 累积);
    变量 文本: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(累积)) {
        文本 = 文本 + "- " + 列表库::获取字符串(累积, i) + "\n";
        i = i + 1;
    }
    列表库::删除列表(累积);
    返回 文本;
}

// 把用户给的相对路径解析成技能目录内的真实路径；越界/非法返回 ""。
函数 解析技能资源路径(技能目录: 字符串, 相对路径: 字符串) : 字符串 {
    如果 (字符串::字节长度(相对路径) == 0) { 返回 ""; }
    如果 (字符串::开始于(相对路径, "/") == 1) { 返回 ""; }     // 绝对路径不许
    如果 (字符串::开始于(相对路径, "~") == 1) { 返回 ""; }     // 家目录展开不许
    如果 (字符串::包含(相对路径, "\\") == 1) { 返回 ""; }       // 反斜杠分隔符不认
    如果 (技能路径含穿越(相对路径) == 1) { 返回 ""; }          // .. 穿越不许
    变量 根: 字符串 = 路径.绝对路径(技能目录);
    变量 根带杠: 字符串 = 根 + "/";
    变量 候选: 字符串 = 路径.连接(技能目录, 相对路径);
    变量 规范: 字符串 = 路径.绝对路径(候选);                   // 存在则解析符号链接
    如果 (字符串::开始于(规范, 根带杠) == 1) { 返回 候选; }
    // 候选不存在时 绝对路径 不做解析，改校验父目录仍在根内（否则「不存在」会被误判成越界）
    变量 父规范: 字符串 = 路径.绝对路径(路径.父目录(候选));
    如果 (字符串::开始于(父规范, 根带杠) == 1 || 字符串::等于(父规范, 根) == 1) { 返回 候选; }
    返回 "";
}

函数 渲染已加载技能(槽位: 整数, 名称: 字符串) : 字符串 {
    变量 键: 字符串 = 技能键(槽位, 名称);
    变量 目录: 字符串 = 哈希表::获取字符串(技能目录表, 键);
    变量 文本: 字符串 = "# 技能：" + 名称 + "\n"
        + 哈希表::获取字符串(技能描述表, 键) + "\n\n"
        + 哈希表::获取字符串(技能正文表, 键) + "\n\n"
        + "## 技能附带文件\n";
    变量 清单: 字符串 = 技能资源清单(目录);
    如果 (字符串::字节长度(清单) == 0) {
        文本 = 文本 + "（无）\n";
    } 否则 {
        文本 = 文本 + 清单
            + "需要时用 read_skill_file（参数 {\"name\": \"" + 名称
            + "\", \"path\": \"<上面的相对路径>\"}）读取。\n";
    }
    变量 允许: 字符串 = 哈希表::获取字符串(技能允许工具表, 键);
    如果 (字符串::字节长度(允许) > 0) {
        文本 = 文本 + "\n## 建议工具\n本技能建议只使用这些工具：" + 字符串::替换(允许, ",", ", ")
            + "。执行本技能期间不要调用其他工具。\n";
    }
    返回 文本;
}

函数 技能库可用名单(槽位: 整数) : 字符串 {
    变量 槽内名单: 整数 = 列表库::获取整数(槽位名称表组, 槽位);
    变量 文本: 字符串 = "";
    变量 i: 整数 = 0;
    当 (i < 列表库::字符串列表大小(槽内名单)) {
        如果 (i > 0) { 文本 = 文本 + ", "; }
        文本 = 文本 + 列表库::获取字符串(槽内名单, i);
        i = i + 1;
    }
    返回 文本;
}

// ——— 工具处理函数 ———

函数 工具_加载技能(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 工具错误("invalid_arguments", "load_skill", "arguments must be a JSON object"); }
    变量 槽位: 整数 = J.获取整数(对象, "__harness_技能槽位");
    变量 名称: 字符串 = 字符串::去空白(J.获取字符串(对象, "name"));
    J.删除(对象);
    如果 (技能槽位有效(槽位) == 0) {
        返回 工具错误("skill_library_unbound", "load_skill", "技能库绑定无效");
    }
    变量 键: 字符串 = 技能键(槽位, 名称);
    如果 (哈希表::获取整数(技能存在表, 键) != 1) {
        返回 工具错误("unknown_skill", "load_skill",
            "没有名为「" + 名称 + "」的技能。可用：" + 技能库可用名单(槽位));
    }
    如果 (哈希表::获取整数(技能已加载表, 键) == 1) {
        返回 "技能「" + 名称 + "」已加载过，完整指令见之前的工具结果，直接按它执行即可。";
    }
    哈希表::设置整数(技能已加载表, 键, 1);
    返回 渲染已加载技能(槽位, 名称);
}

函数 工具_读取技能资源(参数JSON: 字符串) : 字符串 {
    变量 对象: 整数 = J.解码(参数JSON);
    如果 (对象 <= 0) { 返回 工具错误("invalid_arguments", "read_skill_file", "arguments must be a JSON object"); }
    变量 槽位: 整数 = J.获取整数(对象, "__harness_技能槽位");
    变量 名称: 字符串 = 字符串::去空白(J.获取字符串(对象, "name"));
    变量 相对: 字符串 = 字符串::去空白(J.获取字符串(对象, "path"));
    J.删除(对象);
    如果 (技能槽位有效(槽位) == 0) {
        返回 工具错误("skill_library_unbound", "read_skill_file", "技能库绑定无效");
    }
    变量 键: 字符串 = 技能键(槽位, 名称);
    如果 (哈希表::获取整数(技能存在表, 键) != 1) {
        返回 工具错误("unknown_skill", "read_skill_file",
            "没有名为「" + 名称 + "」的技能。可用：" + 技能库可用名单(槽位));
    }
    变量 真实: 字符串 = 解析技能资源路径(哈希表::获取字符串(技能目录表, 键), 相对);
    如果 (字符串::字节长度(真实) == 0) {
        返回 工具错误("path_rejected", "read_skill_file",
            "path 必须是技能目录内的相对路径，不能是绝对路径、~ 或含 ..");
    }
    如果 (IO.文件存在(真实) == 0 || 路径.是目录(真实) == 1) {
        返回 工具错误("not_found", "read_skill_file", "技能目录里没有这个文件：" + 相对);
    }
    变量 大小: 整数 = IO.文件大小(真实);
    变量 内容: 字符串 = IO.读取文件(真实);
    如果 (大小 > 技能资源读上限值) {
        // 子串 按字节截、自动缩到 UTF-8 边界，不会切出半个字
        内容 = 字符串::子串(内容, 0, 技能资源读上限值)
            + "\n\n[已截断：文件共 " + 整数转字符串(大小) + " 字节，只返回前 "
            + 整数转字符串(技能资源读上限值) + " 字节]";
    }
    返回 内容;
}

// ——— 公开 API ———

// 装备一个技能库目录到代理（会话已开也行）：
//   - 系统提示里只追加「名称 + 描述」清单（保留原系统提示）
//   - 给代理注册 load_skill / read_skill_file 两个本地工具
// 可多次调用叠加多个根目录：清单合并，重名后者覆盖并在 stderr 打一行警告。
//   代理值 = 装备技能库(代理值, "/Users/x/.agents/skills");
//   代理值 = 装备技能库(代理值, "./项目技能");
公开 函数 装备技能库(代理值: 代理, 目录路径: 字符串) : 代理 {
    确保技能库表();
    变量 键: 字符串 = 技能代理键(代理值);
    变量 槽位: 整数 = 查技能槽位(键);
    如果 (槽位 < 0) {
        变量 总数: 整数 = 列表库::字符串列表大小(槽位代理键表);
        如果 (总数 >= 技能槽位上限值) {
            IO.打印错误行("[技能] 技能库槽位已满（上限 " + 整数转字符串(技能槽位上限值) + " 个代理）");
            返回 代理值;
        }
        槽位 = 总数;
        列表库::添加字符串(槽位代理键表, 键);
        列表库::添加整数(槽位会话表, 代理值.会话句柄);
        列表库::添加整数(槽位名称表组, 列表库::创建字符串列表());
        哈希表::设置字符串(槽位基础提示表, 整数转字符串(槽位), 会话系统提示(代理值.会话句柄));
        代理值 = 添加工具(代理值, 新建 工具 {
            名字: "load_skill",
            描述: "加载一个技能的完整指令。系统提示里的「可用技能库」只有名称和用途，用到某个技能前必须先调用本工具取得它的完整指令；同一技能只需加载一次。",
            参数schema: "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"技能名称，必须与可用技能库清单里的名称完全一致\"}},\"required\":[\"name\"]}",
            处理: 工具_加载技能,
        });
        代理值 = 添加工具(代理值, 新建 工具 {
            名字: "read_skill_file",
            描述: "读取某个技能目录里附带的文件（scripts/、references/、assets/ 等，路径见 load_skill 的结果）。只能读技能目录内的相对路径。",
            参数schema: "{\"type\":\"object\",\"properties\":{\"name\":{\"type\":\"string\",\"description\":\"技能名称\"},\"path\":{\"type\":\"string\",\"description\":\"技能目录内的相对路径，如 references/api.md\"}},\"required\":[\"name\",\"path\"]}",
            处理: 工具_读取技能资源,
        });
        代理值 = 绑定技能槽位(代理值, "load_skill", 槽位);
        代理值 = 绑定技能槽位(代理值, "read_skill_file", 槽位);
    }
    变量 登记数: 整数 = 登记技能目录(槽位, 目录路径);
    如果 (登记数 == 0) {
        IO.打印错误行("[技能] " + 目录路径 + " 下没有找到任何 <名>/SKILL.md");
    }
    刷新技能清单提示(槽位);
    返回 代理值;
}

// 该代理当前注入系统提示的技能清单文本（未装备技能库返回 ""）。供检视/测试。
公开 函数 技能库清单(代理值: 代理) : 字符串 {
    变量 槽位: 整数 = 查技能槽位(技能代理键(代理值));
    如果 (槽位 < 0) { 返回 ""; }
    返回 技能库清单文本(槽位);
}

// 某技能的正文是否已经通过 load_skill 交给过模型（1/0）
公开 函数 技能库已加载(代理值: 代理, 名称: 字符串) : 整数 {
    变量 槽位: 整数 = 查技能槽位(技能代理键(代理值));
    如果 (槽位 < 0) { 返回 0; }
    如果 (哈希表::获取整数(技能已加载表, 技能键(槽位, 名称)) == 1) { 返回 1; }
    返回 0;
}

// 按某技能的 allowed-tools 收窄代理的工具白名单（加上技能库自己的两个工具）。
// 由宿主决定何时收窄、何时用 设置工具白名单(代理值, "") 放开 —— 代理循环里没有
// 「本轮结束」的挂点可以自动恢复，所以不做隐式的按轮收窄。技能没写 allowed-tools
// 时原样返回，不改白名单。
公开 函数 应用技能工具白名单(代理值: 代理, 名称: 字符串) : 代理 {
    变量 槽位: 整数 = 查技能槽位(技能代理键(代理值));
    如果 (槽位 < 0) { 返回 代理值; }
    变量 允许: 字符串 = 哈希表::获取字符串(技能允许工具表, 技能键(槽位, 名称));
    如果 (字符串::字节长度(允许) == 0) { 返回 代理值; }
    返回 设置工具白名单(代理值, 允许 + ",load_skill,read_skill_file");
}
